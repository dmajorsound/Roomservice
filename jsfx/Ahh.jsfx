// Tempo tools panel (movable): tap tempo, analyze BPM, note values, and note table in ms; sets delay or motion time
function gfxp15()
(
// ---- TEMPO TOOLS (Expert): a small panel beside the delay - the plugin stays usable, every delay knob can be changed while
