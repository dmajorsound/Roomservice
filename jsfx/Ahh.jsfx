  xpf[15] = slider100 >= 0.5;
  xpn = 0; strcpy(#xpt, "Expert settings active: "); k = 0;
  loop(16, xpf[k] ? ( xpn > 0 ? strcat(#xpt, " · "); strcat(#xpt, xpname(k)); xpn += 1; ); k += 1; );
  xpn > 0 ? (
    0;   // drawn in the strip (fixed place), see the strip
  ) : ( xpon = 0; );
);
actcol = cTEXT;
!isfree ? (
  inbox(dmwx - dmww / 2, dmwy - 7, dmww, 14) ? tipbox(dmwx - dmww / 2, dmwy - 7, dmww, 14, "Room width – drag left / right to change it (Shift = fine), double-click = type a value");
  inbox(dmdx, dmdy - 7, dmdw, 14) ? tipbox(dmdx, dmdy - 7, dmdw, 14, "Room depth – drag up / down to change it (Shift = fine), double-click = type a value");
