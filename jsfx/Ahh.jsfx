  segp(x + 48, y, w - 48, 16, 4, 1, "Hard", g == 1, cTEXT) ? setp(119, 1);
  segp(x + 48, y, w - 48, 16, 4, 2, "Grass", g == 2, cTEXT) ? setp(119, 2);
  segp(x + 48, y, w - 48, 16, 4, 3, "Snow", g == 3, cTEXT) ? setp(119, 3);
