function a_rfset(i, v) (
  i == 0 ? slider120 = v;
  i == 1 ? slider121 = v;
  i == 2 ? slider122 = v;
  i == 3 ? slider123 = v;
  i == 4 ? slider124 = v;
  i == 5 ? slider125 = v;
  i == 6 ? slider126 = v;
  i == 7 ? slider127 = v;
  i == 8 ? slider128 = v;
  i == 9 ? slider129 = v;
  i == 10 ? slider130 = v;
  i == 11 ? slider131 = v;
  i == 12 ? slider132 = v;
  i == 13 ? slider133 = v;
  i == 14 ? slider134 = v;
