// ---- REFLECTORS (free field): two vertical planes, state in vopt[52 ...] (6 values each: material, X, Y, angle, length, height) ----
RFB = 52;   // (RFN was never read - removed)
// Returns the absorption coefficient of reflector type m (facade 0.04, glass 0.03, rock 0.02, fence 0.12, hedge 0.5).
function rflA(m) ( m < 1.5 ? 0.04 : (m < 2.5 ? 0.03 : (m < 3.5 ? 0.02 : (m < 4.5 ? 0.12 : 0.5))); );
