// Saves all slider values into snapshot slot k (format flag 19), with sliders above 64 stored in the extended array, then calls sliderchange(-1).
function saveslot(k) local(b, i)
(
  b = uslot + k * USL; b[0] = 20; i = 1;   // 20: + Motion Doppler, free-field ground (118, 119) - they were not stored before; 19: + distance perspective (117)
    // flag history (see loadslot): 18: + delay type, repeats through the device (115, 116); 17: distortion counts on Original (older: 0 there); 16: + source call line (111-114); 15: + input mono mix (110); 14: + motion (100-109); 6: sliders 1-63 + 65-85 (5: 65-84, without the source switch); 4: no delay (65 and up); 3: before 0.201, no source aim = aimed at the listener; 2: 0.197, slider 62 was air temperature; 1: sliders 1-60
  loop(NSN, i < 64 ? ( b[i] = slider(i); ) : ( i > 64 ? ( uslotX[k * USX + i - 64] = slider(i); ); ); i += 1; );
  uslotR[k * URR] = 1; rfget(uslotR + k * URR + 1);   // the reflectors belong to the snapshot
  sliderchange(-1);
);
// clear a snapshot slot: settings, name and description
function snclear(k) (
  uslot[k * USL] = 0; memset(uslot + k * USL + 1, 0, USL - 1); memset(uslotX + k * USX, 0, USX); memset(uslotR + k * URR, 0, URR);
  memset(snam + k * SNL, 0, SNL); memset(dsc + k * DSL, 0, DSL);
  snlast == k + 1 ? ( snlast = 0; );
  sliderchange(-1);
);
// Loads snapshot slot k with an undo snapshot, applying only sliders that existed in the slot's format version (older slots keep defaults for newer ones).
function loadslot(k) local(b, i)
(
  b = uslot + k * USL;
  // a slider newer than the slot's format flag b[0] (thresholds as in the flag list in saveslot) takes the morph default mdef(i); otherwise the stored value, clamped
  b[0] ? ( snap_take(); i = 1; loop(NSN, i != 64 ? sset(i, (i > 60 && b[0] < 1.5) || (i >= 62 && b[0] < 2.5) || (i == 63 && b[0] < 3.5) || (i > 64 && b[0] < 4.5) || (i > 84 && b[0] < 5.5) || (i > 85 && b[0] < 6.5) || (i > 86 && b[0] < 7.5) || (i > 87 && b[0] < 8.5) || (i > 92 && b[0] < 9.5) || (i > 94 && b[0] < 10.5) || (i > 96 && b[0] < 11.5) || (i > 97 && b[0] < 12.5) || (i > 99 && b[0] < 13.5) || (i > 109 && b[0] < 14.5) || (i > 110 && b[0] < 15.5) || (i == 37 && b[0] < 16.5 && floor(b[35] + 0.5) == 0) || (i > 114 && b[0] < 17.5) || (i > 116 && b[0] < 18.5) || (i > 117 && b[0] < 19.5) ? mdef(i) : sclamp(i, i < 64 ? b[i] : uslotX[k * USX + i - 64])); i += 1; ); uslotR[k * URR] >= 0.5 ? rfput(uslotR + k * URR + 1); selw = 0; snap_notify(); );   // (a snapshot with reflectors brings them back; an older one leaves them as they are)
);
// Returns true if slot k is filled and all of its saved slider values equal the current ones (up to the range its format version covers).
function slotmatch(k) local(b, i, m)
(
  b = uslot + k * USL; m = b[0] > 0; i = 1;
  // loop count = the highest slider number the slot's format flag stores (same thresholds as loadslot)
  loop(b[0] < 1.5 ? 60 : (b[0] < 2.5 ? 61 : (b[0] < 3.5 ? 62 : (b[0] < 4.5 ? 63 : (b[0] < 5.5 ? 84 : (b[0] < 6.5 ? 85 : (b[0] < 7.5 ? 86 : (b[0] < 8.5 ? 87 : (b[0] < 9.5 ? 92 : (b[0] < 10.5 ? 94 : (b[0] < 11.5 ? 96 : (b[0] < 12.5 ? 97 : (b[0] < 13.5 ? 99 : (b[0] < 14.5 ? 109 : (b[0] < 15.5 ? 110 : (b[0] < 17.5 ? 114 : (b[0] < 18.5 ? 116 : (b[0] < 19.5 ? 117 : NSN))))))))))))))))), i != 64 && !(i == 37 && b[0] < 16.5 && floor(b[35] + 0.5) == 0) ? ( abs(slider(i) - (i < 64 ? b[i] : uslotX[k * USX + i - 64])) > 0.0001 ? m = 0; ); i += 1; );
// in the free field the reflectors must match too (in a room they play no part)
  m && slider1 >= 0.5 && uslotR[k * URR] >= 0.5 ? ( i = 0; loop(15, abs(vopt[RFB + i] - uslotR[k * URR + 1 + i]) > 0.0001 ? m = 0; i += 1; ); );
  m;
);

function sn_commit(k, store) local(i) (             // store = 1: name + all current settings, 0: name only
  i = 0; loop(SNL, snam[k * SNL + i] = i < snelen ? sneb[i] : 0; i += 1; );
  i = 0; loop(DSL, dsc[k * DSL + i] = i < dselen ? dseb[i] : 0; i += 1; );
  store ? ( saveslot(k); snlast = k + 1; ) : sliderchange(-1);
  snedit = 0;
);
// hash of all sound-relevant sliders; compute_geo (7 image sources, trig, exp) runs only when it changes
function geo_if_changed() local(i, key, rfi)
(
  key = 0; i = 1;
  loop(64, key += slider(i) * (i * 7919 + 1); i += 1; );
  rfi = 0; loop(15, key += vopt[RFB + rfi] * (1913.7 + rfi * 37.3); rfi += 1; );   // the reflectors
  key += slider117 * 1597.3 + slider85 * 991.3 + slider92 * 1237.7 + slider95 * 1301.3 + slider96 * 1409.9 + slider97 * 1499.7;
  key += slider119 * 1663.1 + vopt[69] * 1777.7;
  pro_on != last_pro_on ? ( last_gkey = -1; last_pro_on = pro_on; );   // (the rear network is designed only in 5.1 - switching on: design it now)
  key += pro_on * 2203.3 + slider137 * 2287.1 + slider138 * 2333.7 + slider139 * 2371.3 + slider144 * 2399.9 + slider145 * 2411.1 + slider146 * 2417.3;   // RoomservicePro: the layout and the Center knob pan the taps   // the ground (Free field) and its level - they were missing: a change counted only once something moved (Motion)
  key != last_pkey ? (
    // BARRIER MIX below 100 %: the paths through it lose that share of the damping (see bxing); the reverb tail is blended
    // in energy between the barrier as set and the room without it (the two-part model alone would get too loud for a
    // barrier that lets nearly everything through)
    // a partition smaller than the room: its gap couples the two parts - the tail moves towards the open room
// the share is the coupling of two rooms through an opening - open area S against the absorption area A of the
    // far part: S / (S + A). A 10 cm slit over a 5.5 m wall (0.55 m2) couples about 5 %, a 40 cm gap 20 %, a half-height
    // partition about 45 % (the square root used before gave 20 % for the slit - the tail jumped up with a tiny gap)
    bgW = max(0.8, slider2) * min(4, max(0.25, slider31)); bgH = max(0.8, slider4) * min(4, max(0.25, slider31));
    bgBW = slider95 > 0.001 ? min(bgW, max(0.3, slider95 * min(4, max(0.25, slider31)))) : bgW; bgBH = slider96 > 0.001 ? min(bgH, max(0.3, slider96 * min(4, max(0.25, slider31)))) : bgH;
    bgS = (bgW - bgBW) * bgH + bgBW * (bgH - bgBH);                                                                      // the open part of the barrier plane (m2)
    bgA = max(1, roomA > 0 ? roomA * 0.5 : bgW * bgH);                                                                   // absorption area of the far part (half the room)
    bmixg = min(1, max(0, slider92 / 100)) * (1 - bgS / (bgS + bgA));
    bgblend = 0;
    slider41 >= 0.5 && bmixg < 0.999 ? ( bgoff = 1; compute_geo(); gLGo = xLG; gEQLo = xEQL; gSTWo = xSTW; gRTo = rt; gLFo = lfrP; gMFo = mfp; bgoff = 0; bgblend = 1; );
    compute_geo(); bgblend = 0;
    slider41 >= 0.5 && bmixg < 0.999 ? (
      xLG = sqrt(bmixg * sqr(xLG) + (1 - bmixg) * sqr(gLGo));
      xLLP *= bmixg; xLDf = 1 - (1 - xLDf) * bmixg; xLPL *= bmixg; xLPR *= bmixg; xLG2 *= bmixg;
      xEQL = 1 / sqrt(bmixg / sqr(max(0.0001, xEQL)) + (1 - bmixg) / sqr(max(0.0001, gEQLo)));
      xSTW = xSTW * bmixg + gSTWo * (1 - bmixg);
    );
    // ROOM MODES only when what they depend on changed (room, positions, barrier, bass decay) - automating a level, the mix,
    // a filter or the EQ no longer recalculates up to 96 modes every block
    mdbon = bon && bmixg >= 0.5;
    mdkey = roomW * 1.31 + roomD * 7.17 + roomH * 13.3 + sx * 3.7 + sy * 5.9 + sz * 11.1 + lx * 17.3 + ly * 19.7 + lz * 23.9
          + rt * lfrP * 29.3 + bon * 31.1 + yb * 37.7 + sideL * 41.3 + bsame * 43.7 + brOA * 47.9 + ax0 * 53.3 + az0 * 59.9 + brX0 * 71.3 + brH * 73.9 + isfree * 61.7 + mdbon * 67.1;
    mdkey != last_mdkey ? ( mdcalc(); mdapply(); last_mdkey = mdkey; );
    last_pkey = key;
  );
  mdPend && cMD < 0.001 ? mdswap();   // modes faded out: take the new set
);

// SAMPLE RATE: everything that depends on it. Called at the end of @init and from @block whenever srate is not the rate it
// was set up for - REAPER does not re-run @init on a sample-rate change with ext_noinit, and srate may still be wrong in
// @init when a project loads (then the plugin would run with the coefficients of another rate: other filters, other
// smoothing, other modulation - a render after reopening the project would sound different).
function srsetup() local(k)
(
  srini = srate;
  srlayout();
  memset(ibuf, 0, dlL - ibuf); memset(dlL, 0, 2 * DLMAX + 2 * MAXIN); qBclear();
  // reverb modulation (Hz -> radians per sample), depth
  moddep = 0.00015 * srate;   // (see @init)
  edL0 = min(EDN - 1, floor(0.0043 * srate)); edL1 = min(EDN - 1, floor(0.0067 * srate)); edL2 = min(EDN - 1, floor(0.0049 * srate)); edL3 = min(EDN - 1, floor(0.0079 * srate)); memset(edB0, 0, 4 * EDN); q5edset(); memset(qED, 0, 10 * EDN);
  // smoothing, delay tape, meters, scene crossfade, shelves
  // one-pole coefficients 1 - exp(-1 / (T * srate)): sm 30 ms, smm 12 ms, smf 150 ms, smu 120 ms, dlsm 80 ms; gRK = gain factor per sample for 3 dB per ms (limits how fast a gain may rise)
  sm  = 1 - exp(-1 / (0.03 * srate)); smm = 1 - exp(-1 / (0.012 * srate)); gRK = 10 ^ (3 / 20 / (srate / 1000)); smf = 1 - exp(-1 / (0.15 * srate)); smu = 1 - exp(-1 / (0.12 * srate)); dlsm = 1 - exp(-1 / (0.08 * srate));
  smd = sm; smfd = smf;
  dwr1 = 2 * $pi * 0.53 / srate; dwr2 = 2 * $pi * 0.61 / srate; dwr3 = 2 * $pi * 6.1 / srate; dwr4 = 2 * $pi * 6.7 / srate;
  dwA = 0.001 * srate; dfA = 0.00008 * srate;
  pmdec = exp(-1 / (0.15 * srate)); sm5 = 1 - exp(-1 / (0.005 * srate));
  lfc = 1 - exp(-2 * $pi * 250 / srate); dirC = 1 - exp(-2 * $pi * 3000 / srate); dirCB = 1 - exp(-2 * $pi * 250 / srate);
  xfstep = 1 / (0.08 * srate); JTHR = srate / 343; JTHRF = 0.003 * srate; JTS = 0.0005 * srate;
  fzDR = 1 - 2 * $pi * 20 / srate; fzrel = exp(-1 / (0.05 * srate));
  // limiter: look-ahead 1.5 ms (= latency reported to REAPER), release 150 ms
  LMLA = min(590, max(1, floor(0.0015 * srate + 0.5))); LMN = LMLA + 1; LMQ = LMN + 2;
  lmDL = lmb; lmDR = lmDL + LMLA; lmW = lmDR + LMLA; lmQv = lmW + LMN; lmQt = lmQv + LMQ;
  memset(lmDL, 0, 2 * LMLA); k = 0; loop(LMN, lmW[k] = 1; k += 1; );
  lmsum = LMN; lmqh = lmqn = 0; lmt = 0; lmd = 0; lmdd = 0; lmr = 1; lmga = 1;
  lmrel = 1 - exp(-1 / (0.15 * srate)); pdc_delay = LMLA + 1; crk = exp(-1 / (0.3 * srate)); smQ = 1 - exp(-1 / (0.005 * srate)); xfRI = 1 / (0.003 * srate);   // (pdc +1: see the direct sound,)
  smab = 1 - exp(-1 / (0.25 * srate));                               // A / B trim: 250 ms glide
  // bass steering crossover: 4th-order Linkwitz-Riley = two equal 2nd-order Butterworth sections (low and high stay in phase)
  fdesignbl(stC, stC + 40, 0, 250, 2); memcpy(stC + 5, stC, 5);
  fdesignbl(stC + 10, stC + 40, 1, 250, 2); memcpy(stC + 15, stC + 10, 5);
  qLFfc = -1;   // (RoomservicePro: the LFE low-pass is designed again for the new rate, in @block)
  // every cached design is made again for the new rate (geometry, reverb lines, modes, source model, tone, filters, delay)
  last_pkey = -1; last_mdkey = -1; last_mfp = -1; last_gkey = -1; last_gkey2 = -1; lastfz = -1; lastfzo = -1; lastfzn = -1;
  lastbr = lastdk = -1000; lastlc = lasthc = -1; dllkey = -1;
  fpanic = 1; snap = 1;
);
srsetup();
compute_geo(); mdbon = bon && slider92 >= 50; mdcalc(); mdswap(); cMD = 0;

@serialize
// Every variable here starts with ser_: REAPER runs @serialize on its own thread (e.g. for every undo point when a
// parameter changes) - a shared name like sm (the smoothing of the audio) would be overwritten in the middle of playback.
// REAPER: file_avail(0) is < 0 while saving and 0 while loading (it does NOT tell how much is left), so the state is
// written with a header (magic, version, sizes) and read back by those sizes. Older projects (0.176 … 0.191, no header)
// are read in one go - file_mem returns how many values there were - and split up by the old block order.
uslot = 64; uslotX = 1152; vopt = 2048; snam = vopt + 5200; USL = 64; USX = 56; SNL = 24; dsc = 4194304; DSL = 128; ser_scr = 8192; urb = 4194304 + 32000; URM = 24; URL = 66; MTDP = 4194304 + 40000; MTDS = 4194304 + 41000; MTAP = 4194304 + 45000; uslotR = 4194304 + 62000; URR = 16;   // fixed addresses, as in @init (may run first)
ser_sermagic = 7391.25;
file_avail(0) < 0 ? (
  // ---- save ----
  ser_sm = ser_sermagic; file_var(0, ser_sm); ser_sv = 18; file_var(0, ser_sv);
  ser_sn = 16; file_var(0, ser_sn); ser_su = USL; file_var(0, ser_su); ser_sl = SNL; file_var(0, ser_sl); ser_so = 72; file_var(0, ser_so);
  file_mem(0, uslot, 16 * USL); file_mem(0, snam, 16 * SNL); file_mem(0, vopt, ser_so);   // 0.362: the count written is the count in the header (0.359 - 0.361 wrote 51 values under the number 52: a project saved with them is read with 51)
  ser_sd = DSL; file_var(0, ser_sd); file_mem(0, dsc, 16 * DSL);   // v2: descriptions
  ser_sx = USX; file_var(0, ser_sx); file_mem(0, uslotX, 16 * USX);   // v4: snapshot extension (delay); 56 per slot (motion)
  ser_su2 = URM * URL; file_var(0, ser_su2); file_mem(0, urb, URM * URL);   // v9: my rooms
  file_mem(0, MTDP, 770); file_mem(0, MTDS, 3081); file_mem(0, MTAP, 3); file_mem(0, uslotR, 16 * URR);   // v17: + the reflectors of the 16 snapshots (URR = 16 values per slot) // v16: + the Own spot // v15: + the four path slots // v14: the drawn motion path with its timing and heights (v13: 514 values, v12: 128 points, 257 values)
) : (
  // ---- load ----
  ser_sm = 0; file_var(0, ser_sm);
  ser_sm == ser_sermagic ? (
    file_var(0, ser_sv); file_var(0, ser_sn); file_var(0, ser_su); file_var(0, ser_sl); file_var(0, ser_so);
    ser_sv < 18 ? rfLoad += 1;   // before 0.385 the reflectors had no sliders: the loaded values go into them (not the defaults the other way)
    ser_sn = min(16, max(0, ser_sn)); ser_su = max(1, ser_su); ser_sl = max(1, ser_sl);
    memset(uslot, 0, 16 * USL); memset(snam, 0, 16 * SNL);
    ser_k = 0; loop(ser_sn, file_mem(0, ser_scr, ser_su); memcpy(uslot + ser_k * USL, ser_scr, min(ser_su, USL)); ser_k += 1; );
    ser_k = 0; loop(ser_sn, file_mem(0, ser_scr, ser_sl); memcpy(snam + ser_k * SNL, ser_scr, min(ser_sl, SNL)); ser_k += 1; );
    vopt[18] = vopt[19] = vopt[20] = 0; memset(vopt + 21, 0, 24); ser_cn = ser_so == 52 ? 51 : min(ser_so, 72); file_mem(0, ser_scr, ser_cn); memcpy(vopt, ser_scr, ser_cn); vopt[18] = 0; ser_so < 49 ? ( vopt[48] = 0; ); ser_so < 50 ? ( vopt[49] = 0; ); ser_so < 51 ? ( vopt[50] = 0; ); ser_so < 52 ? ( vopt[51] = 0; );   // Hear is never loaded (monitor only)
    ser_so < 48 ? ( vopt[45] = 0; vopt[46] = 1; vopt[47] = 0; vopt[12] = vopt[12] - (vopt[12] & 512); );   // before 0.246: open in the new tabs (the All tab = the two columns as before)
    ser_sv < 10 ? ( vopt[14] = 0; memset(vopt + 21, 0, 21); vopt[12] = vopt[12] - (vopt[12] & 1024); );   // before 0.230: layout A - standard sizes, the delay open, Plan view
    ser_sv < 11 && floor(slider35 + 0.5) == 0 ? ( slider37 = 0; );   // 0.304: before, distortion did nothing on Original (now it saturates)
    ser_sv < 3 ? ( slider63 = 0; );   // projects before 0.201: the source kept aiming at the listener - they sound as before
    ser_sv < 5 ? ( vopt[12] = 1024 + (vopt[12] & 512); );   // before 0.210: Expert opens with the delay folded, all other sections open
    ser_sv < 6 ? ( vopt[12] = vopt[12] | 2304; );   // before 0.212: Timeline (echogram) and Decay by band start folded
    ser_sv < 8 ? ( slider87 = 0; );                    // before 0.214: no feedback link - L and R keep their feedback
    ser_sv < 7 ? ( slider86 = 0; );                    // before 0.213: no level link - L and R keep the levels they had
    memset(dsc, 0, 16 * DSL);
    ser_sv >= 2 ? (
      ser_sd = 0; file_var(0, ser_sd); ser_sd = min(4096, max(0, ser_sd));
      ser_k = 0; loop(ser_sn, file_mem(0, ser_scr, ser_sd); memcpy(dsc + ser_k * DSL, ser_scr, min(ser_sd, DSL)); dsc[ser_k * DSL + DSL - 1] = 0; ser_k += 1; );
    );
    memset(uslotX, 0, 16 * USX);
    ser_sv >= 4 ? (
      ser_sx = 0; file_var(0, ser_sx); ser_sx = min(4096, max(0, ser_sx));
      ser_k = 0; loop(ser_sn, file_mem(0, ser_scr, ser_sx); memcpy(uslotX + ser_k * USX, ser_scr, min(ser_sx, USX)); ser_k += 1; );
    );
    memset(urb, 0, URM * URL);
    ser_sv >= 9 ? (
      ser_su2 = 0; file_var(0, ser_su2); ser_su2 = min(4000, max(0, ser_su2));
      file_mem(0, ser_scr, ser_su2);
      ser_su2 == URM * 64 ? ( ser_k = 0; loop(URM, memcpy(urb + ser_k * URL, ser_scr + ser_k * 64, 64); ser_k += 1; ); )   // before 0.232: 64 per room
                          : memcpy(urb, ser_scr, min(ser_su2, URM * URL));
    );
    memset(MTDP, 0, 770); memset(MTDS, 0, 3081); memset(MTAP, 0, 3); memset(uslotR, 0, 16 * URR);
    ser_sv >= 15 ? ( file_mem(0, MTDP, 770); file_mem(0, MTDS, 3081); ser_sv >= 16 ? file_mem(0, MTAP, 3); ser_sv >= 17 ? file_mem(0, uslotR, 16 * URR); ) :
    // older formats: v14 = 770 values, v13 = 514, v12 = 128 xy points + a count (257 values), resampled here to 256 points by linear interpolation
    ser_sv == 14 ? ( file_mem(0, MTDP, 770); ) : ser_sv == 13 ? ( file_mem(0, MTDP, 514); ) : (
    ser_sv == 12 ? ( file_mem(0, ser_scr, 257);
      ser_scr[256] >= 128 ? ( ser_k = 0; loop(256, ser_j = floor(ser_k / 2); ser_f = (ser_k / 2) - ser_j;
        MTDP[2 * ser_k] = ser_scr[2 * ser_j] + (ser_scr[2 * ((ser_j + 1) % 128)] - ser_scr[2 * ser_j]) * ser_f;
        MTDP[2 * ser_k + 1] = ser_scr[2 * ser_j + 1] + (ser_scr[2 * ((ser_j + 1) % 128) + 1] - ser_scr[2 * ser_j + 1]) * ser_f; ser_k += 1; ); MTDP[512] = 256; ); ); );
    ser_sv < 15 && MTDP[512] >= 256 ? ( memcpy(MTDS, MTDP, 770); MTDS[3080] = 0; );   // (0.331: an older path goes into slot 1)
  ) : (
    floor(slider35 + 0.5) == 0 ? ( slider37 = 0; );   // (see above)
    rfLoad += 1;
    // legacy stream: the first value was already read (slot 1 flag)
    ser_scr[0] = ser_sm; ser_lgn = 1 + file_mem(0, ser_scr + 1, 4000); ser_lgp = 0;
    // old block order (each block zero-filled when the stream ends before it): slots 0-3 + 12 view options, slots 4-5, 2 view options, names 0-5, slots 6-9, names 6-9, 2 view options, slots 10-15, names 10-15, 2 view options
    ser_lgn >= 268 ? (
    ser_lgp + 256 <= ser_lgn ? memcpy(uslot, ser_scr + ser_lgp, 256) : memset(uslot, 0, 256); ser_lgp += 256;
    ser_lgp + 12 <= ser_lgn ? memcpy(vopt, ser_scr + ser_lgp, 12) : memset(vopt, 0, 12); ser_lgp += 12;
    ser_lgp + 128 <= ser_lgn ? memcpy(uslot + 4 * USL, ser_scr + ser_lgp, 128) : memset(uslot + 4 * USL, 0, 128); ser_lgp += 128;
    ser_lgp + 2 <= ser_lgn ? memcpy(vopt + 12, ser_scr + ser_lgp, 2) : memset(vopt + 12, 0, 2); ser_lgp += 2; vopt[12] = 3328 + (vopt[12] & 512);
    ser_lgp + 144 <= ser_lgn ? memcpy(snam, ser_scr + ser_lgp, 144) : memset(snam, 0, 144); ser_lgp += 144;
    ser_lgp + 256 <= ser_lgn ? memcpy(uslot + 6 * USL, ser_scr + ser_lgp, 256) : memset(uslot + 6 * USL, 0, 256); ser_lgp += 256;
    ser_lgp + 96 <= ser_lgn ? memcpy(snam + 6 * SNL, ser_scr + ser_lgp, 96) : memset(snam + 6 * SNL, 0, 96); ser_lgp += 96;
    ser_lgp + 2 <= ser_lgn ? memcpy(vopt + 14, ser_scr + ser_lgp, 2) : memset(vopt + 14, 0, 2); ser_lgp += 2;
    ser_lgp + 384 <= ser_lgn ? memcpy(uslot + 10 * USL, ser_scr + ser_lgp, 384) : memset(uslot + 10 * USL, 0, 384); ser_lgp += 384;
    ser_lgp + 144 <= ser_lgn ? memcpy(snam + 10 * SNL, ser_scr + ser_lgp, 144) : memset(snam + 10 * SNL, 0, 144); ser_lgp += 144;
