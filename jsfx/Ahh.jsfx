// (txtplate, the text on a backing plate, follows after txtfit)
// (txtbox / txtboxR above shrink the font to fit; txtfit cuts the text instead)
// text that must stay inside a box (dropdowns): shortened with "…" when the scaled font is relatively wider
function txtfit(s, x, yc, w) local(n)
(
  strcpy(#tfit, s);
  tws(#tfit) > w ? (
    n = strlen(#tfit);
    while ( n -= 1; str_setlen(#tfit, n); strcpy(#tfit2, #tfit); strcat(#tfit2, "…"); n > 1 && tws(#tfit2) > w; );
    // never cut inside a word: a hint line of parts ("a  ·  b  ·  c") loses whole parts, other text ends after its last whole word
    tfc = n - 1; tfd = -1; tfsp = -1;
    while ( tfc > 0 && tfd < 0 ) (
      (str_getchar(#tfit, tfc) + 256) % 256 == 0xB7 && (str_getchar(#tfit, tfc - 1) + 256) % 256 == 0xC2 ? tfd = tfc - 1;
