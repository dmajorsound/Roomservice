    tipbox(ex0s, ey0s - 14, qx - ex0s, qy - ey0s + 14, bt == 3 ? "Door: drag = slide · Shift+drag or wheel = open / close · double-click = close" : "Window: drag = slide · Shift+drag or wheel = open / close the two sashes · double-click = close");
  );
