    col(cMUTED, 1); gfx_setfont(7); txt(anaConf >= 4.5 ? "sure" : (anaConf >= 3 ? "fairly sure" : "unsure"), arx + arw, tpy0 + 88, 2);
    tcw = (arw - 6) / 3;
    sprintf(#w1, "%.1f", anaBf); chip(arx, tpy0 + 97, tcw, 13, #w1, anaSel == 0, cTEXT) ? ( anaSel = 0; );
    sprintf(#w1, "½ %.1f", anaBf / 2); chip(arx + tcw + 3, tpy0 + 97, tcw, 13, #w1, anaSel == 1, cTEXT) ? ( anaSel = 1; );
    anaBf * 2 <= 300 ? ( sprintf(#w1, "2× %.1f", anaBf * 2); chip(arx + 2 * tcw + 6, tpy0 + 97, tcw, 13, #w1, anaSel == 2, cTEXT) ? ( anaSel = 2; ); );
    tipbox(arx, tpy0 + 97, arw, 13, "The analysis can land on half or double the tempo – choose the one that feels right");
  ) : ( col(cDIM2, 1); gfx_setfont(2); txt("– BPM", arx, tpy0 + 88, 0); );
  chip(arx, tpy0 + 115, 72, 15, "Use", 0, anaok ? cDLTT : cDIM2) && anaok ? ( tpuse(gdtm ? -1 : tnc(tnsel), floor(min(300, selb) * 100 + 0.5) / 100); );
  tipbox(arx, tpy0 + 115, 72, 15, "Use the analyzed tempo: the delay keeps its note values and plays them at this tempo (in ms mode: the note value chosen below)");
  chip(arx + 76, tpy0 + 115, arw - 76, 15, "Project tempo", slider74 < 0.5 && gdtm, cTEXT) ? ( tpapply(gdtm ? -1 : tnc(tnsel), 0); );
  tipbox(arx + 76, tpy0 + 115, arw - 76, 15, "Use the tempo of the REAPER project: the delay follows it, also when the project tempo changes");
