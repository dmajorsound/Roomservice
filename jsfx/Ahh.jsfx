function q5clear() ( memset(qLP, 0, 2 * TS); memset(qED, 0, 10 * EDN); memset(qSTS, 0, 40); memset(qBSS, 0, 40); memset(qFS, 0, 300); memset(qLMD, 0, 4 * 590); memset(QP5, 0, 128); memset(qLFS, 0, 16); qLFm = 0; );
