  vopt[RFB + 14] < 0.5 ? ( vopt[RFB] >= 0.5 ? pHt = max(pHt, min(vopt[RFB + 5], max(roomW, roomD))); vopt[RFB + 6] >= 0.5 ? pHt = max(pHt, min(vopt[RFB + 11], max(roomW, roomD))); ); );
