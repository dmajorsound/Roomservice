clipwarn = 0;
snap = 1;
cLLP = xLLP = 0; lpLt = 0; cLM = xLM = 0; cLDf = xLDf = 1; cLPL = xLPL = 0; cLPR = xLPR = 0;
xfR = 1; cXR = 1; xfG = 0; xfcnt = 1000000000; xfRI = 1 / (0.003 * srate); sm5 = 1 - exp(-1 / (0.005 * srate));   // scene change of the reverb network (see @block)
xTK = cTK = 0; tkn = 0; tkstep = 1; bndS = 0; xBNG = cBNG = 0; xBNA = 0;   // tail level matching on room changes; boundary bass of the reverb
lfc = 1 - exp(-2 * $pi * 250 / srate);
dirC = 1 - exp(-2 * $pi * 3000 / srate); dirS = 0;    // directivity: shelf corners of the reverb input (highs / bass)
dirCB = 1 - exp(-2 * $pi * 250 / srate); dirB = 0;
cLG2 = xLG2 = 0; cLD2 = xLD2 = 0; cLLP2 = xLLP2 = 0; lpLt2 = 0; cP2L = cP2R = xP2L = xP2R = 1; last_gkey2 = -1; oLD2 = 0;
xfade = 0; xfstep = 1 / (0.08 * srate); JTHR = srate / 343; JTHRF = 0.003 * srate;   // scene crossfade: 80 ms, triggered by jumps > 1 m / 3 ms
JTS = 0.0005 * srate; dfrz = 0; smd = sm; smfd = smf; ldS = ld2S = 0;                 // < 0.5 ms change = unchanged for the crossfade
// FDN feedback mixing angle theta = 0.5 pi (0.12 + 0.88 * density): cos / sin weigh the identity against the Hadamard part; start value for Density 80 %
cTH = xTH = cos(0.5 * $pi * 0.824); sTH = xSH = sin(0.5 * $pi * 0.824);

// ---------- filters: Butterworth cascades (6..48 dB/oct = order 1..8) ----------

// DELAY note values in quarter notes (slider 72 / 73): 1/1, 1/2., 1/2, 1/4., 1/2T, 1/4, 1/8., 1/4T, 1/8, 1/16., 1/8T, 1/16, 1/32
function dnote(n) ( n = floor(n + 0.5); n == 0 ? 4 : (n == 1 ? 3 : (n == 2 ? 2 : (n == 3 ? 1.5 : (n == 4 ? 4 / 3 : (n == 5 ? 1 : (n == 6 ? 0.75 : (n == 7 ? 2 / 3 : (n == 8 ? 0.5 : (n == 9 ? 0.375 : (n == 10 ? 1 / 3 : (n == 11 ? 0.25 : 0.125))))))))))); );
function g_dnote(n) ( n = floor(n + 0.5); n == 0 ? 4 : (n == 1 ? 3 : (n == 2 ? 2 : (n == 3 ? 1.5 : (n == 4 ? 4 / 3 : (n == 5 ? 1 : (n == 6 ? 0.75 : (n == 7 ? 2 / 3 : (n == 8 ? 0.5 : (n == 9 ? 0.375 : (n == 10 ? 1 / 3 : (n == 11 ? 0.25 : 0.125))))))))))); );   // (GUI copy)
// Returns the note-value name (1/1 ... 1/32, dotted, triplet) for delay index n, rounded to the nearest integer.
function dnname(n) ( n = floor(n + 0.5); n == 0 ? "1/1" : (n == 1 ? "1/2 dot." : (n == 2 ? "1/2" : (n == 3 ? "1/4 dot." : (n == 4 ? "1/2 trip." : (n == 5 ? "1/4" : (n == 6 ? "1/8 dot." : (n == 7 ? "1/4 trip." : (n == 8 ? "1/8" : (n == 9 ? "1/16 dot." : (n == 10 ? "1/8 trip." : (n == 11 ? "1/16" : "1/32"))))))))))); );
// Designs a Butterworth chain of order nord at f (high-pass if ishp, else low-pass): nord / 2 biquads into cb (5 coefficients each), plus a first-order section into fb for odd orders.
// ---- MAGNITUDE-MATCHED BIQUADS (VST3 / AU / CLAP; since 1.0.6) --------------------------------------------------------
// The bilinear ("cookbook") designs squeeze everything above ~10 kHz towards Nyquist: a 12 kHz high cut fell 10 dB at
// 16 kHz instead of 6, a bell at 12 kHz was half as wide. These designs follow the analog curve up to ~20 kHz:
// poles by impulse invariance, the numerator fitted to the analog magnitude at DC, at the corner and at Nyquist
// (M. Vicanek, "Matched Second Order Digital Filters", 2016). Analog H(s) = (n2 u^2 + n1 u + n0) / (v^2 + v / q + 1),
// u = s / w0, v = s / wp (wp = pole frequency; = w0 except for shelves). Coefficients: cb[0..2] = b0 b1 b2, cb[3..4] = a1 a2.
function mbq(cb, w0, wp, q, n0, n1, n2) local(z, r, a1, a2, D0, D1, D2, p0, p1, p2, B0, B1, B2, u, v, wm, W)
(
  z = 1 / (2 * q);
  z < 1 ? ( r = cos(wp * sqrt(1 - z * z)); ) : ( r = sqrt(z * z - 1) * wp; r = (exp(r) + exp(-r)) / 2; );
  a1 = -2 * exp(-z * wp) * r; a2 = exp(-2 * z * wp);
  D0 = sqr(1 + a1 + a2); D1 = sqr(1 - a1 + a2); D2 = -4 * a2;
  B0 = n0 * n0 * D0;
  u = $pi / w0; v = $pi / wp; B1 = (sqr(n0 - n2 * u * u) + sqr(n1 * u)) / (sqr(1 - v * v) + sqr(v / q)) * D1;
  wm = min(w0, 0.98 * $pi); p1 = sqr(sin(wm / 2)); p0 = 1 - p1; p2 = 4 * p0 * p1;
  u = wm / w0; v = wm / wp;
  B2 = ((sqr(n0 - n2 * u * u) + sqr(n1 * u)) / (sqr(1 - v * v) + sqr(v / q)) * (D0 * p0 + D1 * p1 + D2 * p2) - B0 * p0 - B1 * p1) / p2;
  W = 0.5 * (sqrt(B0) + sqrt(B1));
  cb[0] = 0.5 * (W + sqrt(max(0, W * W + B2))); cb[1] = 0.5 * (sqrt(B0) - sqrt(B1)); cb[2] = -B2 / (4 * cb[0]);
  cb[3] = a1; cb[4] = a2;
);
// matched high-pass: the double zero at DC kept exactly (12 dB/oct below the corner), the level at the corner matched (= q)
function mhp(cb, w0, q) local(z, r, a1, a2, p0, p1, p2)
(
  z = 1 / (2 * q);
  z < 1 ? ( r = cos(w0 * sqrt(1 - z * z)); ) : ( r = sqrt(z * z - 1) * w0; r = (exp(r) + exp(-r)) / 2; );
  a1 = -2 * exp(-z * w0) * r; a2 = exp(-2 * z * w0);
  p1 = sqr(sin(w0 / 2)); p0 = 1 - p1; p2 = 4 * p0 * p1;
  cb[0] = q * sqrt(sqr(1 + a1 + a2) * p0 + sqr(1 - a1 + a2) * p1 - 4 * a2 * p2) / (4 * p1);
  cb[1] = -2 * cb[0]; cb[2] = cb[0]; cb[3] = a1; cb[4] = a2;
);
// matched first-order section (odd slopes): fb[0..1] = b0 b1, fb[2] = a1; level matched at DC and Nyquist
function mfo(fb, w0, hp) local(a1, h2, B0, B1)
(
  a1 = -exp(-w0); h2 = sqr($pi / w0); h2 = hp ? h2 / (1 + h2) : 1 / (1 + h2);
  B0 = hp ? 0 : sqr(1 + a1); B1 = h2 * sqr(1 - a1);
  fb[0] = (sqrt(B0) + sqrt(B1)) / 2; fb[1] = (sqrt(B0) - sqrt(B1)) / 2; fb[2] = a1;
);
// Butterworth low-pass (ishp 0) / high-pass (ishp 1) of order nord at f: biquads into cb, an odd order's first-order
// section into fb. Matched (see above); the Linkwitz-Riley crossovers keep fdesignbl (their two halves must sum flat).
function fdesign(cb, fb, ishp, f, nord) local(k, q, w0)
(
  f = min(f, 0.45 * srate); w0 = 2 * $pi * f / srate;
  k = 0;
  loop(floor(nord / 2),
    q = (nord % 2) ? 1 / (2 * cos((k + 1) * $pi / nord)) : 1 / (2 * cos((2 * k + 1) * $pi / (2 * nord)));
    ishp ? mhp(cb + k * 5, w0, q) : mbq(cb + k * 5, w0, w0, q, 1, 0, 0);
    k += 1;
  );
  (nord % 2) ? mfo(fb, w0, ishp);
);
function fdesignbl(cb, fb, ishp, f, nord) local(k, q, w0, cw, al, a0, tk)
(
  f = min(f, 0.45 * srate);
  k = 0;
  loop(floor(nord / 2),
    q = (nord % 2) ? 1 / (2 * cos((k + 1) * $pi / nord)) : 1 / (2 * cos((2 * k + 1) * $pi / (2 * nord)));
    w0 = 2 * $pi * f / srate; cw = cos(w0); al = sin(w0) / (2 * q); a0 = 1 + al;
    ishp ? ( cb[k * 5] = (1 + cw) / 2 / a0; cb[k * 5 + 1] = -(1 + cw) / a0; cb[k * 5 + 2] = (1 + cw) / 2 / a0; )
         : ( cb[k * 5] = (1 - cw) / 2 / a0; cb[k * 5 + 1] = (1 - cw) / a0;  cb[k * 5 + 2] = (1 - cw) / 2 / a0; );
    cb[k * 5 + 3] = -2 * cw / a0; cb[k * 5 + 4] = (1 - al) / a0;
    k += 1;
  );
  (nord % 2) ? (
    tk = tan($pi * f / srate);
    ishp ? ( fb[0] = 1 / (1 + tk); fb[1] = -1 / (1 + tk); ) : ( fb[0] = tk / (1 + tk); fb[1] = tk / (1 + tk); );
    fb[2] = (tk - 1) / (tk + 1);
  );
);
// bqrun(x, cb, st, n) - x through n cascaded biquads - is native (src/rt.cpp).
// Runs x through one first-order section (coefficients c[0..2], state z[0..1]) and returns the output.
function forun(x, c, z) local(y) ( y = c[0] * x + c[1] * z[0] - c[2] * z[1]; z[0] = x; z[1] = y; y; );
// Writes high-shelf biquad coefficients into cb[0..4] for corner f (Hz) and gain gdb (dB) at the current sample rate.
function shelfdesign(cb, f, gdb) local(shA, sq)
(
  // matched high shelf (the analog shelf with the slope of the old design, S = 0.707)
  shA = 10 ^ (gdb / 40); sq = 1 / sqrt((shA + 1 / shA) * (1 / 0.707 - 1) + 2);
  mbq(cb, 2 * $pi * min(f, 0.45 * srate) / srate, 2 * $pi * min(f, 0.45 * srate) / srate * sqrt(shA), sq, 1, sqrt(shA) / sq, shA);
);
// Runs x through the enabled low-cut then high-cut filter chains (biquads plus optional first-order) with the given states; returns it.
function fchain(x, ls, lf, hs, hf)
(
  lcon ? ( x = bqrun(x, lcC, ls, lcNb); lcNo ? x = forun(x, lcF, lf); );
  hcon ? ( x = bqrun(x, hcC, hs, hcNb); hcNo ? x = forun(x, hcF, hf); );
  x;
);

// ---------- source models ("futz"): color the source before it enters the room ----------
// parameter block pb: 0 HPf 1 HPn 2 LPf 3 LPn 4 nPeaks 5-13 peaks (f, gain dB, Q) x3 14 sat 15 clip 16 crushSR 17 bits 18 hiss 19 gain 20 asymmetry
// Values follow typical measured responses: POTS telephone 300-3400 Hz, walkie-talkie (narrow-band radio) 400-2800 Hz, small speakers roll off
// with 24 dB/oct below their resonance; asymmetry adds the even harmonics of a small loudspeaker driven hard
function fzparams(m, pb)
(
  pb[0] = 20; pb[1] = 0; pb[2] = 20000; pb[3] = 0; pb[4] = 0; pb[14] = 0; pb[15] = 0; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 1; pb[20] = 0;
  m == 1 ? ( pb[0] = 300; pb[1] = 6; pb[2] = 3400; pb[3] = 8; pb[4] = 2; pb[5] = 1000; pb[6] = 3; pb[7] = 0.9; pb[8] = 2700; pb[9] = 5; pb[10] = 2; pb[11] = 0; pb[12] = 0; pb[13] = 1; pb[14] = 2.5; pb[15] = 0; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 1.25; pb[20] = 0.1; );
  m == 2 ? ( pb[0] = 300; pb[1] = 8; pb[2] = 3400; pb[3] = 8; pb[4] = 2; pb[5] = 1800; pb[6] = 4; pb[7] = 1; pb[8] = 500; pb[9] = -3; pb[10] = 1.5; pb[11] = 0; pb[12] = 0; pb[13] = 1; pb[14] = 0; pb[15] = 0; pb[16] = 8000; pb[17] = 8; pb[18] = 0; pb[19] = 1.3; pb[20] = 0; );
  m == 3 ? ( pb[0] = 700; pb[1] = 4; pb[2] = 14000; pb[3] = 2; pb[4] = 3; pb[5] = 3200; pb[6] = 6; pb[7] = 1.2; pb[8] = 1500; pb[9] = 3; pb[10] = 1; pb[11] = 7000; pb[12] = 3; pb[13] = 1; pb[14] = 1.5; pb[15] = 0; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 1.2; pb[20] = 0.15; );
  m == 4 ? ( pb[0] = 400; pb[1] = 6; pb[2] = 2800; pb[3] = 8; pb[4] = 2; pb[5] = 1700; pb[6] = 8; pb[7] = 1.5; pb[8] = 800; pb[9] = -2; pb[10] = 1; pb[11] = 0; pb[12] = 0; pb[13] = 1; pb[14] = 0; pb[15] = 8; pb[16] = 0; pb[17] = 0; pb[18] = 0.012; pb[19] = 1; pb[20] = 0; );
  m == 5 ? ( pb[0] = 180; pb[1] = 4; pb[2] = 4500; pb[3] = 6; pb[4] = 3; pb[5] = 800; pb[6] = 5; pb[7] = 1; pb[8] = 2200; pb[9] = 3; pb[10] = 1.5; pb[11] = 3600; pb[12] = -2; pb[13] = 1; pb[14] = 3.5; pb[15] = 0; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 1.2; pb[20] = 0.15; );
  m == 6 ? ( pb[0] = 70; pb[1] = 4; pb[2] = 12000; pb[3] = 2; pb[4] = 3; pb[5] = 110; pb[6] = 6; pb[7] = 1.2; pb[8] = 600; pb[9] = -3; pb[10] = 1; pb[11] = 5000; pb[12] = 3; pb[13] = 1; pb[14] = 2.5; pb[15] = 0; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 1.1; pb[20] = 0.2; );
  m == 7 ? ( pb[0] = 180; pb[1] = 4; pb[2] = 10000; pb[3] = 2; pb[4] = 3; pb[5] = 400; pb[6] = 4; pb[7] = 2; pb[8] = 2500; pb[9] = 3; pb[10] = 1.2; pb[11] = 1000; pb[12] = -2; pb[13] = 1.2; pb[14] = 1.5; pb[15] = 0; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 1.2; pb[20] = 0.1; );
  m == 8 ? ( pb[0] = 400; pb[1] = 4; pb[2] = 15000; pb[3] = 2; pb[4] = 3; pb[5] = 800; pb[6] = -4; pb[7] = 1; pb[8] = 3800; pb[9] = 5; pb[10] = 1; pb[11] = 1600; pb[12] = -2; pb[13] = 1.5; pb[14] = 1.5; pb[15] = 0; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 1.3; pb[20] = 0.15; );
  m == 9 ? ( pb[0] = 300; pb[1] = 4; pb[2] = 15000; pb[3] = 2; pb[4] = 2; pb[5] = 2600; pb[6] = 5; pb[7] = 1; pb[8] = 650; pb[9] = -4; pb[10] = 1; pb[11] = 0; pb[12] = 0; pb[13] = 1; pb[14] = 1.2; pb[15] = 0; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 1.2; pb[20] = 0.1; );
  m == 10 ? ( pb[0] = 140; pb[1] = 4; pb[2] = 13000; pb[3] = 2; pb[4] = 3; pb[5] = 170; pb[6] = 4; pb[7] = 1.4; pb[8] = 500; pb[9] = -3; pb[10] = 1; pb[11] = 2500; pb[12] = 3; pb[13] = 1; pb[14] = 2; pb[15] = 0; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 1.15; pb[20] = 0.2; );
  m == 11 ? ( pb[0] = 1500; pb[1] = 4; pb[2] = 9000; pb[3] = 2; pb[4] = 2; pb[5] = 3500; pb[6] = 6; pb[7] = 1; pb[8] = 7000; pb[9] = 3; pb[10] = 1.5; pb[11] = 0; pb[12] = 0; pb[13] = 1; pb[14] = 0; pb[15] = 0; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 0.45; pb[20] = 0; );
  m == 12 ? ( pb[0] = 450; pb[1] = 6; pb[2] = 4000; pb[3] = 6; pb[4] = 2; pb[5] = 1300; pb[6] = 9; pb[7] = 2; pb[8] = 2600; pb[9] = 5; pb[10] = 3; pb[11] = 0; pb[12] = 0; pb[13] = 1; pb[14] = 0; pb[15] = 10; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 1; pb[20] = 0; );
);
// Writes peaking-EQ biquad coefficients into cb[0..4] for center f (Hz, capped at 0.45 fs), gain gdb (dB) and Q.
function pkdesign(cb, f, gdb, q) local(pA, w0)
(
  // matched bell (analog: (u^2 + u pA / q + 1) / (u^2 + u / (pA q) + 1))
  pA = 10 ^ (gdb / 40); w0 = 2 * $pi * min(f, 0.45 * srate) / srate;
  mbq(cb, w0, w0, q * pA, 1, pA / q, 1);
);
function pkbl(cb, f, gdb, q) local(pA, w0, cw, al, a0)
(
  pA = 10 ^ (gdb / 40); w0 = 2 * $pi * min(f, 0.45 * srate) / srate; cw = cos(w0); al = sin(w0) / (2 * q);
  a0 = 1 + al / pA;
  cb[0] = (1 + al * pA) / a0; cb[1] = -2 * cw / a0; cb[2] = (1 - al * pA) / a0; cb[3] = -2 * cw / a0; cb[4] = (1 - al / pA) / a0;
);
// coefficient block cb: 0 HP biquads (24) · 24 LP biquads (24) · 48 peaks (15) · 64 / 68 first-order slots
// SOURCE EQ: the model's high-pass, low-pass and three bells can be moved (sliders 47-57 are OFFSETS from the model:
// 0 = the model as designed, so old projects and model changes keep working). Bands a model does not use start flat.
function fzfill(pb, m) local(j, b)                    // model parameters + neutral defaults for unused bands
(
  fzparams(m, pb);
  j = pb[4];
  while ( j < 3 ? ( b = 5 + 3 * j; pb[b] = j == 0 ? 250 : (j == 1 ? 1000 : 4000); pb[b + 1] = 0; pb[b + 2] = 1; ); j += 1; j < 3; );
);
// Applies the Source EQ slider offsets (HP/LP frequency, slopes, three bells) to the model parameter block pb in place.
function fzedit(pb) local(j, b, n, si)
(
  abs(slider47) > 0.0005 ? ( pb[0] = min(20000, max(20, pb[0] * 2 ^ slider47)); pb[1] < 2 ? pb[1] = 2; );
  abs(slider48) > 0.0005 ? ( pb[2] = min(20000, max(20, pb[2] * 2 ^ slider48)); pb[3] < 2 ? pb[3] = 2; );
  slider58 >= 0.5 ? pb[1] = min(8, floor(slider58 + 0.5));      // slopes chosen by hand: order 1..8 = 6..48 dB/oct
  slider59 >= 0.5 ? pb[3] = min(8, floor(slider59 + 0.5));
  n = pb[4]; j = 0;
  loop(3,
    b = 5 + 3 * j; si = 49 + 3 * j;
    (abs(slider(si)) > 0.0005 || abs(slider(si + 1)) > 0.005 || abs(slider(si + 2)) > 0.0005) ? (
      pb[b] = min(20000, max(20, pb[b] * 2 ^ slider(si)));
      pb[b + 1] = min(24, max(-24, pb[b + 1] + slider(si + 1)));
      pb[b + 2] = min(12, max(0.2, pb[b + 2] * 2 ^ slider(si + 2)));
      n = max(n, j + 1);
    );
    j += 1;
  );
  pb[4] = n;
);
// Returns a checksum of the 13 Source EQ sliders (47-59), used to detect when the EQ changed.
function fzkeyf() local(i, k) ( k = 0; i = 47; loop(13, k += slider(i) * (i * 131 + 7); i += 1; ); k; );
function fzanyf() local(i, k) ( k = 0; i = 47; loop(13, abs(slider(i)) > 0.0005 ? k = 1; i += 1; ); k; );   // is the source EQ edited?
// GUI-thread copy of fzkeyf: checksum of the 13 Source EQ sliders (47-59).
function g_fzkeyf() local(i, k) ( k = 0; i = 47; loop(13, k += slider(i) * (i * 131 + 7); i += 1; ); k; );
// Builds the source-model filter set into cb: fills pb for model m, applies EQ edits if ed, designs HP, LP and up to three bells.
function fzdesign(cb, pb, m, ed)
(
  fzfill(pb, m);
  ed ? fzedit(pb);
  pb[1] > 0 ? fdesign(cb, cb + 64, 1, pb[0], pb[1]);
  pb[3] > 0 ? fdesign(cb + 24, cb + 68, 0, pb[2], pb[3]);
  pb[4] >= 1 ? pkdesign(cb + 48, pb[5], pb[6], pb[7]);
  pb[4] >= 2 ? pkdesign(cb + 53, pb[8], pb[9], pb[10]);
  pb[4] >= 3 ? pkdesign(cb + 58, pb[11], pb[12], pb[13]);
);
// GUI-thread copies of the design functions: EEL2 functions keep their parameters and locals in static storage, so the
// audio thread and the GUI must never run the same function at the same time (a shared copy corrupts the coefficients)
// GUI-thread copies of the matched designs
function g_mbq(cb, w0, wp, q, n0, n1, n2) local(z, r, a1, a2, D0, D1, D2, p0, p1, p2, B0, B1, B2, u, v, wm, W)
(
  z = 1 / (2 * q);
  z < 1 ? ( r = cos(wp * sqrt(1 - z * z)); ) : ( r = sqrt(z * z - 1) * wp; r = (exp(r) + exp(-r)) / 2; );
  a1 = -2 * exp(-z * wp) * r; a2 = exp(-2 * z * wp);
  D0 = sqr(1 + a1 + a2); D1 = sqr(1 - a1 + a2); D2 = -4 * a2;
  B0 = n0 * n0 * D0;
  u = $pi / w0; v = $pi / wp; B1 = (sqr(n0 - n2 * u * u) + sqr(n1 * u)) / (sqr(1 - v * v) + sqr(v / q)) * D1;
  wm = min(w0, 0.98 * $pi); p1 = sqr(sin(wm / 2)); p0 = 1 - p1; p2 = 4 * p0 * p1;
  u = wm / w0; v = wm / wp;
  B2 = ((sqr(n0 - n2 * u * u) + sqr(n1 * u)) / (sqr(1 - v * v) + sqr(v / q)) * (D0 * p0 + D1 * p1 + D2 * p2) - B0 * p0 - B1 * p1) / p2;
  W = 0.5 * (sqrt(B0) + sqrt(B1));
  cb[0] = 0.5 * (W + sqrt(max(0, W * W + B2))); cb[1] = 0.5 * (sqrt(B0) - sqrt(B1)); cb[2] = -B2 / (4 * cb[0]);
  cb[3] = a1; cb[4] = a2;
);
// matched high-pass: the double zero at DC kept exactly (12 dB/oct below the corner), the level at the corner matched (= q)
function g_mhp(cb, w0, q) local(z, r, a1, a2, p0, p1, p2)
(
  z = 1 / (2 * q);
  z < 1 ? ( r = cos(w0 * sqrt(1 - z * z)); ) : ( r = sqrt(z * z - 1) * w0; r = (exp(r) + exp(-r)) / 2; );
  a1 = -2 * exp(-z * w0) * r; a2 = exp(-2 * z * w0);
  p1 = sqr(sin(w0 / 2)); p0 = 1 - p1; p2 = 4 * p0 * p1;
  cb[0] = q * sqrt(sqr(1 + a1 + a2) * p0 + sqr(1 - a1 + a2) * p1 - 4 * a2 * p2) / (4 * p1);
  cb[1] = -2 * cb[0]; cb[2] = cb[0]; cb[3] = a1; cb[4] = a2;
);
// matched first-order section (odd slopes): fb[0..1] = b0 b1, fb[2] = a1; level matched at DC and Nyquist
function g_mfo(fb, w0, hp) local(a1, h2, B0, B1)
(
  a1 = -exp(-w0); h2 = sqr($pi / w0); h2 = hp ? h2 / (1 + h2) : 1 / (1 + h2);
  B0 = hp ? 0 : sqr(1 + a1); B1 = h2 * sqr(1 - a1);
  fb[0] = (sqrt(B0) + sqrt(B1)) / 2; fb[1] = (sqrt(B0) - sqrt(B1)) / 2; fb[2] = a1;
);
function g_fdesign(cb, fb, ishp, f, nord) local(k, q, w0)
(
  f = min(f, 0.45 * srate); w0 = 2 * $pi * f / srate;
  k = 0;
  loop(floor(nord / 2),
    q = (nord % 2) ? 1 / (2 * cos((k + 1) * $pi / nord)) : 1 / (2 * cos((2 * k + 1) * $pi / (2 * nord)));
    ishp ? g_mhp(cb + k * 5, w0, q) : g_mbq(cb + k * 5, w0, w0, q, 1, 0, 0);
    k += 1;
  );
  (nord % 2) ? g_mfo(fb, w0, ishp);
);
// GUI-thread copy: fills parameter block pb with the filter/distortion/gain settings of source model m (0-12).
function g_fzparams(m, pb)
(
  pb[0] = 20; pb[1] = 0; pb[2] = 20000; pb[3] = 0; pb[4] = 0; pb[14] = 0; pb[15] = 0; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 1; pb[20] = 0;
  m == 1 ? ( pb[0] = 300; pb[1] = 6; pb[2] = 3400; pb[3] = 8; pb[4] = 2; pb[5] = 1000; pb[6] = 3; pb[7] = 0.9; pb[8] = 2700; pb[9] = 5; pb[10] = 2; pb[11] = 0; pb[12] = 0; pb[13] = 1; pb[14] = 2.5; pb[15] = 0; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 1.25; pb[20] = 0.1; );
  m == 2 ? ( pb[0] = 300; pb[1] = 8; pb[2] = 3400; pb[3] = 8; pb[4] = 2; pb[5] = 1800; pb[6] = 4; pb[7] = 1; pb[8] = 500; pb[9] = -3; pb[10] = 1.5; pb[11] = 0; pb[12] = 0; pb[13] = 1; pb[14] = 0; pb[15] = 0; pb[16] = 8000; pb[17] = 8; pb[18] = 0; pb[19] = 1.3; pb[20] = 0; );
  m == 3 ? ( pb[0] = 700; pb[1] = 4; pb[2] = 14000; pb[3] = 2; pb[4] = 3; pb[5] = 3200; pb[6] = 6; pb[7] = 1.2; pb[8] = 1500; pb[9] = 3; pb[10] = 1; pb[11] = 7000; pb[12] = 3; pb[13] = 1; pb[14] = 1.5; pb[15] = 0; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 1.2; pb[20] = 0.15; );
  m == 4 ? ( pb[0] = 400; pb[1] = 6; pb[2] = 2800; pb[3] = 8; pb[4] = 2; pb[5] = 1700; pb[6] = 8; pb[7] = 1.5; pb[8] = 800; pb[9] = -2; pb[10] = 1; pb[11] = 0; pb[12] = 0; pb[13] = 1; pb[14] = 0; pb[15] = 8; pb[16] = 0; pb[17] = 0; pb[18] = 0.012; pb[19] = 1; pb[20] = 0; );
  m == 5 ? ( pb[0] = 180; pb[1] = 4; pb[2] = 4500; pb[3] = 6; pb[4] = 3; pb[5] = 800; pb[6] = 5; pb[7] = 1; pb[8] = 2200; pb[9] = 3; pb[10] = 1.5; pb[11] = 3600; pb[12] = -2; pb[13] = 1; pb[14] = 3.5; pb[15] = 0; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 1.2; pb[20] = 0.15; );
  m == 6 ? ( pb[0] = 70; pb[1] = 4; pb[2] = 12000; pb[3] = 2; pb[4] = 3; pb[5] = 110; pb[6] = 6; pb[7] = 1.2; pb[8] = 600; pb[9] = -3; pb[10] = 1; pb[11] = 5000; pb[12] = 3; pb[13] = 1; pb[14] = 2.5; pb[15] = 0; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 1.1; pb[20] = 0.2; );
  m == 7 ? ( pb[0] = 180; pb[1] = 4; pb[2] = 10000; pb[3] = 2; pb[4] = 3; pb[5] = 400; pb[6] = 4; pb[7] = 2; pb[8] = 2500; pb[9] = 3; pb[10] = 1.2; pb[11] = 1000; pb[12] = -2; pb[13] = 1.2; pb[14] = 1.5; pb[15] = 0; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 1.2; pb[20] = 0.1; );
  m == 8 ? ( pb[0] = 400; pb[1] = 4; pb[2] = 15000; pb[3] = 2; pb[4] = 3; pb[5] = 800; pb[6] = -4; pb[7] = 1; pb[8] = 3800; pb[9] = 5; pb[10] = 1; pb[11] = 1600; pb[12] = -2; pb[13] = 1.5; pb[14] = 1.5; pb[15] = 0; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 1.3; pb[20] = 0.15; );
  m == 9 ? ( pb[0] = 300; pb[1] = 4; pb[2] = 15000; pb[3] = 2; pb[4] = 2; pb[5] = 2600; pb[6] = 5; pb[7] = 1; pb[8] = 650; pb[9] = -4; pb[10] = 1; pb[11] = 0; pb[12] = 0; pb[13] = 1; pb[14] = 1.2; pb[15] = 0; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 1.2; pb[20] = 0.1; );
  m == 10 ? ( pb[0] = 140; pb[1] = 4; pb[2] = 13000; pb[3] = 2; pb[4] = 3; pb[5] = 170; pb[6] = 4; pb[7] = 1.4; pb[8] = 500; pb[9] = -3; pb[10] = 1; pb[11] = 2500; pb[12] = 3; pb[13] = 1; pb[14] = 2; pb[15] = 0; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 1.15; pb[20] = 0.2; );
  m == 11 ? ( pb[0] = 1500; pb[1] = 4; pb[2] = 9000; pb[3] = 2; pb[4] = 2; pb[5] = 3500; pb[6] = 6; pb[7] = 1; pb[8] = 7000; pb[9] = 3; pb[10] = 1.5; pb[11] = 0; pb[12] = 0; pb[13] = 1; pb[14] = 0; pb[15] = 0; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 0.45; pb[20] = 0; );
  m == 12 ? ( pb[0] = 450; pb[1] = 6; pb[2] = 4000; pb[3] = 6; pb[4] = 2; pb[5] = 1300; pb[6] = 9; pb[7] = 2; pb[8] = 2600; pb[9] = 5; pb[10] = 3; pb[11] = 0; pb[12] = 0; pb[13] = 1; pb[14] = 0; pb[15] = 10; pb[16] = 0; pb[17] = 0; pb[18] = 0; pb[19] = 1; pb[20] = 0; );
);
// GUI-thread copy of pkdesign: peaking-EQ biquad coefficients into cb[0..4] for f (Hz), gdb (dB), q.
function g_pkdesign(cb, f, gdb, q) local(pA, w0)
(
  pA = 10 ^ (gdb / 40); w0 = 2 * $pi * min(f, 0.45 * srate) / srate;
  g_mbq(cb, w0, w0, q * pA, 1, pA / q, 1);
);
function g_fzfill(pb, m) local(j, b)                    // model parameters + neutral defaults for unused bands
(
  g_fzparams(m, pb);
  j = pb[4];
  while ( j < 3 ? ( b = 5 + 3 * j; pb[b] = j == 0 ? 250 : (j == 1 ? 1000 : 4000); pb[b + 1] = 0; pb[b + 2] = 1; ); j += 1; j < 3; );
);
// GUI-thread copy of fzedit: applies the Source EQ slider offsets to parameter block pb in place.
function g_fzedit(pb) local(j, b, n, si)
(
  abs(slider47) > 0.0005 ? ( pb[0] = min(20000, max(20, pb[0] * 2 ^ slider47)); pb[1] < 2 ? pb[1] = 2; );
  abs(slider48) > 0.0005 ? ( pb[2] = min(20000, max(20, pb[2] * 2 ^ slider48)); pb[3] < 2 ? pb[3] = 2; );
  slider58 >= 0.5 ? pb[1] = min(8, floor(slider58 + 0.5));      // slopes chosen by hand: order 1..8 = 6..48 dB/oct
  slider59 >= 0.5 ? pb[3] = min(8, floor(slider59 + 0.5));
  n = pb[4]; j = 0;
  loop(3,
    b = 5 + 3 * j; si = 49 + 3 * j;
    (abs(slider(si)) > 0.0005 || abs(slider(si + 1)) > 0.005 || abs(slider(si + 2)) > 0.0005) ? (
      pb[b] = min(20000, max(20, pb[b] * 2 ^ slider(si)));
      pb[b + 1] = min(24, max(-24, pb[b + 1] + slider(si + 1)));
      pb[b + 2] = min(12, max(0.2, pb[b + 2] * 2 ^ slider(si + 2)));
      n = max(n, j + 1);
    );
    j += 1;
  );
  pb[4] = n;
);
// GUI-thread copy of fzdesign: builds HP, LP and bell coefficients into cb for model m (ed = apply EQ edits) using the g_ helpers.
function g_fzdesign(cb, pb, m, ed)
(
  g_fzfill(pb, m);
  ed ? g_fzedit(pb);
  pb[1] > 0 ? g_fdesign(cb, cb + 64, 1, pb[0], pb[1]);
  pb[3] > 0 ? g_fdesign(cb + 24, cb + 68, 0, pb[2], pb[3]);
  pb[4] >= 1 ? g_pkdesign(cb + 48, pb[5], pb[6], pb[7]);
  pb[4] >= 2 ? g_pkdesign(cb + 53, pb[8], pb[9], pb[10]);
  pb[4] >= 3 ? g_pkdesign(cb + 58, pb[11], pb[12], pb[13]);
);
// signal order as in a real device: input high-pass -> (codec) -> amplifier distortion -> loudspeaker resonances and low-pass.
// The distortion products are shaped by the speaker response instead of passing unfiltered.
// audio-thread copies of the magnitude helpers (the GUI has its own): a_bqmag2 = squared magnitude of one biquad (c[0..4]) at angular frequency w
// (a_fzlin below uses them: mean power gain of the source filter for speech, 16 points from 200 Hz to 5 kHz, equal weight per octave)
function a_bqmag2(c, w) local(nr, ni, dr, di)
(
  nr = c[0] + c[1] * cos(w) + c[2] * cos(2 * w); ni = -(c[1] * sin(w) + c[2] * sin(2 * w));
  dr = 1 + c[3] * cos(w) + c[4] * cos(2 * w);     di = -(c[3] * sin(w) + c[4] * sin(2 * w));
  (nr * nr + ni * ni) / max(0.0000000001, dr * dr + di * di);
);
// Audio-thread copy: squared magnitude of a first-order section (coefficients c[0..2]) at angular frequency w.
function a_fomag2(c, w) ( (sqr(c[0] + c[1] * cos(w)) + sqr(c[1] * sin(w))) / max(0.0000000001, sqr(1 + c[2] * cos(w)) + sqr(c[2] * sin(w))); );
// Returns the mean power gain of the current source filter (fzb/fzP) over 16 points, 200 Hz to 5 kHz, for equal-loudness compensation.
function a_fzlin() local(i, j, w, m2, acc)
(
  acc = 0; i = 0;
  loop(16,
    w = 2 * $pi * min(200 * 25 ^ (i / 15), 0.49 * srate) / srate; m2 = 1;
    j = 0; loop(floor(fzP[1] / 2), m2 *= a_bqmag2(fzb + j * 5, w); j += 1; );
    (fzP[1] % 2) ? m2 *= a_fomag2(fzb + 64, w);
    j = 0; loop(floor(fzP[3] / 2), m2 *= a_bqmag2(fzb + 24 + j * 5, w); j += 1; );
    (fzP[3] % 2) ? m2 *= a_fomag2(fzb + 68, w);
    j = 0; loop(fzP[4], m2 *= a_bqmag2(fzb + 48 + j * 5, w); j += 1; );
    acc += m2; i += 1;
  );
  acc / 16;
);

// the highest power gain of the model's filter (120 points 60 Hz … 12 kHz, 1/15 octave) - the delay loop through the device is
// scaled by it, so a resonant model never makes the repeats grow
function a_fzpk() local(i, j, w, m2, mx)
(
  mx = 0.000001; i = 0;
  loop(120,
    w = 2 * $pi * min(60 * 200 ^ (i / 119), 0.49 * srate) / srate; m2 = 1;
    j = 0; loop(floor(fzP[1] / 2), m2 *= a_bqmag2(fzb + j * 5, w); j += 1; );
    (fzP[1] % 2) ? m2 *= a_fomag2(fzb + 64, w);
    j = 0; loop(floor(fzP[3] / 2), m2 *= a_bqmag2(fzb + 24 + j * 5, w); j += 1; );
    (fzP[3] % 2) ? m2 *= a_fomag2(fzb + 68, w);
    j = 0; loop(fzP[4], m2 *= a_bqmag2(fzb + 48 + j * 5, w); j += 1; );
    mx = max(mx, m2); i += 1;
  );
  mx;
);
// ---- ROOM MODES (small rooms, low frequencies) ----
// Below the Schroeder frequency fS = 2000 sqrt(T / V) a room does not answer with a smooth diffuse tail but with single
// resonances - its modes f = c/2 sqrt((nx/Lx)^2 + (ny/Ly)^2 + (nz/Lz)^2). How strongly each one sounds depends on where
// source and listener stand (cos shapes: loud near walls and corners, silent in the nodes). The late tail's bass between
// the lowest mode and fS (max 300 Hz) is replaced by the sum of these modes (resonators, bandwidth from the bass RT60),
// normalized to the same average energy - so the room keeps its level, but gets its booming and missing notes.
// Rooms with a barrier: the modes of the listener's part; a source on the other side excites them at the opening.
function mdcalc() local(qWx, qDy, qHz, y0, mVol, mTb, fc, nx, ny, nz, mx, my, mz, f, k, n, j, w, mps, pl, e, msxe, msye, msze, lye, re, im, d, q, fq, sum, best, bi, t0, mr, th, mdBw, fmin, fA, g)
(
  mdPN = 0;
  !isfree ? (
    qWx = roomW; qHz = roomH;
    mdbon ? ( qDy = sideL ? roomD - yb : yb; y0 = sideL ? yb : 0; ) : ( qDy = roomD; y0 = 0; );   // (barrier mix below 50 %: the whole room)
    qDy = max(0.5, qDy);
    mVol = qWx * qDy * qHz; mTb = min(20, max(0.05, rt * lfrP));
    fc = min(300, 2000 * sqrt(mTb / mVol));
    (!mdbon || bsame) ? ( msxe = sx; msye = sy - y0; msze = sz; ) : (
      brOA > 0.0001 ? ( msxe = brOX; msze = brOZ; )
                     : ( t0 = (yb - sy) / (ly - sy); msxe = sx + (lx - sx) * t0; msze = sz + (lz - sz) * t0; );
      msye = sideL ? 0.05 : qDy - 0.05;
    );
    lye = ly - y0;
    mx = min(40, floor(2 * qWx * fc / C_SND)); my = min(40, floor(2 * qDy * fc / C_SND)); mz = min(40, floor(2 * qHz * fc / C_SND));
    n = 0; nx = 0;
    loop(mx + 1,
      ny = 0;
      loop(my + 1,
        nz = 0;
        loop(mz + 1,
          nx + ny + nz > 0 && n < 300 ? (
            f = 0.5 * C_SND * sqrt(sqr(nx / qWx) + sqr(ny / qDy) + sqr(nz / qHz));
            f <= fc ? ( mdT[n * 4] = f; mdT[n * 4 + 1] = nx; mdT[n * 4 + 2] = ny; mdT[n * 4 + 3] = nz; n += 1; );
          );
          nz += 1;
        );
        ny += 1;
      );
      nx += 1;
    );
    // keep the lowest 96 (selection)
    k = 0;
    loop(min(96, n),
      best = mdT[k * 4]; bi = k; j = k + 1;
      loop(n - k - 1, mdT[j * 4] < best ? ( best = mdT[j * 4]; bi = j; ); j += 1; );
      bi != k ? ( j = 0; loop(4, t0 = mdT[k * 4 + j]; mdT[k * 4 + j] = mdT[bi * 4 + j]; mdT[bi * 4 + j] = t0; j += 1; ); );
      k += 1;
    );
    n = min(96, n);
    n >= 2 ? (
      mdBw = 2.2 / mTb;                                       // modal bandwidth: delta / pi, delta = 6.91 / T
      fmin = mdT[0]; fA = 0.85 * fmin;
      fc > 1.3 * fA ? (
        k = 0;
        loop(n,
          f = mdT[k * 4]; nx = mdT[k * 4 + 1]; ny = mdT[k * 4 + 2]; nz = mdT[k * 4 + 3]; mdPi[k] = nx * 4096 + ny * 64 + nz;
          mps = cos(nx * $pi * msxe / qWx) * cos(ny * $pi * msye / qDy) * cos(nz * $pi * msze / qHz);
          pl = cos(nx * $pi * lx / qWx) * cos(ny * $pi * lye / qDy) * cos(nz * $pi * lz / qHz);
          e = (nx > 0 ? 2 : 1) * (ny > 0 ? 2 : 1) * (nz > 0 ? 2 : 1);
          mdT[k * 4 + 1] = mps * pl * e / f;                 // weight (the indices are no longer needed)
          k += 1;
        );
        // normalize: mean |sum of modes|^2 over the band fA … fc = 1 (64 points, log spaced)
        sum = 0; j = 0;
        loop(64,
          fq = fA * (fc / fA) ^ ((j + 0.5) / 64);
          re = im = 0; k = 0;
          loop(n, f = mdT[k * 4]; q = f / mdBw; d = q * (fq / f - f / fq); w = mdT[k * 4 + 1] / (1 + d * d); re += w; im -= w * d; k += 1; );
          sum += re * re + im * im; j += 1;
        );
        g = sum > 0.0000000001 ? 1 / sqrt(sum / 64) : 0;
        k = 0;
        // one resonator per mode: 2-pole coefficients (a1 = -2 r cos(theta), a2 = r^2), input gain 0.5 (1 - r^2) * mode weight * normalization g
        loop(n,
          f = mdT[k * 4]; mr = exp(-$pi * mdBw / srate); th = 2 * $pi * f / srate;
          mdP[k * 3] = -2 * mr * cos(th); mdP[k * 3 + 1] = mr * mr; mdP[k * 3 + 2] = 0.5 * (1 - mr * mr) * mdT[k * 4 + 1] * g; mdPf[k] = f;
          k += 1;
        );
        mdPN = n; mdPc = fc; mdPa = fA;
      );
    );
  );
);

// apply the modes from mdcalc: the same set (source / listener moved, decay changed) -> new weights, glided per sample;
// a new set (other room) -> fade the modes out, swap, fade in (in @block: mdswap) - never a jump of a ringing resonator
function mdapply() local(k, j, n, id, fd, nm, ok)
(
  // MODES FOLLOW THE ROOM: the new set is matched to the playing one mode by mode (nx ny nz). If the room moved only a little
  // (every mode that stays within 4 %, at least half of them stay) they GLIDE: a mode that stays keeps ringing with its new
  // frequency, damping and weight; a new one fades in from 0; one that left rings out (weight 0) while it is still heard.
  // Automating the room, a position or the barrier keeps the modes playing. A big change (preset, snapshot): fade out,
  // swap, fade in (mdswap).
  ok = mdPN > 0 && mdN > 0 && !mdPend; nm = 0;
  ok ? (
    memset(mdUs, 0, 128);
    k = 0;
    loop(mdPN,
      id = mdPi[k]; j = 0; fd = -1;
      while ( j < mdN && fd < 0 ? ( mdI[j] == id ? fd = j; j += 1; 1; ) : 0; );
      mdQi[k] = fd;
      fd >= 0 ? ( mdUs[fd] = 1; nm += 1; abs(mdPf[k] - mdF[fd]) > 0.04 * mdF[fd] ? ok = 0; );
      k += 1;
    );
    nm < 0.5 * mdPN ? ok = 0;
  );
  ok ? (
    n = 0; k = 0;
    loop(mdPN,
      fd = mdQi[k];
      mdQ[n * 6] = mdP[k * 3]; mdQ[n * 6 + 1] = mdP[k * 3 + 1]; mdQ[n * 6 + 5] = mdP[k * 3 + 2];
      fd >= 0 ? ( mdQ[n * 6 + 2] = mdM[fd * 6 + 2]; mdQ[n * 6 + 3] = mdM[fd * 6 + 3]; mdQ[n * 6 + 4] = mdM[fd * 6 + 4]; mdQc0[n] = mdC0[fd]; mdQc1[n] = mdC1[fd]; )
              : ( mdQ[n * 6 + 2] = 0; mdQ[n * 6 + 3] = 0; mdQ[n * 6 + 4] = 0; mdQc0[n] = mdP[k * 3]; mdQc1[n] = mdP[k * 3 + 1]; );   // (a new mode starts on its own coefficients)
      mdQf[n] = mdPf[k]; mdQi[n] = mdPi[k]; n += 1; k += 1;
    );
    j = 0;
    loop(mdN,
      !mdUs[j] && n < 128 && (abs(mdM[j * 6 + 2]) > 0.000001 || abs(mdM[j * 6 + 3]) > 0.000001) ? (
        mdQ[n * 6] = mdM[j * 6]; mdQ[n * 6 + 1] = mdM[j * 6 + 1]; mdQ[n * 6 + 2] = mdM[j * 6 + 2];
        mdQ[n * 6 + 3] = mdM[j * 6 + 3]; mdQ[n * 6 + 4] = mdM[j * 6 + 4]; mdQ[n * 6 + 5] = 0; mdQc0[n] = mdC0[j]; mdQc1[n] = mdC1[j];
        mdQf[n] = mdF[j]; mdQi[n] = mdI[j]; n += 1;
      );
      j += 1;
    );
    memcpy(mdM, mdQ, n * 6); memcpy(mdF, mdQf, n); memcpy(mdI, mdQi, n); mdN = n; memcpy(mdC0, mdQc0, n); memcpy(mdC1, mdQc1, n);
    // crossovers of the mode band follow (coefficients only - the filter states run on)
    abs(mdPc - mdFc) > 0.002 * mdFc ? ( fdesignbl(mdX, mdX + 50, 0, mdPc, 2); memcpy(mdX + 5, mdX, 5); fdesignbl(mdX + 30, mdX + 50, 1, mdPc, 2); memcpy(mdX + 35, mdX + 30, 5); mdFc = mdPc; );
    abs(mdPa - mdFa) > 0.002 * mdFa ? ( fdesignbl(mdX + 10, mdX + 50, 0, mdPa, 2); memcpy(mdX + 15, mdX + 10, 5); fdesignbl(mdX + 40, mdX + 50, 1, mdPa, 2); memcpy(mdX + 45, mdX + 40, 5); mdFa = mdPa; );
    mdPend = 0;
  ) : ( mdPN > 0 || mdN > 0 ? mdPend = 1; );
);

// Commits the pending room-mode tables (mdP*) to the active ones (mdM / mdF / mdI), redesigns the LR4 crossovers at mdPc / mdPa, and resets their states.
function mdswap() local(k)
(
  k = 0; loop(mdPN, mdM[k * 6] = mdP[k * 3]; mdM[k * 6 + 1] = mdP[k * 3 + 1]; mdM[k * 6 + 2] = mdM[k * 6 + 5] = mdP[k * 3 + 2]; mdM[k * 6 + 3] = mdM[k * 6 + 4] = 0; mdF[k] = mdPf[k]; mdI[k] = mdPi[k]; k += 1; );
  mdPN > 0 ? (
    fdesignbl(mdX, mdX + 50, 0, mdPc, 2); memcpy(mdX + 5, mdX, 5);           // LR4 low-pass fc
    fdesignbl(mdX + 30, mdX + 50, 1, mdPc, 2); memcpy(mdX + 35, mdX + 30, 5);  // LR4 high-pass fc
    fdesignbl(mdX + 10, mdX + 50, 0, mdPa, 2); memcpy(mdX + 15, mdX + 10, 5);  // LR4 low-pass fA
    fdesignbl(mdX + 40, mdX + 50, 1, mdPa, 2); memcpy(mdX + 45, mdX + 40, 5);  // LR4 high-pass fA
    memset(mdXS, 0, 24); mdx1 = mdx2 = 0;
  );
  mdN = mdPN; mdFc = mdPc; mdFa = mdPa; mdPend = 0;
  k = 0; loop(mdN, mdC0[k] = mdM[k * 6]; mdC1[k] = mdM[k * 6 + 1]; k += 1; ); mdcmov = 0;
);
// ---- 4x OVERSAMPLING for the distortion of the source models ----
// the nonlinear stage (runs at 4x): tanh saturation with a small bias (even harmonics) and hard clip, both with
// first-order anti-derivative anti-aliasing (ADAA) on top
function fznl(x) local(y, du, fzL0)
(
  fzSat > 0 ? (
    y = fzSat * fzPush * x + fzAsym; du = y - fzU1; fzL0 = lcosh(y);   // lcosh of the previous sample is kept (fzL1) - half the log / exp calls, the same numbers
    x = ((abs(du) > 0.00001 ? (fzL0 - fzL1) / du : thf(0.5 * (y + fzU1))) - fzAsT) / fzSatN;
    fzU1 = y; fzL1 = fzL0;
  );
  fzClip > 0 ? (
    y = fzClip * fzPush * x; du = y - fzU2;
    x = (abs(du) > 0.00001 ? (clipF(y) - clipF(fzU2)) / du : min(1, max(-1, 0.5 * (y + fzU2)))) / fzClipN;
    fzU2 = y;
  );
  x;
);
// the same filters written out (no index arithmetic, the zero-stuffed inputs skip their multiplications) - same numbers, less CPU
function osup(x) local(y) ( y = oc0 * x + su0; su0 = oc1 * x - oc3 * y + su1; su1 = oc2 * x - oc4 * y; x = y;
  y = oc5 * x + su2; su2 = oc6 * x - oc8 * y + su3; su3 = oc7 * x - oc9 * y; x = y;
  y = oc10 * x + su4; su4 = oc11 * x - oc13 * y + su5; su5 = oc12 * x - oc14 * y; x = y;
  y = oc15 * x + su6; su6 = oc16 * x - oc18 * y + su7; su7 = oc17 * x - oc19 * y; x = y;
  y = oc20 * x + su8; su8 = oc21 * x - oc23 * y + su9; su9 = oc22 * x - oc24 * y; x = y;
  x; );
// One step of the 4x upsampler's elliptic low-pass fed with a zero (stuffed) sample; returns the filtered output.
function osup0() local(x, y) ( y = su0; su0 = su1 - oc3 * y; su1 = -oc4 * y; x = y;
  y = oc5 * x + su2; su2 = oc6 * x - oc8 * y + su3; su3 = oc7 * x - oc9 * y; x = y;
  y = oc10 * x + su4; su4 = oc11 * x - oc13 * y + su5; su5 = oc12 * x - oc14 * y; x = y;
  y = oc15 * x + su6; su6 = oc16 * x - oc18 * y + su7; su7 = oc17 * x - oc19 * y; x = y;
  y = oc20 * x + su8; su8 = oc21 * x - oc23 * y + su9; su9 = oc22 * x - oc24 * y; x = y;
  x; );
// One step of the 10th-order elliptic anti-alias low-pass used before decimating the 4x signal; returns the filtered sample.
function osdn(x) local(y) ( y = oc0 * x + sd0; sd0 = oc1 * x - oc3 * y + sd1; sd1 = oc2 * x - oc4 * y; x = y;
  y = oc5 * x + sd2; sd2 = oc6 * x - oc8 * y + sd3; sd3 = oc7 * x - oc9 * y; x = y;
  y = oc10 * x + sd4; sd4 = oc11 * x - oc13 * y + sd5; sd5 = oc12 * x - oc14 * y; x = y;
  y = oc15 * x + sd6; sd6 = oc16 * x - oc18 * y + sd7; sd7 = oc17 * x - oc19 * y; x = y;
  y = oc20 * x + sd8; sd8 = oc21 * x - oc23 * y + sd9; sd9 = oc22 * x - oc24 * y; x = y;
  x; );
// Runs the source-model nonlinearity (fznl) at 4x oversampling: upsample x, distort, low-pass, keep every 4th sample; returns it.
function fzos(x) local(d)
(
  d = osdn(fznl(osup(4 * x)));       // zero-stuffing + low-pass = 4x upsampling; distortion at 4x; low-pass, keep every 4th sample
  d = osdn(fznl(osup0()));
  d = osdn(fznl(osup0()));
  d = osdn(fznl(osup0()));
  d;
);
// ---- CALL LINE: what a call does to a voice before the device plays it (devices only; Original stays the plain input)
// order as in a real call: talker's phone (AGC + half-duplex switch) -> network (band limit, codec, lost packets) -> the
// device's speaker (the model: its filters, saturation, clipping)
// DUPLEX (slider 111): a speakerphone / echo suppressor lets only one direction talk at a time and its AGC levels the voice.
// Heard as: word onsets clipped (the switch opens late), tails chopped (it closes fast after a short hold), the level
// pumps after loud words, now and then a dip in the middle of a phrase (a loud syllable taken for echo), and comfort
// noise in the gaps (fades out 2-3 s after the voice). All deterministic (own noise generator, reset at playback start).
function fzduck(x) local(t, g)
(
  dqF = max(abs(x), dqF * dqRF);                       // fast envelope (30 ms release)
  dqS += (x * x - dqS) * dqKS;                         // mean square, 50 ms
  dqPk = max(dqF, dqPk * dqRP);                        // recent peak (2.5 s release): the reference of the detector
  t = max(0.002, dqPk * 0.04);                         // voice present: within 28 dB of the recent peak, above -54 dBFS
  dqF > t ? ( dqAct = 1; dqHold = dqHN; ) : ( dqHold > 0 ? dqHold -= 1 : dqAct = 0; );
  // AGC: towards -23 dBFS RMS (at most +12 dB) while the voice is present (fast down 12 ms, slow up 0.5 s: it pumps after loud words)
  dqAct ? ( g = min(4, max(0.25, 0.07 / sqrt(max(0.00000001, dqS)))); dqAg += (g - dqAg) * (g < dqAg ? dqKA : dqKR); );
  // the switch: opens slowly at an onset, closes fast after the hold; a misfire dips it for 45 ms (at most every 0.35 s)
  dqCool > 0 ? dqCool -= 1;
  dqDip <= 0 && dqCool <= 0 && dqAct && dqF > 4 * sqrt(dqS) && dqF > 3 * t ? (
    dqRs = (dqRs * 16807) % 2147483647; dqRs / 2147483647 < 0.35 * fzDk ? ( dqDip = dqDN; dqCool = dqCN; ); );   // the cooldown only after a real dip (it started on every candidate - fewer dips than meant)
  dqDip > 0 ? ( dqDip -= 1; dqGg += (dqFl - dqGg) * dqKC; ) : ( dqAct ? dqGg += (1 - dqGg) * dqKO : dqGg += (dqFl - dqGg) * dqKC; );
  x *= (1 + (dqAg - 1) * fzDk) * dqGg;
  dqRs = (dqRs * 16807) % 2147483647;
  x + (dqRs / 1073741823.5 - 1) * 0.0004 * fzDk * (1 - dqGg) * min(1, dqPk * 40);
);
// the linear part of the source model for the delay loop (same order as fzside, own states st: 40)
function dvlin(x, st) (
  fzHPb > 0 ? x = bqrun(x, fzb, st, fzHPb);
  fzHPo ? x = forun(x, fzb + 64, st + 32);
  fzNP > 0 ? x = bqrun(x, fzb + 48, st + 16, fzNP);
  fzLPb > 0 ? x = bqrun(x, fzb + 24, st + 8, fzLPb);
  fzLPo ? x = forun(x, fzb + 68, st + 34);
  x;
);
// CODEC + PACKET LOSS (sliders 112, 113): one STFT frame every hop. Lost packets (Gilbert model: losses come in bursts)
// are concealed as codecs do - the last spectrum is repeated with running phases (the robotic, frozen vowel of a bad
// line), fading after 40 ms, silent after 60 ms. Codec artifacts: weak bins drop out (musical noise), levels are coarsely
// quantized, whole bands above 1 kHz go unfunded per packet (swirling, watery highs) and the top of the band loses its
// phase (hoarse noise fill).
function qlframe() local(i, j, k, re, im, m2, mx, thr, sq, g, rp, L, b, ph, kh, pl, pb, pg, tg)
(
  i = 0; j = qlPos;
  loop(QLN, qlF[2 * i] = qlIn[j] * qlW[i]; qlF[2 * i + 1] = 0; j += 1; j >= QLN ? j = 0; i += 1; );
  fft(qlF, QLN); fft_permute(qlF, QLN);
  qlPC -= 1;
  qlPC <= 0 ? (
    qlPC = qlPF;
    // packet clock: lost or not (mean loss up to 40 %, mean burst 1 … 5 packets)
    fzDO > 0 ? (
      pl = 0.4 * fzDO; pb = 1 / (1 + 4 * fzDO); pg = pl * pb / (1 - pl);
      qlRs = (qlRs * 16807) % 2147483647;
      qlBad ? ( qlRs / 2147483647 < pb ? qlBad = 0; ) : ( qlRs / 2147483647 < pg ? qlBad = 1; );
    ) : ( qlBad = 0; );
    qlBad ? qlLN += 1 : qlLN = 0;
    // bit allocation of this packet: which bands above 1 kHz get no bits (more often the higher they are)
    k = 0; loop(24, qlRs = (qlRs * 16807) % 2147483647; qlBM[k] = qlRs / 2147483647 >= fzCA * (0.15 + 0.5 * k / 15); k += 1; );
  );
  qlBad ? (
    tg = qlLN <= 1 ? 1 : (qlLN == 2 ? 0.5 : (qlLN == 3 ? 0.15 : 0)); qlPG += (tg - qlPG) * 0.4;
    k = 0;
    loop(QLN / 2 + 1,
      qlRs = (qlRs * 16807) % 2147483647;
      qlPh[k] += k * 2 * $pi * QLH / QLN + (qlRs / 2147483647 - 0.5) * 0.8;
      m2 = qlMg[k] * qlPG; qlF[2 * k] = m2 * cos(qlPh[k]); qlF[2 * k + 1] = m2 * sin(qlPh[k]);
      k += 1;
    );
  ) : (
    qlPG = 1;
    fzCA > 0 ? (
      // what gets bits: a bin well below the mean of its third octave (the envelope) is dropped - from 26 dB below at
      // 0 % to 6 dB below at 100 % (more and more holes: musical noise) - and anything 100 … 50 dB under the loudest bin
      mx = 0; memset(qlEP, 0, 72); k = 1;
      loop(QLN / 2, m2 = sqr(qlF[2 * k]) + sqr(qlF[2 * k + 1]); mx = max(mx, m2); b = qlEb[k]; qlEP[2 * b] += m2; qlEP[2 * b + 1] += 1; k += 1; );
      thr = mx * 10 ^ (-(100 - 50 * fzCA) / 10); pl = 10 ^ (-(26 - 20 * fzCA) / 10);
      sq = (0.5 + 5.5 * fzCA) * 0.1151292546;            // level step in dB, as a natural-log step of the magnitude
      kh = floor(qlHF * QLN / srate);
      k = 1;
      loop(QLN / 2,
        re = qlF[2 * k]; im = qlF[2 * k + 1]; m2 = re * re + im * im;
        b = qlEb[k];
        m2 < thr || m2 < qlEP[2 * b] / max(1, qlEP[2 * b + 1]) * pl ? ( qlF[2 * k] = qlF[2 * k + 1] = 0; ) : (
          L = 0.5 * log(m2); g = exp(floor(L / sq + 0.5) * sq - L); rp = 0;
          b = qlBd[k]; b >= 0 && !qlBM[b] ? ( g *= 0.18; rp = 1; );
          k >= kh ? ( qlRs = (qlRs * 16807) % 2147483647; qlRs / 2147483647 < 0.6 * fzCA ? rp = 1; );
          rp ? ( qlRs = (qlRs * 16807) % 2147483647; ph = 2 * $pi * qlRs / 2147483647; m2 = sqrt(m2) * g;
                 qlF[2 * k] = m2 * cos(ph); qlF[2 * k + 1] = m2 * sin(ph); )
             : ( qlF[2 * k] = re * g; qlF[2 * k + 1] = im * g; );
        );
        k += 1;
      );
    );
    // keep the frame for the concealment
    k = 0; loop(QLN / 2 + 1, re = qlF[2 * k]; im = qlF[2 * k + 1]; qlMg[k] = sqrt(re * re + im * im); qlPh[k] = atan2(im, re); k += 1; );
  );
  // real signal: bin N - k = conjugate of bin k
  qlF[1] = 0; qlF[QLN + 1] = 0;
  k = 1; loop(QLN / 2 - 1, qlF[2 * (QLN - k)] = qlF[2 * k]; qlF[2 * (QLN - k) + 1] = -qlF[2 * k + 1]; k += 1; );
  fft_ipermute(qlF, QLN); ifft(qlF, QLN);
  i = 0; j = qlPos;
  loop(QLN, qlOut[j] += qlF[2 * i] * qlW[i] * qlSc; j += 1; j >= QLN ? j = 0; i += 1; );
);
// one sample through the STFT stage (latency: one frame)
function qlstep(x) local(y)
(
  y = qlOut[qlPos]; qlOut[qlPos] = 0; qlIn[qlPos] = x;
  qlPos += 1; qlPos >= QLN ? qlPos = 0;
  qlCnt += 1; qlCnt >= QLH ? ( qlCnt = 0; qlframe(); );
  y;
);
// Runs one sample through the source model: duck, hiss, HP, codec crush, band limit/packet loss, 4x saturation/clip, bells, LP, then output gain.
function fzrun(x) local(y, du)
(
  fzDk > 0 || dqGg < 0.9999 ? x = fzduck(x);
  fzHiss > 0 ? (                                     // squelch: noise only while the source is active
    fzenv = max(abs(x), fzenv * fzrel);
    fzgate += ((fzenv > 0.004) - fzgate) * 0.002;
    fzrs = (fzrs * 16807) % 2147483647; x += (fzrs / 1073741823.5 - 1) * fzHiss * fzgate;   // own noise generator: the same hiss in every render
  );
  fzHPb > 0 ? x = bqrun(x, fzb, fzS, fzHPb);
  fzHPo ? x = forun(x, fzb + 64, fzS1);
  fzCrSR > 0 ? (                                     // codec: band limit first (no aliasing), then sample-and-hold + quantization
    fzLPb > 0 ? x = bqrun(x, fzb + 24, fzS2, fzLPb);
    fzLPo ? x = forun(x, fzb + 68, fzS1 + 4);
    fzacc += fzCrSR / srate;
    // quantized in the companded domain (mu-law, as telephone codecs do): quiet signals keep their resolution instead of
    // falling silent below the first step; fewer bits = more noise that follows the level
    fzacc >= 1 ? (
      fzacc -= 1;
      y = floor(log(1 + 255 * min(1, abs(x))) * 0.180336880 * fzq + 0.5) / fzq;
      fzhold = (x < 0 ? -1 : 1) * (exp(y * 5.545177444) - 1) * 0.003921569;
    );
    x = fzhold;
  );
  fzBW > 0 ? x = bqrun(x, qlC, qlS, 6);   // the network's band (HP 4th + LP 8th order)
  qlOn ? x = qlstep(x);   // codec artifacts / lost packets
  // saturation and hard clip run 4x oversampled (elliptic anti-alias filters, see fzos) - their harmonics above the
  // audio band no longer fold back as inharmonic tones
  fzSat > 0 || fzClip > 0 ? (
    x = fzos(x);
    fzSat > 0 && fzAsym > 0 ? ( y = x - fzDx + fzDR * fzDy; fzDx = x; fzDy = y; x = y; );   // the bias rectifies: remove the DC it creates (20 Hz)
  );
  fzNP > 0 ? x = bqrun(x, fzb + 48, fzS + 16, fzNP);
  fzLPb > 0 ? x = bqrun(x, fzb + 24, fzS + 8, fzLPb);
  fzLPo ? x = forun(x, fzb + 68, fzS1 + 2);
  x * fzOutG;
);
// MIX WITHOUT CANCELLATION: the dry part of a Mix is not the plain input but AP = P(x) + c Q(x) - the filter P and its
// complement Q (same poles, the other numerators; c = (-1)^biquads keeps them adding). Odd orders: an exact all-pass;
// even orders: at most +3 dB right at the corner. Its phase follows P where P passes, so filtered and dry part no longer
// cancel (a plain blend of a steep filter with the input notched up to -85 dB in the pass band)
function apstage(x, cP, apf1, cQ, apf2, nb, no, st) local(p, q)
(
  p = bqrun(x, cP, st, nb); no ? p = forun(p, apf1, st + 8);
  q = bqrun(x, cQ, st + 10, nb); no ? q = forun(q, apf2, st + 18);
  (nb & 1) ? p - q : p + q;
);
// Filter module: the dry path (low cut, then high cut - as fchain), per channel (st: 40 states)
function fapath(x, st) (
  lcon ? x = apstage(x, lcC, lcF, lcCc, lcFc, lcNb, lcNo, st);
  hcon ? x = apstage(x, hcC, hcF, hcCc, hcFc, hcNb, hcNo, st + 20);
  x;
);
// the linear part of fzos: the same 4x anti-alias filters (up, down), no distortion - the phase the saturating path has
function ecasc(x, st) local(y) (
  y = oc0 * x + st[0]; st[0] = oc1 * x - oc3 * y + st[1]; st[1] = oc2 * x - oc4 * y; x = y;
  y = oc5 * x + st[2]; st[2] = oc6 * x - oc8 * y + st[3]; st[3] = oc7 * x - oc9 * y; x = y;
  y = oc10 * x + st[4]; st[4] = oc11 * x - oc13 * y + st[5]; st[5] = oc12 * x - oc14 * y; x = y;
  y = oc15 * x + st[6]; st[6] = oc16 * x - oc18 * y + st[7]; st[7] = oc17 * x - oc19 * y; x = y;
  y = oc20 * x + st[8]; st[8] = oc21 * x - oc23 * y + st[9]; st[9] = oc22 * x - oc24 * y; y;
);
// Linear counterpart of fzos: passes x through the same 4x up/down elliptic filters (state st) without distortion, for matching phase.
function oslin(x, st) (
  ecasc(ecasc(4 * x, st), st + 10); ecasc(ecasc(0, st), st + 10); ecasc(ecasc(0, st), st + 10);
  ecasc(ecasc(0, st), st + 10);                                   // (as fzos: the 4th sample of the four)
);
// ORIGINAL + DISTORTION, one channel: 4x up, tanh with first-order ADAA, 4x down, DC blocker (st: 40 states)
function odsat(x, st) local(y, u, du, k, lcv)
(
  k = 0;
  loop(4,
    u = odG * ecasc(k == 0 ? 4 * x : 0, st) + odA; du = u - st[30]; lcv = lcosh(u);   // (st[33] = lcosh of the previous u,)
    y = ((abs(du) > 0.00001 ? (lcv - st[33]) / du : thf(0.5 * (u + st[30]))) - odAT) / odN;
    st[30] = u; st[33] = lcv; y = ecasc(y, st + 10);
    k += 1;
  );
  odA > 0 ? ( st[31] = y - st[32] + fzDR * st[31]; st[32] = y; y = st[31]; );
  y;
);
// its dry part (module mix, on / off): the same 4x filters and DC blocker, linear - no comb against the saturated part
function odlin(x, st) local(y) ( y = oslin(x, st); odA > 0 ? ( st[31] = y - st[32] + fzDR * st[31]; st[32] = y; y = st[31]; ); y; );
// Source model: the dry path (its high-pass, its low-pass - twice with a codec, the 4x filters and the DC blocker of the
// saturation, as fzrun), st: 60 states, so: 22 states
function fzap(x, st, so) (
  fzSat > 0 || fzClip > 0 ? (
    x = oslin(x, so);
    fzSat > 0 && fzAsym > 0 ? ( so[21] = x - so[20] + fzDR * so[21]; so[20] = x; x = so[21]; );
  );
  fzHPb + fzHPo > 0 ? x = apstage(x, fzb, fzb + 64, fzCc, fzCc + 40, fzHPb, fzHPo, st);
  fzLPb + fzLPo > 0 ? (
    x = apstage(x, fzb + 24, fzb + 68, fzCc + 20, fzCc + 44, fzLPb, fzLPo, st + 20);
    fzCrSR > 0 ? x = apstage(x, fzb + 24, fzb + 68, fzCc + 20, fzCc + 44, fzLPb, fzLPo, st + 40);
  );
  x;
);
// the linear part of fzrun for the stereo side (Original + EQ): high-pass, EQ bands, low-pass, gain - the same coefficients and
// order as the mid, own states (fzSs). Devices are mono: their side fades out instead (see STEREO WIDTH)
function fzside(x) (
  fzHPb > 0 ? x = bqrun(x, fzb, fzSs, fzHPb);
  fzHPo ? x = forun(x, fzb + 64, fzSs + 32);
  fzNP > 0 ? x = bqrun(x, fzb + 48, fzSs + 16, fzNP);
  fzLPb > 0 ? x = bqrun(x, fzb + 24, fzSs + 8, fzLPb);
  fzLPo ? x = forun(x, fzb + 68, fzSs + 34);
  x * fzOutG;
);
// Returns the linear magnitude of the biquad at cb c (b0,b1,b2,a1,a2) at angular frequency w.
function bqmag(c, w) local(nr, ni, dr, di)
(
  nr = c[0] + c[1] * cos(w) + c[2] * cos(2 * w); ni = -(c[1] * sin(w) + c[2] * sin(2 * w));
  dr = 1 + c[3] * cos(w) + c[4] * cos(2 * w);     di = -(c[3] * sin(w) + c[4] * sin(2 * w));
  sqrt((nr * nr + ni * ni) / max(0.0000000001, dr * dr + di * di));
);
// first-order section (odd slopes): magnitude at w
function g_fomag(c, w) ( sqrt((sqr(c[0] + c[1] * cos(w)) + sqr(c[1] * sin(w))) / max(0.0000000001, sqr(1 + c[2] * cos(w)) + sqr(c[2] * sin(w)))); );
// response of the GUI's temp design fzt / fzTP at fq, in dB (source EQ display, help page)
function fzmagdb(fq) local(w, mag, j)
(
  w = 2 * $pi * min(fq, 0.49 * srate) / srate; mag = fzTP[19];
  j = 0; loop(floor(fzTP[1] / 2), mag *= bqmag(fzt + j * 5, w); j += 1; );
  (fzTP[1] % 2) ? mag *= g_fomag(fzt + 64, w);
  j = 0; loop(floor(fzTP[3] / 2), mag *= bqmag(fzt + 24 + j * 5, w); j += 1; );
  (fzTP[3] % 2) ? mag *= g_fomag(fzt + 68, w);
  j = 0; loop(fzTP[4], mag *= bqmag(fzt + 48 + j * 5, w); j += 1; );
  20 * log10(max(0.000001, mag));
);
function fzcache() local(m, gi)       // frequency responses for the help page (GUI thread, temp blocks)
(
  m = 0;
  loop(13,
    g_fzdesign(fzt, fzTP, m, 0);
    gi = 0; loop(48, fzresp[m * 48 + gi] = fzmagdb(40 * 500 ^ (gi / 47)); gi += 1; );
    m += 1;
  );
);
// SOURCE PRESETS (the second column of the model menu): model, distortion, call line - EQ flat, model on, mix 100 %
NSP = 23; spTb = alloc(8 * NSP);   // per preset: category, model, distortion, duplex, codec, dropouts, line, EQ shape (spq)
spTb[0] = 0; spTb[1] = 1; spTb[2] = 45; spTb[3] = 0; spTb[4] = 0; spTb[5] = 0; spTb[6] = 1;   // Landline call
spTb[8] = 0; spTb[9] = 2; spTb[10] = 55; spTb[11] = 15; spTb[12] = 55; spTb[13] = 8; spTb[14] = 1;   // Old mobile (2G)
spTb[16] = 0; spTb[17] = 3; spTb[18] = 30; spTb[19] = 0; spTb[20] = 15; spTb[21] = 0; spTb[22] = 2;   // Mobile HD call
spTb[24] = 0; spTb[25] = 2; spTb[26] = 50; spTb[27] = 25; spTb[28] = 75; spTb[29] = 45; spTb[30] = 1;   // Bad connection
spTb[32] = 0; spTb[33] = 3; spTb[34] = 40; spTb[35] = 65; spTb[36] = 25; spTb[37] = 5; spTb[38] = 2;   // Speakerphone on a table
spTb[40] = 0; spTb[41] = 10; spTb[42] = 35; spTb[43] = 55; spTb[44] = 30; spTb[45] = 5; spTb[46] = 2;   // Conference call
spTb[48] = 0; spTb[49] = 8; spTb[50] = 30; spTb[51] = 40; spTb[52] = 35; spTb[53] = 10; spTb[54] = 3;   // Video call
spTb[56] = 0; spTb[57] = 3; spTb[58] = 25; spTb[59] = 0; spTb[60] = 45; spTb[61] = 0; spTb[62] = 2;   // Voice message
spTb[64] = 1; spTb[65] = 4; spTb[66] = 60; spTb[67] = 30; spTb[68] = 0; spTb[69] = 0; spTb[70] = 1;   // Walkie-talkie
spTb[72] = 1; spTb[73] = 4; spTb[74] = 70; spTb[75] = 35; spTb[76] = 60; spTb[77] = 15; spTb[78] = 1;   // Police radio
spTb[80] = 1; spTb[81] = 12; spTb[82] = 60; spTb[83] = 0; spTb[84] = 0; spTb[85] = 0; spTb[86] = 0;   // Megaphone
spTb[88] = 1; spTb[89] = 12; spTb[90] = 35; spTb[91] = 0; spTb[92] = 0; spTb[93] = 0; spTb[94] = 2;   // PA announcement
spTb[96] = 1; spTb[97] = 1; spTb[98] = 65; spTb[99] = 50; spTb[100] = 20; spTb[101] = 0; spTb[102] = 1;   // Intercom
spTb[104] = 1; spTb[105] = 5; spTb[106] = 75; spTb[107] = 45; spTb[108] = 30; spTb[109] = 0; spTb[110] = 1;   // Drive-thru
spTb[112] = 2; spTb[113] = 5; spTb[114] = 55; spTb[115] = 0; spTb[116] = 0; spTb[117] = 0; spTb[118] = 0;   // Old radio
spTb[120] = 2; spTb[121] = 6; spTb[122] = 50; spTb[123] = 0; spTb[124] = 0; spTb[125] = 0; spTb[126] = 0;   // Boombox
spTb[128] = 2; spTb[129] = 7; spTb[130] = 40; spTb[131] = 0; spTb[132] = 0; spTb[133] = 0; spTb[134] = 0;   // TV in the room
spTb[136] = 2; spTb[137] = 8; spTb[138] = 35; spTb[139] = 0; spTb[140] = 0; spTb[141] = 0; spTb[142] = 0;   // Laptop speakers
spTb[144] = 2; spTb[145] = 9; spTb[146] = 30; spTb[147] = 0; spTb[148] = 15; spTb[149] = 0; spTb[150] = 3;   // Tablet video
spTb[152] = 2; spTb[153] = 10; spTb[154] = 55; spTb[155] = 0; spTb[156] = 25; spTb[157] = 3; spTb[158] = 2;   // Bluetooth speaker
spTb[168] = 2; spTb[169] = 0; spTb[170] = 10; spTb[171] = 0; spTb[172] = 0; spTb[173] = 0; spTb[174] = 0; spTb[175] = 1;   // Car stereo: clean full range, EQ shape 1 (bass lift, mid scoop, bright highs)
spTb[176] = 2; spTb[177] = 0; spTb[178] = 15; spTb[179] = 0; spTb[180] = 0; spTb[181] = 0; spTb[182] = 0; spTb[183] = 2;   // Stadium music system: full range, a fat sub bass, warm low mids, big highs
spTb[160] = 2; spTb[161] = 11; spTb[162] = 20; spTb[163] = 0; spTb[164] = 0; spTb[165] = 0; spTb[166] = 0;   // Headphones leaking
// Returns the display name of source preset k (call, radio, PA and device presets).
function spname(k) ( (k == 0 ? "Landline call" : (k == 1 ? "Old mobile (2G)" : (k == 2 ? "Mobile HD call" : (k == 3 ? "Bad connection" : (k == 4 ? "Speakerphone on a table" : (k == 5 ? "Conference call" : (k == 6 ? "Video call" : (k == 7 ? "Voice message" : (k == 8 ? "Walkie-talkie" : (k == 9 ? "Police radio" : (k == 10 ? "Megaphone" : (k == 11 ? "PA announcement" : (k == 12 ? "Intercom" : (k == 13 ? "Drive-thru" : (k == 14 ? "Old radio" : (k == 15 ? "Boombox" : (k == 16 ? "TV in the room" : (k == 17 ? "Laptop speakers" : (k == 18 ? "Tablet video" : (k == 19 ? "Bluetooth speaker" : (k == 20 ? "Headphones leaking" : (k == 21 ? "Car stereo" : "Stadium music system")))))))))))))))))))))); );
// Returns the one-line description text of source preset k.
function spdesc(k) ( (k == 0 ? "a classic call: telephone handset, 300 Hz – 3.4 kHz" : (k == 1 ? "an early mobile call: narrowband, the codec warbles" : (k == 2 ? "a modern phone call: HD voice (wideband), clean" : (k == 3 ? "breaking up: codec artifacts, robotic drops, gaps" : (k == 4 ? "hands-free: onsets clipped, the level pumps" : (k == 5 ? "a conference puck in a meeting room" : (k == 6 ? "a laptop video call (VoIP, super-wideband)" : (k == 7 ? "a recorded voice message played on a phone" : (k == 8 ? "push to talk: narrow, hard clipping, squelch hiss" : (k == 9 ? "digital radio: vocoder artifacts and drop-outs" : (k == 10 ? "a hand-held horn: loud, narrow, beamed" : (k == 11 ? "a station or hall announcement" : (k == 12 ? "a door intercom: small speaker, switching" : (k == 13 ? "a drive-thru speaker post: crackly and switching" : (k == 14 ? "a small radio in a box: mid-heavy, warm distortion" : (k == 15 ? "a portable stereo: bass and presence" : (k == 16 ? "a TV set playing in the room" : (k == 17 ? "small laptop speakers: no bass" : (k == 18 ? "a video on a tablet" : (k == 19 ? "a small Bluetooth speaker, 360 degrees" : (k == 20 ? "what leaks out of someone's headphones" : (k == 21 ? "a modern car stereo: full range with a bass lift, a slight mid scoop and bright highs - clean, not vintage" : "a big stadium music system: full range, a fat sub bass, warm low mids and big, bright highs (music, not an announcement)")))))))))))))))))))))); );
// Returns the icon height in pixels for preset k's icon (31 for k=4, 28 for 2, 27 for 7, 24 for 3, else 22).
function ichgt(k) ( k == 4 ? 31 : (k == 2 ? 28 : (k == 7 ? 27 : (k == 3 ? 24 : 22))); );
function icfit(k) ( min(1, 24 / ichgt(k)); );   // tall icons (walkie-talkie, mobile) stay inside their row
// Returns the source preset category heading for index c: Calls, Radio and PA, or Devices.
function spcat(c) ( c == 0 ? "Calls" : (c == 1 ? "Radio and PA" : "Devices"); );
// row of preset k in the menu (category headings of 15 px between the groups)
function spry(k) ( srcmy + 4 + k * srcih + (spTb[k * 8] + 1) * 15; );
// Returns the preset index whose menu row contains y position yy, or -1 if none.
function spritem(yy) local(ri, k) ( ri = -1; k = 0; loop(NSP, yy >= spry(k) && yy < spry(k) + srcih ? ri = k; k += 1; ); ri; );
// the Source EQ values of a preset's EQ shape (0 = none; 1 = car stereo: bass +7 dB at about 90 Hz, mids -1.5 dB, treble +2.5 dB at about 5.6 kHz)
function spq(f, i) ( f == 2 ? (i == 49 ? -2 : (i == 50 ? 10 : (i == 51 ? -0.4 : (i == 52 ? -1 : (i == 53 ? 3 : (i == 55 ? 0.4 : (i == 56 ? 3.5 : 0))))))) : (f == 1 ? (i == 49 ? -1.5 : (i == 50 ? 7 : (i == 53 ? -1.5 : (i == 55 ? 0.5 : (i == 56 ? 2.5 : 0))))) : 0); );   // 2 = stadium system: sub bass +10 dB at about 60 Hz (wide), warm low mids +3 dB, highs +3.5 dB
// does preset k describe the current source settings?
function spmatch(k) local(b, m, i) ( b = spTb + k * 8; m = slider85 >= 0.5 && fzsel == b[1] && abs(slider37 - b[2]) < 0.05 && abs(slider111 - b[3]) < 0.05 && abs(slider112 - b[4]) < 0.05
  && abs(slider113 - b[5]) < 0.05 && floor(slider114 + 0.5) == b[6]; i = 47; loop(13, abs(slider(i) - spq(b[7], i)) > 0.0005 ? m = 0; i += 1; ); m; );
// Returns the name of source model k (Original, Telephone, ... Megaphone).
function srcname(k) ( k == 0 ? "Original" : (k == 1 ? "Telephone" : (k == 2 ? "Mobile phone" : (k == 3 ? "Smartphone" : (k == 4 ? "Walkie-talkie" : (k == 5 ? "Radio" : (k == 6 ? "Boombox" : (k == 7 ? "TV" : (k == 8 ? "Laptop" : (k == 9 ? "Tablet" : (k == 10 ? "Mini speaker" : (k == 11 ? "Headphones" : "Megaphone"))))))))))) );
// Returns the short characterization subtitle of source model k (e.g. frequency range).
function srcsub(k) ( k == 0 ? "Full range" : (k == 1 ? "300 Hz – 3.4 kHz" : (k == 2 ? "Codec 8 kHz" : (k == 3 ? "No bass" : (k == 4 ? "400 Hz – 2.8 kHz" : (k == 5 ? "180 Hz – 4.5 kHz" : (k == 6 ? "Big bass" : (k == 7 ? "Boxy" : (k == 8 ? "Thin" : (k == 9 ? "Light" : (k == 10 ? "Bluetooth" : (k == 11 ? "Leaking earbuds" : "Horn"))))))))))) );
// Returns the call-line band name for value v: Off, Narrowband, Wideband or Super-wideband.
function lnname(v) ( v < 0.5 ? "Off" : (v < 1.5 ? "Narrowband" : (v < 2.5 ? "Wideband" : "Super-wideband")); );
// Returns the short call-line band label for value v: Off, Narrow, Wide or Super.
function lnshort(v) ( v < 0.5 ? "Off" : (v < 1.5 ? "Narrow" : (v < 2.5 ? "Wide" : "Super")); );
// Returns the call-line menu entry text for index k, including its frequency range.
function lnmenu(k) ( k == 0 ? "Off – the device only" : (k == 1 ? "Narrowband  0.3 – 3.4 kHz" : (k == 2 ? "Wideband  0.1 – 7 kHz" : "Super-wideband  0.05 – 14 kHz")); );
// Formats a percentage v into string #fv as 'off' (below 0.05) or '<n> %'; returns it.
function clval(v) ( v < 0.05 ? strcpy(#fv, "off") : ( sprintf(#fv, "%.0f", v); strcat(#fv, " %"); ); );
// Returns the second subtitle line (character of the processing) of source model k.
function srcsub2(k) ( k == 0 ? "unprocessed" : (k == 1 ? "saturation" : (k == 2 ? "codec crush" : (k == 3 ? "bright" : (k == 4 ? "clip + hiss" : (k == 5 ? "warm saturation" : (k == 6 ? "crunchy" : (k == 7 ? "400 Hz resonance" : (k == 8 ? "hollow mids" : (k == 9 ? "little low end" : (k == 10 ? "small box" : (k == 11 ? "thin, distant" : "heavy distortion"))))))))))) );

// ---------- physics ------------------------------------------------------------
// ---------- BARRIER (wall / window / door parallel to the back wall) ----------
// back-part material (the part between back wall and barrier): 0 = same as the room
function g_bkA(i) ( i == 1 ? 0.05 : (i == 2 ? 0.03 : (i == 3 ? 0.08 : (i == 4 ? 0.10 : (i == 5 ? 0.45 : (i == 6 ? 0.70 : (i == 7 ? 0.85 : (i == 8 ? 0.02 : 0.04))))))); );// GUI copy
// Returns the mid-band absorption coefficient of barrier material i (1 concrete ... 8 tiles, else plaster).
function bkA(i) ( i == 1 ? 0.05 : (i == 2 ? 0.03 : (i == 3 ? 0.08 : (i == 4 ? 0.10 : (i == 5 ? 0.45 : (i == 6 ? 0.70 : (i == 7 ? 0.85 : (i == 8 ? 0.02 : 0.04))))))); );
function bkord(p) ( p == 0 ? 0 : (p == 1 ? 8 : (p == 2 ? 2 : (p == 3 ? 9 : (p == 4 ? 1 : (p == 5 ? 3 : (p == 6 ? 4 : (p == 7 ? 5 : (p == 8 ? 6 : 7)))))))); );   // menu row -> material
// Returns the name of barrier material i (0 = Same as room).
function bkname(i) ( i == 0 ? "Same as room" : (i == 1 ? "Concrete" : (i == 2 ? "Glass" : (i == 3 ? "Metal" : (i == 4 ? "Wood" : (i == 5 ? "Curtain" : (i == 6 ? "Foam" : (i == 7 ? "Wool" : (i == 8 ? "Tiles" : "Plaster")))))))); );
// ---- AIR ABSORPTION ----
// AIR ABSORPTION after ISO 9613-1 (dB per meter) for frequency f, temperature tc (C) and relative humidity rh (%)
function airdb(f, tc, rh) local(tk, tr, h, frO, frN)
(
  tk = tc + 273.15; tr = tk / 293.15;
  h = rh * 10 ^ (-6.8346 * (273.16 / tk) ^ 1.261 + 4.6151);          // molar concentration of water vapor (%)
  frO = 24 + 40400 * h * (0.02 + h) / (0.391 + h);
  frN = tr ^ -0.5 * (9 + 280 * h * exp(-4.170 * (tr ^ (-1 / 3) - 1)));
  8.686 * f * f * (0.0000000000184 * tr ^ 0.5 + tr ^ -2.5 * (0.01275 * exp(-2239.1 / tk) / (frO + f * f / frO) + 0.1068 * exp(-3352 / tk) / (frN + f * f / frN)));
);
// alpha of a surface in band b (0 = 125 Hz, 1 = 4 kHz) from its mid alpha: the material shape, interpolated (log alpha)
function aband(a, b) local(i, t, arat)
(
  a <= mtab[0] ? ( arat = mtab[1 + b]; ) : ( a >= mtab[(NMAT - 1) * 3] ? ( arat = mtab[(NMAT - 1) * 3 + 1 + b]; ) : (
    i = 0; while ( i < NMAT - 2 && a > mtab[(i + 1) * 3] ? ( i += 1; 1; ) : 0; );
    t = log(a / mtab[i * 3]) / log(mtab[(i + 1) * 3] / mtab[i * 3]);
    arat = mtab[i * 3 + 1 + b] + (mtab[(i + 1) * 3 + 1 + b] - mtab[i * 3 + 1 + b]) * t;
  ); );
  arat = min(0.99, max(0.005, a * exp(arat)));
  // bass: every real surface also loses some low end through flexing, gaps, doors and furniture (~3 %) - without it a
  // room with soft walls would boom far longer than measured rooms do
  b == 0 ? arat + 0.03 * (1 - arat) : arat;
);
// alpha in octave j (0 = 125 Hz ... 5 = 4 kHz) from the mid alpha: the material shape per octave, interpolated (log alpha);
// the bass leak (flexing, gaps, furniture) as in aband: 3 % at 125 Hz, 1.5 % at 250 Hz
function abandX(a, j) local(i, t, arat)
(
  a <= mtab[0] ? ( arat = mtx[j]; ) : ( a >= mtab[(NMAT - 1) * 3] ? ( arat = mtx[(NMAT - 1) * 6 + j]; ) : (
    i = 0; while ( i < NMAT - 2 && a > mtab[(i + 1) * 3] ? ( i += 1; 1; ) : 0; );
    t = log(a / mtab[i * 3]) / log(mtab[(i + 1) * 3] / mtab[i * 3]);
    arat = mtx[i * 6 + j] + (mtx[(i + 1) * 6 + j] - mtx[i * 6 + j]) * t;
  ); );
  arat = min(0.99, max(0.005, a * exp(arat)));
  j == 0 ? arat + 0.03 * (1 - arat) : (j == 1 ? arat + 0.015 * (1 - arat) : arat);
);
// Floor + ceiling absorption in octave j (0 = 125 Hz … 5 = 4 kHz): the neutral shape of abandF per octave (x0.8 … x1.1), clamped 0.005-0.99, with the bass leak as in abandX.
function abandFX(a, j) local(arat)
(
  arat = min(0.99, max(0.005, a * (j == 0 ? 0.8 : (j == 1 ? 0.88 : (j == 2 ? 0.96 : (j == 3 ? 1.04 : (j == 4 ? 1.07 : 1.1)))))));
  j == 0 ? arat + 0.03 * (1 - arat) : (j == 1 ? arat + 0.015 * (1 - arat) : arat);
);
// Returns the total absorption area for band j of a box bw x bd x bh: two walls each pair plus floor and ceiling, using abandX/abandFX.
function areaX(j, bw, bd, bh, a1, a2, a3, a4, a5) ( bw * bh * (abandX(a1, j) + abandX(a2, j)) + bd * bh * (abandX(a3, j) + abandX(a4, j)) + 2 * bw * bd * abandFX(a5, j); );
// ---- PER-OCTAVE LOOP FILTER: low shelf 177 Hz, peaks 250 / 500 / 2k / 4k (Q 1.41), high shelf 5.6 kHz, gain.
// The 7 gains are fitted to the wanted attenuation per pass at 125 / 250 / 500 / 1k / 2k / 4k / 8k Hz (interaction matrix,
// inverted once per sample rate, then 2 corrections); below 63 Hz the low shelf holds the 125 Hz value
function fqshelf(cb, f, gdb, hi) local(fqa, w0, cw, sw, al, sa, a0)
(
  fqa = 10 ^ (gdb / 40); w0 = 2 * $pi * min(f, 0.45 * srate) / srate; cw = cos(w0); sw = sin(w0); al = sw / 2 * sqrt(2); sa = 2 * sqrt(fqa) * al;
  hi ? (
    a0 = (fqa + 1) - (fqa - 1) * cw + sa;
    cb[0] = fqa * ((fqa + 1) + (fqa - 1) * cw + sa) / a0; cb[1] = -2 * fqa * ((fqa - 1) + (fqa + 1) * cw) / a0; cb[2] = fqa * ((fqa + 1) + (fqa - 1) * cw - sa) / a0;
    cb[3] = 2 * ((fqa - 1) - (fqa + 1) * cw) / a0; cb[4] = ((fqa + 1) - (fqa - 1) * cw - sa) / a0;
  ) : (
    a0 = (fqa + 1) + (fqa - 1) * cw + sa;
    cb[0] = fqa * ((fqa + 1) - (fqa - 1) * cw + sa) / a0; cb[1] = 2 * fqa * ((fqa - 1) - (fqa + 1) * cw) / a0; cb[2] = fqa * ((fqa + 1) - (fqa - 1) * cw - sa) / a0;
    cb[3] = -2 * ((fqa - 1) + (fqa + 1) * cw) / a0; cb[4] = ((fqa + 1) + (fqa - 1) * cw - sa) / a0;
  );
);
// Returns the center frequency in Hz of loop-filter fit point i (125 Hz ... 8 kHz, octave steps).
function fqfreq(i) ( i == 0 ? 125 : (i == 1 ? 250 : (i == 2 ? 500 : (i == 3 ? 1000 : (i == 4 ? 2000 : (i == 5 ? 4000 : 8000))))); );
// the same at a frequency of the table fqT (cos / sin of w and 2w, made once per sample rate): 0-6 = the fit points, 7-22 = check grid
function bqdbI(cb, i) local(t, nr, ni, dr, di)
(
  t = fqT + i * 4;
  nr = cb[0] + cb[1] * t[0] + cb[2] * t[2]; ni = -(cb[1] * t[1] + cb[2] * t[3]);
  dr = 1 + cb[3] * t[0] + cb[4] * t[2]; di = -(cb[3] * t[1] + cb[4] * t[3]);
  10 * log10(max(0.0000000001, (nr * nr + ni * ni) / max(0.0000000001, dr * dr + di * di)));
);
// Returns the loop filter's total level in dB (gain g0 plus six biquads at cb) at tabulated frequency index i.
function fqrespI(cb, g0, i) ( g0 + bqdbI(cb, i) + bqdbI(cb + 5, i) + bqdbI(cb + 10, i) + bqdbI(cb + 15, i) + bqdbI(cb + 20, i) + bqdbI(cb + 25, i); );
// the 6 filters of one line from the gains x[1..6] (x[0] = broadband gain, not a filter)
function fqset(cb, x)
(
  fqshelf(cb, 177, x[1], 0); pkbl(cb + 5, 250, x[2], 1.41); pkbl(cb + 10, 500, x[3], 1.41);
  pkbl(cb + 15, 2000, x[4], 1.41); pkbl(cb + 20, 4000, x[5], 1.41); fqshelf(cb + 25, 5657, x[6], 1);
);
// once per sample rate: response matrix for 1 dB in each of the 7 gains, inverted (Gauss-Jordan, partial pivot)
function fqinit() local(i, j, k, rq, piv, t, x, cb, f, w)
(
  x = fqW; cb = fqW + 16; fqT = fqW + 100;
  i = 0; f = 20;
  loop(23,
    w = 2 * $pi * min(i < 7 ? fqfreq(i) : f, 0.45 * srate) / srate;
    fqT[i * 4] = cos(w); fqT[i * 4 + 1] = sin(w); fqT[i * 4 + 2] = cos(2 * w); fqT[i * 4 + 3] = sin(2 * w);
    i >= 7 ? f *= 1.6; i += 1;
  );
  j = 0;
  loop(7,
    memset(x, 0, 7); x[j] = 1; fqset(cb, x);
    i = 0; loop(7, fqB[i * 7 + j] = fqrespI(cb, x[0], i); i += 1; );
    j += 1;
  );
  // [B | I] -> [I | B^-1]
  i = 0; loop(7, j = 0; loop(7, fqBi[i * 7 + j] = i == j; j += 1; ); i += 1; );
  k = 0;
  loop(7,
    piv = k; rq = k + 1; loop(6 - k, abs(fqB[rq * 7 + k]) > abs(fqB[piv * 7 + k]) ? piv = rq; rq += 1; );
    piv != k ? ( j = 0; loop(7, t = fqB[k * 7 + j]; fqB[k * 7 + j] = fqB[piv * 7 + j]; fqB[piv * 7 + j] = t;
