      loop(t - 1, gfx_line(u1 + nx * k, v1 + ny * k, u2 + nx * k, v2 + ny * k, 1); k += 1; ); );
  ); ); );
);
// Draws a 1 px line in design units; in the room view (gclp) it is first clipped to the view rect clX0..clY1 (Liang-Barsky).
function LN(x1, y1, x2, y2) local(dx, dy, t0, t1, k, p, q, r, ok)
(
  gclp ? (   // clipped to the room view (Liang-Barsky)
    dx = x2 - x1; dy = y2 - y1; t0 = 0; t1 = 1; ok = 1; k = 0;
    // Liang-Barsky: per view edge k (left, right, top, bottom) p = direction towards it, q = distance inside; t0 / t1 = visible part of the segment (0 ... 1), ok = 0 when fully outside
    loop(4,
      p = k == 0 ? -dx : (k == 1 ? dx : (k == 2 ? -dy : dy)); q = k == 0 ? x1 - clX0 : (k == 1 ? clX1 - x1 : (k == 2 ? y1 - clY0 : clY1 - y1));
      abs(p) < 0.000001 ? ( q < 0 ? ok = 0; ) : ( r = q / p; p < 0 ? ( r > t1 ? ok = 0 : ( r > t0 ? t0 = r; ); ) : ( r < t0 ? ok = 0 : ( r < t1 ? t1 = r; ); ); );
      k += 1;
    );
    ok && t1 >= t0 ? LNPX(gox + (x1 + t0 * dx) * gs, goy + (y1 + t0 * dy) * gs, gox + (x1 + t1 * dx) * gs, goy + (y1 + t1 * dy) * gs);
  ) : LNPX(gox + x1 * gs, goy + y1 * gs, gox + x2 * gs, goy + y2 * gs);
);
// Draws a line of width wd (design units): thin = stacked 1 px lines, wider = filled band with soft edges and round caps; clipped when gclp.
function LNW(x1, y1, x2, y2, wd) local(len, nx, ny, n, q, off, w, a, px1, py1, px2, py2, dx, dy, t0, t1, k, p, r, ok, ux, uy, hw, ex, ey)
(
  w = wd * gs; a = gfx_a;
  w < 1.6 ? (
    // thin: as before (1 px lines side by side)
    n = max(1, floor(wd * gs + 0.5));
    len = sqrt(sqr(x2 - x1) + sqr(y2 - y1));
    len > 0 ? (
      nx = -(y2 - y1) / len / gs; ny = (x2 - x1) / len / gs;
      q = 0;
      loop(n, off = q - (n - 1) / 2; LN(x1 + nx * off, y1 + ny * off, x2 + nx * off, y2 + ny * off); q += 1; );
    );
  ) : (
