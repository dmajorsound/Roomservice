  vedPend && vedId == id && kmapT >= 0 ? ( nf = vedmap(vedVal); kchg = 1; vedPend = 0; );
  vedit == id ? vedplace(x + w - 24, y, 48);
  click && hit ? (
    t = time_precise();
    (mouse_cap & 16) ? ( nf = fdef; kdrag = 0; lastkid = -1; kchg = 1; ) :
    (lastkid == id && t - lastkt < 0.5) ? ( kmapT >= 0 ? ( vedopen(id, vs); lastkid = -1; ) : ( nf = fdef; kdrag = 0; lastkid = -1; kchg = 1; ); )
                                        : ( kdrag = id; ksx = mx; kf0 = f; lastkid = id; kmv = 0; );
    lastkt = t;
  );
  kdrag == id && !kmv && abs(ksx - mx) > 2 ? ( kmv = 1; ksx = mx; );
  kdrag == id && kmv ? ( nf = min(1, max(0, kf0 + (mx - ksx) / ((mouse_cap & 8) ? 4 * w : w))); !(mouse_cap & 8) && abs(nf - fdef) < 0.012 ? nf = fdef; kchg = 1; );   // detent at the default
