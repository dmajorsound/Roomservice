      i = oi0; loop(max(0, oi1 - oi0), onv = max(onv, anaNv[i]); i += 1; );
      onv > 0 ? ( oh = 10 * onv / omx; col(oh > 5 ? cTEXT : cDIM2, 1); LN(arx + 2 + ob * 2, tpy0 + 63, arx + 2 + ob * 2, tpy0 + 63 - oh); );
      ob += 1;
    );
