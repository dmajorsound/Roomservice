// the mouse is on a scale handle of reflector r (length at the end of the foot line, height at the top edge in 3D)
function rflhh(r) ( (rflLHv[r] && sqr(mx - rflLHx[r]) + sqr(my - rflLHy[r]) < 64) || (rflHHv[r] && sqr(mx - rflHHx[r]) + sqr(my - rflHHy[r]) < 64); );
// the mouse is on reflector r (its handle, 12 px, or anywhere along its foot line, 6 px) - easier to grab
function rflon(r) ( r == 0 ? rflHv0 && (sqr(mx - rflHx0) + sqr(my - rflHy0) < 144 || segd(mx, my, rflSx0[0], rflSy0[0], rflSx1[0], rflSy1[0]) < 6)
