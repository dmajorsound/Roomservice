// copies the 15 reflector values (vopt[52 … 66]: two reflectors x 6, two levels, the on/off flag) into b[0 … 14] / back from it
function rfget(b) local(i) ( i = 0; loop(15, b[i] = vopt[RFB + i]; i += 1; ); );
function rfput(b) local(i) ( i = 0; loop(15, vopt[RFB + i] = b[i]; i += 1; ); );
// Stores all NSL slider values and the reflectors into the A/B comparison slot k (abSt; [0] = 1 marks the slot as filled).
