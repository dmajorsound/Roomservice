// ---- VALUE ENTRY: right-click, Ctrl / Cmd + click (Mac: Ctrl+click is a right-click) on a knob, slider or mix -> type the value in the unit shown (Enter = set, Esc or a
// click elsewhere = cancel). kmap(type, a, b, s) before a control tells how a typed value becomes its position:
// type 0 = linear a … b, 1 = logarithmic a … b, 2 = output level, 3 = input level, -1 = no entry; the value typed is divided
// by s first (e.g. the decay: seconds / the room's own reverb time). Hz: "6k" or "6" on a kHz control = 6000 Hz.
kmapT = -1; kmapA = 0; kmapB = 1; kmapS = 1; vedit = 0; vedPend = 0;
abSt = 4194304 + 30000; abOn = 0; abCur = 0; abMatch = 1;   // A / B: the two settings (2 x USTR = 282 values, session only)
urb = 4194304 + 32000; URM = 24; URL = 66; URP = 40;   // MY ROOMS: 24 x [used, category, name (24 bytes), 40 room values (the 40th, door / window size: 0 in older saved rooms = 100 %)] (filled by @serialize)
rsnb = urb + 1600; rqb = urb + 1630; rtb = urb + 1660; urX = urb + 1730; urY = urb + 1760; rmH = urb + 1790;   // name / search buffers, menu layout (rmX / rmY: urb + 1900 / 2000, 100 each)
rsave = 0; rsnlen = 0; rscat = 6; rqlen = 0; memset(rqb, 0, 30); urctx = 0; rsren = 0; urflash = 0; urflu = 0;
cvY = alloc(4100); SPFN = 8192; SPB = allocA(2 * SPFN); spRI = alloc(SPFN); spRO = alloc(SPFN); spWin = alloc(SPFN); SPN = 217; spSm = alloc(SPN); spBI = alloc(SPN); spBO = alloc(SPN);   // FFT 8192 // 1/24 octave (217 bands, was 1/6 = 55) // SPECTRUM: fft, rings in / out, window, bands
memset(spRI, 0, 8192); memset(spRO, 0, 8192); spw = 0; spWinOk = 0; i = 0; loop(SPN, spBI[i] = spBO[i] = -120; i += 1; ); spT = 0;          // spectrum: in / out rings and band levels cleared (-120 dB)
// Sets how a typed value maps to the next control's position: kmapT type (0 lin, 1 log, 2 out level, 3 in level, -1 none), range a..b, divisor sc.
function kmap(t, a, b, sc) ( kmapT = t; kmapA = a; kmapB = b; kmapS = sc; );
// Parses typed text st to a number ('-' sign, '.' or ',' decimal, 'k' = x1000); sets vedok (digits seen) and vedk (k used).
function vedparse(st) local(i, n, c, v, sg, fr, vdp, k1, vany)
(
  n = strlen(st); i = 0; v = 0; sg = 1; fr = 1; vdp = 0; k1 = 0; vany = 0;
  loop(n,
    c = str_getchar(st, i);
    c == '-' ? ( sg = -1; ) : ( (c == '.' || c == ',') ? ( vdp = 1; ) : ( (c == 'k' || c == 'K') ? ( k1 = 1; ) : (
      c >= '0' && c <= '9' ? ( vany = 1; vdp ? ( fr *= 0.1; v += (c - '0') * fr; ) : ( v = v * 10 + (c - '0'); ); );
    ); ); );
    i += 1;
