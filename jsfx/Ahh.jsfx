);
// BURST GUARD, step by step: the old content of reverb line j (j < 8: main network, 8 … 11: neighbor room) is scaled by
// scRat[j] - but only the samples that are about to be read, block by block (scaling a whole line at once costs up to 1 ms at
// 96 kHz: a dropout). A line has up to two readers: the current length and, during a crossfade, the old length. Cursor scC
// runs ahead of the newer reader up to scE (= first sample written after the change); cursor scD runs ahead of the older
// reader up to scN (where the newer reader started) - so no sample is scaled twice.
function scbase(j) ( j < 8 ? fdnbase + j * LINEMAX : (j < 12 ? fdn2base + (j - 8) * LINEMAX : fdnBbase + (j - 12) * LINEMAXB); );
function sclen(j) ( j < 12 ? LINEMAX : LINEMAXB; );   // (the rear lines may be shorter, see srlayout)
// Multiplies samples [a,b) (wrapping at LINEMAX) of FDN delay line j by its pending scale ratio scRat[j].
function scrng(j, a, b) local(bp, p)
(
  b > a ? ( bp = scbase(j); p = a % sclen(j); loop(b - a, bp[p] *= scRat[j]; p += 1; p >= sclen(j) ? p = 0; ); );
);
// Completes a pending lazy line rescale on line j: applies the remaining ranges at once and marks both jobs done.
function scfinish(j) ( scrng(j, scC[j], scE[j]); scC[j] = scE[j]; scrng(j, scD[j], scN[j]); scD[j] = scN[j]; );
// Starts a lazy gain rescale of FDN line j by sratio, computing the sample ranges the new and old readers will touch.
function scstart(j, sratio, dnew, dold) local(sa, sb)
(
  scfinish(j);                                                 // a job still running: finish it first
  sa = max(fwn - sclen(j) + 1, fwn - ceil(dnew + 2 * moddep) - 8); sb = max(fwn - sclen(j) + 1, fwn - ceil(dold + 2 * moddep) - 8);
  scRat[j] = sratio; scE[j] = fwn; scC[j] = max(sa, sb); scD[j] = min(sa, sb); scN[j] = scC[j];
);
// per block: dmin / dmax = delays of the newer / older reader this block; olda = the older reader still reads
function scstep(j, dmin, dmax, olda)
(
  scC[j] < scE[j] ? ( scrng(j, scC[j], min(scE[j], fwn + samplesblock - floor(dmin) + 4)); scC[j] = max(scC[j], min(scE[j], fwn + samplesblock - floor(dmin) + 4)); );
  scD[j] < scN[j] ? (
    olda ? ( scrng(j, scD[j], min(scN[j], fwn + samplesblock - floor(dmax) + 4)); scD[j] = max(scD[j], min(scN[j], fwn + samplesblock - floor(dmax) + 4)); )
