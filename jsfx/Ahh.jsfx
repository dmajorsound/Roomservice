// ROOM GROUP: while the room engine is on, a thin line in the room color around the modules that belong to it -
// Room + Reverb, the room view, Walls and (when it is on) Barrier: they are one thing, set in four places
function actlines() (
  !szoom && !zoomv && !learn && !rbyp ? (
    col(cRMTT, 0.6);
    basic ? (
      RRO(sxR - 2, yS1 - 2, bwR + 4, hbR + 4, 10);
      btg > 0 ? RRO(sxB - 2, yS2 - 2, bwB + 4, hbB + 4, 10);
    ) : (
      RRO(L0 - 2, syR - 2, LW + 4, shR + 4, 10);
      RRO(R0 - 2, syW - 2, RWc + 4, shW + 4, 10);
      btg > 0 ? RRO(R0 - 2, syB - 2, RWc + 4, shB + 4, 10);
    );
    RRO(VX - 2, VY - 2, VW + 4, VH + 4, 10);
  );
);
// Draws the 'room off' veil over room-engine modules (keeping the On/Off switch usable) and the module group lines
function gfxp10()
(
// ROOM OFF: veil over everything that belongs to the room engine; the On / Off switch stays usable
rbyp && !szoom ? (
  col(cSURF, 0.62);
  secopen(1) ? R(L0 + 2, syR + 24, LW - 4, shR - 26);
  R(R0 + 2, syW + 22, RWc - 4, shW - 24); R(R0 + 2, syB + 2, RWc - 4, shB - 4);
);
actlines();
);
// resamples the mark to th device pixels high: every target pixel = the exact area average of the source map under it
function lgsize(th) local(tw, x, y, fx, fy, x0, x1, y0, y1, i, j, wx, wy, acc)
(
  th = max(4, min(64, th)); tw = min(96, floor(th * LGW / LGH + 0.5)); lgTH = th; lgTW = tw; fx = LGW / tw; fy = LGH / th;
  y = 0; loop(th,
    y0 = y * fy; y1 = y0 + fy;
    x = 0; loop(tw,
      x0 = x * fx; x1 = x0 + fx; acc = 0;
      j = floor(y0); while ( j < y1 && j < LGH ? ( wy = min(j + 1, y1) - max(j, y0);
        i = floor(x0); while ( i < x1 && i < LGW ? ( wx = min(i + 1, x1) - max(i, x0); acc += lgS[j * LGW + i] * wx * wy; ); i += 1; i < x1; );
      ); j += 1; j < y1; );
      lgT[y * 96 + x] = acc / (fx * fy); x += 1; );
    y += 1; );
);
// the dmajorsound mark, hU units high, top left corner at (x, y) in page units
function dmlogo(x, y, hU) local(th, lpx0, lpy0, i, j, c)
(
  th = floor(hU * gs + 0.5); th != lgTH ? lgsize(th);
  lpx0 = floor(gox + x * gs + 0.5); lpy0 = floor(goy + y * gs + 0.5);
  col(cMUTED, 1);
  j = 0; loop(lgTH, i = 0; loop(lgTW, c = lgT[j * 96 + i]; c > 0.03 ? ( gfx_a = c; gfx_rect(lpx0 + i, lpy0 + j, 1, 1); ); i += 1; ); j += 1; );
  gfx_a = 1;
);
// UPDATE NOTE (VST3 / AU / CLAP only): the plug-in asks GitHub once per session whether a newer release is out and
// then sets updav and string 1000 = its version; the plug-in downloads and opens the installer itself (see updnote).
// As a JSFX in REAPER nothing sets updav: nothing is drawn.
function updnote(ty) local(x, w, h, mh, mw, xr, cx, cy)
(
  updav ? (
    // right in the footer, left of "dmajorsound.com": 1 "x is out" (the dot blinks), 2 "Downloading x … 42%" (a ring),
    // 3 "x downloaded", 4 "Download failed". Click and right-click go to the plug-in (updgo 1 / 2); string 1001 = the hint
    gfx_setfont(7);
    updav == 2 ? ( updprog >= 0 ? sprintf(#updl, "Downloading %s … %d%%", 1000, floor(updprog * 100 + 0.5)) : sprintf(#updl, "Downloading %s …", 1000); ) :
    updav == 3 ? sprintf(#updl, "%s downloaded", 1000) : (updav == 4 ? strcpy(#updl, "Download failed") : sprintf(#updl, "%s is out", 1000));
    mh = 10; mw = mh * LGW / LGH; xr = WT - 20 - mw - mh / 2 - tws("dmajorsound.com") - 16;
    w = tws(#updl) + 12; x = xr - w;
    h = inbox(x - 3, ty - 6, w + 6, 12);
    cx = gox + (x + 3) * gs - 0.5; cy = goy + ty * gs - 0.5;
    gfx_r = 1; gfx_g = 0.45; gfx_b = 0.42; gfx_a = 1;
    updav == 2 ? ( gfx_circle(cx, cy, 2.8 * gs, 0, 1); gfx_circle(cx, cy, 2.8 * gs - 1, 0, 1); ) :
    ( updav != 1 || floor(time_precise() * 1.6) % 2 == 0 || h ? gfx_circle(cx, cy, 2.6 * gs, 1, 1); );
    gfx_r = 1; gfx_g = 0.45; gfx_b = 0.42; gfx_a = h ? 1 : 0.9; gfx_setfont(7); txt(#updl, x + 10, ty, 0);
    h ? ( sprintf(#updt, "%s", 1001); tipbox(x - 3, ty - 6, w + 6, 12, #updt); tipforce = 1; );
    h && click ? ( updgo = 1; click = 0; );
    h && rclick ? ( updgo = 2; rclick = 0; );
  );
);
// Footer: hairline, then the dmajorsound mark in the bottom right corner with "dmajorsound.com" to its left
// (the same in every dmajorsound plugin; the mark stays 8 units clear of the window resize corner)
function dmfoot(ly, ty) local(tw, th, mh, mw)
(
  col(cHAIR, 1); PXR(12, ly, WT - 24, 1); gfx_rect(gpx0, gpy0, gpw, max(1, floor(gs * 0.5 + 0.5)));
  mh = 10; mw = mh * LGW / LGH;
  dmlogo(WT - 20 - mw, ty - mh / 2, mh);
  gfx_setfont(7); strcpy(#dmw, "dmajorsound.com"); gfx_measurestr(#dmw, tw, th);
  col(cMUTED, 1); txt(#dmw, WT - 20 - mw - mh / 2, ty, 2);
);
// THE NAME: the Ahh! wordmark (as the plug-in icon). "Ahh" in the built-in bold font, then an exclamation mark as tall as
// the letters: the bar from the top of the h, the dot - the sound source - centred on the baseline, two reflections
// around it, open at the top. Drawn in pixels from the font's own metrics (Arimo Bold: ascent 1854, descent 434,
// h 1485 units high, ink of "Ahh" from 0.025 to 1.88 em), so the bar lines up with the h at every scale.
function ahhmark(x, yc, sz, ctx, crf, cdot) local(fh, px, ty, bl, lh, em, ink, cx, rr, dr, bw, gp, top, k, a1, a2, rw)
(
  fh = max(6, floor(sz * gT + 0.5)); gfx_setfont(5, "Arial", fh, 'b');
  col(ctx, 1); txt("Ahh", x, yc, 0);
  px = floor(gox + x * gs + 0.5); ty = floor(goy + yc * gs - fh / 2 + 0.5);     // where txt put the text box
  bl = ty + fh * 1854 / 2288; lh = fh * 1485 / 2288; em = fh * 2048 / 2288;
  ink = px + 1.88 * em;
  rr = 0.30 * lh; dr = 0.104 * lh; bw = 0.20 * lh; gp = 0.09 * lh;
  cx = floor(ink + 0.08 * lh + rr) + 0.5; top = floor(bl - lh + 0.5);   // (the bar on whole pixels, its top on the h's top row)
  bw = max(2, floor(bw + 0.5)); dr = max(1.6, dr);
  // reflections: two arcs around the dot, open at the top (62 degrees each side), drawn as rings of 1 px arcs
  a1 = 62 * $pi / 180; a2 = 2 * $pi - a1;
  col(crf, 0.35); rw = max(1, floor(0.045 * lh + 0.5)); k = 0; loop(rw, gfx_arc(cx, bl, rr - 0.0225 * lh - rw / 2 + 0.5 + k, a1, a2, 1); k += 1; );
  col(crf, 0.7);  rw = max(1, floor(0.055 * lh + 0.5)); k = 0; loop(rw, gfx_arc(cx, bl, 0.62 * rr - rw / 2 + 0.5 + k, a1, a2, 1); k += 1; );
  // the bar: a rounded line from the top of the h down to the gap above the dot
  col(ctx, 1);
  gfx_rect(floor(cx - bw / 2), top + floor(bw / 2), bw, max(1, floor(bl - dr - gp + 0.5) - top - 2 * floor(bw / 2)));
  gfx_circle(cx - 0.5, top + bw / 2 - 0.5, bw / 2, 1, 1); gfx_circle(cx - 0.5, floor(bl - dr - gp + 0.5) - bw / 2 - 0.5, bw / 2, 1, 1);
  col(cdot, 1); gfx_circle(cx - 0.5, bl - 0.5, dr, 1, 1);
);
// THE LOGO: the plug-in icon itself (resources/Ahh_icon.svg, drawn by the host in vector) at the window scale gT - sharp at
// every size and screen scale. x, yc: its left edge and vertical middle in gT units. The same in light and dark mode.
function ahhicon(x, yc, S)
(
  gfx_ahhicon(gox + x * gs, goy + (yc - S / 2) * gs, S * gs);
)

// Top bar: name, Basic/Expert and view mode switches, Tabs/All/Fit, room presets menu button and snapshot slots
function gfxp11()
(
rvTX = 0;   // (Labels off only ever covers the room drawing)
gclp = 0;   // the clipping of the room view never reaches the top bar
col(cBG, 1); gfx_rect(0, 0, gfx_w, gfx_h);

szoom ? ( gs = gsN; gox = goxN; goy = goyN; WT = WTN; HT = HTN; setfonts(); mx = (mouse_x - gox) / gs; my = (mouse_y - goy) / gs; );
// ---------- top bar ----------
// THE NAME AND THE MARK keep one size in every view (Basic, Expert, Tabs, All, Learn): drawn at gT (window only), not at the page scale;
// vertically centered on the switch row, the view switches start after them (tbOff)
thgeo(); tbOff = max(0, ceil(o51X + o51W + 8 - 126)); roombx = 242 + tbOff;   // (again with the scale of this frame's top bar)
gsT0 = gs; gs = gT; ahhicon(9, 17 * gsT0 / gT, 31); gs = gsT0;
darkmode ? ( col(0x4A4B52, 1); RRO(thX, thY, thS, thS, thS * 0.233); );   // dark mode: the logo's fill is the page color - a light edge keeps its shape
thm_open ? ( col(cACTO, 1); RRO(thX - 2, thY - 2, thS + 4, thS + 4, thS * 0.233 + 2); );
thh = inbox(thX, thY, thS, thS);
click && thh ? ( thm_open = !thm_open; click = 0; );
!thm_open ? tipbox(thX, thY, thS, thS, "Interface: System (follows your computer), Dark or Light – click to choose");
// OUTPUT FORMAT: Stereo | 5.1, in every view (Basic, Expert, Learn) - the 5.1 output needs a track with 6 channels
segtrack(o51X, o51Y, o51W, o51H);
segp(o51X, o51Y, o51W, o51H, 2, 0, "Stereo", slider136 < 0.5, cTEXT) ? ( slider136 = 0; slider_automate(slider136); click = 0; );
segp(o51X, o51Y, o51W, o51H, 2, 1, "5.1", slider136 >= 0.5, cTEXT) ? ( slider136 = 1; slider_automate(slider136); click = 0; );
tipbox(o51X, o51Y, o51W / 2, o51H, slider136 >= 0.5 ? "Stereo output. Click: back to stereo (the 5.1 settings stay)" : "Stereo output – two channels");
tipbox(o51X + o51W / 2, o51Y, o51W / 2, o51H, slider136 >= 0.5 ? (num_ch >= 6 ? "5.1 output: the room on six loudspeaker channels (L R C LFE Ls Rs) – a stereo source keeps its two channels; the loudspeakers are shown in the Stage View" : "5.1 output: the room on six loudspeaker channels (L R C LFE Ls Rs) – a stereo source keeps its two channels and is moved in the room as it is") : "5.1 output: the room on six loudspeaker channels (L R C LFE Ls Rs) – a stereo source keeps its two channels");
gs = gsT0; gfx_setfont(5, "Arial", FS5, 'b');   // the dmajorsound mark, raised a little, right after the name (the name a little smaller, the switches 8 units further right: nothing touches)
// Basic | Expert | Learn: one segmented switch, the active segment filled
// VIEW MODE: a dark switch right after the name (the plugin's own view - not a preset, not a snapshot)
col(cTEXT, 1); RR(126 + tbOff, 8, 106, 18, 9);
gk = 0;
loop(3,
  mdon = gk == 0 ? basic : (gk == 1 ? !basic && !learn : learn); mdh = inbox(126 + tbOff + gk * 34, 8, 34, 18);
  mdon ? ( col(cACT, 1); RR(128 + tbOff + gk * 34, 10, 32, 14, 7); cCTLon ? ( col(cACTO, 1); RRO(128 + tbOff + gk * 34, 10, 32, 14, 7); ); col(cACTX, 1); ) : col(mdh ? cSURF : cDIM2, 1);
  gfx_setfont(6); txt(gk == 0 ? "Basic" : (gk == 1 ? "Expert" : "Learn"), 143 + tbOff + gk * 34, 17, 1);
  click && mdh ? ( vopt[11] = gk == 0; vopt[43] = gk == 2; szclr = 1; );   // the zoom is cleared at the start of the next frame (clearing it here drew every module on top of each other for one frame = a flash)
  gk += 1;
);
tipbox(126 + tbOff, 8, 34, 18, "Basic view (B): room, decay, source and barrier at a glance – every other setting stays as it is");
tipbox(160 + tbOff, 8, 34, 18, "Expert view (E): all controls, every module at once");
tipbox(194 + tbOff, 8, 34, 18, "Learn (L): the plugin explains what you hear – labels in the room, the sound in three parts, short tasks and the words in plain language (the sound is the same)");
// TABS | ALL | FIT (Expert): under the view modes - toggles between the tab view and every module at once. Fit = the module as large as the window allows (Tabs) / every module fitted into the window (All)
!basic && !learn ? (
  mvfit = tabm ? vopt[48] >= 0.5 : vopt[42] >= 0.5;
  col(cHAIR, 1); RR(126 + tbOff, 31, 106, 12, 6);
  gk = 0;
  loop(3,
    mvx = 126 + tbOff + (gk == 0 ? 0 : (gk == 1 ? 36 : 71)); mvw = gk == 0 ? 36 : 35; mvh2 = inbox(mvx, 31, mvw, 12);
    mvon = gk == 0 ? tabm : (gk == 1 ? !tabm : mvfit);
    mvon ? ( col(cACT, 1); RR(mvx + 1, 32, mvw - 2, 10, 5); cCTLon ? ( col(cACTO, 1); RRO(mvx + 1, 32, mvw - 2, 10, 5); ); col(cACTX, 1); ) : col(mvh2 ? cTEXT : cMUTED, 1);
    gfx_setfont(7); txt(gk == 0 ? "Tabs" : (gk == 1 ? "All" : "Fit"), mvx + mvw / 2, 37.5, 1);
    click && mvh2 ? (
      gk == 0 ? ( vopt[45] = 0; szclr = 1; ) : ( gk == 1 ? ( vopt[45] = 1; szclr = 1; ) : (
        tabm ? ( vopt[48] = mvfit ? 0 : 1; vopt[35] = 0; ) : ( vopt[42] = mvfit ? 0 : 1; !mvfit && !vlock ? ( memset(vopt + 21, 0, 10); vopt[33] = 0; ); scy = 0; ); ); );
      click = 0;
    );
    gk += 1;
  );
  tipbox(126 + tbOff, 31, 36, 12, "Tabs: the Stage View on top and one module under it – larger, no scrolling (key T · key 0 switches Tabs <-> All · key Z zooms the module)");
  tipbox(162 + tbOff, 31, 35, 12, "All: every module at once in two columns (key A · key 0 switches Tabs <-> All · key Z zooms the module under the mouse)");
  tipbox(197 + tbOff, 31, 35, 12, tabm ? (mvfit ? "Fit on (key F): the module fills the width, the Stage View gets the rest – click: standard" : "Fit (key F): make the module as large as the window allows – text, knobs and graphics grow, the Stage View gets smaller")
                               : (mvfit ? "Fit all (key F): every module in the window at once – smaller text. Click: text and knobs as large as in Basic (the page scrolls with the mouse wheel)" : "Fit all: fit every module into the window (smaller) – module heights you dragged go back to standard"));
);
col(cBORD, 1); LNW(237 + tbOff, 7, 237 + tbOff, 27, 1);                                // separator: the plugin's view | what you load
col(cMUTED, 1); gfx_setfont(11); txt("Presets", roombx, 5, 0);
// room presets: dropdown (menu drawn at the end, on top)
rsel = -1; k = 0; loop(NPRE, !isfree && roommatch(k) ? rsel = k; k += 1; );
col(cSURF, 1); RR(roombx, roomby, roombw, roombh, 8); col(rmenu ? cMUTED : (inbox(roombx, roomby, roombw, roombh) ? cDIM2 : cBORD), 1); RRO(roombx, roomby, roombw, roombh, 8);
col(isfree ? cMUTED : cRMTT, 1); RR(roombx + 7, roomby + roombh / 2 - 5, 3, 10, 1.5);   // color mark of the room
// preset changed by hand (decay, levels, tone, predelay, density, floor / ceiling, barrier): name + " *", the time is the one you hear
rmod = 0; rsel >= 0 ? ( pb0 = PT + rsel * PRS;
  rmod = abs(slider32 - 1) > 0.001 || abs(slider62 - 100) > 0.05 || abs(slider20 - pb0[17]) > 0.05 || abs(slider21 - pb0[18]) > 0.05 || abs(slider33 - pb0[16]) > 0.5
      || (vopt[8] < 0.5 && abs(slider34 - pb0[15]) > 0.5) || abs(slider38 - pb0[19]) > 0.5 || slider19 < 0.5 || slider41 >= 0.5; );   // (predelay following the room: not a change)
urs = -1; rsel < 0 && !isfree ? ( i = 0; loop(URM, urs < 0 && urmatch(i) ? urs = i; i += 1; ); );
isfree ? ( strcpy(#rnm, ffpname(ffpLast)); ffbm = FFP + ffpLast * 16; (abs(slider2 * slider31 - ffbm[0]) > 0.1 || abs(slider3 * slider31 - ffbm[1]) > 0.1 || slider119 != ffbm[3] || vopt[RFB] != ffbm[4] || vopt[RFB + 6] != ffbm[10]) ? strcat(#rnm, " *"); ) : ( rsel >= 0 ? ( strcpy(#rnm, roomname(rsel)); rmod ? strcat(#rnm, " *"); ) : ( urs >= 0 ? sn_strn(urb + urs * URL + 2, 24, #rnm) : strcpy(#rnm, "Custom") ) );
col(cTEXT, 1); gfx_setfont(2); txtfit(#rnm, roombx + 15, roomby + roombh / 2, roombw - 30);
chevd(roombx + roombw - 11, roomby + roombh / 2, cMUTED);
tipbox(roombx, roomby, roombw, roombh, rmod ? "Presets: room preset, changed (*): decay, levels, tone, predelay, density, floor / ceiling or a barrier differ from the preset – the time is the reverb time RT60 you hear now" : "Presets: typical rooms – the time is the reverb time RT60, calculated from size and materials");
// snapshots 1-16 (NSNAP; two rows of 8, Basic shows 8): click = load, double-click = name + store, Save then slot = store
// a single click loads only when no second click follows (otherwise the double-click would store the loaded settings)
snPend && time_precise() - snPt >= SNDBL ? ( loadslot(snPend - 1); uslot[(snPend - 1) * USL] ? ( snlast = snPend; ); snPend = 0; );
snmk = 0;
col(cMUTED, 1); gfx_setfont(basic ? 7 : 11); txt("Snapshots", 346 + tbOff, basic ? 6 : 5, 0);
snWd = basic ? 18 : 15; snHt = basic ? 14 : 13;           // size of one snapshot button
gk = 0;
loop(basic ? 8 : NSNAP,
  snx = snslx(gk); sny = snsly(gk); snm = slotmatch(gk); snh = inbox(snx, sny, snWd, snHt);
  snm && snmk == 0 ? ( snmk = gk + 1; );                                            // active snapshot (shown in the 3D view)
  snm ? ( col(cTEXT, 1); RR(snx, sny, snWd, snHt, 3.5); col(cSURF, 1); )
      : ( col(snh ? cHAIR : cLINE, 1); RR(snx, sny, snWd, snHt, 3.5); saveArm ? ( col(cIOTT, 1); RRO(snx, sny, snWd, snHt, 3.5); ); col(uslot[gk * USL] ? cTEXT : cDIM2, 1); );
  sprintf(#ul, "%d", gk + 1); gfx_setfont(basic ? 6 : 12); txt(#ul, snx + snWd / 2, sny + snHt / 2, 1);       // empty slots: gray number
  uslot[gk * USL] && !snm ? ( col(cRMTT, 1); CI(snx + snWd - 2, sny + 2.5, basic ? 1.4 : 1, 1); );     // filled: a blue dot
  snflk == gk && time_precise() - snflash < 0.6 ? ( col(cRMTT, 1); RRO(snx - 1, sny - 1, snWd + 2, snHt + 2, 4); );   // stored: a blue ring for a moment
  saveArm && snconf == gk + 1 && time_precise() - snconfT < 4 ? ( col(cAMB, 1); RRO(snx - 1.5, sny - 1.5, snWd + 3, snHt + 3, 4); RRO(snx - 1, sny - 1, snWd + 2, snHt + 2, 4);
    sprintf(#tipb, "Snapshot %d is in use – click it again to replace it", gk + 1); tipstr = #tipb; tipon = 1; tipforce = 1; tipx = snx + 7; tipy = 42; );   // replace: asks once
  rclick && snh ? ( snctx = gk + 1; snmS = gs; snqX = max(2, min(gox + snx * gs, gfx_w - 214 * gs)); snqY = goy + (basic ? sny + snHt + 4 : snsly(NSNAP - 1) + snHt + 4) * gs; rclick = 0; click = 0; snPend = 0; );   // menu: rename / overwrite / clear
  click && snh ? (
    saveArm && uslot[gk * USL] && !(snconf == gk + 1 && time_precise() - snconfT < 4) ? ( snconf = gk + 1; snconfT = time_precise(); ) :   // filled: click again to replace
    saveArm ? ( saveslot(gk); saveArm = 0; snlast = gk + 1; snconf = 0; ) : (
      snPend == gk + 1 && time_precise() - snPt < SNDBL ? ( snPend = 0; sn_open(gk); ) : ( snPend = gk + 1; snPt = time_precise(); );
    );
  );
  snh ? (
    sprintf(#tipb, "Snapshot %d", gk + 1);
    snam[gk * SNL] > 0 ? ( strcat(#tipb, " “"); strcat(#tipb, sn_str(snam + gk * SNL, #snt)); strcat(#tipb, "”"); );
    dsc[gk * DSL] > 0 ? ( strcat(#tipb, " – "); strcat(#tipb, sn_strn(dsc + gk * DSL, DSL, #snt)); );
    strcat(#tipb, saveArm ? ": click to store the current settings here" : (uslot[gk * USL] ? ": click = load, double-click = rename / store, right-click = rename / overwrite / clear" : ": empty – double-click = name it and store the current settings"));
    !(saveArm && snconf == gk + 1 && time_precise() - snconfT < 4) ? ( tipstr = #tipb; tipon = 1; tipx = snx + 7; tipy = 42; );
  );
  gk += 1;
);
!basic ? (
col(saveArm ? cIOTT : cMUTED, 1); gfx_setfont(2); txt("Save", 487 + tbOff, 17, 0);
saveArm ? ( LNW(487 + tbOff, 24, 487 + tbOff + tws("Save"), 24, 1.4); );
click && inbox(483 + tbOff, 7, 28, 20) ? ( saveArm = !saveArm; );
tipbox(483 + tbOff, 7, 28, 20, saveArm ? "Now click a snapshot 1–16 to store the current settings" : "Save: click, then choose snapshot 1–16 (or double-click a snapshot to give it a name)");
) : (
// Basic: Save beside the label above the 8 snapshots - click, then a snapshot = store the current settings there
gfx_setfont(7); sbsx = 346 + tbOff + tws("Snapshots") + 10; sbsh = inbox(sbsx - 4, 0, tws("Save") + 8, 12);
col(saveArm ? cIOTT : (sbsh ? cTEXT : cMUTED), 1); gfx_setfont(7); txt("Save", sbsx, 6, 0);
LNW(sbsx, 11, sbsx + tws("Save"), 11, saveArm ? 1.4 : 0.8);                          // underlined: a button
click && sbsh ? ( saveArm = !saveArm; );
tipbox(sbsx - 4, 0, tws("Save") + 8, 12, saveArm ? "Now click a snapshot 1–8 to store the current settings" : "Save: click, then choose snapshot 1–8 to store the current settings there");
);
// HELP: how the plugin works and the most used keys (a page over the plugin) - where the top bar has room for it
hlpbx = 516 + tbOff;
!tabm && !basic && WT - 204 - 42 - 6 - hlpbx >= 46 ? (   // Basic - the "?" in the strip opens the help
  hbqh = inbox(hlpbx, 9, 19, 16);   // a "?" like in Expert
  col(hlpon ? cSRC : (hbqh ? cHAIR : cLINE), 1); RR(hlpbx, 9, 19, 16, 8);
  col(hlpon ? 0xFFFFFF : (hbqh ? cTEXT : cMUTED), 1); gfx_setfont(6); txt("?", hlpbx + 9.5, 17, 1);
  click && hbqh ? ( hlpon = !hlpon; click = 0; );
  tipbox(hlpbx, 9, 19, 16, "Help: how Ahh works and the most used keys");
);
// RESET: a button next to View (Save belongs to the snapshots)
vgx = WT - (basic ? 204 : 234); rsx = tabm ? 522 + tbOff : vgx - 42;
col(cHAIR, 1); LNW(rsx - 6, 9, rsx - 6, 25, 1);                      // separator: Save belongs to the snapshots
chip(rsx, 9, 34, 16, "Reset", 0, cTEXT);
tipbox(rsx, 9, 34, 16, vlock ? "Reset: only the room stays on – living room, listener in the middle, source 2 m in front of it; delay, barrier, filters, source model and EQ off. The limiter stays on as a protection. The layout is locked and stays (snapshots are kept)"
                             : "Reset: only the room stays on – living room, listener in the middle, source 2 m in front of it; delay, barrier, filters, source model and EQ off, all sections open (the delay folded). The limiter stays on as a protection (snapshots are kept)");
click && inbox(rsx, 9, 34, 16) ? (
  snap_take();
  slider1 = 0; slider2 = 5.5; slider3 = 4.5; slider4 = 2.6;          // default room: living room (= the living-room preset)
  slider5 = slider6 = slider7 = slider8 = 0.04; slider9 = 0.33;
  slider10 = 2.75; slider11 = 0.25; slider12 = 1.5; slider13 = 2.75; slider14 = 2.25; slider15 = 1.5;   // listener in the middle, source 2 m in front of it
  slider16 = 1; slider17 = 0; slider18 = 100; slider19 = 1;
  slider20 = 0; slider21 = 0; slider22 = 0; slider23 = 1;
  slider24 = 0; slider25 = 80; slider26 = 1; slider27 = 0; slider28 = 12000; slider29 = 1; slider30 = 0; slider31 = 1; slider32 = 1; slider33 = 0; slider34 = 0; slider35 = 0; slider36 = 0; slider37 = 0; slider38 = 80; slider39 = 0; slider40 = 0; slider41 = 0; slider60 = 0; slider95 = 0; slider96 = 0; slider97 = 100; slider42 = 1.25; slider43 = 0; slider44 = 25; slider45 = 2.75; slider46 = 0;
  // Source EQ offsets (sliders 47 … 59: shifts, gains, Qs, slopes) back to zero
  i = 47; loop(13, sset(i, 0); i += 1; );
  slider61 = 0; slider62 = 100; slider63 = 1; slider64 = 0;   // source angle (fixed, to the front), reflectivity, aim, morph off
  i = 65; loop(30, sset(i, sdef(i)); i += 1; ); slider98 = 100; slider99 = 0; i = 100; loop(10, sset(i, sdef(i)); i += 1; ); mtKill = 1; i = 110; loop(8, sset(i, sdef(i)); i += 1; );                 // delay off with its defaults (50 ms, 30 % feedback, 0 dB, 120 Hz - 10 kHz), source width 100 %, ducking 0, Motion off with its defaults (a running motion is killed), input mono / call line / distance back to defaults
  rflclr(); vopt[18] = 0; tpon = 0; xpon = 0;                              // hear: direct, early and late on again
  selw = 0;
  !vlock ? (                                                         // a locked layout stays as it is
    vopt[1] = vopt[2] = vopt[3] = vopt[6] = 0; vopt[10] = 0;          // view: no tips, paths, direct line or waves; walls shown
    vopt[12] = 2304; vopt[13] = 0;   // the room view stays open (hiding it folded the page in an animation - it looked like flicker)
    vopt[14] = 0; memset(vopt + 21, 0, 21); vopt[47] = 0; zoomv = 0; !tabm ? szoom = 0; scy = 0;   // Tabs - szoom is the open tab; clearing it drew the whole page (all modules on top of each other) for one frame = the blink // layout: every section open, standard column widths, no zoom, top of the page (the room view stays open, see vopt[12])
  );
  snlast = 0;
  snap_notify();
);
!tabm ? viewgrp(vgx, 0);
// black & white (all colors off) and light / dark: top right, one above the other
!basic ? (
mbx = WT - 18; mby = 11;
col(cTEXT, 1); CI(mbx, mby, 4.5, 1); col(cBG, 1); R(mbx + 0.5, mby - 5.5, 6, 11); col(cTEXT, 1); CI(mbx, mby, 4.5, 0);   // half black, half white
mhit = sqr(mx - mbx) + sqr(my - mby) < 42;
click && mhit ? ( vopt[7] = monoOn ? 0 : 1; );
mhit ? ( tipon = 1; tipstr = monoOn ? "Colors on" : "Black & white: switch all colors off"; tipx = mbx - 60; tipy = mby + 22; );
);
// ---------- SIGNAL-FLOW STRIP: the modules in the order the sound passes them - dot = on / off (click), Shift / Alt + click = solo ----------
fsY = tabm ? 5 : (!basic && !learn ? 46 : 36); fsH = 24; fsC = fsY + fsH / 2;                 // tabs: the right part of the strip sits in the top bar
!tabm ? card(8, fsY, WT - 16, fsH);
// strip order: module ids 0 IN, 1 FILTER, 2 SOURCE, 3 DELAY, 4 ROOM, 5 BARRIER, 6 OUT, 7 MOTION; the Filter sits right after IN (Pre reverb) or just before OUT (Post reverb), per slider30; Basic shows only Source, Room, Barrier, OUT
basic ? ( stord[0] = 2; stord[1] = 4; stord[2] = 5; stord[3] = 6; stn = 4; ) : (
