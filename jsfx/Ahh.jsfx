  PJ(lx, ly, lz); tipbox(qx - 12, qy - 12, 24, 24, basic ? "Listener: drag = move  ·  Ctrl/Cmd+drag = on a line  ·  Shift+drag or wheel = height  ·  double-click = center" : "Listener: drag = move  ·  Ctrl/Cmd+drag = on a line (left / right or forward / back)  ·  Shift+drag or wheel = height  ·  Alt+drag = turn  ·  double-click = center");
