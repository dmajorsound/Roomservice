  chip(x0 + 44, syW + 28, 30, 16, "R2", rflSel == 1, cWALTT) ? ( rflSel = 1; vopt[RFB + 6] >= 0.5 ? rflset(1, 0) : rflset(1, rflLM[1] >= 0.5 ? rflLM[1] : 1); );
  tgl(x0 + w0 - 36, syW + 5, vopt[RFB + 14] < 0.5, cWALTT) ? ( vopt[RFB + 14] = vopt[RFB + 14] >= 0.5 ? 0 : 1; );
  tipbox(x0 + w0 - 36, syW + 5, 26, 14, "Reflectors on / off (both) – the settings stay");
  vopt[RFB] >= 0.5 ? ( col(cWALTT, 1); CIF(x0 + 35, syW + 36, 1.6, 1); ); vopt[RFB + 6] >= 0.5 ? ( col(cWALTT, 1); CIF(x0 + 69, syW + 36, 1.6, 1); );
  tipbox(x0 + 10, syW + 28, 64, 16, "R1 / R2: click = this reflector on / off (and select it for the knobs). Two freely placed vertical planes (facade, rock face, fence, hedge) – each one adds a real echo. A dot = on");
  segtrack(x0 + 82, syW + 28, w0 - 92, 16);
  gk = 0;
  loop(6,
    segp(x0 + 82, syW + 28, w0 - 92, 16, 6, gk, rflName(gk), mm == gk, cTEXT) ? ( rflset(rflSel, gk); mm = gk; );
    gk += 1;
  );
  tipbox(x0 + 82, syW + 28, w0 - 92, 16, "Material: Facade (brick, stone), Glass, Rock, Fence (reflects little), Hedge (soft) – Off removes the reflector");
// the knobs as large as those of the Free field tab (the same rule: nine places over its width, its extra height) - only smaller when this card is too low
  ksp = (w0 - 20) / 6; kscale(min(min(((LW - 40) / 9) / (2 * KR0 + 22), kfit(secx(1) / 4)), (shW - 96) / (2 * KR0 + 36))); kcol = cWALTT;
  ky = syW + 56 + KR + min(10, max(0, (shW - 56 - 2 * KR - 30) / 2));   // under the material row, as in the Free field tab (no longer centered in a tall card)
  gk = 0;
  loop(6,
    kx = x0 + 10 + ksp * (gk + 0.5);
    lo = gk == 3 ? 0.5 : gk == 4 ? 1 : gk == 5 ? -12 : 0; hi = gk == 0 ? rw * 1.25 : gk == 1 ? rd * 1.25 : gk == 2 ? 180 : gk == 3 ? max(10, 4 * max(rw, rd)) : gk == 5 ? 24 : 40;
    av = gk == 5 ? vopt[RFB + 12 + rflSel] : vopt[o + 1 + gk]; df = gk == 0 ? rw * 0.8 : gk == 1 ? rd * 0.5 : gk == 2 ? 90 : gk == 3 ? rd * 1.1 : gk == 5 ? 12 : 4;
    kdim = mm < 1 || vopt[RFB + 14] >= 0.5; gk == 2 ? sprintf(#fv, "%.0f°", av) : (gk == 5 ? sprintf(#fv, "%+.0f dB", av) : sprintf(#fv, "%.1f m", av));
