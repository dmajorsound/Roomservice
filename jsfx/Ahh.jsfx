          eE += e5;
        );
        j += 1;
      );
      bxT = eE > dE ? 4 : 2;                                       // 4 = around the outer edges, 2 = bent through the opening
      eE > dE ? ( edx = ejb == 1 ? brX0 : (ejb == 2 ? brX1 : fx); edz = ejb == 0 ? brH : fz; dE += eE; df = ef; ) : ( dE += eE; );   // around the loudest outer edge
