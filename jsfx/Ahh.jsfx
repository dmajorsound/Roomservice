  col(abs(v) < 0.05 ? cMUTED : cTEXT, 1); gfx_setfont(7); txt(#o5f, cx, cy, 1);
  click && hit ? ( (mouse_cap & 16) ? set51(si, 0) : vedopen(id, #o5f); click = 0; );
  vedPend && vedId == id ? ( set51(si, min(hi, max(lo, vedVal))); vedPend = 0; );
  vedit == id ? vedplace(cx, cy, 44);
