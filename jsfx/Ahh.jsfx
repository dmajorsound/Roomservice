  s4 = -f0 + f1 - f2 - f3 + f5 + f6 - f7; s5 = -f0 - f1 + f2 - f3 - f4 + f6 + f7; s6 = -f0 + f1 - f2 + f3 - f4 - f5 + f7; s7 = -f0 + f1 + f2 - f3 + f4 - f5 - f6;
