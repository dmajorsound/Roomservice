  kind == 11 ? ( j = 0; loop(13, a1 = $pi + j / 13 * $pi; a2 = $pi + (j + 1) / 13 * $pi;
                   icL(cos(a1) * 9, -12 + sin(a1) * 9, cos(a2) * 9, -12 + sin(a2) * 9, 2.2, ink); j += 1; );
