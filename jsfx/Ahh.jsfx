pro_on ? ( qLT[2] = (f0 - f1 - f2 + f3 + f4 - f5 - f6 + f7) * cMuL * 0.5; );
// (output allpasses for a wider tail were tried - above 200 Hz the tail is already uncorrelated (r = -0.06); the r = 0.36
