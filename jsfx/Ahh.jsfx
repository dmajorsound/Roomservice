// Draws a section header at (x,y) with title s and color c: fold chevron, click folds (Alt+click toggles all), sets zoom close button position
function sechdr(id, s, x, y, c) local(m, op, ax, ay, hw, vi, head, colm, anyo)
(
  ay = y + 12;
  szoom == id ? ( zxbX = gox + (crdX + crdW) * gs; zxbY = goy + crdY * gs; zxbOn = 1; );   // zoom window: its corner for the X
  (
    vi = basic ? 13 : 12; ax = x + 10;
    head = tabm ? 0 : 1;   // tabs: no fold arrow (the tab is the module); Expert and Basic: every module folds on its own (Alt+click: all)
    colm = 2 ^ id;
