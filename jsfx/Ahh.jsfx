function rfset(i, v) (
  i == 0 ? slider120 = v;
  i == 1 ? slider121 = v;
  i == 2 ? slider122 = v;
  i == 3 ? slider123 = v;
  i == 4 ? slider124 = v;
  i == 5 ? slider125 = v;
  i == 6 ? slider126 = v;
  i == 7 ? slider127 = v;
  i == 8 ? slider128 = v;
  i == 9 ? slider129 = v;
  i == 10 ? slider130 = v;
  i == 11 ? slider131 = v;
  i == 12 ? slider132 = v;
  i == 13 ? slider133 = v;
  i == 14 ? slider134 = v;
);
// automation notification for reflector slider i: e = 0 touch start, 1 touch end, 2 one-shot
function rfauto(i, e) (
  e == 0 ? (
  i == 0 ? slider_automate(slider120, 0);
  i == 1 ? slider_automate(slider121, 0);
  i == 2 ? slider_automate(slider122, 0);
  i == 3 ? slider_automate(slider123, 0);
  i == 4 ? slider_automate(slider124, 0);
  i == 5 ? slider_automate(slider125, 0);
  i == 6 ? slider_automate(slider126, 0);
  i == 7 ? slider_automate(slider127, 0);
  i == 8 ? slider_automate(slider128, 0);
  i == 9 ? slider_automate(slider129, 0);
  i == 10 ? slider_automate(slider130, 0);
  i == 11 ? slider_automate(slider131, 0);
  i == 12 ? slider_automate(slider132, 0);
  i == 13 ? slider_automate(slider133, 0);
  i == 14 ? slider_automate(slider134, 0);
