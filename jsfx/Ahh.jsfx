        !planv ? (
          PJ(c - ux * hl, cx - uy * hl, rht); rfx2 = qx; rfy2 = qy; PJ(c + ux * hl, cx + uy * hl, rht); rfx3 = qx; rfy3 = qy;
          PJ(slider10 * rs, slider11 * rs, 0); bx1 = qx; by1 = qy; PJ(slider13 * rs, slider14 * rs, 0); bx2 = qx; by2 = qy; pnf = cfade;
          pnx0 = min(min(rfx0, rfx1), min(rfx2, rfx3)); pnx1 = max(max(rfx0, rfx1), max(rfx2, rfx3)); pny0 = min(min(rfy0, rfy1), min(rfy2, rfy3)); pny1 = max(max(rfy0, rfy1), max(rfy2, rfy3));
          (bx1 > pnx0 - 14 && bx1 < pnx1 + 14 && by1 > pny0 - 14 && by1 < pny1 + 14) || (bx2 > pnx0 - 14 && bx2 < pnx1 + 14 && by2 > pny0 - 14 && by2 < pny1 + 14) ? cfade = cfade * 0.4;   // the panel in front of a ball: see-through, the ball stays findable
