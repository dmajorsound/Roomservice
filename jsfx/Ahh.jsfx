  f > 0.01 ? ( col(v >= 0.891 ? cWARN : c, 1); R(bx, yc + hh / 2 - hh * f, w, hh * f); );
);
function mmout(k) ( k == 0 ? pkOL : (k == 1 ? pkOR : (k == 2 ? qPK[2] : (k == 3 ? qPK[5] : (k == 4 ? qPK[3] : qPK[4])))); );
function inN() ( inch >= 6 ? 6 : (inch >= 0.5 && inch < 1.5 ? 1 : 2); );   // input meters: 1 on a mono track, 2 on stereo, 6 on 5.1
function mmin(k) ( inch >= 6 ? (k == 0 ? pkIL : (k == 1 ? pkIR : (k == 2 ? pkJC : (k == 3 ? pkJF : (k == 4 ? pkJS : pkJT))))) : (k == 0 ? pkIL : pkIR); );
function innm(k) ( inN() == 1 ? "M" : (k == 0 ? "L" : (k == 1 ? "R" : (k == 2 ? "C" : (k == 3 ? "LFE" : (k == 4 ? "Ls" : "Rs"))))); );
function mmWd() ( inN() * 3.5 + 3 + (slider136 >= 0.5 ? 6 : 2) * 3.5; );   // 1 / 2 / 6 x In + gap + 2 / 6 x Out
function mmdraw(xr, yc) local(idl, x, k, n)
(
  idl = time_precise() - lastblk > 0.3; n = slider136 >= 0.5 ? 6 : 2; x = xr - mmWd();
  col(cSURF, 1); R(x - 1, yc - 7, mmWd() + 2, 14);
  k = 0; loop(inN(), mmbar(x + k * 3.5, yc, 2.5, 12, idl ? 0 : mmin(k), cDIM2); k += 1; );
  k = 0; loop(n, mmbar(x + inN() * 3.5 + 3 + k * 3.5, yc, 2.5, 12, idl ? 0 : mmout(k), cIOTT); k += 1; );
);
function mmpop(xr, yc) local(idl, n, ni, w, x, y, k, bx, o)
(
  idl = time_precise() - lastblk > 0.3; n = slider136 >= 0.5 ? 6 : 2; ni = inN(); w = 22 + (ni + n) * 15 + 12; x = max(4, min(xr - w, WT - w - 4)); y = yc + 10;
  col(cINK, 0.14); RR(x + 1, y + 3, w, 86, 6); col(cSURF, 1); RR(x, y, w, 86, 6); col(cBORD, 1); RRO(x, y, w, 86, 6);
  col(cMUTED, 1); gfx_setfont(7); txt("In", x + 8 + (ni * 15 - 6) / 2, y + 9, 1); txt("Out", x + 8 + ni * 15 + 12 + (n * 15 - 6) / 2, y + 9, 1);
  k = 0; loop(ni + n,
    bx = x + 8 + k * 15 + (k >= ni ? 12 : 0); o = k - ni;
    mmbar(bx, y + 44, 9, 52, idl ? 0 : (k < ni ? mmin(k) : mmout(o)), k < ni ? cDIM2 : cIOTT);
    col(cMUTED, 1); gfx_setfont(7); txt(k < ni ? innm(k) : (o == 0 ? "L" : (o == 1 ? "R" : (o == 2 ? "C" : (o == 3 ? "LFE" : (o == 4 ? "Ls" : "Rs"))))), bx + 4.5, y + 78, 1);
    k += 1; );
);
// the header meter under the mouse (-1 = none)
function mmover() local(k, h, px, py)
(
  h = -1; k = 0;
  loop(mmN,
    px = (mouse_x - mmB[k * 5 + 3]) / mmB[k * 5 + 2]; py = (mouse_y - mmB[k * 5 + 4]) / mmB[k * 5 + 2];
    mmB[k * 5] > 0 && px >= mmB[k * 5] - mmWd() - 2 && px <= mmB[k * 5] + 2 && abs(py - mmB[k * 5 + 1]) <= 8 ? h = k;
    k += 1; );
  h;
);
// draws every registered header meter (and the large one under the mouse); part = 1: a meter-only frame
function mmflush(part) local(k, gsS, gxS, gyS)
(
  gsS = gs; gxS = gox; gyS = goy; k = 0;
  loop(mmN,
    gs = mmB[k * 5 + 2]; gox = mmB[k * 5 + 3]; goy = mmB[k * 5 + 4];
    mmB[k * 5] > 0 ? mmdraw(mmB[k * 5], mmB[k * 5 + 1]);
    k += 1; );
  !part ? mmHovL = (mouse_cap & 1) ? -1 : mmover();
  mmHovL >= 0 && mmHovL < mmN ? ( k = mmHovL; gs = mmB[k * 5 + 2]; gox = mmB[k * 5 + 3]; goy = mmB[k * 5 + 4]; setfonts(); mmpop(mmB[k * 5], mmB[k * 5 + 1]); );
  gs = gsS; gox = gxS; goy = gyS; setfonts();
