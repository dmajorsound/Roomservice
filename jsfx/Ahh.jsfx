  isfree ? pre = 0;   // (outdoors no predelay - the ground reflection arrives where physics puts it)
  k = 1; loop(NT - 1, xDL[k] = min(MAXIN - 4, xDL[k] + pre); xDR[k] = min(MAXIN - 4, xDR[k] + pre); k += 1; );
  k = 0; loop(NT, xDL[k] += dopA; xDR[k] += dopA; k += 1; );   // the Doppler extra delay in use (see DOPPLER)
  bon && !bsame ? (
    // tail starts after the way through the barrier: via the opening, or straight through the wall
    brOA > 0.0001 ? ( pcx = brOX; pcz = brOZ; ) : ( pcx = sx + (lx - sx) * (yb - sy) / (ly - sy); pcz = sz + (lz - sz) * (yb - sy) / (ly - sy); );
    brd = sqrt(sqr(sx - pcx) + sqr(sy - yb) + sqr(sz - pcz)) + sqrt(sqr(lx - pcx) + sqr(ly - yb) + sqr(lz - pcz));
    // Room spill = the reverberant sound of the source's room, radiated into the listener's room by the wall / opening.
    // Part of it reaches the listener straight from there (direct field of that surface, Q = 2), the rest only after it has
    // been reflected around the listener's room:  direct / reverberant = A / (8 pi r^2)  (A = absorption area, r = distance).
    // The direct part is placed where it comes through, so the spill follows the listener, the door and the source.
    spx = min(roomW, max(0, sx + (lx - sx) * (yb - sy) / (ly - sy))); spz = min(roomH, max(0, sz + (lz - sz) * (yb - sy) / (ly - sy)));
    brOA > 0.0001 ? ( spx += bshare * (brOX - spx); spz += bshare * (brOZ - spz); );   // energy-weighted: opening <-> wall
    sphd = sqrt(sqr(spx - lx) + sqr(yb - ly)); spd3 = max(0.5, sqrt(sqr(sphd) + sqr(spz - lz)));
    sprat = isfree ? 0 : min(4, AeP / (8 * $pi * spd3 * spd3));
    splf = isfree ? 1 : exp(-0.04 * spd3 / rtL);                 // reverberant part in the listener's room (Barron)
    xLG *= sqrt(splf + sprat); bspl += 10 * log10(splf + sprat);
    plat = sin(atan2(yb - ly, spx - lx) - face) * sphd / spd3;
    xLDf = sqrt(splf / (splf + sprat)); pang(plat); xLPL = sqrt(sprat / (splf + sprat)) * pgL; xLPR = sqrt(sprat / (splf + sprat)) * pgR;
  ) : ( brd = rdir; xLDf = 1; xLPL = 0; xLPR = 0; );
  xLD = min(MAXIN - 4, (brd + mfp) / C_SND * srate + pre) + dopA;
  // BASS STEERING weight (precedence effect): full while the direct sound is within 10 dB of everything that follows it (early
  // reflections + the reverb as it is played, incl. what comes through a barrier), none below -20 dB (e.g. a closed door) -
  // in between it fades
