        eon ? (
          rho = j == 0 ? brH - fz : (j == 1 ? fx - brX0 : brX1 - fx);    // distance to the top / left / right edge
          egf = isfree ? 1 : min(1, (j == 0 ? roomH - brH : (j == 1 ? brX0 : roomW - brX1)) * 500 / C_SND);
          dlt = sqrt(d1 * d1 + rho * rho) + sqrt(d2 * d2 + rho * rho) - d1 - d2;
          a5 = 10 * log10(3 + 40 * dlt * 500 / C_SND); a4 = 10 * log10(3 + 40 * dlt * 4000 / C_SND);
