// PREDELAY FOLLOWS THE ROOM (vopt[8], Reverb row): when width, depth, height or size are changed by hand, the predelay
// goes with the room as in the presets - about 3.5 ms per meter of mean free path (4 V / S) above 0.8 m, 0 ... 60 ms
// (living room 6, classroom 10, lecture hall 22, concert hall 45 ms). Setting the predelay by hand ends the following.
function pdroom() local(w, d, h, v, a) (
  w = slider2 * slider31; d = slider3 * slider31; h = slider4 * slider31; v = w * d * h; a = 2 * (w * d + w * h + d * h);
  floor(min(60, max(0, 3.5 * (4 * v / max(0.01, a) - 0.8))) * 2 + 0.5) / 2;
);
// Sets slider i to v from the GUI, flags it changed, holds the value for the audio thread; manages predelay auto-follow when room size changes.
function setp(i, v) (
  abs(slider(i) - v) > 0.0000001 ? ( sset(i, v); gchg[i] = 1; );
