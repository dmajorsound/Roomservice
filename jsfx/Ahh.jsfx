    col(0xFFFFFF, 0.1); pnq(-0.9, -0.5, 0.1, 0.4); pnq(0.1, 0.6, 0.55, 0.85);
  ) : ( m < 4.5 ? (
    nc = min(40, max(3, floor(pnHl * 2 / 0.6)));
