  // loop gains: low frequencies decay with RT60, highs faster (more absorption = darker)
  hfr = hfrP;                                      // HF / LF decay ratio from walls + air (Eyring)
  bgoff ? ( gHFo = hfr; ) : ( bgblend ? ( hfr = hfr * bmixg + gHFo * (1 - bmixg); ); );   // (hfr is local: kept here)
  // RT60 PER OCTAVE (63 Hz ... 8 kHz) relative to the mids: Eyring with the materials per octave and the air of each band,
  // for the same room as hfr / lfrP; 125 Hz and 4 kHz are exactly lfrP and hfr (bass of the modes, barrier mix, ...)
  rbsel == 1 ? ( rbV = pV; rbS = pS2; rbA = pA; rbD = pD; rb1 = pNy; rb2 = pSy; rb3 = pwE; rb4 = pwW; rb5 = pwF; ) : (
  rbsel == 2 ? ( rbV = qV; rbS = qS; rbA = qA; rbD = qD; rb1 = qNy; rb2 = qSy; rb3 = qwE; rb4 = qwW; rb5 = qwF; ) : (
               rbV = roomV; rbS = roomS; rbA = roomA; rbD = roomD; rb1 = aN; rb2 = aS; rb3 = aE; rb4 = aW; rb5 = aF; ); );
  rbm = 0.161 * rbV / (-rbS * log(1 - min(0.95, max(0.005, rbA / rbS))) + 4 * airm5 * rbV);
  k = 0;
  loop(8,
    rbj = min(5, max(0, k - 1)); rbAk = areaX(rbj, roomW, rbD, roomH, rb1, rb2, rb3, rb4, rb5);
    rbt = 0.161 * rbV / (-rbS * log(1 - min(0.95, max(0.005, rbAk / rbS))) + 4 * airOB[k] * rbV);
    // RT relative to the mids, limited: bass bands (k <= 2) 0.4 ... 1.8, mids 0.1 ... 1.8, highs (k >= 6) 0.1 ... 1 (never longer than the mids)
