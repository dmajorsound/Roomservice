);
clipwarn > 0 ? clipwarn -= 1;

pkOL = max(abs(outL), pkOL * pmdec); pkOR = max(abs(outR), pkOR * pmdec);
pro_on ? ( qPK[2] = max(abs(qO[2]), qPK[2] * pmdec); qPK[3] = max(abs(qO[3]), qPK[3] * pmdec); qPK[4] = max(abs(qO[4]), qPK[4] * pmdec); qPK[5] = max(abs(qO[5]), qPK[5] * pmdec); );   // (meters of C, Ls, Rs - the Output module shows them in Step 7)
pro_on ? (   // 5.1: the correlation of the standard stereo downmix (ITU: Lo = L + 0.707 C + 0.707 Ls, Ro = R + 0.707 C + 0.707 Rs, no LFE)
  dmxL = outL + 0.70710678 * (qO[2] + qO[3]); dmxR = outR + 0.70710678 * (qO[2] + qO[4]);
  crXY = crXY * crk + dmxL * dmxR; crXX = crXX * crk + dmxL * dmxL; crYY = crYY * crk + dmxR * dmxR;
) : (
  crXY = crXY * crk + outL * outR; crXX = crXX * crk + outL * outL; crYY = crYY * crk + outR * outR;   // correlation (GUI)
);
spOn ? ( spRI[spw] = spIn; spRO[spw] = (outL + outR) * 0.5; spw = (spw + 1) & 8191; );   // spectrum (only while the window is open)
spOn ? ( gonC += 1; gonC >= 4 ? ( gonC = 0; gonB[2 * gonP] = outL; gonB[2 * gonP + 1] = outR; gonP = (gonP + 1) & (GONN - 1); ); );   // goniometer ring

// SAFETY: a non-finite output (NaN / Inf) is replaced by silence and the long buffers are cleared - one bad sample must not
// leave the plugin dead (a NaN in a feedback loop stays forever)
nanB = !(abs(outL) < 1000000) || !(abs(outR) < 1000000);
pro_on ? nanB = nanB || !(abs(qO[2]) < 1000000) || !(abs(qO[3]) < 1000000) || !(abs(qO[4]) < 1000000) || !(abs(qO[5]) < 1000000);
nanB ? (
  outL = 0; outR = 0; nanCnt += 1;
  // the full reset of the next block (@block, fpanic) - it also clears the recursive states that are not in the buffers
  // below: the FDN loop filters, the source model's biquads, the oversampler, the room modes (a partial reset left a NaN
  // sitting in one of those, and it came straight back on the next sample - the plugin stayed silent until playback restarted)
  fpanic = 1;
  memset(ibuf, 0, dlL - ibuf); memset(arr, 0, stb + 64 - arr); memset(dlL, 0, 2 * DLMAX + 2 * MAXIN); qBclear(); memset(dlC, 0, 48 + ANAMAX + 80);
  memset(lmDL, 0, 2 * LMLA); lmsum = LMN; lmr = 1; lmga = 1; k0 = 0; loop(LMN, lmW[k0] = 1; k0 += 1; );
  pro_on ? ( memset(qO, 0, 8); q5clear(); );
);
spl0 = outL;
spl1 = outR;
// 5.1 (REAPER order): L R C LFE Ls Rs. (in Stereo the channels 3 - 6 of a wider track pass through untouched, as before)
pro_on ? ( spl2 = qO[2]; spl3 = qO[5]; spl4 = qO[3]; spl5 = qO[4]; );
// silence in and out: count; long enough -> sleep (5.1: C, Ls, Rs count as output as well)
slc = abs(inL) + abs(inR) < SLIN && abs(outL) + abs(outR) + (pro_on ? abs(qO[2]) + abs(qO[3]) + abs(qO[4]) : 0) < SLOUT ? slc + 1 : 0;
slc > slhold ? ( slp = 1; slc = 0; );
);

@gfx 760 574
gclp = 0;
// reflector sliders changed by the host (automation while the audio is stopped, too) -> the reflectors (see REFLECTOR AUTOMATION)
rfLoad == rfLoadG ? ( i = 0; loop(15, sv = slider(120 + i); sv == sv && !rfTch[i] && abs(sv - rfSl[i]) > 0.0000001 ? ( vopt[RFB + i] = sv; rfSl[i] = sv; ); i += 1; ); );
gfx_clear = -1;                          // never auto-clear: the frame is kept for partial (meter-only) redraws
// the whole frame is drawn into image 1 (the plugin's own framebuffer, kept between frames) and put on the screen
// with ONE blit at the very end of @gfx - the screen never shows a half-drawn frame (the cleared background, a cleared
// module before its meters are back), which flickered on a Mac in the All view (Metal presents the window at any moment)
(fbW != gfx_w || fbH != gfx_h) ? ( gfx_setimgdim(1, gfx_w, gfx_h); fbW = gfx_w; fbH = gfx_h; fullcnt = 0; );
gfx_dest = 1;
// the correlation of this frame (2 = no signal), taken once at its start (the modules read it from here)
crvG = time_precise() - lastblk > 0.3 || crXX + crYY < 0.000000001 ? 2 : crXY / sqrt(crXX * crYY + 0.00000000000000000001);
// calm display: smoothed per frame, shown in steps of 0.02 at most 8 times a second, and "–" (no signal) only after
// 0.6 s of silence - the number and the bar no longer jump and blink from frame to frame (quiet tails, a moving source)
crvT = time_precise();
crvG <= 1.5 ? ( crvSl = crvT; crvD = crvD > 1.5 ? crvG : crvD + (crvG - crvD) * 0.2; ) : ( crvT - crvSl > 0.6 ? crvD = 2; );
(crvT - crvLt > 0.125 && abs(crvD - crvS) >= 0.035) || crvT - crvLt > 0.6 || (crvD > 1.5) != (crvS > 1.5) ? (   // small wobbles (< 0.035) wait 0.6 s - the number no longer blinks between two neighbours
   crvS = crvD > 1.5 ? 2 : floor(crvD * 50 + 0.5) / 50; crvLt = crvT; );
inStereo0 = time_precise() - lastblk < 0.3 && sdE > 0.000000001 && sdE > mdE * 0.0001;
inStereo0 ? stHold = time_precise(); inStereo = inStereo0 || time_precise() - stHold < 1.5;   // kept for 1.5 s - a slow audio block (Barrier: Window / Door / Open recompute) must not make the span handles blink // a stereo input (side at least -40 dB under the mid) - the span in the room view
// BARRIER TILES (Basic and Expert): Wall / Window / Door as icon tiles - filled in the accent color when chosen; a click on another
// type switches the barrier to it (with that type's typical damping)
// a barrier that is switched on stands half way between source and listener (depth and side) - unless they stand on the
// same spot (linked) or the barrier is locked
// from the position sliders themselves (sx / lx are the audio thread's copy - stale while it has not run since the
// balls were moved, so the barrier sometimes landed between the OLD places); no exception for two balls on one spot
function bcenter() (
  !lockB ? ( slider42 = (slider11 + slider14) / 2; sauto1(42); );
  !lockE ? ( slider45 = (slider10 + slider13) / 2; sauto1(45); );
);
// Draws the Wall/Window/Door barrier-type tiles in a row at (x,y,w,h); click selects type k (sets slider41, slider44 default material)
function bartiles(x, y, w, h) local(cw, k, tx, act, hit, ic)
(
  cw = (w - 8) / 3; k = 1;
  loop(3,
    tx = x + (k - 1) * (cw + 4); act = btg == k; hit = inbox(tx, y, cw, h);
    col(act ? cBARTT : (hit ? cHAIR : cLINE), 1); RR(tx, y, cw, h, 8);
    ic = act ? cSURF : (hit ? cTEXT : cMUTED); gfx_setfont(6); btw = tws("Window");   // the widest name decides - one layout for all three
    h >= 36 ? ( baricon(k, tx + cw / 2, y + (h - 12) / 2, ic); col(ic, 1); gfx_setfont(6); txt(k == 1 ? "Wall" : (k == 2 ? "Window" : "Door"), tx + cw / 2, y + h - 8, 1); )   // icon above, name below
            : ( baricon(k, tx + cw / 2 - btw / 2 - 6, y + h / 2, ic); col(ic, 1); gfx_setfont(6); txt(k == 1 ? "Wall" : (k == 2 ? "Window" : "Door"), tx + cw / 2 + 8, y + h / 2, 1); );
    click && hit && !act ? ( btg == 0 ? bcenter(); slider41 = k; sauto1(41); slider44 = bmatrw(k, 1); sauto1(44); );
    tipbox(tx, y, cw, h, k == 1 ? "Wall between source and listener, parallel to the back wall" : (k == 2 ? "Wall with a window (1.2 × 1.2 m, sill 0.9 m, two sashes) – Open swings them open to the left and right" : "Wall with a door (0.9 × 2.1 m) – Open swings the leaf up to 90°"));
    k += 1;
  );
);
// padlock icon (cx, cy = center of the body), locked = closed shackle
function padlock(cx, cy, lk)
(
  RR(cx - 3.6, cy - 0.8, 7.2, 5.6, 1.2);   // smooth shackle
  SDB0(); lk ? ( SDSEG(cx - 2.2, cy - 0.8, cx - 2.2, cy - 3); SDSEG(cx + 2.2, cy - 0.8, cx + 2.2, cy - 3); SDARC(cx, cy - 3, 2.2, -0.5 * $pi, 0.5 * $pi); )
             : ( SDSEG(cx - 2.2, cy - 0.8, cx - 2.2, cy - 4.6); SDSEG(cx + 2.2, cy - 3.6, cx + 2.2, cy - 4.6); SDARC(cx, cy - 4.6, 2.2, -0.5 * $pi, 0.5 * $pi); ); SDDRAW(1.05);
);
// ---- sections: current height (folding animation) and "fully open" ----
function sech(id, full) ( HDR + secop[id + basic * 12] * (full - HDR); );
// Returns true if section id is unfolded; folded state kept in secop[], offset 12 per view mode (Basic vs Expert)
function secopen(id) ( secop[id + basic * 12] >= 1; );
// extra height of a section, set with the mouse (Expert: per section, Basic: the row of four)
function secx(id) ( basic ? vopt[32] + bfill : vopt[id == 14 ? 37 : 20 + id]; );   // (Motion: vopt[37])   // Basic: + the height the cards get to fill the window
// a section's controls only exist while it is drawn: in a section zoom only the zoomed one
function secvis(id) ( !learn && secopen(id) && (!szoom || szoom == id); );
// DROPDOWN MENU placement: inside the visible part of the window (mnvl … mnvb, current scale); pref 0 = below the box first,
// 1 = above first; scaled down (mfk < 1) only when it is taller / wider than the visible part. -> mfx, mfy, mfk
function mfit(bx, by, bw, bh, mw, mh, pref) local(sw, sh)
(
  mfk = max(0.5, min(1, min((mnvr - mnvl) / mw, (mnvb - mnvt) / mh))); sw = mw * mfk; sh = mh * mfk;
  pref ? ( mfy = by - sh - 3; mfy < mnvt ? ( mfy = by + bh + 3; ); ) : ( mfy = by + bh + 3; mfy + sh > mnvb ? ( mfy = by - sh - 3; ); );
  mfy = max(mnvt, min(mfy, mnvb - sh));
  mfx = max(mnvl, min(bx, mnvr - sw));
);
// a menu with its own scale k around its top left corner (ax, ay): draw (mtx … mtxend) and read the mouse (mloc … mrest)
function mtx(ax, ay, k) (
  gsMn = gs; goxMn = gox; goyMn = goy; mxMn = mx; myMn = my;
  gs = gsMn * k; gox = goxMn + ax * (gsMn - gs); goy = goyMn + ay * (gsMn - gs);
  setfonts(); mx = (mouse_x - gox) / gs; my = (mouse_y - goy) / gs; mtxa = ax; mtya = ay; mtxk = k;
);
// Ends a scaled-menu block started by mtx: restores gs, gox, goy, fonts and mouse mx/my, and maps the tooltip back to page scale
function mtxend() (
  tipon ? ( tipx = mtxa + (tipx - mtxa) * mtxk; tipy = mtya + (tipy - mtya) * mtxk; );   // tooltip back to the page scale
  gs = gsMn; gox = goxMn; goy = goyMn; setfonts(); mx = mxMn; my = myMn;
);
// Returns true if the mouse is inside box (x,y,w,h) in the unscaled normal page coordinates (goxN, goyN, gsN)
function inboxN(x, y, w, h) local(px, py) ( px = (mouse_x - goxN) / gsN; py = (mouse_y - goyN) / gsN; px >= x && px < x + w && py >= y && py < y + h; );
// Maps mouse mx,my into a menu's local scale k around anchor (ax,ay), saving the originals in mxMn/myMn; undo with mrest
function mloc(ax, ay, k) ( mxMn = mx; myMn = my; mx = ax + (mx - ax) / k; my = ay + (my - ay) / k; );
// Restores mouse mx,my saved by mloc
function mrest() ( mx = mxMn; my = myMn; );
// CLOSE BUTTON (x) of a preset window: a round badge on its top right corner (x, y, w = the window; k = its scale when drawn small)
function menuxhit(x, y, w, k) ( sqr(mx - (x + (w - 3) * k)) + sqr(my - (y + 3 * k)) < sqr(8.5 * k); );
// Draws the round close badge (x) at the top right corner of a preset window at (x,y,w); highlights when hovered
function menux(x, y, w) local(cx, cy, hit)
(
  cx = x + w - 3; cy = y + 3; hit = sqr(mx - cx) + sqr(my - cy) < 72;
  col(cINK, 0.12); CIF(cx + 0.5, cy + 1.5, 8, 1);
  col(hit ? cTEXT : cSURF, 1); CIF(cx, cy, 8, 1); col(hit ? cTEXT : cBORD, 1); CI(cx, cy, 8, 0);
  col(hit ? cSURF : cMUTED, 1); LNW(cx - 2.8, cy - 2.8, cx + 2.8, cy + 2.8, 1.3); LNW(cx - 2.8, cy + 2.8, cx + 2.8, cy - 2.8, 1.3);
);
// Maps a resizable part's id to its index in the vopt[] extra-height array (Motion 14 -> 37, ids 9/21/22 special, else 20+id)
function rzidx(id) ( id == 9 ? 33 : (id == 21 ? 34 : (id == 22 ? 32 : (id == 14 ? 37 : 20 + id))); );
// Returns true if resizable part id is currently available (view parts need vop>=1, id 22 needs section 3 open, else section open)
function rzok(id) ( id == 9 || id == 21 ? vop >= 1 : (id == 22 ? secopen(3) : secopen(id)); );
// bottom edge of a resizable part: rzgx, rzgw (x range), rzgy (edge)
function rzgeo(id) (
  id == 9 || id == 21 ? ( rzgx = VX; rzgw = VW; rzgy = VY + VH; ) : (
  id == 22 ? ( rzgx = 8; rzgw = bcw; rzgy = max(yS2 + hbB, yO2 + hbO); ) : (
  id == 4 || id == 5 ? ( rzgx = R0; rzgw = RWc; rzgy = id == 4 ? syW + shW : syB + shB; ) : (
  id == 6 ? ( rzgx = flX; rzgw = flW; rzgy = syF + shF; ) : (
  id == 3 ? ( rzgx = srX; rzgw = srW; rzgy = syS + shS; ) : (
  id == 7 ? ( rzgx = IOX; rzgw = IOW; rzgy = IOY + IOH; ) : (     // Output: where it is (right column while the room view is hidden)
  rzgx = L0; rzgw = LW; rzgy = id == 10 ? syD + shD : syR + shR;
  ))))));
);
// section heading: fold arrow (Expert), color mark, name, "?" - a click on arrow or name folds / unfolds the section
// FOLDING: Expert - every section folds on its own; Basic - the arrow of Source folds the row of four.
// Alt+click on any arrow
// (also the one of the 3D view) folds / opens everything.
// RESET of one module: its parameters back to the defaults - the power button (on / off) stays; one undo step
function mrr(a, b) local(i) ( i = a; loop(b - a + 1, sset(i, sdef(i)); i += 1; ); );
// Resets module id's sliders to defaults via sset/mrr (Filter, Source, Delay, Room, Walls/Reflectors, Free field); takes an undo snapshot first
function modulereset(id) local(i) (
  id != 15 ? snap_take();
  id == 6 ? ( mrr(24, 30); sset(88, 100); );                                                             // Filter (39 = its power)
  id == 3 ? ( sset(35, 0); sset(37, 0); mrr(47, 59); sset(89, 100); sset(98, 100); sset(110, 0); mrr(111, 114); );   // Source (85 = power)
  id == 10 ? ( mrr(66, 84); sset(86, sdef(86)); sset(87, sdef(87)); sset(90, 100); sset(93, 0); sset(94, 0); sset(99, 0); sset(115, 0); sset(116, 0); );   // Delay (65)
  id == 1 ? ( mrr(2, 4); mrr(10, 15); sset(20, 0); sset(21, 0); mrr(31, 34); sset(38, sdef(38)); sset(61, 0); sset(62, 100); sset(91, 100); sset(117, 0); vopt[8] = 1; );   // Room (36; the free field / room mode stays as it is)
  id == 4 ? ( isfree ? ( i = 0; loop(12, vopt[RFB + i] = FFP[ffpLast * 16 + 4 + i]; i += 1; ); vopt[RFB + 12] = vopt[RFB + 13] = 12; vopt[RFB + 14] = 0; rflSel = 0; ) : ( mrr(5, 9); sset(19, 1); ); );   // free field: the two reflectors back to the loaded place
  id == 15 ? ffpapply(0);                                                                               // Free field: back to the Street (power stays)
  id == 5 ? ( mrr(42, 46); sset(92, 100); mrr(95, 97); );                                                // Barrier (41 = type / power)
  id == 7 ? ( sset(18, 100); sset(22, 0); sset(23, 1); sset(40, 0); sset(60, 0); vopt[49] = 0; set51(143, 0); set51(144, 100); set51(147, 0); set51(148, 0); set51(149, 0); set51(150, 0); set51(151, 0); );       // Output
  id == 14 ? ( mrr(101, 109); );                                                                         // Motion (100)
  id != 15 ? snap_notify();
);
function ic_reset(cx, cy) local(px, py, dx, dy) (   // an open circle with an arrow head (counter-clockwise): reset
// the arc runs from the upper left over the top, right and bottom round to the lower left; the head sits on the
  // upper-left end and points on along the circle (counter-clockwise) into the gap
  SDB0(); SDARC(cx, cy, 3.9, -0.95, 4.15);
  px = cx + sin(-0.95) * 3.9; py = cy - cos(-0.95) * 3.9; dx = -cos(-0.95); dy = -sin(-0.95);
  CHEV(px + dx * 1.1, py + dy * 1.1, dx, dy, 2.3, 1); SDDRAW(1);
);
// Toggles all sections folded/unfolded in the section-bit mask vopt[12] (Expert) or vopt[13] (Basic): all open if any is closed, else all closed
function foldall() local(vi, allm) (
  vi = basic ? 13 : 12; allm = basic ? 682 : 4094 + 16384;                 // all section bits + 512 (3D view) (+ 1024 Delay, 2048 Decay by band, 16384 Motion)
  vopt[vi] = (vopt[vi] & allm) != allm ? allm : 0;
);
// 5.1 OUTPUT LEVEL of one channel, typed in: a small field under its meter (k: 0 L, 1 R, 2 C, 3 LFE, 4 Ls, 5 Rs).
// Click = type the level in dB, Alt+click = 0 dB. L R C Ls Rs: -24 … +6 dB (sliders 147 … 151), LFE: its level (143, -24 … +10)
function o5field(k, cx, cy) local(si, v, lo, hi, id, hit)
(
  si = k == 3 ? 143 : (k < 3 ? 147 + k : 146 + k); lo = -24; hi = k == 3 ? 10 : 6;
  v = slider(si); id = 93 + k;
  sprintf(#o5f, abs(v) < 0.05 ? "0.0" : (abs(v) >= 9.95 ? (v > 0 ? "+%.0f" : "%.0f") : (v > 0 ? "+%.1f" : "%.1f")), v);
  hit = inbox(cx - 8, cy - 6, 16, 12);
