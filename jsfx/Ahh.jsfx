function sn_add(c) local(n, tb, tln, tmx) (     // append one character (Unicode code point) as UTF-8 to the active field
  tb = snf ? dseb : sneb; tln = snf ? dselen : snelen; tmx = snf ? DSL : SNL;
  n = c < 128 ? 1 : (c < 2048 ? 2 : (c < 65536 ? 3 : 4));
  c >= 32 && tln + n <= tmx - 1 ? (
    n == 1 ? ( tb[tln] = c; ) : (
    n == 2 ? ( tb[tln] = 192 | (c >> 6); tb[tln + 1] = 128 | (c & 63); ) : (
    n == 3 ? ( tb[tln] = 224 | (c >> 12); tb[tln + 1] = 128 | ((c >> 6) & 63); tb[tln + 2] = 128 | (c & 63); ) : (
      tb[tln] = 240 | (c >> 18); tb[tln + 1] = 128 | ((c >> 12) & 63); tb[tln + 2] = 128 | ((c >> 6) & 63); tb[tln + 3] = 128 | (c & 63); )));
    tln += n; tb[tln] = 0;
