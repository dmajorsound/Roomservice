function spapply(k) local(b, i) ( b = spTb + k * 8; snap_take(); sset(35, b[1]); sset(37, b[2]); i = 47; loop(13, sset(i, spq(b[7], i)); i += 1; );
  sset(111, b[3]); sset(112, b[4]); sset(113, b[5]); sset(114, b[6]); sset(85, 1); sset(89, 100); snap_notify(); );

// ---- snapshot names: stored as bytes (one per value) so that @serialize can keep them with the slots ----
function sn_str(b, s) local(i, z) (
  strcpy(s, ""); i = 0; z = 0;
  loop(SNL, b[i] <= 0 ? ( z = 1; ); !z ? ( sprintf(#snch, "%c", b[i]); strcat(s, #snch); ); i += 1; );
  s;
