// Draws a round ON/OFF power button at x,y (filled in color c when on, thin ring when off) and returns 1 if clicked.
function tgl(x, y, on, c) local(hit, cx, cy)
(
  cCTLon ? ( c = on ? cACTO : cCTL; );   // ON = blue (white on white was hard to tell from off in dark mode)
