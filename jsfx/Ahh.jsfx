    // 8 kHz x 0.7 of the front's ratio), normalized to the same energy as the front (its mean length differs)
    pro_on ? (
      qr5 = fqR[5]; qr6 = fqR[6]; qr7 = fqR[7]; fqR[5] *= 0.9; fqR[6] *= 0.8; fqR[7] *= 0.7; fqCt = fqCB; fqGt = fqGB;
      lsum = 0; k = 0; loop(8, fqdesign(k, flenB[k]); lsum += flenB[k]; k += 1; );
      fqCt = fqC; fqGt = fqG; fqR[5] = qr5; fqR[6] = qr6; fqR[7] = qr7;
      gm = 10 ^ (-3 * (lsum / 8) / (rt * srate)); qTailR = sqrt((1 - gm * gm) / (gm * gm)) / max(0.000001, tailn);
    );
    last_gkey = gkey;
