  j = j0;
  loop(j1 - j0 + 1,
    yj = (abs(j) % 2) ? (j + 1) * roomD - yb : j * roomD + yb;      // the barrier, mirrored into image cell j
    (yj - ly) * (yj - py) < 0 ? (
      t = (yj - ly) / (py - ly);
      bxing(fold(lx + t * (px - lx), roomW), fold(lz + t * (pz - lz), roomH), t * dtot, (1 - t) * dtot);
      gE *= bxE; bxF > 0 ? ( gF += 1 / sqr(bxF); gM *= bxM; gN = 1; ); gC += bxC;
      ncr += 1; crX = lx + t * (px - lx); crZ = lz + t * (pz - lz); crY = yj; crV = bxV; crEx = bxEx; crEz = bxEz;
    );
    j += 1;
  );
