function gmtext(p) local(k)
(
  gmX0 = gmY0 = -1; gmX1 = gmY1 = 1; gmZ0 = gmZ1 = 0;
  p == 1 ? ( gmY0 = gmY1 = 0; ); p == 2 ? ( gmX0 = gmX1 = 0; ); p == 3 ? ( gmX0 = gmX1 = gmY0 = gmY1 = 0; gmZ0 = -1; gmZ1 = 1; );
  p == 6 ? ( gmY0 = -0.35; gmY1 = 0.35; );
