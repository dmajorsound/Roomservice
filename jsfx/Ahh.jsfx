  snf == 0 && (floor((time_precise() - snt0) * 2) & 1) == 0 ? ( snc = snfx + 8 + tws(#sne); col(cTEXT, 1); LNW(snc, snny + 6, snc, snny + snnh - 6, 1.2); );
