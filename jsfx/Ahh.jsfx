      fg[k] = g0;
      fgL[k] = g0 + (10 ^ (-3 * flen[k] / (min(20, rt * lfrP) * srate)) - g0) / 0.8944;   // bass RT60 at 125 Hz (shelf corner 250 Hz compensated)
      fqdesign(k, flen[k]);                                                    // per octave (what the lines play)
