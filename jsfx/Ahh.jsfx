  krow(c1, y, "Double-click", "Knob: type a value", ovkw, ovdw); y += 25;
  krow(c1, y, "Right-click", "Type a value (Mac: also Ctrl+click)", ovkw, ovdw); y += 25;
  krow(c1, y, "Alt + click", "Knob back to its default", ovkw, ovdw); y += 25;
  krow(c1, y, "Plan: drag", "Move source / listener (Shift: height)", ovkw, ovdw); y += 25;
  krow(c1, y, "Alt + drag ball", "Turn the source / the listener (Expert)", ovkw, ovdw); y += 25;
  krow(c1, y, "2× on a ball", "To the room center · listener arrow: ahead", ovkw, ovdw); y += 25;
  krow(c1, y, "Alt + 2× source", "The listener looks straight ahead again", ovkw, ovdw); y += 25;
  krow(c1, y, "Reflector", "Drag = move · Alt+drag = turn · squares = size", ovkw, ovdw); y += 25;
  krow(c1, y, "Ctrl/Cmd + drag", "Source / listener on a line only", ovkw, ovdw); y += 25;
  krow(c1, y, "Plan: wall", "Drag = stretch (Alt: height, Ctrl/Cmd: size)", ovkw, ovdw); y += 25;
