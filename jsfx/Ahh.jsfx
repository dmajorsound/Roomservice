        pda = e == 0 ? ax - clX0 : (e == 1 ? clX1 - ax : (e == 2 ? ay - clY0 : clY1 - ay));
        pdb = e == 0 ? bx - clX0 : (e == 1 ? clX1 - bx : (e == 2 ? by - clY0 : clY1 - by));
        pdb >= 0 ? (
          pda < 0 ? ( t = pda / (pda - pdb); PLQ[32 + 2 * m] = ax + t * (bx - ax); PLQ[33 + 2 * m] = ay + t * (by - ay); m += 1; );
          PLQ[32 + 2 * m] = bx; PLQ[33 + 2 * m] = by; m += 1;
        ) : ( pda >= 0 ? ( t = pda / (pda - pdb); PLQ[32 + 2 * m] = ax + t * (bx - ax); PLQ[33 + 2 * m] = ay + t * (by - ay); m += 1; ); );
        i += 1;
      );
