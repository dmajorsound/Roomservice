// orthogonal for every th (lossless) - low density = lines feed mostly themselves (distinct echoes),
// high density = every line feeds all others (smooth tail)
s0 = f1 + f2 + f3 + f4 + f5 + f6 + f7;
s1 = -f0 + f2 + f3 - f4 + f5 - f6 - f7;
s2 = -f0 - f1 + f3 + f4 - f5 + f6 - f7;
s3 = -f0 - f1 - f2 + f4 + f5 - f6 + f7;
s4 = -f0 + f1 - f2 - f3 + f5 + f6 - f7;
s5 = -f0 - f1 + f2 - f3 - f4 + f6 + f7;
s6 = -f0 + f1 - f2 + f3 - f4 - f5 + f7;
s7 = -f0 + f1 + f2 - f3 + f4 - f5 - f6;
