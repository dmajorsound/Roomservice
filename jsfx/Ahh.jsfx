        rflCol = vopt[o] < 1.5 ? 0x8C8F99 : (vopt[o] < 2.5 ? 0x7FB6C9 : (vopt[o] < 3.5 ? 0x8A8378 : (vopt[o] < 4.5 ? 0x9A9AA4 : 0x6FA37A)));
