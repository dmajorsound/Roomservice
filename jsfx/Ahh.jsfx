function bxing(fx, fz, d1, d2) local(brx, brz, rho, dlt, a5, a4, dE, mE, dm, df, eE, eA, e5, ef, j, inelm, mfc, mm, mx5, mcmp, edx, edz, ejb, eon, egf)
(
  (fx < brX0 - 0.0001 || fx > brX1 + 0.0001 || fz > brH + 0.0001) ? (
    // beside or above a smaller partition: free (a narrow gap passes less)
