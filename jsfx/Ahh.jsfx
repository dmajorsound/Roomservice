// Returns the name of free-field place preset k.
function ffpname(k) ( (k == 0 ? "Street (default)" : (k == 1 ? "Narrow alley" : (k == 2 ? "City street canyon" : (k == 3 ? "Boulevard" : (k == 4 ? "Soccer field" : (k == 5 ? "Meadow" : (k == 6 ? "Parking lot" : (k == 7 ? "Forest road" : (k == 8 ? "Mountain wall" : (k == 9 ? "Canyon" : (k == 10 ? "Courtyard corner" : (k == 11 ? "Shopping street" : (k == 12 ? "Garden" : (k == 13 ? "Snow field" : (k == 14 ? "Rooftop" : (k == 15 ? "Highway barrier" : "Harbour quay")))))))))))))))); );
// Returns the description of free-field place preset k.
function ffpdesc(k) ( (k == 0 ? "a street between low buildings: hard asphalt, a facade on each side (4 m high) - the sound runs along it and slaps back from both sides" : (k == 1 ? "a 6 m alley between tall walls: a dense, fast flutter between the facades" : (k == 2 ? "a wide street between high-rises: high facades, a late, bright wash" : (k == 3 ? "a broad avenue: the facades are far away, the echoes come late and soft" : (k == 4 ? "open grass, a stand behind the far goal: one late, soft echo" : (k == 5 ? "open grass, nothing around: only the soft ground" : (k == 6 ? "hard asphalt, a building behind you and a low fence at the side" : (k == 7 ? "a gravel road between dense trees: soft, dull reflections from both sides" : (k == 8 ? "open ground, a rock face far ahead: one hard, late echo" : (k == 9 ? "a narrow valley with rock on both sides: long, hard echoes" : (k == 10 ? "two facades meeting at a right angle: the sound comes back from two directions" : (k == 11 ? "glass shop fronts on both sides: bright, ringing reflections" : (k == 12 ? "grass between a wooden fence and a hedge: very little reflection" : (k == 13 ? "fresh snow, nothing around: dry and very quiet" : (k == 14 ? "a flat roof with low parapet walls: reflections only at low height" : (k == 15 ? "a concrete noise barrier along one side: a hard slap from the right" : "a hard quay in front of a warehouse wall: one wide, hard echo")))))))))))))))); );
// the Delay module helps the sound of every place: delay preset (-1 = delay off) and its mix %
FFD = alloc(40);
FFD[0] = 2; FFD[1] = 30;    FFD[2] = 0; FFD[3] = 45;    FFD[4] = 2; FFD[5] = 45;    FFD[6] = 2; FFD[7] = 25;
FFD[8] = 4; FFD[9] = 30;    FFD[10] = -1; FFD[11] = 0;  FFD[12] = 2; FFD[13] = 20;  FFD[14] = 8; FFD[15] = 40;
FFD[16] = 11; FFD[17] = 50; FFD[18] = 10; FFD[19] = 60; FFD[20] = 1; FFD[21] = 45;  FFD[22] = 2; FFD[23] = 25;
FFD[24] = -1; FFD[25] = 0;  FFD[26] = -1; FFD[27] = 0;  FFD[28] = 0; FFD[29] = 20;  FFD[30] = 0; FFD[31] = 25;
FFD[32] = 0; FFD[33] = 30;
// Applies free-field place k from the FFP table: sets area size, ground, positions, reflectors and its delay preset, with an undo snapshot.
function ffpapply(k) local(b, sz1, i)
(
  b = FFP + k * 16; sz1 = max(1, ceil(max(b[0], b[1]) / 40 * 4) / 4);   // the Size factor that makes the area fit the 40 m sliders
  snap_take();
  mtE > 0.001 || slider100 >= 0.5 ? ( mtKill = 1; slider100 = 0; );
  sset(1, 1); sset(31, sz1); sset(2, b[0] / sz1); sset(3, b[1] / sz1); sset(4, max(0.8, min(15, b[2] / sz1)));
  sset(119, b[3]); sset(117, 0);
  sset(13, b[0] / sz1 / 2); sset(14, b[1] / sz1 / 2); sset(10, b[0] / sz1 / 2); sset(11, b[1] / sz1 / 2 - 1.5 / sz1);   // listener in the middle, the source 1.5 m in front of it (as in the room)
  sset(12, 1.5); sset(15, 1.5); sset(16, 1); sset(17, 0); sset(63, 1); sset(61, 0);
  i = 0; loop(12, vopt[RFB + i] = b[4 + i]; i += 1; ); vopt[RFB + 12] = vopt[RFB + 13] = 12;
  rflSel = 0; ffpLast = k;
  FFD[k * 2] >= 0 ? ( dpload(FFD[k * 2]); sset(90, FFD[k * 2 + 1]); ) : sset(65, 0);
  snap_notify();
);
// REFLECTOR SETUPS (Reflectors module, free field): typical placements around the listener and the source as they stand now -
// the area, the ground and the positions stay; only the two reflectors are set (inside the area). NRP setups, rpLast = the last one
// THE dmajorsound MARK: a 256 x 173 coverage map (16 levels) taken from the logo file; resampled once per size into lgT
// (area-weighted), so the mark stays sharp and anti-aliased at every scale
