                yy = -11; loop(3, xx = -2.5; loop(3, icC(xx, yy, 0.8, det); xx += 2.5; ); yy += 3.5; ); );
  kind == 3 ? ( icR(-6.5, -24, 13, 24, 3, ink); icR(-5.3, -22.8, 10.6, 21.6, 2.2, det); icR(-2, -21.8, 4, 1.5, 0.7, ink); );
  kind == 4 ? ( icL(-3, -22, -3, -31, 2, ink); icR(-6, -22, 12, 22, 2, ink); icR(1, -25, 3, 3, 1, ink);
                yy = -17; loop(3, icL(-3.5, yy, 3.5, yy, 1, det); yy += 3; ); icR(-3.5, -7, 7, 3, 1, det); );
  kind == 5 ? ( icL(-7, -17, -5, -21, 1.6, ink); icL(-5, -21, 5, -21, 1.6, ink); icL(5, -21, 7, -17, 1.6, ink);
                icR(-11, -17, 22, 17, 3, ink); icC(-4.5, -8.5, 4.5, det); icC(-4.5, -8.5, 1.5, ink);
