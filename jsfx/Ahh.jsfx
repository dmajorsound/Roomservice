  f = min(5, max(0.1, min((VW - 96) / max(1, x1 - x0), (VH - 100) / max(1, y1 - y0))));
  vzox = VX + VW / 2 - cx - ((x0 + x1) / 2 - cx) * f; vzoy = VY + 46 + (VH - 100) / 2 - cy - ((y0 + y1) / 2 - cy) * f; vzf = f;
