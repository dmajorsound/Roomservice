    sprintf(#tpt, "%s: %.0f ms at %.1f BPM – click: the delay plays it now", tnname(k), g_dnote(tnc(k)) * 60000 / gbpm, gbpm); tipbox(tnx, tpy0 + 147, tnw, 15, #tpt);
    k += 1;
