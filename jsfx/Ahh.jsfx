  i == 34 && !pdint ? ( vopt[8] = 0; );      // the predelay set by hand: it no longer follows the room
  vopt[8] >= 0.5 && (i == 2 || i == 3 || i == 4 || i == 31) ? (   // (set here directly: EEL2 functions cannot call themselves)
    pdv = pdroom(); abs(slider34 - pdv) > 0.0000001 ? ( sset(34, pdv); gchg[34] = 1; ); gval[34] = pdv; gheld[34] = 1;
  );
);

tIX[0] = 0; tIY[0] = 0; tIZ[0] = 0;
tIX[1] = 0; tIY[1] = -1; tIZ[1] = 0;     // N (back)
tIX[2] = 1; tIY[2] = 0; tIZ[2] = 0;      // E (right)
tIX[3] = 0; tIY[3] = 1; tIZ[3] = 0;      // S (front)
tIX[4] = -1; tIY[4] = 0; tIZ[4] = 0;     // W (left)
tIX[5] = 0; tIY[5] = 0; tIZ[5] = -1;     // floor
tIX[6] = 0; tIY[6] = 0; tIZ[6] = 1;      // ceiling
// second-order image cells (taps 7-24): all integer offsets (i, j, m) in -2 … 2 with |i| + |j| + |m| = 2 (18 combinations), stored in tIX / tIY / tIZ
k = 7; i = -2;
loop(5, j = -2; loop(5, m = -2; loop(5,
  abs(i) + abs(j) + abs(m) == 2 ? ( tIX[k] = i; tIY[k] = j; tIZ[k] = m; k += 1; );
  m += 1; ); j += 1; ); i += 1; );
