  gfx_setfont(fi); gfx_measurestr(s, tw2, th2);
  k = min(1, min((w - 4) * gs / max(1, tw2), (h - 1) * gs / max(1, th2)));
  k < 0.999 ? gfx_setfont(9, "Arial", fsz(fi) * k, fbd(fi) ? 'b' : 0);
  txt(s, cx, cy, 1);
);
// Returns the width of string s in design units (measured in the current font, divided by gs).
function tws(s) local(tw2, th2) ( gfx_measurestr(s, tw2, th2); tw2 / gs; );
// knob values in ONE size - fitted to the reference "1.50 m" (the widest usual value), so the size does not jump
// from knob to knob or while turning; only a value wider than that gets smaller
function txtboxR(s, cx, cy, w, h, fi) local(tw2, th2, tr, k)
(
  gfx_setfont(fi); gfx_measurestr("1.50 m", tr, th2); gfx_measurestr(s, tw2, th2);
