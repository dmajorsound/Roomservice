fac[4] = 1.559; fac[5] = 1.703; fac[6] = 1.861; fac[7] = 1.997;
// (modph / modrt: the former sine LFOs of the FDN lines - the delay modulation is the random walk (modstep); no longer computed, the slots stay reserved so the memory layout does not move)
modph = apLen + 16; modrt = modph + 8;
fac2[0] = 1.083; fac2[1] = 1.297; fac2[2] = 1.533; fac2[3] = 1.811;           // other ratios than net 1: no shared modes
moddep = 0.00015 * srate;   // 0.15 ms; +-12 samples at 48 kHz (0.25 ms, at most 2 cents on the fastest line) - measured: the fixed comb
                                          // structure of the tail (the same peaks at 25 / 50 / 75 % of RT60) falls from r = 0.4 to about 0.1 in large rooms

wi = 0; fwi = 0; api = 0; fwn = 0; cMuD = cMuE = cMuL = tMuD = tMuE = tMuL = 1; mrlast = -1;   // fwn = samples written to the reverb lines (not wrapped)
