// one line: length L samples, decay rt (mid), ratios fqR[1..7] (125 Hz ... 8 kHz) -> its 6 filters + gain.
// Attenuation per pass is held at -35 dB at most (a band that loses more is gone after one pass anyway; the fit stays exact)
function fqdesign(k, L) local(t, x, e, cb, i, j, it, mxr, f)
(
  t = fqW + 64; x = fqW + 72; e = fqW + 80; cb = fqCt + k * 30;   // (fqCt / fqGt: the block designed into - the main lines, or the rear network of RoomservicePro)
  i = 0; loop(7, t[i] = max(-35, -60 * L / (max(0.05, rt * fqR[i + 1]) * srate)); i += 1; );
  i = 0; loop(7, x[i] = 0; j = 0; loop(7, x[i] += fqBi[i * 7 + j] * t[j]; j += 1; ); i += 1; );
