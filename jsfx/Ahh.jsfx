  ffnR = ffnB = 0; !basic && vopt[19] >= 0.5 ? ( ffnR = VX + 8 + 172; ffnB = VY + 78; );   // ffnR: right end of the notes in the top left corner (info window, loudness notes)
  !learn ? lhsign(); lhvis = !learn && lhvis; elsign();
  ganupd(); mtHv = 0; apHv = 0; ffHv = 0; mtEg > 0.001 ? ( mtSon ? mtpath(1); mtLon ? mtpath(2); !basic && !learn ? mtsign(); );   // the motion path and its sign
  mtE <= 0.001 && slider100 < 0.5 && !basic && !learn && (tabm ? tabsel == 14 : secopen(14)) ? ( floor(slider101 + 0.5) != 1 ? mtghost(1); floor(slider101 + 0.5) != 0 ? mtghost(2); );   // ghost path
  !basic && !learn && floor(slider107 + 0.5) == 1 && (floor(slider102 + 0.5) == 0 || floor(slider102 + 0.5) == 5) && (tabm ? tabsel == 14 : secopen(14)) ? apmark();
  ffmark();
  rflmark();
  // the title pill sits in the top left corner of the view (14 px from the left edge, under the view's chip row); a note
