    head ? ( op ? chevd(ax, ay, vlock ? cDIM2 : cMUTED) : chevr(ax, ay, vlock ? cDIM2 : cMUTED); );   // open: chevron down, folded: right
    sechead(id, s, x + 19, ay, c);
    gfx_setfont(2); hw = 30 + tws(s);
