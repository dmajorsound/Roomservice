    ok = 1; t0 = 0; t1 = 1; dx = x2 - x1; dy = y2 - y1;
    gclp ? ( k = 0;
      loop(4,
        p = k == 0 ? -dx : (k == 1 ? dx : (k == 2 ? -dy : dy)); q = k == 0 ? x1 - clX0 : (k == 1 ? clX1 - x1 : (k == 2 ? y1 - clY0 : clY1 - y1));
        abs(p) < 0.000001 ? ( q < 0 ? ok = 0; ) : ( r = q / p; p < 0 ? ( r > t1 ? ok = 0 : ( r > t0 ? t0 = r; ); ) : ( r < t0 ? ok = 0 : ( r < t1 ? t1 = r; ); ); );
        k += 1; ); );
    ok && t1 >= t0 ? (
      px1 = gox + (x1 + t0 * dx) * gs; py1 = goy + (y1 + t0 * dy) * gs; px2 = gox + (x1 + t1 * dx) * gs; py2 = goy + (y1 + t1 * dy) * gs;
      len = sqrt(sqr(px2 - px1) + sqr(py2 - py1));
      len > 0.01 ? (
        ux = (px2 - px1) / len; uy = (py2 - py1) / len; hw = max(0.25, (w - 1) / 2); ex = -uy; ey = ux;
        gfx_triangle(px1 + ex * hw, py1 + ey * hw, px2 + ex * hw, py2 + ey * hw, px2 - ex * hw, py2 - ey * hw, px1 - ex * hw, py1 - ey * hw);
        gfx_a = a * 0.9;
        gfx_line(px1 + ex * (hw + 0.5), py1 + ey * (hw + 0.5), px2 + ex * (hw + 0.5), py2 + ey * (hw + 0.5), 1);
        gfx_line(px1 - ex * (hw + 0.5), py1 - ey * (hw + 0.5), px2 - ex * (hw + 0.5), py2 - ey * (hw + 0.5), 1);
