             LNW(x + 4, y + 7, x + 4, y + 10, 0.9); LNW(x + 12, y + 7, x + 12, y + 10, 0.9); )   // religious: a vaulted hall (no symbol of one faith)
  ))))));
);
// ---- BASIC: a row of film locations as small tiles - icon, name, reverb time; click = load the room
// lower tiles (28 instead of 34), Outdoors first
function basictiles() local(n, i, k, x, w, b, hit, on, ty, th, j)
(
  n = 9; w = (WT - 16 - (n - 1) * 6) / n; ty = 64; th = 28;
  i = 0;
  loop(n,
    x = 8 + i * (w + 6); hit = inbox(x, ty, w, th);
    i == 0 ? ( on = isfree;
      col(cSURF, 1); RR(x, ty, w, th, 6);
      on ? ( col(cRMTT, 1); RRO(x, ty, w, th, 6); RRO(x + 0.6, ty + 0.6, w - 1.2, th - 1.2, 5.6); ) : ( hit ? ( col(cBORD, 1); RRO(x, ty, w, th, 6); ); );
      col(on ? cRMTT : cMUTED, 1); LNW(x + 6, ty + 21, x + 22, ty + 21, 1); LNW(x + 8, ty + 21, x + 12, ty + 13, 1); LNW(x + 12, ty + 13, x + 16, ty + 21, 1); LNW(x + 13, ty + 21, x + 18, ty + 15, 1); LNW(x + 18, ty + 15, x + 22, ty + 21, 1); CIF(x + 19, ty + 9, 2, 0);
      col(cTEXT, 1); gfx_setfont(6); txtfit("Outdoors", x + 27, ty + 9, w - 29); col(cMUTED, 1); gfx_setfont(7); txt("no room", x + 27, ty + 20, 0);
      click && hit ? ( modeset(1); snlast = 0; click = 0; );
      hit ? ( tipon = 1; tipx = x + w / 2; tipy = ty + th + 12; tipstr = "Outdoors (free field): no walls, no reverb – source and listener still set distance, direction and panning. Click a room tile to go back inside"; );
    ) : (
    j = i - 1; k = bastile(j); b = PT + k * PRS; on = !isfree && roommatch(k);
    col(cSURF, 1); RR(x, ty, w, th, 6);
    on ? ( col(cRMTT, 1); RRO(x, ty, w, th, 6); RRO(x + 0.6, ty + 0.6, w - 1.2, th - 1.2, 5.6); ) : ( hit ? ( col(cBORD, 1); RRO(x, ty, w, th, 6); ); );
    col(on ? cRMTT : cMUTED, 1); tileicon(j == 3 ? 3 : (j == 4 ? 4 : j), x + 6, ty + 7);
    col(cTEXT, 1); gfx_setfont(6); txtfit(bastname(j), x + 27, ty + 9, w - 29);
    sprintf(#w1, "%.2f s", presetrt(k)); col(cMUTED, 1); gfx_setfont(7); txt(#w1, x + 27, ty + 20, 0);
    click && hit ? ( loadroom(k); snlast = 0; click = 0; );
    hit ? ( tipon = 1; tipx = x + w / 2; tipy = ty + th + 12; sprintf(#rtip, "%s (preset “%s”) – %.1f × %.1f × %.1f m, reverb time %.2f s. Click: load this room – more rooms in the Room preset menu", bastname(j), roomname(k), b[0] * b[14], b[1] * b[14], b[2] * b[14], presetrt(k)); tipstr = #rtip; );
    );
    i += 1;
  );
);
// ---------- MY ROOMS ----------
// the room values of a user room (what a factory room sets, plus decay, reflectivity, source aim, room + barrier mix)
function urparam(i) ( i < 17 ? i + 1 : (i == 17 ? 19 : (i == 18 ? 20 : (i == 19 ? 21 : (i < 24 ? i + 11 : (i == 24 ? 36 : (i == 25 ? 38 : (i < 32 ? i + 15 : (i == 32 ? 61 : (i == 33 ? 62 : (i == 34 ? 63 : (i == 35 ? 91 : (i == 36 ? 92 : (i == 37 ? 95 : (i == 38 ? 96 : 97)))))))))))))); );
// Returns the number of used slots in the user room library (urb, URM slots of URL values)
function urcount() local(u, n) ( n = 0; u = 0; loop(URM, urb[u * URL] ? n += 1; u += 1; ); n; );
// Returns the category name for user room category c (room category name if c<6, else "Other")
function urcatname(c) ( c < 6 ? roomcatname(c) : "Other"; );
// text buffers (UTF-8 bytes): append a character / remove the last one; they return the new length
function bufadd(tb, tln, tmx, c) local(n)
(
  n = c < 128 ? 1 : (c < 2048 ? 2 : (c < 65536 ? 3 : 4));
  c >= 32 && tln + n <= tmx - 1 ? (
    n == 1 ? ( tb[tln] = c; ) : (
    n == 2 ? ( tb[tln] = 192 | (c >> 6); tb[tln + 1] = 128 | (c & 63); ) : (
    n == 3 ? ( tb[tln] = 224 | (c >> 12); tb[tln + 1] = 128 | ((c >> 6) & 63); tb[tln + 2] = 128 | (c & 63); ) : (
      tb[tln] = 240 | (c >> 18); tb[tln + 1] = 128 | ((c >> 12) & 63); tb[tln + 2] = 128 | ((c >> 6) & 63); tb[tln + 3] = 128 | (c & 63); )));
    tln += n; tb[tln] = 0;
  );
  tln;
);
// Removes the last UTF-8 character from byte buffer tb of length tln (zeroing its bytes); returns the new length
function bufback(tb, tln) local(c) ( c = 128; while ( tln > 0 && (c & 192) == 128 ? ( tln -= 1; c = tb[tln]; tb[tln] = 0; 1; ) : 0; ); tln; );
// Returns byte c lower-cased if it is an ASCII letter A-Z, otherwise unchanged
function lcb(c) ( c >= 65 && c <= 90 ? c + 32 : c; );
// search: the query (bytes) inside a name (bytes, 0 = end), letters A-Z without case
function bmatch(sb, qb, qn) local(i, j, ok, hit, sn)
(
  qn <= 0 ? 1 : (
    sn = 0; while ( sn < 63 && sb[sn] > 0 ? ( sn += 1; 1; ) : 0; );
    hit = 0; i = 0;
    loop(max(0, sn - qn + 1), !hit ? ( ok = 1; j = 0; loop(qn, ok && lcb(sb[i + j]) != lcb(qb[j]) ? ok = 0; j += 1; ); ok ? hit = 1; ); i += 1; );
    hit;
  );
);
// Copies string st (max 63 chars) into byte buffer b as characters, zero-terminated; returns b
function strtob(st, b) local(i, n) ( n = min(63, strlen(st)); i = 0; loop(n, b[i] = str_getchar(st, i, 'cu'); i += 1; ); b[n] = 0; b; );
// Returns the index of the user library room whose 24-byte name equals nb, or -1 if none
function urfind(nb) local(u, f, i, eq) ( f = -1; u = 0; loop(URM, urb[u * URL] && f < 0 ? ( eq = 1; i = 0; loop(24, urb[u * URL + 2 + i] != nb[i] ? eq = 0; i += 1; ); eq ? f = u; ); u += 1; ); f; );
// store the current room under the name in rsnb (same name = replaced); 0 = library full
function ursave() local(u, i, b)
(
  u = urfind(rsnb); u < 0 ? ( u = 0; while ( u < URM && urb[u * URL] ? ( u += 1; 1; ) : 0; ); );
  u < URM ? (
    b = urb + u * URL; b[0] = 1; b[1] = rscat; i = 0; loop(24, b[2 + i] = rsnb[i]; i += 1; );
    i = 0; loop(URP, b[26 + i] = slider(urparam(i)); i += 1; );
    1;
  ) : 0;
);
function urover(u) local(b, i) ( b = urb + u * URL; i = 0; loop(URP, b[26 + i] = slider(urparam(i)); i += 1; ); );   // same name and category, the current room
// Deletes user library slot u by shifting later slots down and clearing the last one
function urdel(u) local(v) ( v = u; loop(URM - 1 - u, memcpy(urb + v * URL, urb + (v + 1) * URL, URL); v += 1; ); memset(urb + (URM - 1) * URL, 0, URL); );
// load: like a factory room - "Keep when loading" keeps source + listener and / or the barrier (moved inside the new room)
function urload(u) local(b, i, sp, kp, kb, hz)
(
  b = urb + u * URL; kp = vopt[16] >= 0.5; kb = vopt[17] >= 0.5;
  snap_take();
  i = 0;
  loop(URP,
    sp = urparam(i);
    // "Keep when loading": skip the source / listener sliders (10-17, 61, 63) and the barrier sliders (41-46, 92, 95+); a stored 0 in slider 97 loads as its default 100
    !((kp && ((sp >= 10 && sp <= 17) || sp == 61 || sp == 63)) || (kb && ((sp >= 41 && sp <= 46) || sp == 92 || sp >= 95))) ? sset(sp, sp == 97 && b[26 + i] < 1 ? 100 : b[26 + i]);
    i += 1;
  );
  kp ? (
    hz = slider4 * slider31 - 0.1;
    slider10 = min(max(slider10, 0.1), slider2 - 0.1); slider11 = min(max(slider11, 0.1), slider3 - 0.1); slider12 = min(max(slider12, 0.1), hz);
    slider13 = min(max(slider13, 0.1), slider2 - 0.1); slider14 = min(max(slider14, 0.1), slider3 - 0.1); slider15 = min(max(slider15, 0.1), hz);
  );
  kb ? ( slider42 = min(max(slider42, 0.3), slider3 - 0.3); slider45 = min(max(slider45, 0), slider2); );
  selw = 0; snap_notify();
);
// the current settings are this user room (its room values)
function urmatch(u) local(b, i, ok) ( b = urb + u * URL; ok = b[0] > 0; i = 0; while ( ok && i < URP ? ( i != 32 && i != 34 && abs(slider(urparam(i)) - (i == 39 && b[26 + i] < 1 ? 100 : b[26 + i])) > 0.001 ? ok = 0; i += 1; 1; ) : 0; ); ok; );
// GONIOMETER: the output as a cloud of points, left against right - L up-left, R up-right, so mono = a vertical
// line, out of phase = a horizontal line, a wide mix = a round cloud. Automatic gain: the loudest point fills the circle
function gondraw(gx, gy, gr) local(k, l, r2, xx, yy, pk, sc, d)
(
  col(cBG, 1); RR(gx - gr - 4, gy - gr - 4, 2 * gr + 8, 2 * gr + 8, 5);
  col(cHAIR, 1); CI(gx, gy, gr, 0); d = gr * 0.7071;
  LNW(gx - d, gy - d, gx + d, gy + d, 1); LNW(gx + d, gy - d, gx - d, gy + d, 1);
  col(cMUTED, 1); gfx_setfont(7); txt("L", gx - d - 6, gy - d - 5, 1); txt("R", gx + d + 6, gy - d - 5, 1);
  !aidle ? (
    pk = 0.001; k = 0; loop(GONN, pk = max(pk, abs(gonB[2 * k]) + abs(gonB[2 * k + 1])); k += 1; );
    gonPk = pk > gonPk ? pk : gonPk * 0.97 + pk * 0.03;
    sc = gr * 0.95 * 1.4142 / gonPk; d = max(1, floor(1.3 * gs + 0.5));
    col(cIOTT, 0.5); k = 0;
    loop(GONN,
      l = gonB[2 * k]; r2 = gonB[2 * k + 1];
      xx = gox + (gx + (r2 - l) * 0.7071 * sc) * gs; yy = goy + (gy - (l + r2) * 0.7071 * sc) * gs;
      gfx_rect(floor(xx), floor(yy), d, d);
      k += 1;
    );
  );
  tipbox(gx - gr, gy - gr, 2 * gr, 2 * gr, "Goniometer: the output, left against right – a vertical line = mono, a horizontal line = out of phase, a round cloud = wide. Automatic gain: the loudest moment fills the circle");
);
// RoomservicePro: the 5.1 VECTORSCOPE - a ring with the five loudspeaker directions of the chosen layout; per loudspeaker a
// radial bar from the ring inward (its level, -60 ... 0 dB), in the middle the energy vector of the five channels (where the
// sound sits), with a short fading trail; the LFE as a small bar at the right. Levels: the peak meters of the five channels.
function vsdraw(gx, gy, gr) local(k, az, a, e, et, vsx, vsy, lv, vbl, xx, yy, d, i)
(
  col(cBG, 1); RR(gx - gr - 4, gy - gr - 4, 2 * gr + 8, 2 * gr + 8, 5);
  col(cHAIR, 1); CI(gx, gy, gr, 0); CI(gx, gy, gr * 0.5, 0);
  et = 0; vsx = 0; vsy = 0;
  k = 0;
  loop(5,
    az = slider137 < 0.5 ? (k == 0 ? -slider138 : (k == 1 ? slider138 : (k == 2 ? 0 : (k == 3 ? -slider139 : slider139))))
                         : (k == 0 ? -25 : (k == 1 ? 25 : (k == 2 ? 0 : (k == 3 ? -100 : 100))));
    a = az * $pi / 180;
    lv = k == 0 ? mOL : (k == 1 ? mOR : (k == 2 ? mOC : (k == 3 ? mOLs : mORs)));
    e = lv * lv; et += e; vsx += e * sin(a); vsy += e * cos(a);
    // two bars per loudspeaker, side by side: the source's direct sound (green) and the reflections + reverb (blue)
    vsdl = aidle ? 0 : gr * 0.45 * lin2f(dbs(qVD[k == 0 ? 0 : (k == 1 ? 1 : (k == 2 ? 2 : (k == 3 ? 3 : 4)))]), -60, 0);
    vsrl = aidle ? 0 : gr * 0.45 * lin2f(dbs(qVR[k]), -60, 0);
    col(cSRC, 1); vsdl > 0.5 ? LNW(gx + sin(a) * gr - cos(a) * 1.8, gy - cos(a) * gr - sin(a) * 1.8, gx + sin(a) * (gr - vsdl) - cos(a) * 1.8, gy - cos(a) * (gr - vsdl) - sin(a) * 1.8, 2.4);
    col(cACTO, 1); vsrl > 0.5 ? LNW(gx + sin(a) * gr + cos(a) * 1.8, gy - cos(a) * gr + sin(a) * 1.8, gx + sin(a) * (gr - vsrl) + cos(a) * 1.8, gy - cos(a) * (gr - vsrl) + sin(a) * 1.8, 2.4);
    col(cMUTED, 1); CIF(gx + sin(a) * gr, gy - cos(a) * gr, 2.2, 1);
    gfx_setfont(7); txt(k == 0 ? "L" : (k == 1 ? "R" : (k == 2 ? "C" : (k == 3 ? "Ls" : "Rs"))), gx + sin(a) * (gr + 9), gy - cos(a) * (gr + 9), 1);
    k += 1;
  );
  et > 0.000001 ? ( vsx /= et; vsy /= et; ) : ( vsx = 0; vsy = 0; );
  !aidle ? ( vsB[2 * vsP] = vsx; vsB[2 * vsP + 1] = vsy; vsP = (vsP + 1) % VSN; );
  i = 0;
  loop(VSN,
    k = (vsP + i) % VSN; xx = gx + vsB[2 * k] * gr; yy = gy - vsB[2 * k + 1] * gr;
    col(cIOTT, 0.08 + 0.6 * i / VSN); CIF(xx, yy, 1.5 + 2.5 * i / VSN, 1);
    i += 1;
  );
  // the LFE: a small bar right of the ring
  lv = lin2f(dbs(mOLf), -60, 0); d = gr * 1.2;
  col(cHAIR, 1); RR(gx + gr + 14, gy - d / 2, 5, d, 2.5);
  lv > 0.01 ? ( col(cIOTT, 1); RR(gx + gr + 14, gy + d / 2 - d * lv, 5, d * lv, 2.5); );
  col(cMUTED, 1); gfx_setfont(7); txt("LFE", gx + gr + 16.5, gy + d / 2 + 8, 1);
  tipbox(gx - gr - 4, gy - gr - 4, 2 * gr + 30, 2 * gr + 8, "5.1 vectorscope: the ring carries the five loudspeakers, the bars from the ring inward are their levels – green = the direct sound of the source, blue = reflections and reverb; the dot is where the energy of the five channels sits (with a short trail). Right: the LFE level");
);
// LEVEL BARS: one smooth bar in three zones (green up to -12 dB, amber up to -3 dB, red above) on a soft track
function mzc(z) ( z == 0 ? (darkmode ? 0x4CC38A : 0x2E9E6A) : (z == 1 ? cWARN : 0xE5484D); );
// Draws a vertical level bar at (x,y,w,h) for linear level lv (-60..0 dB scale), colored green/amber/red above 80% and 95%
function mbarV(x, y, w, h, lv) local(f, a, b)
(
  col(cHAIR, 1); RR(x, y, w, h, 2);
  f = lin2f(lv, -60, 0);
  f > 0.005 ? (
    a = min(f, 0.8); col(mzc(0), 1); R(x, y + h * (1 - a), w, h * a);
    f > 0.8 ? ( b = min(f, 0.95); col(mzc(1), 1); R(x, y + h * (1 - b), w, h * (b - 0.8)); );
    f > 0.95 ? ( col(mzc(2), 1); R(x, y + h * (1 - f), w, h * (f - 0.95)); );
  );
);
// Draws a horizontal rounded level bar at (x,y,w,h) for linear level lv (-60..0 dB scale), colored green/amber/red above 80% and 95%
function mbarH(x, y, w, h, lv) local(f, a, b)
(
  col(cHAIR, 1); RR(x, y, w, h, h / 2);
  f = lin2f(lv, -60, 0);
  f > 0.02 ? (
    a = min(f, 0.8); col(mzc(0), 1); RR(x, y, max(h, w * a), h, h / 2);
    f > 0.8 ? ( b = min(f, 0.95); col(mzc(1), 1); R(x + w * 0.8, y, w * (b - 0.8), h); );
    f > 0.95 ? ( col(mzc(2), 1); R(x + w * 0.95, y, w * (f - 0.95), h); );
  );
);
// Draws the OUTPUT section: meters with peak hold, spectrum, correlation, gain faders, limiter and detail/equal-loudness buttons
function drawio()
(
// ---------- OUTPUT: input / output meters + limiter gain reduction, IN / OUT gain, MIX, limiter, equal loudness ----------
card(IOX, IOY, IOW, IOH);
sechdr(7, "Output", IOX, IOY, cIOTT);
secopen(7) ? (
  tnow = time_precise();
  // audio not running (REAPER stopped and does not process the FX): the meters show silence instead of the last values
  aidle = tnow - lastblk > 0.3;
  aidle ? ( mIL = mIR = mOL = mOR = 0; mGV = 1; mOC = mOLf = mOLs = mORs = 0; mJC = mJF = mJS = mJT = 0; ) : ( mJC = pkJC; mJF = pkJF; mJS = pkJS; mJT = pkJT; mIL = pkIL; mIR = pkIR; mOL = pkOL; mOR = pkOR; mGV = lmgv; mOC = qPK[2]; mOLs = qPK[3]; mORs = qPK[4]; mOLf = qPK[5]; );   // (RoomservicePro: C, Ls, Rs, LFE)
// PEAK HOLD as in a DAW: every channel keeps its highest peak for 3 s, then falls at 20 dB/s (the numbers can be
  // read); a click on the numbers resets them
  hdt = min(0.2, max(0, tnow - hTl)); hTl = tnow;
  v = dbs(mIL); v >= hIL ? ( hIL = v; tIL = tnow; ) : ( tnow - tIL > 3 ? hIL = max(v, hIL - 20 * hdt); );
  v = dbs(mIR); v >= hIR ? ( hIR = v; tIR = tnow; ) : ( tnow - tIR > 3 ? hIR = max(v, hIR - 20 * hdt); );
  v = dbs(mOL); v >= hOL ? ( hOL = v; tOL = tnow; ) : ( tnow - tOL > 3 ? hOL = max(v, hOL - 20 * hdt); );
  v = dbs(mOR); v >= hOR ? ( hOR = v; tOR = tnow; ) : ( tnow - tOR > 3 ? hOR = max(v, hOR - 20 * hdt); );
  v = inN() == 6 ? dbs(max(max(mJC, mJF), max(mJS, mJT))) : -150; v >= hI6 ? ( hI6 = v; tI6 = tnow; ) : ( tnow - tI6 > 3 ? hI6 = max(v, hI6 - 20 * hdt); );   // a 5.1 input: the held peak of its other four channels
  hIn = max(max(hIL, hIR), hI6); hOut = max(hOL, hOR);
  slider136 >= 0.5 ? ( v = max(max(dbs(mOC), dbs(mOLf)), max(dbs(mOLs), dbs(mORs))); v >= hO5 ? ( hO5 = v; tO5 = tnow; ) : ( tnow - tO5 > 3 ? hO5 = max(v, hO5 - 20 * hdt); ); hOut = max(hOut, hO5); );
  limact = clipon && gwarn > 0 && !aidle;
  // icon buttons in the header (Expert only)
// three icon buttons of one size (28 x 16) at the right end of the header - Detail, Equal loudness, Limiter
  chx = IOX + IOW - 4 * 32 - 2; chy = IOY + 4;   // four buttons - Detail, Equal loudness, Limiter, Input Guard
  lmcol = limact && (floor(time_precise() * 8) & 1) == 0 ? cWARN : cIOTT;   // blinks in the warning yellow
  eqlon = slider60 >= 0.5;
  !basic ? (
// DETAIL: High = interaural time difference and head shadow for the direct sound and the reflections of first AND
    // second order; Normal counts the first order only (about 17 % less CPU); Stereo-safe pans by level only, no phase shift
    dtm = floor(vopt[49] + 0.5);
    ibtn(chx, chy, 28, 16, dtm != 1, cIOTT) ? ( vopt[49] = (dtm + 1) % 3; ); ic_detail(chx + 14, chy + 8, dtm == 0 ? 1 : (dtm == 1 ? 0 : 2));
    itip(chx, chy, 28, 16, dtm == 0 ? "Detail: High – ear timing and head shadow for the direct sound and the reflections of first and second order (the most real, but left and right differ in time). Click: Normal" : (dtm == 1 ? "Detail: Normal – ear timing and head shadow for the direct sound and the first reflections only (about 17 % less CPU). Click: Stereo-safe" : "Detail: Stereo-safe – positions by level only: no ear timing, no head shadow, left and right stay in phase (mono compatible). Click: High"),
         dtm == 0 ? "Detail: High – ear timing for direct + 1st and 2nd reflections" : (dtm == 1 ? "Detail: Normal – 1st reflections only, less CPU" : "Detail: Stereo-safe – level panning only, no phase shift"));
    ibtn(chx + 32, chy, 28, 16, eqlon, cIOTT) ? ( slider60 = eqlon ? 0 : 1; sauto1(60); ); ic_eql(chx + 46, chy + 8);
    itip(chx + 32, chy, 28, 16, eqlon ? "Equal loudness on: every room, distance, barrier and source model plays about as loud as the input – for comparing sounds (the level no longer tells the distance). Click: off" : "Equal loudness: every room, distance, barrier and source model plays about as loud as the input – for comparing sounds (the level no longer tells the distance)",
         eqlon ? "Equal loudness: on – everything as loud as the input" : "Equal loudness: off – the level tells the distance");
    ibtn(chx + 64, chy, 28, 16, clipon, lmcol) ? ( slider23 = clipon ? 0 : 1; autom(4194304); ); ic_lim(chx + 78, chy + 8);
    itip(chx + 64, chy, 28, 16, clipon ? "Limiter on: look-ahead peak limiter, every peak stays below -1 dBFS (1.5 ms latency, REAPER compensates it) – blinks while it works. Click: off" : "Limiter off – click: on (every peak stays below -1 dBFS)",
         clipon ? "Limiter: on – peaks stay below -1 dBFS" : "Limiter: off");
// INPUT GUARD: a soft limiter right after the Input gain - protects the reverb from hot inputs (off = the input stays exactly as it is)
    grdon = vopt[68] >= 0.5;
    ibtn(chx + 96, chy, 28, 16, grdon, cIOTT) ? ( vopt[68] = grdon ? 0 : 1; ); ic_grd(chx + 110, chy + 8);
    itip(chx + 96, chy, 28, 16, grdon ? "Input Guard on: a soft limiter right after the Input gain – up to -1 dBFS nothing changes, above that peaks bend smoothly and never pass 0 dBFS. Protects the room from a hot input. Click: off" : "Input Guard off – the input stays exactly as it is. Click: on (a soft limiter after the Input gain, from -1 dBFS)",
         grdon ? "Input Guard: on – soft limit after the input gain" : "Input Guard: off");
  );
  tabm || basic ? (
    // TABS: input meters (L R) left, spectrum in the middle, output meters right - same height; under them the faders
    // Input | Dry / wet | Output; bottom row: correlation and the limiter's gain reduction
// BASIC: the same look, compact - spectrum | output meters, faders Dry / wet | Output
    q51 = !basic && slider136 >= 0.5;   // RoomservicePro: the 5.1 output - six meters, the vectorscope, the LFE / Center controls
    om51 = slider136 >= 0.5;   // 5.1: six output meters in every view (Basic too); the 5.1 controls only in Expert (q51)
    in6 = inN() == 6; mon1 = inN() == 1; omw = in6 ? 128 : 64; omw2 = om51 ? 128 : 64; omy = IOY + (basic ? 44 : 54); omh = IOH - (basic ? 44 + 46 : 54 + 80); omx1 = IOX + 14; omx2 = IOX + IOW - 14 - omw2; basic && om51 ? ( omh -= 10; );   // (Basic, 5.1: the six channel names stay clear of the Output fader's text)   // 8 px more under the meters - L / R sat on the fader names
    gj = basic ? 1 : 0;
    loop(basic ? 1 : 2,
      omx = gj == 0 ? omx1 : omx2; omwj = gj == 0 ? omw : omw2; om6 = om51 && gj == 1; io6 = om6 || (in6 && gj == 0);   // io6: six bars in this group (5.1 output, or a 5.1 input)
      !basic ? ( col(cMUTED, 1); gfx_setfont(4); txt(gj == 0 ? (in6 ? "Input 5.1" : (mon1 ? "Input mono" : "Input")) : (om6 ? "Output 5.1" : "Output"), omx + omwj / 2, IOY + 30, 1); );
