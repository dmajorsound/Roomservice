    // 8 delay lines: base length = 1.2 mean free paths (20 - 110 ms) x the spread factors fac[], rounded to an odd sample count; 4 allpass lengths scaled with the room (ds 0.5 ... 2.5)
    base = min(0.11, max(0.02, 1.2 * mfp / C_SND));
    k = 0;
    loop(8, flen[k] = min(LINEMAX - 2, floor(base * fac[k] * srate) | 1); k += 1; );
    k = 0; loop(8, flenB[k] = min(LINEMAXB - 2, floor(base * facB[k] * srate) | 1); k += 1; );   // (RoomservicePro: the rear lines)
    ds = min(2.5, max(0.5, mfp / 3.5));
    apLen[0] = floor(0.0047 * ds * srate); apLen[1] = floor(0.0036 * ds * srate);
    apLen[2] = floor(0.0127 * ds * srate); apLen[3] = floor(0.0093 * ds * srate);
    last_mfp = mfp;
