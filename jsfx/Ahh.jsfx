  rsclash ? ( col(cIOTT, 1); gfx_setfont(7); txt("another room has this name", rsfx + rsfw, rsny - 8, 2); );
  col(cBG, 1); RR(rsfx, rsny, rsfw, 24, 4); col(cRMTT, 1); RRO(rsfx, rsny, rsfw, 24, 4);
  sn_strn(rsnb, 24, #rsn); gfx_setfont(2); col(cTEXT, 1); txt(#rsn, rsfx + 7, rsny + 12, 0);
  (floor((time_precise() - rst0) * 2) & 1) == 0 ? ( rsc = rsfx + 8 + tws(#rsn); LNW(rsc, rsny + 6, rsc, rsny + 18, 1.2); );
  col(cTEXT, 1); gfx_setfont(6); txt("Category", rsfx, rscy - 8, 0);
  k = 0;
  loop(7,
    rcx0 = rsfx + (k % 4) * (rsfw + 4) / 4; rcy0 = rscy + floor(k / 4) * 20;
    chip(rcx0, rcy0, (rsfw + 4) / 4 - 4, 16, urcatname(k), rscat == k, cRMTT);
    k += 1;
  );
  col(cMUTED, 1); gfx_setfont(7);
