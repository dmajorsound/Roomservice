    head && !szoom && !vlock && click && inbox(x + 2, y + 2, hw, 20) ? (
      (mouse_cap & 16) ? foldall() : ( vopt[vi] = vopt[vi] - (vopt[vi] & colm) + (anyo ? colm : 0); );
      shpin ? ( shpin = 0; );
    );
    // zoom (Source, Walls, Echogram in Expert): magnifier after the "?" - the section alone, larger; again (or Esc) = back
    !tabm && (!basic || id == 1 || id == 3 || id == 5 || id == 7) ? (
      zx = x + 28 + tws(s) + 24; zhit = sqr(mx - zx) + sqr(my - ay) < 49;
      !learn && !szoom ? ( MZR[id * 4] = gox + crdX * gs; MZR[id * 4 + 1] = goy + crdY * gs; MZR[id * 4 + 2] = crdW * gs; MZR[id * 4 + 3] = crdH * gs; MZR[80 + id] = mzfr; );   // the module's place on screen - key Z zooms the one under the mouse (All / Fit)
      col(szoom == id ? c : (zhit ? cTEXT : cMUTED), 1);   // smooth strokes
      SDB0(); SDARC(zx - 1, ay - 1, 3.5, 0, 2 * $pi); SDSEG(zx + 1.6, ay + 1.6, zx + 4.3, ay + 4.3); SDSEG(zx - 2.6, ay - 1, zx + 0.6, ay - 1); szoom != id ? SDSEG(zx - 1, ay - 2.6, zx - 1, ay + 0.6); SDDRAW(1.05);
      click && zhit ? ( szoom = szoom == id ? 0 : id; basic ? ( vopt[13] & m ? ( vopt[13] -= m; ); ) : ( vopt[12] & m ? ( vopt[12] -= m; ); ); click = 0; );
      zhit ? ( tipon = 1; tipforce = 0; tipstr = szoom == id ? "Back to all sections (Esc or key Z)" : "Zoom: this section alone, larger (key Z with the mouse over it)"; tipx = zx; tipy = ay + 16; );
    );
// reset this module (after the magnifier, or where it would be)
    (id == 1 || id == 3 || id == 4 || id == 5 || id == 6 || id == 7 || id == 10 || id == 14 || id == 15) && !(basic && id != 1 && id != 3 && id != 5 && id != 7) ? (
      gfx_setfont(2); rsix = x + 28 + tws(s) + ((!tabm && (!basic || id == 1 || id == 3 || id == 5 || id == 7)) ? 40 : 24); rsih = sqr(mx - rsix) + sqr(my - ay) < 42;
      col(rsih ? c : cMUTED, 1); ic_reset(rsix, ay);
      click && rsih ? ( modulereset(id); click = 0; );
      rsih ? ( tipon = 1; tipforce = 0; tipstr = "Reset: this module back to its defaults (on / off stays) – Ctrl/Cmd+Z undoes it"; tipx = rsix; tipy = ay + 16; );
    );
    // the small In / Out meter: registered here, left of the module's power button; hmix moves it (not in Output - it has the big meters - and not in Learn)
    mmCur = -1;
    id != 7 && basic && crdW >= hw + 140 && mmN < MMCAP && goy + ay * gs > 30 * gT ? (
      mmB[mmN * 5] = basic ? crdX + crdW - 40 : -1; mmB[mmN * 5 + 1] = ay; mmB[mmN * 5 + 2] = gs; mmB[mmN * 5 + 3] = gox; mmB[mmN * 5 + 4] = goy; mmCur = mmN; mmN += 1;   // (Basic only: in Tabs the open tab carries the meter, in All the headers are full)
    );
    head ? tipbox(x + 2, y + 2, hw - 14, 20, vlock ? "GUI locked – unlock it with Lock GUI at the right of the signal-flow strip" : basic ? (op ? "Click: fold the four sections (Alt+click: fold everything)" : "Click: open the four sections (Alt+click: open everything)")
                                                    : (op ? "Click: fold this section (Alt+click: fold everything)" : "Click: open this section (Alt+click: open everything)"));
  );
);
// ---- SIGNAL-FLOW STRIP: items 0 IN, 1 FILTER, 2 SOURCE, 3 DELAY, 4 ROOM, 5 BARRIER, 6 OUT ----
function mtname(p) ( p == 0 ? "Circle" : (p == 1 ? "Left - right" : (p == 2 ? "Front - back" : (p == 3 ? "Up - down" : (p == 4 ? "Pass-by" : (p == 5 ? "Square" : (p == 6 ? "Wave" : "Drawn")))))); );
// Returns the tempo-sync label for index q: 1..8 maps to "8 bars", "4 bars" ... "1 bar", "1/2" ... "1/16"
function mttempo(q) ( q == 1 ? "8 bars" : (q == 2 ? "4 bars" : (q == 3 ? "2 bars" : (q == 4 ? "1 bar" : (q == 5 ? "1/2" : (q == 6 ? "1/4" : (q == 7 ? "1/8" : "1/16")))))); );
// Builds the Motion status text into #sts: "off", or path name plus tempo-sync division or rate in Hz
function mtstat() local(q) (
  slider100 < 0.5 ? strcpy(#sts, "off") : (
    q = floor(slider108 + 0.5);
    q > 0 ? sprintf(#sts, "%s · %s", mtname(floor(slider102 + 0.5)), mttempo(q)) : sprintf(#sts, "%s · %.2f Hz", mtname(floor(slider102 + 0.5)), slider103); );
);
// Returns the signal-flow strip item name for index q (0 IN, 1 FILTER, 2 SOURCE, 3 DELAY, 4 ROOM, 5 BARRIER, 6 OUT, 7 MOTION)
function stname(q) ( q == 7 ? "MOTION" : q == 0 ? "IN" : (q == 1 ? "FILTER" : (q == 2 ? "SOURCE" : (q == 3 ? "DELAY" : (q == 4 ? "ROOM" : (q == 5 ? "BARRIER" : "OUT"))))); );
// Returns the theme text color for signal-flow strip item q (Output color for q 0 and 6)
function stcol(q) ( q == 7 ? cMOTT : q == 1 ? cFLTT : (q == 2 ? cSRTT : (q == 3 ? cDLTT : (q == 4 ? cRMTT : (q == 5 ? cBARTT : cIOTT)))); );
// Returns true if strip item q is active (Filter and Room are on when their bypass sliders are below 0.5; In/Out always 1)
function ston(q) ( q == 7 ? slider100 >= 0.5 : q == 1 ? slider39 < 0.5 : (q == 2 ? slider85 >= 0.5 : (q == 3 ? slider65 >= 0.5 : (q == 4 ? slider36 < 0.5 : (q == 5 ? slider41 >= 0.5 : 1)))); );
function stsolo(q) ( q == 2 ? 1 : (q == 3 ? 2 : (q == 4 ? 3 : 0)); );   // solo code of an item (0 = cannot be soloed)
// Returns the tooltip text for signal-flow strip item q
function stip(q) (
  q == 7 ? "Motion: source or listener on a path – click = on / off (it glides in and out)" : q == 0 ? "Input gain into the plugin (the In knob in Output)" : (
  q == 1 ? "Filter: low / high cut – before the room (Pre) or after it (Post). Click = on / off" : (
  q == 2 ? "Source model (phone, radio …): click = on / off to compare · Shift+click = solo: only the source model – no delay, no room" : (
  q == 3 ? "Delay before the room: click = on / off · Shift+click = solo: only the echoes – no source, no room" : (
  q == 4 ? "Room + reverb: click = on / off · Shift+click = solo: only the room sound – reflections and reverb, no direct sound, no delay" : (
  q == 5 ? "Barrier between source and listener: click = on / off (the type is remembered)" : "Output gain and limiter")))));
);
// barrier on / off: off remembers the type, on brings it back
function bartog() local(t) ( t = floor(slider41 + 0.5); t > 0 ? ( barL = t; slider41 = 0; ) : ( slider41 = min(3, max(1, barL)); bcenter(); ); sauto1(41); );
// Toggles strip item q on/off (Filter, Source, Delay, Room sliders, Barrier via bartog, Motion via setp) and notifies automation
function sttog(q) (
  q == 1 ? ( slider39 = slider39 >= 0.5 ? 0 : 1; sauto1(39); );
  q == 2 ? ( slider85 = slider85 >= 0.5 ? 0 : 1; sauto1(85); );
  q == 3 ? ( slider65 = slider65 >= 0.5 ? 0 : 1; sauto1(65); );
  q == 4 ? ( slider36 = slider36 >= 0.5 ? 0 : 1; sauto1(36); );
  q == 5 ? bartog();
  q == 7 ? setp(100, slider100 >= 0.5 ? 0 : 1);   // Motion in the chain
);
// status text of an item -> #sts
function ststat(q) local(t, i, e)
(
  q == 7 ? mtstat() : q == 0 ? ( slider40 <= -71.9 ? strcpy(#sts, "-inf dB") : ( abs(slider40) < 0.05 ? strcpy(#sts, "0 dB") : sprintf(#sts, "%+.1f dB", slider40); ); slider110 >= 0.5 ? ( abs(slider40) < 0.05 ? strcpy(#sts, "mono") : strcat(#sts, " mono"); ); ) : (
  q == 1 ? ( slider39 >= 0.5 ? strcpy(#sts, "off") : (
      slider24 >= 0.5 && slider27 >= 0.5 ? sprintf(#sts, "%.0f Hz – %.1f kHz", slider25, slider28 / 1000) : (
      slider24 >= 0.5 ? sprintf(#sts, "low cut %.0f Hz", slider25) : (
      slider27 >= 0.5 ? sprintf(#sts, "high cut %.1f kHz", slider28 / 1000) : strcpy(#sts, "no cut set") ) ); ); ) : (
  q == 2 ? ( slider85 < 0.5 ? strcpy(#sts, "off") : (
      strcpy(#sts, srcname(fzsel)); e = 0; i = 47; loop(13, abs(slider(i)) > 0.0005 ? e = 1; i += 1; ); e ? strcat(#sts, " *"); fzsel > 0 && (slider111 > 0.05 || slider112 > 0.05 || slider113 > 0.05 || slider114 >= 0.5) ? strcat(#sts, " · call"); ); ) : (
  q == 3 ? ( slider65 < 0.5 ? strcpy(#sts, "off") : (
      t = dpmatch(); t >= 0 ? strcpy(#sts, dpname(t)) : (
      gdtm ? ( strcpy(#sts, "L "); strcat(#sts, dnname(slider72)); strcat(#sts, " · R "); strcat(#sts, dnname(gdlt ? slider72 : slider73)); )
           : sprintf(#sts, "L %.0f · R %.0f ms", gtL, gtR); ); ); ) : (
  q == 4 ? ( slider36 >= 0.5 ? strcpy(#sts, "off") : strcpy(#sts, #rnm); ) : (
  q == 5 ? ( t = floor(slider41 + 0.5);
      t == 0 ? strcpy(#sts, "off") : ( t == 1 ? strcpy(#sts, "Wall") : (
      slider43 >= 0.5 ? sprintf(#sts, t == 2 ? "Window · %.0f°" : "Door · %.0f°", slider43 * 0.9) : strcpy(#sts, t == 2 ? "Window" : "Door") ); ); ) : (
    slider22 <= -71.9 ? strcpy(#sts, "-inf dB") : ( abs(slider22) < 0.05 ? strcpy(#sts, "0 dB") : sprintf(#sts, "%+.1f dB", slider22); );
  ))))));
);
// DECAY BY BAND: reverb time RT60 at frequency f, as the reverb lines play it - averaged over the 8 lines. Per line and pass:
// gain fg x (one-pole high damping) + (fgL - fg) x (one-pole low shelf), the same filters as in @sample
// (GUI copies: a JSFX function keeps its locals in one place - the audio thread designs at the same time)
function bqdbG(cb, f) local(w, c1, s1, c2, s2, nr, ni, dr, di)
(
  w = 2 * $pi * f / srate; c1 = cos(w); s1 = sin(w); c2 = cos(2 * w); s2 = sin(2 * w);
  nr = cb[0] + cb[1] * c1 + cb[2] * c2; ni = -(cb[1] * s1 + cb[2] * s2);
  dr = 1 + cb[3] * c1 + cb[4] * c2; di = -(cb[3] * s1 + cb[4] * s2);
  10 * log10(max(0.0000000001, (nr * nr + ni * ni) / max(0.0000000001, dr * dr + di * di)));
);
// Returns the gain in dB at frequency f: offset g0 plus the sum of six biquad bands stored at coefficient base cb (5 slots apart)
function fqrespG(cb, g0, f) ( g0 + bqdbG(cb, f) + bqdbG(cb + 5, f) + bqdbG(cb + 10, f) + bqdbG(cb + 15, f) + bqdbG(cb + 20, f) + bqdbG(cb + 25, f); );
// Returns estimated RT60 in seconds at frequency f, averaged over the 8 delay lines (line length and gain plus filter response); capped at 99
function rtband(f) local(k, gdb, acc)
(
  acc = 0; k = 0;
  loop(8,
    gdb = min(-0.0000001, 20 * log10(max(0.0000001, fqG[k])) + fqrespG(fqC + k * 30, 0, min(f, 0.45 * srate)));
    acc += -60 * flen[k] / srate / gdb;
    k += 1;
  );
  min(99, acc / 8);
);
// ---- OUTPUT section helpers: spectrum analysis, pixel curves, level bars (drawio below) ----
// SPECTRUM: the last 8192 samples (SPFN) of input and output (mono sum), Hann window, FFT, 1/24-octave bands from 31.5 Hz (dBFS of a
// sine), shown with fast rise / slower fall; when the audio stops the curves sink
function spcalc() local(k, i, b, fc, k0, k1, kfr, fr, pw, v, ring, dst, w0, bh, bw6)
(
// FFT 8192, 1/24-octave bands; where a band is narrower than two FFT bins (the bass) the power is interpolated
  // between the neighboring bins in log frequency - no stair steps. Level as before (the power of a 1/6-octave band).
  !spWinOk ? ( i = 0; loop(SPFN, spWin[i] = 0.5 - 0.5 * cos(2 * $pi * i / SPFN); i += 1; ); spWinOk = 1; );
  bh = srate / SPFN; k = 0;
  loop(2,
    ring = k == 0 ? spRI : spRO; dst = k == 0 ? spBI : spBO; w0 = spw;
    i = 0; loop(SPFN, SPB[2 * i] = ring[(w0 + i) & 8191] * spWin[i]; SPB[2 * i + 1] = 0; i += 1; );
    fft(SPB, SPFN); fft_permute(SPB, SPFN);
    b = 0;
    loop(SPN,
      fc = 31.5 * 2 ^ (b / 24); bw6 = fc * (2 ^ (1 / 12) - 2 ^ (-1 / 12)) / bh;          // width of a 1/6-octave band in bins
      k0 = max(1, floor(fc * 2 ^ (-1 / 48) / bh + 0.5)); k1 = min(SPFN / 2 - 1, max(k0, floor(fc * 2 ^ (1 / 48) / bh + 0.5)));
      k1 - k0 >= 2 ? (
        pw = 0; i = k0; loop(k1 - k0 + 1, pw += sqr(SPB[2 * i]) + sqr(SPB[2 * i + 1]); i += 1; ); pw /= (k1 - k0 + 1);
      ) : (
        kfr = max(1, min(SPFN / 2 - 2, fc / bh)); i = floor(kfr); fr = kfr - i;
        pw = (sqr(SPB[2 * i]) + sqr(SPB[2 * i + 1])) * (1 - fr) + (sqr(SPB[2 * i + 2]) + sqr(SPB[2 * i + 3])) * fr;
      );
      // 6291456 = 3/32 x SPFN^2: Hann-window FFT power of a full-scale sine summed over its bins -> 0 dBFS; pw x bw6 = power of a 1/6-octave band
      v = 10 * log10(pw * max(1, bw6) / 6291456 + 0.0000000000001);
      dst[b] += (v - dst[b]) * (v > dst[b] ? 0.6 : 0.18);
      b += 1;
    );
    k += 1;
  );
);
// PIXEL CURVES (as in fine analyser / EQ plugins): one value per SCREEN pixel column in cvY (screen y), drawn
// straight in screen pixels - the area as 1 px columns with an anti-aliased top pixel, the line as anti-aliased 1 px
// segments (a second, fainter pass makes it about 1.6 px). No polygons, no stacked lines: smooth at any scale.
function cvfill(cvx0, n, cvyb, c, al, cvyt) local(i, t, tq, r, g, b, H, a0)
(
// each 1 px column fades towards the bottom (alpha falls by 85 % over the height of the graph)
  r = floor(c / 65536) / 255; g = (floor(c / 256) % 256) / 255; b = (c % 256) / 255; H = max(1, cvyb - cvyt); i = 0;
  loop(n,
    t = min(cvyb, cvY[i]); tq = ceil(t); a0 = al * (1 - 0.85 * (tq - cvyt) / H) * cfade;
    tq < cvyb ? gfx_gradrect(cvx0 + i, tq, 1, cvyb - tq, r, g, b, a0, 0, 0, 0, 0, 0, 0, 0, -al * 0.85 * cfade / H);
    tq - t > 0.02 ? ( col(c, a0 / max(0.0001, cfade) * (tq - t)); gfx_rect(cvx0 + i, tq - 1, 1, 1); );
    i += 1;
  );
);
// Draws the polyline cvY[0..n-1] at screen x from cvx0 in color c, alpha al, adding a faint second pass for lines wider than 1.2
function cvline(cvx0, n, c, al, cvw) local(i)
(
  col(c, al); i = 1; loop(n - 1, gfx_line(cvx0 + i - 1, cvY[i - 1], cvx0 + i, cvY[i], 1); i += 1; );
  cvw > 0.6 ? ( col(c, al * 0.75); i = 1; loop(n - 1, gfx_line(cvx0 + i - 1, cvY[i - 1] + 0.7, cvx0 + i, cvY[i] + 0.7, 1); i += 1; ); );   // stronger curves - a second pass for every size, ...
  cvw > 1.2 ? ( col(c, al * 0.55); i = 1; loop(n - 1, gfx_line(cvx0 + i - 1, cvY[i - 1] - 0.7, cvx0 + i, cvY[i] - 0.7, 1); i += 1; ); );   // ... a third one above it for the larger ones
);
function spv(a, b) ( min(-6, max(-90, 0.25 * a[max(0, min(SPN - 1, b - 1))] + 0.5 * a[max(0, min(SPN - 1, b))] + 0.25 * a[max(0, min(SPN - 1, b + 1))])); );   // a light smoothing over neighboring bands (calm, still detailed)
// Catmull-Rom spline value (dB) between bands b and b+1 at fraction t; a = the smoothed bands (spSm, filled once per curve by spsmooth)
// spv ran four times per screen pixel (12 clamped reads each) - now once per band, the spline reads the array
function spsmooth(a) local(b) ( b = 0; loop(SPN, spSm[b] = spv(a, b); b += 1; ); );
function spcr(a, b, t) local(p0, p1, p2, p3) ( p0 = a[max(0, b - 1)]; p1 = a[b]; p2 = a[min(SPN - 1, b + 1)]; p3 = a[min(SPN - 1, b + 2)]; 0.5 * (2 * p1 + (p2 - p0) * t + (2 * p0 - 5 * p1 + 4 * p2 - p3) * t * t + (3 * p1 - p0 - 3 * p2 + p3) * t * t * t); );
// Draws the live input/output spectrum panel at (x,y,w,h): log grid, interpolated per-pixel curves from spBI/spBO, labels and tooltip
function spdraw(x, y, w, h) local(b, px, py, lx, ly, f, gx, v, gy, t, n, spx0, spyb, k, bp)
(
  col(cBG, 1); RR(x, y, w, h, 4);
  col(cHAIR, 1); f = 100; loop(3, gx = x + log(f / 31.5) / log(16000 / 31.5) * w; LN(gx, y + 2, gx, y + h - 2); f *= 10; );
  col(cHAIR, 0.6); f = -24; loop(3, gy = y + h - 1 - (f + 90) / 84 * (h - 3); LN(x + 2, gy, x + w - 2, gy); f -= 24; );   // faint level lines (-24, -48, -72 dB)
// one value per screen pixel (cvfill / cvline)
  spx0 = floor(gox + x * gs + 0.5); n = min(4096, max(2, floor(w * gs))); spyb = floor(goy + (y + h - 1) * gs + 0.5);
  k = 0;
  loop(2,
    spsmooth(k == 0 ? spBI : spBO); b = 0;
    loop(n,
      bp = b / (n - 1) * (SPN - 1);
      v = min(-6, max(-90, spcr(spSm, floor(bp), bp - floor(bp))));
      cvY[b] = goy + (y + h - 1 - (v + 90) / 84 * (h - 3)) * gs; b += 1;
    );
    k == 0 ? cvfill(spx0, n, spyb, cDIM, 0.6, floor(goy + y * gs)) : ( cvfill(spx0, n, spyb, cIOTT, 0.22, floor(goy + y * gs)); cvline(spx0, n, cIOTT, 1, 1.6); );
    k += 1;
  );
  gfx_setfont(7); col(cDIM2, 1);
  txt("100", x + log(100 / 31.5) / log(16000 / 31.5) * w + 2, y + h - 6, 0); txt("1k", x + log(1000 / 31.5) / log(16000 / 31.5) * w + 2, y + h - 6, 0); txt("10k", x + log(10000 / 31.5) / log(16000 / 31.5) * w + 2, y + h - 6, 0);
  col(cMUTED, 1); txt("in", x + w - 26, y + 7, 2); col(cIOTT, 1); txt("out", x + w - 6, y + 7, 2);
  tipbox(x, y, w, h, "Spectrum, live: input (gray area) and output (colored line), 1/24 octave, 31.5 Hz – 16 kHz, -90 … -6 dBFS – what the room adds and takes away");
);
// ---- TAB ROW (page scale, between room view and module): the modules in signal order - dot = on / off,
// name = open the tab, S = solo (Source, Delay, Room; monitor only), Shift / Alt + click = solo too; All = the two columns.
// The splitter above it sets the height of the room view (double-click = automatic).
function tabname(id) ( id == 15 ? "Free field" : id == 1 ? "Room" : (id == 3 ? "Source" : (id == 4 ? (isfree ? "Reflectors" : "Walls") : (id == 5 ? "Barrier" : (id == 6 ? "Filter" : (id == 7 ? "Output" : (id == 14 ? "Motion" : "Delay")))))); );
// Returns the sample reference text shown under tab id's name in the tab row (e.g. "Living room", "low cut 120 Hz")
function tabref(id) ( id == 15 ? "outdoors" : id == 1 ? "Living room" : (id == 3 ? "Telephone" : (id == 4 ? "Plaster · α 0.04" : (id == 5 ? "Door · 90°" : (id == 6 ? "low cut 120 Hz" : (id == 7 ? "-12.5 dB" : (id == 14 ? "Front - back · 8 bars" : "L 320 · R 480")))))); );
function tabq(id) ( id == 1 ? 4 : (id == 3 ? 2 : (id == 5 ? 5 : (id == 6 ? 1 : (id == 10 ? 3 : (id == 14 ? 7 : 0))))); );   // its item in the signal-flow strip (0 = none)
// Returns the theme color for tab id's module (Delay color is the default)
function tabc(id) ( id == 15 ? cFFTT : id == 1 ? cRMTT : (id == 3 ? cSRTT : (id == 4 ? cWALTT : (id == 5 ? cBARTT : (id == 6 ? cFLTT : (id == 7 ? cIOTT : (id == 14 ? cMOTT : cDLTT)))))); );
// Fills tbo[] with the tab ids in signal order (pre/post Filter position by slider30); returns the tab count
function taborder() local(n) (
  n = 0; slider30 < 0.5 ? ( tbo[n] = 6; n += 1; );
  tbo[n] = 3; tbo[n + 1] = 10; tbo[n + 2] = 1; tbo[n + 3] = 15; tbo[n + 4] = 4; tbo[n + 5] = 5; n += 6;   // + Free field (its own tab after Room)
  tbo[n] = 14; n += 1; slider30 >= 0.5 ? ( tbo[n] = 6; n += 1; ); tbo[n] = 7; n + 1;   // + Motion (before the post filter and Output - the chain order)
);
// Selects the tab d steps (+1 / -1) from the current tab in taborder, wrapping around; writes vopt[46]
function tabstep(d) local(n, i, k) (
  n = taborder(); k = 0; i = 0; loop(n, tbo[i] == tabsel ? k = i; i += 1; );
  vopt[46] = tbo[(k + d + n) % n];
);
// CORRELATION bar: the scale is colored - red left of the middle (parts cancel in mono), green right (mono
// compatible); the fill from the middle to the value and the marker take the value's color (yellow close to 0)
function corrbar(x, yc, w, crv) local(cx0)
(
  col(cHAIR, 1); RR(x, yc - 1.5, w, 3, 1.5);
  col(0xD9534F, 0.22); RR(x, yc - 1.5, w / 2, 3, 1.5); col(0x2E9E6A, 0.22); RR(x + w / 2, yc - 1.5, w / 2, 3, 1.5);
  cx0 = x + w / 2; col(cDIM2, 1); R(cx0 - 0.5, yc - 4, 1, 8);
  crvC = cTEXT;
  crv <= 1.5 ? (
// the color zone has a margin (0.03) - a value close to 0 or 0.3 no longer flips the color (the mini meter blinked)
    crvZt = crv < 0 ? 0 : (crv < 0.3 ? 1 : 2);
    crvZt != crvZ ? ( (crvZt > crvZ ? crv >= (crvZ == 0 ? 0.03 : 0.33) : crv < (crvZ == 2 ? 0.27 : -0.03)) ? crvZ = crvZt; );
    crvC = crvZ == 0 ? 0xD9534F : (crvZ == 1 ? cWARN : 0x2E9E6A);
    col(crvC, 1); crv >= 0 ? R(cx0, yc - 1.5, w / 2 * crv, 3) : R(cx0 + w / 2 * crv, yc - 1.5, -w / 2 * crv, 3);
    R(x + w * (crv + 1) / 2 - 1.2, yc - 4, 2.4, 8);
  );
);
// MINI CORRELATION in the signal-flow strip (every tab and view, Expert): "Corr", the colored bar, the value - how the processing changes the
// mono compatibility while you work in Source, Room or Delay. Repainted alone on the meter-only frames (its place is kept)
function mcorrw() ( gfx_setfont(7); (WT >= 1500 ? tws("Corr") + 6 : 0) + 46 + tws("+0.00"); );   // its width (the word only on a wide window)
// Draws the compact correlation meter at (x,cy): label, 40 px bar, signed value text; stores its hit area in mcX/mcCY/mcGS/mcGX/mcGY and sets mcOn
function mcorrdraw(x, cy) local(crv, mlw)
(
  gfx_setfont(7); mlw = 0; WT >= 1500 ? ( mlw = tws("Corr") + 6; col(cMUTED, 1); txt("Corr", x, cy, 0); );
  crv = crvS; corrbar(x + mlw, cy, 40, crv);
  crv <= 1.5 ? sprintf(#w1, "%+.2f", crv) : strcpy(#w1, "–"); col(crvC, 1); gfx_setfont(7); txt(#w1, x + mlw + 46, cy, 0);
  mcW = mcorrw();
  tipbox(x, cy - 9, mcW, 18, "Correlation of the output, left against right (mono compatibility): green = mono compatible, yellow = very wide, red = parts cancel in a mono or TV downmix. The full meter and the goniometer are in Output");
  mcX = x; mcCY = cy; mcGS = gs; mcGX = gox; mcGY = goy; mcOn = 1;
);
// vopt layout per reflector r (base RFB + 6 r): +0 material (0 = off), +1 X, +2 Y, +3 angle, +4 length, +5 height; RFB + 12 + r = level (dB); RFB + 14 = both reflectors off
function rflset(r, m) local(o)
(
  o = RFB + r * 6; m < 0.5 && vopt[o] >= 0.5 ? rflLM[r] = vopt[o]; vopt[o] = m;
  m >= 0.5 && vopt[o + 4] < 0.5 ? ( vopt[o + 1] = max(0.8, slider2) * min(4, max(0.25, slider31)) * (r == 0 ? 0.92 : 0.08); vopt[o + 2] = max(0.8, slider3) * min(4, max(0.25, slider31)) * 0.5; vopt[o + 3] = 90; vopt[o + 4] = max(0.8, slider3) * min(4, max(0.25, slider31)) * 1.1; vopt[o + 5] = 4; );
);
// Draws the module tab row (dot on/off, name, status text, solo button) and handles clicks; shortens status texts to fit the window width
function tabrow() local(n, i, id, q, x, w, on, act, c, hit, dhit, shit, cy, sq, sx, nw, tdq)
(
  n = taborder(); cy = TBY + TBH / 2 - 1;   // the tab texts 3 px higher - more space between the status text (e.g. "Original") and the tab line
   x = tbX0 = max(8, (goxZ - goxN) / gsN + 0.2); i = 0;
// nine tabs - on a narrow window the status texts get shorter so the whole row stays inside the window (a name never gets cut)
  tbtot = 0; tbmin = 0;
  loop(n, id = tbo[i]; gfx_setfont(7); stw2 = tws(tabref(id)); gfx_setfont(2); tbnw = max(tws(tabname(id)), stw2); tbtot += 28 + tbnw + (stsolo(tabq(id)) > 0 ? 22 : 0) + 2 + 3 + 7 + (id == tabsel && id != 7 ? mmWd() + 10 : 0); tbmin += max(0, tbnw - tws(tabname(id))); i += 1; );
  tbcut = min(1, max(0, tbtot - 7 - (WT - 8 - tbX0 - (stpwT > 0 ? stpwT + 30 : 0))) / max(1, tbmin)); i = 0;   // share of the status width that has to go (0 = all fit) // the row starts on the module's left edge - the first tab's frame runs straight into it
  loop(n,
    id = tbo[i]; q = tabq(id); c = tabc(id); act = id == tabsel; on = id == 15 ? isfree : (id == 4 && isfree ? vopt[RFB + 14] < 0.5 && (vopt[RFB] >= 0.5 || vopt[RFB + 6] >= 0.5) : (q > 0 ? (id == 1 ? ston(q) && !isfree : ston(q)) : 1)); sq = q > 0 ? stsolo(q) : 0; tdq = q > 0 || id == 15 || (id == 4 && isfree);   // Reflectors (Walls tab outdoors) - a round on / off button like Barrier // Free field and Room switch each other (the dot of the one that is off brings it back)
    q > 0 ? ststat(q == 6 ? 6 : q) : ( id == 7 ? ststat(6) : ( id == 14 ? mtstat() : ( id == 15 ? strcpy(#sts, isfree ? "outdoors" : "off") : ( id == 4 && isfree ? sprintf(#sts, "R1 %s · R2 %s", rflName(vopt[RFB]), rflName(vopt[RFB + 6])) : strcpy(#sts, #wmt) ) ) ) );
    gfx_setfont(7); stw2 = tws(tabref(id));   // a fixed width per tab - it does not jump with its values (longer status text is shortened)
    gfx_setfont(2); nw = max(tws(tabname(id)), stw2); nw -= (nw - tws(tabname(id))) * tbcut; mmtw = act && id != 7 ? mmWd() + 10 : 0; w = 28 + nw + (sq > 0 ? 22 : 0) + 2 + mmtw;
    hit = inbox(x, TBY + 2, w, TBH); dhit = tdq && sqr(mx - (x + 12)) + sqr(my - cy) < 56;
    sx = x + w - 24; shit = sq > 0 && inbox(sx - 2, cy - 9, 20, 18);
    act ? ( tbAX = x; tbAW = w; col(c, 1); cCTLon ? ( RR(x - 1.2, TBY - 1.2, w + 2.4, TBH + 6.6, 7.2); col(szoom ? cSURF : mixc(cSURF, c, cCTLon == 2 ? 0.22 : 0.16), 1); RR(x, TBY, w, TBH + 6, 6); R(x, TAY - 2, w, 6); ) : ( RR(x - 1.6, TBY - 1.6, w + 3.2, TBH + 7, 7.4); col(cSURF, 1); RR(x, TBY, w, TBH + 6, 6); R(x, TAY - 2, w, 6); ); )   // the active tab: a frame in the module color, 1.6 wide (no line over the title)
        : ( col(hit ? cHAIR : cLINE, 1); RR(x, TBY + 3, w, TBH - 3, 6); );
    tdq ? ( on ? ( col(c, 1); CI(x + 12, cy, 4.8, 1); ) : ( col(cSURF, 1); CI(x + 12, cy, 4.8, 1); col(dhit ? cTEXT : cDIM2, 1); CI(x + 12, cy, 4.8, 0); CI(x + 12, cy, 4.0, 0); ); )
          : ( col(c, 1); RR(x + 9.5, cy - 6, 3, 12, 1.5); );
    col(act ? cTEXT : (on ? cMUTED : cDIM2), 1); gfx_setfont(2); txt(tabname(id), x + 24, cy - 5, 0);
    col(on ? cMUTED : cDIM2, 1); gfx_setfont(7); txtfit(#sts, x + 24, cy + 7, nw);
    mmtw > 0 && mmN < MMCAP ? ( mmB[mmN * 5] = x + w - (sq > 0 ? 28 : 6); mmB[mmN * 5 + 1] = cy; mmB[mmN * 5 + 2] = gs; mmB[mmN * 5 + 3] = gox; mmB[mmN * 5 + 4] = goy; mmN += 1; );   // In / Out level of the open module
    sq > 0 ? (
      soloM == sq ? ( col(cAMB, 1); RR(sx, cy - 7, 16, 14, 4); col(0xFFFFFF, 1); ) : ( col(shit ? cTEXT : cBORD, 1); RRO(sx, cy - 7, 16, 14, 4); col(shit ? cTEXT : cMUTED, 1); );   // (S centered on both lines)
      gfx_setfont(6); txt("S", sx + 8, cy, 1);
    );
    click && (shit || (hit && (mouse_cap & 24) && sq > 0)) ? ( soloM == sq ? ( soloM = 0; ) : ( !(id == 1 ? ston(q) : on) ? sttog(q); soloM = sq; ); click = 0; ) : (
    click && dhit ? ( id == 4 && isfree ? ( on ? ( vopt[RFB + 14] = 1; ) : ( vopt[RFB + 14] = 0; vopt[RFB] < 0.5 && vopt[RFB + 6] < 0.5 ? rflset(0, 1); ); ) :   // (on with no reflector set: R1 becomes a facade, as Barrier starts with a wall)
    ( id == 15 || (id == 1 && isfree) ? ( modeset(id == 15 && isfree ? 0 : (id == 1 ? 0 : 1)); snlast = 0; ) : sttog(q); ); click = 0; ) : (
    click && hit ? ( vopt[46] = id; click = 0; ); ); );
    shit ? ( tipon = 1; tipforce = 0; tipx = sx + 8; tipy = TBY - 12;
      tipstr = soloM == sq ? "Solo on – click to end it (or Esc)" : (sq == 1 ? "Solo: only the source model – no delay, no room. Monitor only, not saved, ends when the window closes"
        : (sq == 2 ? "Solo: only the echoes of the delay – no source, no room. Monitor only, not saved, ends when the window closes" : "Solo: only the room – reflections and reverb, no direct sound, no delay. Monitor only, not saved, ends when the window closes")); ) : (
    dhit ? ( tipon = 1; tipforce = 0; tipx = x + 12; tipy = TBY - 12; tipstr = id == 4 && isfree ? (on ? "Reflectors are on – click: both off (their settings stay)" : "Reflectors are off – click: on again (none set: R1 becomes a facade)") : id == 15 ? (isfree ? "Free field is on – click: back to the room" : "Free field: outdoors, no walls, no reverb – click: switch it on (the room is off then)") : (id == 1 && isfree ? "Free field is on, the room is off – click: back to the room" : (on ? "On – click: bypass this module" : "Bypassed – click: on")); ) : (
    hit ? ( tipon = 1; tipx = x + w / 2; tipy = TBY - 12; tipstr = sq > 0 ? "Open this module · Shift+click = solo · keys 1 … 9 open the tabs, [ and ] = previous / next" : "Open this module · keys 1 … 9 open the tabs, [ and ] = previous / next"; ); ); );
    x += w + 3;
    i < n - 1 ? ( col(cDIM2, 1); gfx_setfont(6); txt(id == 4 ? "+" : (id == 15 ? "›" : (id == 1 ? "/" : (id == 7 ? "·" : "›"))), x + 2, cy, 1); x += 7; );
    i += 1;
  );
  tbEndX = x;   // All and Fit moved under the view modes (Tabs | All | Fit)
  // solo / hear sign (violet pill with x, right of the tabs): names the active solo or room-part listening; a click ends it
  stpwT > 0 ? (
    gfx_setfont(7); x = WT - 14 - tws("Latency 1.5 ms") - 14 - stpwT;
    col(cAMB, 1); RR(x, cy - 8, stpwT, 16, 8); col(0xFFFFFF, 1); gfx_setfont(6); txt(#stp, x + 9, cy, 0);
    LNW(x + stpwT - 13, cy - 2.5, x + stpwT - 8, cy + 2.5, 1.3); LNW(x + stpwT - 13, cy + 2.5, x + stpwT - 8, cy - 2.5, 1.3);
    click && inbox(x, cy - 9, stpwT, 18) ? ( soloM > 0 ? ( soloM = 0; ) : ( vopt[18] = 0; ); click = 0; );
    tipbox(x, cy - 9, stpwT, 18, soloM > 0 ? "Solo: only this module is heard – click to end it (or Esc). Monitor only: not saved, ends when the window closes" : "Hear: only a part of the room sound plays (set in Room) – click: all three again");
  );
  // latency readout: the limiter looks 1.5 ms ahead - always on, reported to REAPER (it compensates)
  sprintf(#tlat, "Latency %.1f ms", pdc_delay / srate * 1000); gfx_setfont(7);
  tbEndX + 12 < WT - 14 - tws(#tlat) ? ( col(cMUTED, 1); txt(#tlat, WT - 14, cy, 2);   // only where it does not run into the tab row
  tipbox(WT - 14 - tws(#tlat), TBY + 2, tws(#tlat), TBH, "Latency of the plugin: the limiter looks 1.5 ms ahead. It is always on and reported to REAPER, which compensates it"); );
  // splitter between room view and tabs: drag = height of the room view, double-click = automatic
  hit = !vhid && !vgone && my >= VY + VH && my < TBY && mx >= VX && mx < VX + VW;
  click && hit ? ( time_precise() - tbdt < 0.35 ? ( vopt[47] = 0; vopt[48] = 0; vopt[35] = 0; tbdrag = 0; ) : ( tbdrag = 1; tbdy = my - VH; ); tbdt = time_precise(); click = 0; );
  tbdrag ? ( (mouse_cap & 1) ? ( tbnv = floor(max(VFH + 30, min(tabmax, my - tbdy)) + 0.5); (vopt[48] >= 0.5 || vopt[35] >= 0.99) && abs(tbnv - VH) < 1 ? 0 : ( vopt[47] = tbnv; vopt[35] = 0; vopt[48] = 0; ); ) : ( tbdrag = 0; ); );   // also with Fit on - moving it ends Fit
