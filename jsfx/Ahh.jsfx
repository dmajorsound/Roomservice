  xSTW *= pbD;   // no bass steering with the source on the listener (it would turn the phase of the input)
  // ---- 2nd network: the neighbor room (same side only) ----
  xLG2 = 0;
  bnet && !isfree ? (
    base2 = min(0.11, max(0.02, 1.2 * mfpQ / C_SND));
    k = 0; loop(4, flen2[k] = min(LINEMAX - 2, floor(base2 * fac2[k] * srate) | 1); k += 1; );
    gkey2 = rt2 * 1000003 + hfr2 * 1009 + base2 + lfr2 * 7919;
    gkey2 != last_gkey2 ? (
      lsum = 0; k = 0;
      loop(4,
        g0 = 10 ^ (-3 * flen2[k] / (rt2 * srate)); gh = 10 ^ (-3 * flen2[k] / (rt2 * hfr2 * srate));
        hr = gh / g0; hc = cos(2 * $pi * 4000 / srate);
        hr < 0.99999 ? ( hB = (2 - 2 * hr * hr * hc) / (hr * hr - 1); fb2[k] = (-hB - sqrt(hB * hB - 4)) / 2; ) : ( fb2[k] = 0; );
        fg2[k] = g0; fgL2[k] = g0 + (10 ^ (-3 * flen2[k] / (min(20, rt2 * lfr2) * srate)) - g0) / 0.8944; lsum += flen2[k]; k += 1;
      );
      gm = 10 ^ (-3 * (lsum / 4) / (rt2 * srate));
      tailn2 = sqrt((1 - gm * gm) / (gm * gm));
      last_gkey2 = gkey2;
    );
