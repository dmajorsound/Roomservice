  );
);
function sn_back() local(c, tb, tln) (           // backspace: remove the last character (all its UTF-8 bytes)
  tb = snf ? dseb : sneb; tln = snf ? dselen : snelen; c = 128;
  while ( tln > 0 && (c & 192) == 128 ? ( tln -= 1; c = tb[tln]; tb[tln] = 0; 1; ) : 0; );
  snf ? ( dselen = tln; ) : ( snelen = tln; );
);
function sn_strn(b, n, s) local(i, z) (           // bytes -> string (n bytes max, 0 = end)
  strcpy(s, ""); i = 0; z = 0;
  loop(n, b[i] <= 0 ? ( z = 1; ); !z ? ( sprintf(#snch, "%c", b[i]); strcat(s, #snch); ); i += 1; );
  s;
