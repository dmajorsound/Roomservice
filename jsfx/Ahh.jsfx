  i == 0 ? slider_automate(slider120, 1);
  i == 1 ? slider_automate(slider121, 1);
  i == 2 ? slider_automate(slider122, 1);
  i == 3 ? slider_automate(slider123, 1);
  i == 4 ? slider_automate(slider124, 1);
  i == 5 ? slider_automate(slider125, 1);
  i == 6 ? slider_automate(slider126, 1);
  i == 7 ? slider_automate(slider127, 1);
  i == 8 ? slider_automate(slider128, 1);
  i == 9 ? slider_automate(slider129, 1);
  i == 10 ? slider_automate(slider130, 1);
  i == 11 ? slider_automate(slider131, 1);
  i == 12 ? slider_automate(slider132, 1);
  i == 13 ? slider_automate(slider133, 1);
  i == 14 ? slider_automate(slider134, 1);
  ) : (
  i == 0 ? slider_automate(slider120);
  i == 1 ? slider_automate(slider121);
  i == 2 ? slider_automate(slider122);
  i == 3 ? slider_automate(slider123);
  i == 4 ? slider_automate(slider124);
  i == 5 ? slider_automate(slider125);
  i == 6 ? slider_automate(slider126);
  i == 7 ? slider_automate(slider127);
  i == 8 ? slider_automate(slider128);
  i == 9 ? slider_automate(slider129);
  i == 10 ? slider_automate(slider130);
  i == 11 ? slider_automate(slider131);
  i == 12 ? slider_automate(slider132);
  i == 13 ? slider_automate(slider133);
  i == 14 ? slider_automate(slider134);
  );
);
function rflName(m) ( m < 0.5 ? "Off" : (m < 1.5 ? "Facade" : (m < 2.5 ? "Glass" : (m < 3.5 ? "Rock" : (m < 4.5 ? "Fence" : "Hedge")))); );
// Eyring RT60 in seconds of a box (volume bV, surface bSu, absorption area bA) including air absorption, clamped 0.08-20 s.
function rtEy(bV, bSu, bA) local(ab) ( ab = min(0.95, max(0.005, bA / bSu)); min(20, max(0.08, 0.161 * bV / (-bSu * log(1 - ab) + 4 * airm5 * bV))); );
// HF / mid decay ratio of a box: walls absorb more highs (abar), air absorbs much more at 4 kHz (m = 0.0068 /m)
