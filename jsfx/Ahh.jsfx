  fzRef = 0.25;
  fzSat > 0 ? fzRef = (thf(fzSat * fzPush * fzRef + fzAsym) - fzAsT) / fzSatN;
  fzClip > 0 ? fzRef = min(1, fzClip * fzPush * fzRef) / fzClipN;
  fzOutG = slider60 >= 0.5 ? min(20, 1 / max(0.05, sqrt(max(0.000001, fzLin)) * fzRef / 0.25)) : fzGain;
  lcon = slider24 >= 0.5; hcon = slider27 >= 0.5; fpost = slider30 >= 0.5; 
  lcN = floor(slider26 + 0.5) + 1; hcN = floor(slider29 + 0.5) + 1;
  lcNb = floor(lcN / 2); lcNo = lcN % 2; hcNb = floor(hcN / 2); hcNo = hcN % 2;
  lckey = slider25 * 16 + lcN; hckey = slider28 * 16 + hcN;
  lckey != lastlc ? ( fdesign(lcC, lcF, 1, max(20, slider25), lcN); fdesign(lcCc, lcFc, 0, max(20, slider25), lcN); lastlc = lckey; );
  hckey != lasthc ? ( fdesign(hcC, hcF, 0, max(1000, slider28), hcN); fdesign(hcCc, hcFc, 1, max(1000, slider28), hcN); lasthc = hckey; );
  // TONE (slider 33): > 0 = bright: high shelf at 4 kHz (0.12 x value); < 0 = dark: one-pole low-pass sweeping from 20 kHz (0) down to 1.5 kHz (-100)
  bron = slider33 > 0.5; dkon = slider33 < -0.5;
