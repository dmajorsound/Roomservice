  btV = 0;
  ncr == 1 && crV > 0.001 ? (
    vpx = crX + crV * foldsg(crX, roomW) * (crEx - fold(crX, roomW));
    vpz = crZ + crV * foldsg(crZ, roomH) * (crEz - fold(crZ, roomH));
