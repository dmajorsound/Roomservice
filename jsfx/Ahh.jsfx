  gfx_setfont(7); tbw = tws(#w2) + 10; tbx = tpx0 + TPW - 34 - tbw + 4; tbhit = inbox(tbx, tpy0 + 6, tbw, 14);
  tbhit || vedit == 79 ? ( col(cLINE, 1); RR(tbx, tpy0 + 6, tbw, 14, 4); );
