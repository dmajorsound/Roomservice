  erE = 0; k = 1; loop(NT - 1, erE += tapOn[k] * sqr(tapG[k]); k += 1; );
  ecl80 = 0; k = NIMG; loop(NCL, (tapT[k] - tapT[0]) > 80 ? ecl80 += tapOn[k] * sqr(tapG[k]); k += 1; );   // cluster energy after 80 ms
  tailE = max(barE * exp(-1.11 / rt) - ecl80, barE - erE);
