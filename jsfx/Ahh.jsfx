      );
    );
  );
);
// Draws a dashed line from (x1,y1) to (x2,y2) with the given dash and gap lengths (design units) and width wd, using LNW segments.
function DL(x1, y1, x2, y2, dash, gap, wd) local(len, ux1, uy1, t, t2)
(
  len = sqrt(sqr(x2 - x1) + sqr(y2 - y1));
  len > 0 ? (
    ux1 = (x2 - x1) / len; uy1 = (y2 - y1) / len; t = 0;
    while (
      t2 = min(len, t + dash);
      LNW(x1 + ux1 * t, y1 + uy1 * t, x1 + ux1 * t2, y1 + uy1 * t2, wd);
      t += dash + gap;
      t < len;
    );
  );
);
// circles and arcs sit on a whole pixel: a letter or a pointer placed on the same point is exactly in the middle
function CI(x, y, rad, fill) ( gclp && (x < clX0 || x > clX1 || y < clY0 || y > clY1) ? 0 : gfx_circle(floor(gox + x * gs + 0.5), floor(goy + y * gs + 0.5), rad * gs, fill, 1); );
// Draws a circle (filled if fill) at design coords x,y, radius rad, at sub-pixel position; skipped when outside the clip rect (gclp).
function CIF(x, y, rad, fill) ( gclp && (x < clX0 || x > clX1 || y < clY0 || y > clY1) ? 0 : gfx_circle(gox + x * gs, goy + y * gs, rad * gs, fill, 1); );
// text centered on the pixel that CI uses as center
function txtc(s, x, y) local(tw2, th2)
(
  gfx_measurestr(s, tw2, th2);
  gfx_x = floor(floor(gox + x * gs + 0.5) + 0.5 - tw2 / 2 + 0.5); gfx_y = floor(floor(goy + y * gs + 0.5) + 0.5 - th2 / 2 + 0.5);
  gfx_drawstr(s);
);
// Fills the quad (x1,y1)...(x4,y4) as triangles in design units; in the room view (gclp) it is clipped to the view rect first (Sutherland-Hodgman).
function POLY4(x1, y1, x2, y2, x3, y3, x4, y4) local(n, e, m, i, j, ax, ay, bx, by, pda, pdb, t)
(
  gclp ? (
// in the room view the polygon is clipped to the view (Sutherland-Hodgman) - walls, barrier face and shadows no longer reach out of it when the view is zoomed
    PLQ[0] = x1; PLQ[1] = y1; PLQ[2] = x2; PLQ[3] = y2; PLQ[4] = x3; PLQ[5] = y3; PLQ[6] = x4; PLQ[7] = y4; n = 4; e = 0;
    // clip against the 4 view edges in turn (e = left, right, top, bottom): pda / pdb = distance inside the edge (>= 0 = inside); the result goes to PLQ + 32 and is copied back
    while (e < 4 && n > 0) (
      m = 0; i = 0;
      loop(n,
        j = i + 1 >= n ? 0 : i + 1;
