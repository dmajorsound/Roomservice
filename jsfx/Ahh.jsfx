);
// all barrier crossings of the path listener -> image source (image space): btE energy factor, btF corner (0 = none)
function btrans(px, py, pz) local(j, j0, j1, yj, t, dtot, gE, gF, gM, gN, gC, ncr, crX, crZ, crY, crV, crEx, crEz, vpx, vpz, dv1, dv2)
(
  gE = 1; gF = 0; gM = 1; gN = 0; gC = 0; ncr = 0;
  dtot = sqrt(sqr(px - lx) + sqr(py - ly) + sqr(pz - lz));
