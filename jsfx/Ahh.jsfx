function ic_detail(cx, cy, hi) local(k) (          // three bars of growing height: High = all three, Normal = the third only outlined; 2 = Stereo-safe: two dots joined by a bar (L = R)
  hi == 2 ? ( CI(cx - 4.5, cy, 2.6, 1); CI(cx + 4.5, cy, 2.6, 1); RR(cx - 4.5, cy - 0.7, 9, 1.4, 0.7); ) :   /* 0.311: L = R (was two bars: looked like pause) */
