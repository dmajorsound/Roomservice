  dkon && slider33 != lastdk ? ( dkA = exp(-2 * $pi * (20000 * (1500 / 20000) ^ (-slider33 / 100)) / srate); lastdk = slider33; );
  fcg   = (slider19 >= 0.5) && !isfree;

  k = 0;
  loop(NT,
    tapOn[k] = (k == 0) ? 1 : (isfree ? ((k == 1 && bon && bsame) || (k == 2 && vopt[RFB] >= 0.5 && vopt[RFB + 14] < 0.5) || (k == 3 && vopt[RFB + 6] >= 0.5 && vopt[RFB + 14] < 0.5) || (slider119 >= 0.5 && k < NIMG && tIZ[k] == -1 && tIX[k] == 0 && tIY[k] == 0)) : (!tapZ[k] || fcg));   // free field: the barrier reflection and the ground
