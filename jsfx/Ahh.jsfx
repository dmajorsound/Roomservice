            ex = b[1] + sin(b[4]) * b[3]; ey = b[2] - cos(b[4]) * b[3]; dd = sqrt(sqr(px + 0.5 - ex) + sqr(py + 0.5 - ey));
            ex = b[1] + sin(b[5]) * b[3]; ey = b[2] - cos(b[5]) * b[3]; dd = min(dd, sqrt(sqr(px + 0.5 - ex) + sqr(py + 0.5 - ey))); );
        );
