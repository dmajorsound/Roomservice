// ---- output limiter: look-ahead peak limiter, ceiling -1 dBFS ----
// The needed gain of every sample (ceiling / peak) goes through a sliding minimum over the look-ahead window, an exponential
// release and a moving average over the same window. The average is the attack ramp: it reaches the needed gain exactly when
// the peak leaves the delay line, so no sample passes above the ceiling and the gain never steps (no click, no distortion).
LMLA = min(590, max(1, floor(0.0015 * srate + 0.5)));   // look-ahead 1.5 ms = latency, reported to REAPER (always, also with the limiter off); at most 590 samples - the buffers (5 x LMLA + 7) must stay below vopt + 5000 (above ~400 kHz they reached the snapshot names)
LMN = LMLA + 1; LMQ = LMN + 2; LMCEIL = 0.89;   // window (samples), queue size, ceiling -1 dBFS (the soft clipper above it stays as a safety net)
lmb = vopt + 2000; lmDL = lmb; lmDR = lmDL + LMLA; lmW = lmDR + LMLA; lmQv = lmW + LMN; lmQt = lmQv + LMQ;
memset(lmDL, 0, 2 * LMLA); k = 0; loop(LMN, lmW[k] = 1; k += 1; );
lmsum = LMN; lmqh = lmqn = 0; lmt = 0; lmd = 0; lmdd = 0; lmr = 1; lmga = 1; lmgv = 1;
lmrel = 1 - exp(-1 / (0.15 * srate));        // release 150 ms
