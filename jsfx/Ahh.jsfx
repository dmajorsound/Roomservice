            col(cSURF, 1); R(lhx - 3.5, lhy - 3.5, 7, 7); col(rflCol, 1); LNBOX(lhx - 3.5, lhy - 3.5, 7, 7, lhit ? 1.6 : 1);
            lhit && drag != 26 + r ? tipbox(lhx - 5, lhy - 5, 10, 10, "Length: drag along the panel = longer / shorter (the center stays; the knob Length does the same)");
