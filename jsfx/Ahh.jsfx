  rsfull ? ( col(cIOTT, 1); gfx_setfont(7); txt("My rooms is full (24) – delete one in the room menu first", rspx + 96, rsby + 9, 0); );
  col(cSURF, 1); RR(rspx + rspw - 76, rsby, 64, 18, 4); col(cBORD, 1); RRO(rspx + rspw - 76, rsby, 64, 18, 4); col(cMUTED, 1); txt("Cancel", rspx + rspw - 44, rsby + 9, 1);
);
// ---- snapshot name popup (top-bar scale, also in section zoom) ----
snedit ? (
  tipon = 0; tipforce = 0;
  gs = gsN; gox = goxN; goy = goyN; WT = WTN; setfonts(); mx = (mouse_x - gox) / gs; my = (mouse_y - goy) / gs;
  snk = snedit - 1; sn_geo();
