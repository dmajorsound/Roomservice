    xGL[k] *= dirg; xGR[k] *= dirg;
    pro_on ? ( qpp = qG5x + k * 5; qpp[0] *= dirg; qpp[1] *= dirg; qpp[2] *= dirg; qpp[3] *= dirg; qpp[4] *= dirg; );   // (RoomservicePro: the loudspeaker gains the same way)
