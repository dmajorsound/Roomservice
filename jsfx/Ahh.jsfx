PT[1200] = 4; PT[1201] = 5; PT[1202] = 3; PT[1203] = 0.85; PT[1204] = 0.85; PT[1205] = 0.85; PT[1206] = 0.85; PT[1207] = 0.85; PT[1208] = 2; PT[1209] = 1.1; PT[1210] = 1.5; PT[1211] = 2; PT[1212] = 3.1; PT[1213] = 1.5; PT[1214] = 1; PT[1215] = 6; PT[1216] = 0; PT[1217] = 0; PT[1218] = 0; PT[1219] = 90;   // Effect rooms – Dead room: RT60 0.08 s
PT[1220] = 1; PT[1221] = 40; PT[1222] = 1; PT[1223] = 0.05; PT[1224] = 0.05; PT[1225] = 0.05; PT[1226] = 0.05; PT[1227] = 0.05; PT[1228] = 0.5; PT[1229] = 1.25; PT[1230] = 0.65; PT[1231] = 0.5; PT[1232] = 7.25; PT[1233] = 0.65; PT[1234] = 1; PT[1235] = 0.5; PT[1236] = 0; PT[1237] = 0; PT[1238] = 0; PT[1239] = 35;   // Effect rooms – Drain pipe: RT60 0.77 s
saveArm = 0;

limbase = rtab + 31 * 17 + 8;               // (end of the old preset table: the memory after it stays where it was)
// ---- MATERIALS per frequency band: mid alpha (500 Hz - 1 kHz) and log(alpha / mid alpha) at 125 Hz and at 4 kHz
// (typical measured values: glazed tiles, window glass, plaster on masonry, rough concrete, sheet metal, wood paneling on
// battens, heavy velour curtain, 5 cm foam, 5 cm mineral wool). Any alpha in between: the shape is interpolated
mtab = limbase; NMAT = 9;
mtab[0] = 0.02; mtab[1] = log(0.67); mtab[2] = log(1.33);     // tiles
mtab[3] = 0.03; mtab[4] = log(8.0);  mtab[5] = log(0.35);   // glass: panes resonate in the bass (more extreme - thin bass, long bright highs)
mtab[6] = 0.04; mtab[7] = log(0.6);  mtab[8] = log(1.6);      // plaster
mtab[9] = 0.05; mtab[10] = log(0.12); mtab[11] = log(3.0);   // concrete (more extreme - booming long bass, dark highs)
mtab[12] = 0.08; mtab[13] = log(1.6); mtab[14] = log(0.35);   // sheet metal (more extreme - very bright, ringing highs)
mtab[15] = 0.10; mtab[16] = log(2.15); mtab[17] = log(0.85);  // wood paneling: bass absorber
mtab[18] = 0.45; mtab[19] = log(0.22); mtab[20] = log(1.02);  // curtain
mtab[21] = 0.70; mtab[22] = log(0.11); mtab[23] = log(1.27);  // foam: almost nothing in the bass
mtab[24] = 0.85; mtab[25] = log(0.16); mtab[26] = log(1.03);  // mineral wool
// the same materials per octave 125 / 250 / 500 / 1k / 2k / 4k Hz (alpha / mid alpha; 500 and 1k average 1) - typical
// measured tables (Hall / Everest / Cox-D'Antonio); 125 Hz and 4 kHz are the values above
mtx = 4194304 + 31000;
// Stores the six per-band absorption ratios of material m (v0..v5) as logs in the material shape table mtx.
function msetx(m, v0, v1, v2, v3, v4, v5) ( mtx[m * 6] = log(v0); mtx[m * 6 + 1] = log(v1); mtx[m * 6 + 2] = log(v2); mtx[m * 6 + 3] = log(v3); mtx[m * 6 + 4] = log(v4); mtx[m * 6 + 5] = log(v5); );
msetx(0, 0.67, 0.75, 0.90, 1.10, 1.20, 1.33);   // tiles
msetx(1, 8.00, 2.40, 1.20, 0.80, 0.45, 0.35);   // glass: the pane resonates in the bass
msetx(2, 0.60, 0.70, 0.90, 1.10, 1.30, 1.60);   // plaster
msetx(3, 0.12, 0.30, 0.75, 1.25, 2.10, 3.00);   // concrete
msetx(4, 1.60, 1.30, 1.10, 0.90, 0.55, 0.35);   // sheet metal
msetx(5, 2.15, 1.69, 1.31, 0.69, 0.77, 0.85);   // wood paneling on battens
msetx(6, 0.22, 0.55, 0.87, 1.13, 1.10, 1.02);   // heavy curtain
msetx(7, 0.11, 0.33, 0.80, 1.20, 1.30, 1.27);   // foam
msetx(8, 0.16, 0.60, 0.93, 1.07, 1.10, 1.03);   // mineral wool
fqBase = mtx + 64;                               // per-octave reverb: RT ratios (8), barrier-mix copy (8), gains (8), coefficients (8 x 30), states (8 x 12), fit matrix (49 + 49), work
fqR = fqBase; fqRo = fqBase + 8; fqG = fqBase + 16; fqC = fqBase + 24; fqS = fqC + 240; fqB = fqS + 96; fqBi = fqB + 49; fqW = fqBi + 49;
memset(fqS, 0, 96); k = 0; loop(8, fqR[k] = 1; fqG[k] = 0; k += 1; ); fqsr = 0; fqCt = fqC; fqGt = fqG;
// ---- RoomservicePro: the REAR NETWORK - 8 more lines for Ls / Rs (16 lines in all in 5.1). Its own lengths (other ratios than
// the main lines: no shared modes, so the rear is uncorrelated with the front), fed 10 ms later than the front and designed a
// little darker (more damping from 2 kHz up). Loop filters, gains, states, length crossfade - all as the main network has them.
fqCB = alloc(240); fqCcB = alloc(240); fqCdB = alloc(240); fqSB = alloc(96); fqGB = alloc(8); fqGcB = alloc(8); fstB = alloc(8); memset(fqCB, 0, 720); memset(fqSB, 0, 120);
flenB = alloc(8); cFLB = alloc(8); oFLB = alloc(8); xfSB = alloc(8); facB = alloc(8); memset(flenB, 0, 40); fwiB = 0; fqmovB = 0; qTailR = 1;
facB[0] = 1.061; facB[1] = 1.203; facB[2] = 1.337; facB[3] = 1.489; facB[4] = 1.627; facB[5] = 1.779; facB[6] = 1.931; facB[7] = 2.089;
QRBN = 8192; qRB = alloc(QRBN); memset(qRB, 0, QRBN); qRBi = 0; qRD = 0;   // the rear offset: a ring for the diffused input (up to 20 ms at 384 kHz)
// clears the rear network (format switch, panic, room off and on again)
function qBclear() ( memset(fdnBbase, 0, 8 * LINEMAXB); memset(fqSB, 0, 96); memset(fstB, 0, 8); memset(qRB, 0, QRBN); k0 = 0; loop(8, cFLB[k0] = flenB[k0]; k0 += 1; ); fwiB = 0; );
// ---- SOURCE DIRECTIVITY per source model: pattern p = (a + (1 - a) cos)^n, floor (leak to the back), darker off-axis
// (share of the highs lost towards the back), high shelf of the power that goes into the room (directional highs)
dtab = mtab + 32;
// Stores the directivity parameters of source model m (pattern a, power n, floor, highs corner, shelf gain) in dtab.
function dset(m, dpa, pn, pfl, phb, psh) ( dtab[m * 5] = dpa; dtab[m * 5 + 1] = pn; dtab[m * 5 + 2] = pfl; dtab[m * 5 + 3] = phb; dtab[m * 5 + 4] = psh; );
dset(0, 0.65, 1, 0.25, 2500, 0.5);      // Original: a talker (Q 2.2, highs beam: behind -16 dB at 4 kHz, -21 dB at 8 kHz)
dset(1, 0.80, 1, 0.30, 5000, 0.7);      // Telephone: small speaker, nearly round
dset(2, 0.80, 1, 0.30, 5000, 0.7);      // Mobile phone
dset(3, 0.80, 1, 0.30, 5000, 0.7);      // Smartphone
dset(4, 0.80, 1, 0.30, 5000, 0.7);      // Walkie-talkie
dset(5, 0.50, 1, 0.20, 3000, 0.5);      // Radio: speaker in a box, front only (Q 3)
dset(6, 0.50, 1, 0.20, 3000, 0.5);      // Boombox
dset(7, 0.55, 1, 0.20, 3000, 0.5);      // TV
dset(8, 0.75, 1, 0.30, 4000, 0.6);      // Laptop
dset(9, 0.75, 1, 0.30, 4000, 0.6);      // Tablet
dset(10, 0.95, 1, 0.80, 9000, 0.8);     // Mini speaker: 360 degrees
dset(11, 1.00, 1, 1.00, 14000, 0.9);    // Headphones (leaking sound): round
dset(12, 0.50, 3, 0.08, 1200, 0.35);    // Megaphone: horn, Q 7, highs strongly beamed
// ---- EARLY CLUSTER: 24 directions (Fibonacci sphere) and arrival fractions, density growing with t^2 like real reflections
cdir = dtab + 72; cufr = cdir + 80;
// DELAY (before the room): two lines of 4 s, the side signal for the direct sound (as long as the input line), filter
// coefficients and states; TEMPO ANALYSIS: onset strength in 10 ms frames (10 s)
dlC = cufr + 32; dlSt = dlC + 32; anaNv = dlSt + 16; ANAMAX = 1000;   // (the delay lines themselves: see srlayout)
memset(dlL, 0, 2 * DLMAX + 2 * MAXIN); memset(dlC, 0, 48 + ANAMAX + 80);
dwi = 0; dlhold = 0; shold = 0; sideIn = 0; cDON = 0; dllkey = -1; anaOn = 0; anaN = 0; anaDone = 0; anaSc = anaNv + ANAMAX + 8;
osC = anaSc + 80; osU = osC + 32; osD = osU + 16; memset(osU, 0, 32);   // 4x oversampling of the source-model distortion
mdM = osD + 16; mdT = mdM + 128 * 6 + 8; mdX = mdT + 300 * 4 + 8; mdXS = mdX + 64; mdP = mdXS + 32; mdPf = mdP + 300; mdF = mdPf + 100;
mdI = mdF + 132; mdPi = mdI + 132; mdQ = mdPi + 132; mdQf = mdQ + 128 * 6 + 8; mdQi = mdQf + 132; mdUs = mdQi + 132;   // modes: ids (nx ny nz), merge buffers
bpkC = mdUs + 132; bpkS = bpkC + 8; memset(bpkS, 0, 8);   // barrier coincidence peak: coefficients, states (out L R, neighbor L R)
memset(mdM, 0, 128 * 6); memset(mdXS, 0, 24); mdN = 0; mdPN = 0; mdPend = 0; mdx1 = mdx2 = 0;   // ROOM MODES
// osC: 5 biquad sections (b0 b1 b2 a1 a2 each) of the elliptic low-pass used for the 4x up / down sampling; oc0 … oc24 below are scalar copies of the same values (faster in the inner loop)
osC[0] = 0.00013044032859283806; osC[1] = 0.00019700083762148941; osC[2] = 0.00013044032859283803; osC[3] = -1.5232480565269744; osC[4] = 0.59407966273118606;
osC[5] = 1; osC[6] = -0.08847383427992779; osC[7] = 1.0000000000000002; osC[8] = -1.4997225020050786; osC[9] = 0.67207517614275214;
osC[10] = 1; osC[11] = -0.8130179791719655; osC[12] = 0.99999999999999989; osC[13] = -1.4717689893251873; osC[14] = 0.78105330244098525;
osC[15] = 1; osC[16] = -1.088083953915002; osC[17] = 1.0000000000000002; osC[18] = -1.4590266712276223; osC[19] = 0.88063362441987625;
osC[20] = 1; osC[21] = -1.1853552911927485; osC[22] = 0.99999999999999978; osC[23] = -1.4746145339349073; osC[24] = 0.96224384683568642;
oc0 = osC[0]; oc1 = osC[1]; oc2 = osC[2]; oc3 = osC[3]; oc4 = osC[4]; oc5 = osC[5]; oc6 = osC[6]; oc7 = osC[7]; oc8 = osC[8]; oc9 = osC[9];
oc10 = osC[10]; oc11 = osC[11]; oc12 = osC[12]; oc13 = osC[13]; oc14 = osC[14]; oc15 = osC[15]; oc16 = osC[16]; oc17 = osC[17]; oc18 = osC[18]; oc19 = osC[19];
oc20 = osC[20]; oc21 = osC[21]; oc22 = osC[22]; oc23 = osC[23]; oc24 = osC[24]; su0 = su1 = su2 = su3 = su4 = su5 = su6 = su7 = su8 = su9 = 0; sd0 = sd1 = sd2 = sd3 = sd4 = sd5 = sd6 = sd7 = sd8 = sd9 = 0;
k = 0;
loop(NCL,
  cz0 = 1 - 2 * (k + 0.5) / NCL; cr0 = sqrt(1 - cz0 * cz0); cph = k * 2.39996323;
  cdir[k * 3] = cr0 * cos(cph); cdir[k * 3 + 1] = cr0 * sin(cph); cdir[k * 3 + 2] = cz0;
  cufr[k] = ((k + 0.5) / NCL + 0.37 * sin(k * 12.9898) / NCL);     // jittered, stable
  k += 1;
);
// shuffle the directions against the times (otherwise early = from above, late = from below)
// k <-> (7k + 3) mod 24 pairs every index with exactly one partner - each pair is now swapped once (j0 > k) and with all
// three components; before, every pair was swapped twice (back again) and the shuffle did nothing
k = 0; loop(NCL, j0 = (k * 7 + 3) % NCL; j0 > k ? (
  cs0 = cdir[k * 3]; cdir[k * 3] = cdir[j0 * 3]; cdir[j0 * 3] = cs0;
  cs0 = cdir[k * 3 + 1]; cdir[k * 3 + 1] = cdir[j0 * 3 + 1]; cdir[j0 * 3 + 1] = cs0;
  cs0 = cdir[k * 3 + 2]; cdir[k * 3 + 2] = cdir[j0 * 3 + 2]; cdir[j0 * 3 + 2] = cs0; ); k += 1; );
// vopt: fixed address (see above): [0] marker, [1] paths, [2] direct line, [3] tips, [4] dark, [5] link, [6] waves, [7] b&w, [8] predelay follows the room
// first start of an instance: view defaults (vopt[64], vopt[65] = reflector levels +12 dB, vopt[66] = reflectors off flag (0 = on), vopt[67] = free-field outline view ON, vopt[68] = Input Guard OFF)
vopt[0] != 7333 ? ( vopt[64] = vopt[65] = 12; vopt[66] = 0; vopt[67] = 1; vopt[68] = 0; vopt[69] = 0; vopt[0] = 7333; vopt[1] = 0; vopt[2] = 0; vopt[3] = 0; vopt[4] = 1; vopt[8] = 1; vopt[16] = 1; vopt[11] = 1; vopt[12] = 2304; vopt[14] = vopt[15] = 0; memset(vopt + 21, 0, 24); vopt[45] = 0; vopt[46] = 1; vopt[47] = 0; );   // (Expert: Timeline and Decay by band folded)   // new instance: Basic view
lastlc = lasthc = -1;
// AUTOMATION FROM THE GUI (REAPER 6.74+):
//   slider_automate(sliderX, 0)  begins / continues a touch session  (called on every value change while held)
//   slider_automate(sliderX, 1)  ends the session                   (called on mouse release)
//   slider_automate(sliderX)     legacy one-shot write, no session   (buttons, presets, reset, wheel)
// The one-argument form must NOT be used for gestures: REAPER treats it as a momentary write and the
// envelope takes over again between GUI frames (only visible in Touch/Latch during playback).
// While a gesture is held, @block re-asserts the GUI value each block as a safety net.
