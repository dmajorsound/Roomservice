// Draws the surface texture of reflector panel material m (1 facade windows, 2 glass, 3 rock strata, 4 fence pickets, 5 hedge leaves) using pnq and pnl
function pntex(m) local(i, j, nc, nr, u, v)
(
  m < 1.5 ? (
    nc = min(24, max(2, floor(pnHl * 2 / 3.2))); nr = min(8, max(1, floor(pnH / 3)));
    col(darkmode ? 0xB8C2CF : 0x7F8EA6, 1);   // opaque: two overlapping half-transparent triangles would show a seam
