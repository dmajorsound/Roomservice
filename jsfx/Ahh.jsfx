  col(cMUTED, 1); gfx_setfont(7); txt("Enter = save   Esc = cancel", rspx + rspw - 12, rspy + 15, 2);
  rsex = !rsren && urfind(rsnb) >= 0; rsclash = rsren && urfind(rsnb) >= 0 && urfind(rsnb) != rsren - 1;
  col(cTEXT, 1); gfx_setfont(6); txt("Name", rsfx, rsny - 8, 0);
