  p == 4 ? ( LNW(cx - 11, cy + 4, cx + 11, cy + 4, 0.85); LNW(cx + 11, cy + 4, cx + 7, cy + 1, 0.85); LNW(cx + 11, cy + 4, cx + 7, cy + 7, 0.85); CIF(cx - 1, cy + 4, 1.7, 1); CIF(cx - 6, cy + 4, 1.1, 1); CIF(cx, cy - 5, 2.2, 0); ) : (
  p == 5 ? ( LNBOX(cx - 7, cy - 7, 14, 14, 0.85); LNW(cx + 7, cy - 1, cx + 4, cy + 2, 0.85); LNW(cx + 7, cy - 1, cx + 10, cy + 2, 0.85); CIF(cx, cy, 1.6, 1); ) : (
  p == 6 ? ( mik = 0; loop(12, LNW(cx - 11 + mik * 22 / 12, cy - 5 * sin(mik * $pi / 3), cx - 11 + (mik + 1) * 22 / 12, cy - 5 * sin((mik + 1) * $pi / 3), 0.85); mik += 1; ); CIF(cx + 0.5, cy - 4.3, 1.7, 1); ) : (
