  tipbox(arx, tpy0 + 26, arw, 16, "Click, then play the selected clip or the time selection – Ahh listens for 10 s (a JSFX cannot read files directly)");
  col(cHAIR, 1); RR(arx, tpy0 + 46, arw, 3, 1.5); anaN > 0 ? ( col(cDLTT, 1); RR(arx, tpy0 + 46, max(3, arw * anaN / ANAMAX), 3, 1.5); );
  col(cBG, 1); RR(arx, tpy0 + 52, arw, 13, 3);
