  // twice, +3 dB) - for wavelengths that are long against the distance, i.e. below c / (2 pi d). The direct sound and the
  // early reflections get their boundary gain from the mirror sources already; this adds it to the tail. Nearest surface only.
  bndd = roomH; bnda = 1;
  fcg ? ( sz < bndd ? ( bndd = sz; bnda = aF; ); roomH - sz < bndd ? ( bndd = roomH - sz; bnda = aF; ); );
  !isfree ? (
    sx < bndd ? ( bndd = sx; bnda = aW; ); roomW - sx < bndd ? ( bndd = roomW - sx; bnda = aE; );
    sy < bndd ? ( bndd = sy; bnda = aN; ); roomD - sy < bndd ? ( bndd = roomD - sy; bnda = aS; );
  );
  bndd = max(0.1, bndd);
  xBNG = isfree ? 0 : sqrt(1 + (1 - bnda)) - 1;                 // extra amplitude below the corner
  xBNA = 1 - exp(-2 * $pi * min(800, max(20, C_SND / (2 * $pi * bndd))) / srate);
);


// ---------- GUI helpers (design units, 760 wide, scaled by gs) ----------
// black & white mode: every color becomes its gray value (luminance), nothing else changes
function gmono() local(v) ( monoOn ? ( v = 0.299 * gfx_r + 0.587 * gfx_g + 0.114 * gfx_b; v = min(1, max(0, (v - 0.5) * 1.5 + 0.5)); gfx_r = gfx_g = gfx_b = v; ); );   // gray value, contrast x1.5
// cfade: opacity of everything drawn through col() - 1 normally, ramps up while a help text fades in
function col(c, al) ( gfx_r = floor(c / 65536) / 255; gfx_g = (floor(c / 256) % 256) / 255; gfx_b = (c % 256) / 255; gfx_a = al * cfade; gmono(); );
// ---- pixel-exact boxes ----
// Every box is snapped to whole screen pixels FIRST (left / top / right / bottom edge each rounded once), so neighbors
// share their edges exactly, fill and outline of one shape cover the same pixels, and nothing sticks out by a pixel.
// PXR leaves the box in gpx0, gpy0 (top left) and gpw, gph (size in pixels).
function PXR(x, y, w, h)
(
  gpx0 = floor(gox + x * gs + 0.5); gpy0 = floor(goy + y * gs + 0.5);
  gpw = floor(gox + (x + w) * gs + 0.5) - gpx0; gph = floor(goy + (y + h) * gs + 0.5) - gpy0;
);
// Draws a filled rectangle in GUI units (x, y, w, h) with the current color, clipped to the room view when gclp is set.
function R(x, y, w, h) local(x2, y2)
(
  gclp ? ( x2 = min(x + w, clX1); y2 = min(y + h, clY1); x = max(x, clX0); y = max(y, clY0); w = x2 - x; h = y2 - y; );   // inside the room view
  w > 0 && h > 0 ? ( PXR(x, y, w, h); gfx_rect(gpx0, gpy0, max(1, gpw), max(1, gph)); );
);
// filled rounded box: drawn row by row (no part is painted twice - also correct with transparency), the two pixels at
// the ends of each corner row get the share of the circle they cover (smooth corners)
function RR(x, y, w, h, rad) local(crad, i, yc, ins, cins, fr, a0)
(
  w > 0 && h > 0 ? (
    PXR(x, y, w, h); gpw = max(1, gpw); gph = max(1, gph);
    crad = min(floor(rad * gs + 0.5), floor(min(gpw, gph) / 2));
    crad < 2 ? gfx_rect(gpx0, gpy0, gpw, gph) : (
      a0 = gfx_a;
      gph > 2 * crad ? gfx_rect(gpx0, gpy0 + crad, gpw, gph - 2 * crad);
      i = 0;
      loop(crad,
        yc = crad - i - 0.5; ins = crad - sqrt(crad * crad - yc * yc);      // how far this row is set in from the side
        cins = ceil(ins - 0.0001); fr = cins - ins;
        gpw > 2 * cins ? ( gfx_rect(gpx0 + cins, gpy0 + i, gpw - 2 * cins, 1); gfx_rect(gpx0 + cins, gpy0 + gph - 1 - i, gpw - 2 * cins, 1); );
        fr > 0.04 && cins >= 1 ? (
          gfx_a = a0 * fr;
          gfx_rect(gpx0 + cins - 1, gpy0 + i, 1, 1); gfx_rect(gpx0 + gpw - cins, gpy0 + i, 1, 1);
          gfx_rect(gpx0 + cins - 1, gpy0 + gph - 1 - i, 1, 1); gfx_rect(gpx0 + gpw - cins, gpy0 + gph - 1 - i, 1, 1);
          gfx_a = a0;
        );
        i += 1;
      );
    );
  );
);
// outline of the same box: on its outermost pixels
function RRO(x, y, w, h, rad) local(crad)
(
  w > 0 && h > 0 ? (
    PXR(x, y, w, h); gpw = max(2, gpw); gph = max(2, gph);
    crad = min(floor(rad * gs + 0.5), floor(min(gpw, gph) / 2));
    gfx_roundrect(gpx0, gpy0, gpw - 1, gph - 1, min(crad, floor((min(gpw, gph) - 1) / 2)), 1);   // pill ends: two clean half circles
  );
);
// the source icons are small free drawings: they keep the unsnapped versions
function RRF(x, y, w, h, rad) local(rx0, ry0, pw, ph, pr)
(
  rx0 = gox + x * gs; ry0 = goy + y * gs; pw = w * gs; ph = h * gs;
  pr = min(rad * gs, min(pw, ph) / 2);
  gfx_rect(rx0 + pr, ry0, pw - 2 * pr, ph);
  gfx_rect(rx0, ry0 + pr, pr, ph - 2 * pr);
  gfx_rect(rx0 + pw - pr, ry0 + pr, pr, ph - 2 * pr);
  gfx_circle(rx0 + pr, ry0 + pr, pr, 1, 1);
  gfx_circle(rx0 + pw - pr - 1, ry0 + pr, pr, 1, 1);
  gfx_circle(rx0 + pr, ry0 + ph - pr - 1, pr, 1, 1);
  gfx_circle(rx0 + pw - pr - 1, ry0 + ph - pr - 1, pr, 1, 1);
);
// Draws a 1 px anti-aliased rounded-rectangle outline at design-unit x,y,w,h with corner radius rad, scaled by gs and offset by gox/goy.
function RROF(x, y, w, h, rad) ( gfx_roundrect(gox + x * gs, goy + y * gs, w * gs, h * gs, rad * gs, 1); );
// PIXEL-SNAPPED HAIRLINE (screen pixels): a horizontal or vertical line lies exactly on whole device pixels (no blur across two
// half-gray rows at an odd scale) and grows with the scale (1 px up to 2.3x, then 2 px ...); a slanted line stays anti-aliased, as thick
function LNPX(u1, v1, u2, v2) local(t, a, b, nx, ny, l, k)
(
  t = max(1, floor(gs * 0.75 + 0.25)); l = sqrt(sqr(u2 - u1) + sqr(v2 - v1));
  l < 0.75 ? 0 : ( abs(v2 - v1) < 0.01 ? (   // (a stroke shorter than 3/4 px is left out - as the anti-aliased line drew next to nothing)
    a = floor(min(u1, u2) + 0.5); b = floor(max(u1, u2) + 0.5); gfx_rect(a, floor(v1 + 0.5 - t / 2), b - a + 1, t);
  ) : ( abs(u2 - u1) < 0.01 ? (
    a = floor(min(v1, v2) + 0.5); b = floor(max(v1, v2) + 0.5); gfx_rect(floor(u1 + 0.5 - t / 2), a, t, b - a + 1);
  ) : (
    gfx_line(u1, v1, u2, v2, 1);
