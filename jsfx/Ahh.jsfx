// word-wrapped text (UTF-8 bytes), max ml lines; snCx / snCy = end of the text (for the caret)
function sn_wrap(b, n, x, y, w, wlh, ml) local(ls, i, i2, sp, fit, e, wln, wlw, wch)
(
  ls = 0; wln = 0; wlw = 0;
  while (
    i = ls; sp = -1; fit = 1; strcpy(#swl, "");
    while ( i < n && fit ? (
        i2 = i + 1; while ( i2 < n && (b[i2] & 192) == 128 ? ( i2 += 1; 1; ) : 0; );
        strcpy(#swc, #swl); strcat(#swc, sn_sub(b, i, i2, #swt)); gfx_measurestr(#swc, wlw, wch);
        wlw > w * gs && i > ls ? ( fit = 0; ) : ( b[i] == 32 ? ( sp = i; ); strcpy(#swl, #swc); i = i2; );
        1;
      ) : 0; );
    e = i;
