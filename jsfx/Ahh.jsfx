// ---- text helpers: txt / txtbox / txtboxR / txtfit / txtplate (font slot 9 holds a shrunken copy of the current font when a label has to fit) ----
// Positions come from gfx_measurestr and are rounded to whole pixels, so letters sit exactly centered in circles and buttons.
// font sizes / bold flags as set in setfonts() (used to shrink a label that would not fit its box)
function fsz(i) ( i == 1 ? FS1 : (i == 2 ? FS2 : (i == 3 ? FS3 : (i == 4 ? FS4 : (i == 5 ? FS5 : (i == 6 ? FS6 : (i == 15 ? FS15 : (i == 16 ? FS16 : FS7))))))); );
// Returns 1 if font slot i is drawn bold (every slot except 4, 7 and 16), used when making a shrunken copy of the font.
function fbd(i) ( i != 4 && i != 7 && i != 16; );
// text at (x, yc): al 0 = left, 1 = centered, 2 = right; vertically centered on yc using the measured line height
function txt(s, x, yc, al) local(px, py, tw2, th2)
(
  rvTX || (gclp && (x < clX0 || x > clX1 || yc < clY0 || yc > clY1)) ? 0 : (
  gfx_measurestr(s, tw2, th2);
  px = gox + x * gs; py = goy + yc * gs;
  gfx_x = floor((al == 1 ? px - tw2 / 2 : (al == 2 ? px - tw2 : px)) + 0.5);
  gfx_y = floor(py - th2 / 2 + 0.5);
  gfx_drawstr(s);
  );
