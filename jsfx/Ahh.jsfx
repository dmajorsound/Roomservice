             hx = cx + (mid ? 1 : 2) * r * ux; hy = cy + (mid ? 1 : 2) * r * uy; cx -= mid ? r * ux : 0; cy -= mid ? r * uy : 0; );   // the anchor of a pass-by = its start A
  p == 7 && MTDP[512] >= 256 ? ( km = 0; k = 0; loop(256, MTDP[2 * k] > MTDP[2 * km] ? km = k; k += 1; ); hx = cx + r * MTDP[2 * km]; hy = cy + r * MTDP[2 * km + 1]; hz = cz + r * MTDP[514 + km]; );
