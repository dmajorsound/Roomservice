// Returns true if the mouse (mx,my) is inside the rectangle x,y,w,h.
function inbox(x, y, w, h) ( mx >= x && mx < x + w && my >= y && my < y + h; );
// If the mouse is in the rect x,y,w,h, requests tooltip text s (tipon, tipstr) anchored at its center, below it when y < 60 else above.
function tipbox(x, y, w, h, s) ( inbox(x, y, w, h) ? ( tipon = 1; tipstr = s; tipx = x + w / 2; tipy = y < 60 ? y + h + 12 : y - 12; ); );
// icon buttons: the tooltip also with Tips off - then only the name and a short line (Tips on: the full text)
function itip(x, y, w, h, sf, ss) ( inbox(x, y, w, h) ? ( tipbox(x, y, w, h, tipShow ? sf : ss); tipforce = !tipShow && !(mouse_cap & 1); ); );
// Tooltip s over a knob centered at (cx,cy): hit rect of 44 x 48 units scaled by KSC (calls tipbox).
function knobtip(cx, cy, s) ( tipbox(cx - 22 * KSC, cy - 14 * KSC, 44 * KSC, 48 * KSC, s); );
// Sets the font sizes FS1-FS7 from the display scale gs (20 percent larger in zoomed tab modules) and creates Arial font slots 1-7 and 11-14.
function setfonts()
(
  fbz = tabm && szoom && gs == gsZ && gsZ != gsN ? 1.2 : 1; fgs = gs * fbz;   // text in the tab modules 20 % larger
  FS6 = 8.5 * fgs; FS7 = 8 * fgs; FS1 = 8.5 * fgs; FS2 = 9.5 * fgs; FS3 = 11 * fgs; FS4 = 8.5 * fgs; FS5 = 13.5 * fgs;
  gfx_setfont(6, "Arial", FS6, 'b');        // small buttons, chips
  gfx_setfont(7, "Arial", FS7);             // small hints
  gfx_setfont(1, "Arial", FS1, 'b');        // labels
  gfx_setfont(2, "Arial", FS2, 'b');        // headings, knob values
  gfx_setfont(3, "Arial", FS3, 'b');        // values (Basic knobs)
  gfx_setfont(4, "Arial", FS4);             // small text, knob names
  gfx_setfont(5, "Arial", FS5, 'b');        // title
  gfx_setfont(11, "Arial", 6.5 * gs);        // tiny label (Snapshots)
  gfx_setfont(12, "Arial", 7 * gs, 'b');     // snapshot numbers
  gfx_setfont(13, "Arial", 10 * gs);         // info window: names
