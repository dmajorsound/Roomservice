);
// the stroke -> 256 points at equal TIME steps (the speed of the drawing is kept: fast and slow parts), closed into a
// loop (the way back to the start at the average speed), smoothed a little; center + size + duration in MTDP; the motion starts
function mtfinish() local(zcm, L, k, j, t, f, cxm, cym, R, mv, Tdur, Tback, Ttot, Lc, v, n, p0, p1, x0, y0, t0)
(
  mtRec = 0; n = mtRN;
  L = 0; k = 0; loop(max(0, n - 1), L += sqrt(sqr(mtRB[3 * k + 3] - mtRB[3 * k]) + sqr(mtRB[3 * k + 4] - mtRB[3 * k + 1])); k += 1; );
  n >= 4 && L > 0.3 ? (
    Tdur = mtRB[3 * n - 1] - mtRB[2];
    Tdur < 0.3 ? ( t = 0;   // (no usable timing: even speed along the line)
                k = 1; mtRB[2] = 0; loop(n - 1, t += sqrt(sqr(mtRB[3 * k] - mtRB[3 * k - 3]) + sqr(mtRB[3 * k + 1] - mtRB[3 * k - 2])) / L; mtRB[3 * k + 2] = t; k += 1; ); Tdur = 1; )
          : ( t0 = mtRB[2]; k = 0; loop(n, mtRB[3 * k + 2] -= t0; k += 1; ); );
    Lc = sqrt(sqr(mtRB[0] - mtRB[3 * n - 3]) + sqr(mtRB[1] - mtRB[3 * n - 2])); v = L / Tdur; Tback = min(Tdur, Lc / max(0.001, v)); Ttot = Tdur + max(0.05, Tback);
    k = 0; j = 0;
    loop(256,
      t = k * Ttot / 256;
      t <= Tdur ? (
        while ( j < n - 2 && mtRB[3 * j + 5] < t ? ( j += 1; 1; ) : 0; );
        f = mtRB[3 * j + 5] - mtRB[3 * j + 2] > 0.000001 ? min(1, max(0, (t - mtRB[3 * j + 2]) / (mtRB[3 * j + 5] - mtRB[3 * j + 2]))) : 0;
        mtRSm[2 * k] = mtRB[3 * j] + (mtRB[3 * j + 3] - mtRB[3 * j]) * f; mtRSm[2 * k + 1] = mtRB[3 * j + 1] + (mtRB[3 * j + 4] - mtRB[3 * j + 1]) * f;
        mtRSz[k] = mtRBz[j] + (mtRBz[j + 1] - mtRBz[j]) * f;
      ) : (
        f = (t - Tdur) / max(0.05, Ttot - Tdur);
        mtRSm[2 * k] = mtRB[3 * n - 3] + (mtRB[0] - mtRB[3 * n - 3]) * f; mtRSm[2 * k + 1] = mtRB[3 * n - 2] + (mtRB[1] - mtRB[3 * n - 2]) * f;
        mtRSz[k] = mtRBz[n - 1] + (mtRBz[0] - mtRBz[n - 1]) * f;
      );
      k += 1;
    );
    // two passes of a gentle smoothing (1 2 1, around the loop): no frame-rate jitter in the speed
    loop(2,
      x0 = mtRSm[510]; y0 = mtRSm[511]; p0 = mtRSm[0]; p1 = mtRSm[1]; k = 0;
      loop(256, j = (k + 1) % 256; f = k == 255 ? p0 : mtRSm[2 * j]; t = k == 255 ? p1 : mtRSm[2 * j + 1];
        cxm = mtRSm[2 * k]; cym = mtRSm[2 * k + 1];
        mtRSm[2 * k] = 0.25 * x0 + 0.5 * cxm + 0.25 * f; mtRSm[2 * k + 1] = 0.25 * y0 + 0.5 * cym + 0.25 * t; x0 = cxm; y0 = cym; k += 1; );
    );
    cxm = 0; cym = 0; k = 0; loop(256, cxm += mtRSm[2 * k]; cym += mtRSm[2 * k + 1]; k += 1; ); cxm /= 256; cym /= 256;
    R = 0.05; k = 0; loop(256, R = max(R, sqrt(sqr(mtRSm[2 * k] - cxm) + sqr(mtRSm[2 * k + 1] - cym))); k += 1; );
    snap_take();
    mtEg > 0.001 || slider100 >= 0.5 ? ( mtKill = 1; slider100 = 0; );
    zcm = 0; k = 0; loop(256, zcm += mtRSz[k]; k += 1; ); zcm /= 256;
    // MTDP layout (770 values): 0 … 511 = x, y per point in units of R around the center, 512 = point count, 513 = duration (s), 514 … 769 = z; MTDS keeps four such slots
    k = 0; loop(256, MTDP[2 * k] = (mtRSm[2 * k] - cxm) / R; MTDP[2 * k + 1] = (mtRSm[2 * k + 1] - cym) / R; MTDP[514 + k] = (mtRSz[k] - zcm) / R; k += 1; ); MTDP[512] = 256; MTDP[513] = Ttot; memcpy(MTDS + 770 * min(3, max(0, floor(MTDS[3080] + 0.5))), MTDP, 770);   // kept in the slot in use
    mv = floor(slider101 + 0.5);
