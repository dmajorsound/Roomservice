         : ( anaok ? sprintf(#w1, "done · %d onsets", anaOns) : (anaDone == -1 || (anaDone == 1 && anaRes == -1) ? strcpy(#w1, "no clear beat – try a rhythmic part") : strcpy(#w1, "not started")) );
  col(cMUTED, 1); gfx_setfont(7); txtfit(#w1, arx, tpy0 + 73, arw);
  anaok ? (
