  fbp[fwiB] = cTH * f4 + sn * s4 + inj; fbp += LINEMAXB; fbp[fwiB] = cTH * f5 + sn * s5 - inj; fbp += LINEMAXB;
  fbp[fwiB] = cTH * f6 + sn * s6 - inj; fbp += LINEMAXB; fbp[fwiB] = cTH * f7 + sn * s7 + inj;
