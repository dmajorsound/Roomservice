// ---------- source icons (design units, origin = bottom center) ----------
function icR(x, y, w, h, rr0, c) ( icOL ? ( col(icInk, 1); RROF(icx + x * ik, icy + y * ik, w * ik, h * ik, rr0 * ik); ) : ( col(c, 1); RRF(icx + x * ik, icy + y * ik, w * ik, h * ik, rr0 * ik); ); );
// Icon part: circle at (x,y) radius rr0 in icon space (origin icx,icy, scale ik); filled in color c, or ink outline when icOL is set.
function icC(x, y, rr0, c) ( icOL ? ( col(icInk, 1); CIF(icx + x * ik, icy + y * ik, rr0 * ik, rr0 * ik < 1.2); ) : ( col(c, 1); CIF(icx + x * ik, icy + y * ik, rr0 * ik, 1); ); );
// Icon part: line (x1,y1)-(x2,y2) of width w in icon space; color c, or icInk with width capped at 1.2 in outline mode (icOL).
