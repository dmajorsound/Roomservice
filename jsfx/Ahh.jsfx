// BARRIER: what the closed wall / door / window lets through, 63 Hz - 16 kHz, relative to 500 Hz (its level there = Damp):
// the shelf of the material (mass law, gaps) and its coincidence peak, as the sound engine uses them
function barresp(f) local(mx5, mcm, mm, h5r, h5i, hr, hi, a, w, pk, p5)
(
  // shelf |H| = mm + (1 - mm) / (1 + jw), w = f / bfEl (corner); mm is limited so the loss at 500 Hz never exceeds dEl (Damp, dB); then the coincidence peak (bpkG dB at bpkF, Q bpkQ) is added; all relative to 500 Hz
  mm = bmEl; mx5 = sqr(500 / bfEl); mcm = (1 + mx5) / (1 + mm * mm * mx5);
  mcm * 10 ^ (-dEl / 10) > 1 ? ( mcm = 10 ^ (dEl / 10); mm = sqrt(max(0, ((1 + mx5) / mcm - 1) / mx5)); );
  w = f / bfEl; hr = mm + (1 - mm) / (1 + w * w); hi = -(1 - mm) * w / (1 + w * w);
  w = 500 / bfEl; h5r = mm + (1 - mm) / (1 + w * w); h5i = -(1 - mm) * w / (1 + w * w);
  a = 10 * log10(max(0.0000001, (hr * hr + hi * hi) / (h5r * h5r + h5i * h5i)));
  bpkG > 0.05 ? (
    pk = 10 ^ (bpkG / 40); w = f / bpkF; p5 = 500 / bpkF;
    a += 10 * log10(((1 - w * w) ^ 2 + sqr(w * pk / bpkQ)) / ((1 - w * w) ^ 2 + sqr(w / (pk * bpkQ))));
    a -= 10 * log10(((1 - p5 * p5) ^ 2 + sqr(p5 * pk / bpkQ)) / ((1 - p5 * p5) ^ 2 + sqr(p5 / (pk * bpkQ))));
  );
  a;
);
// Draws the barrier transmission graph at (x,y,w,h): response 63 Hz-16 kHz via barresp, relative to 500 Hz, with grid and tooltip
function bargraph(x, y, w, h) local(k, f, gx, gy, py, px, v)
(
  col(cBG, 1); RR(x, y, w, h, 4);
  col(cHAIR, 1); k = 0; loop(3, f = k == 0 ? 125 : (k == 1 ? 1000 : 8000); gx = x + log(f / 63) / log(16000 / 63) * w; LN(gx, y + 2, gx, y + h - 2); k += 1; );
  gy = y + 3 + 15 / 40 * (h - 6); LN(x + 2, gy, x + w - 2, gy);              // 0 dB = the level at 500 Hz (Damp)
  btg > 0 ? (
    col(cBARTT, 1); k = 0;
    // 41 log-spaced points, 63 Hz - 16 kHz; vertical range +15 … -25 dB (0 dB line at 15/40 of the height)
    loop(41,
      f = 63 * (16000 / 63) ^ (k / 40); v = min(15, max(-25, barresp(f)));
      px = x + 3 + k / 40 * (w - 6); py = y + 3 + (15 - v) / 40 * (h - 6);
      k > 0 ? LNW(gx, gy, px, py, 1.4); gx = px; gy = py; k += 1;
    );
  );
  h >= 24 ? ( col(cDIM2, 1); gfx_setfont(7); txt("125", x + log(125 / 63) / log(16000 / 63) * w, y + h - 5, 1); txt("1k", x + log(1000 / 63) / log(16000 / 63) * w, y + h - 5, 1); txt("8k", x + log(8000 / 63) / log(16000 / 63) * w, y + h - 5, 1); );
  btg > 0 ? tipbox(x, y, w, h, "What the closed part lets through, 63 Hz – 16 kHz, relative to 500 Hz (the level there = Damp): more bass (mass law), fewer highs – glass and drywall pass more around their coincidence frequency, doors without seals keep their highs through the gaps");
);
// BARRIER info: what reaches the listener (direct sound, room spill / next room, path)
function barinfo(x, y, xr)
(
  gfx_setfont(4); col(btg > 0 ? cMUTED : cDIM2, 1);
  txt("Direct sound", x, y, 0); txt(bil3 ? "Next room" : "Room leak", x, y + 14, 0);
  gfx_setfont(2); col(btg > 0 ? cBARTT : cDIM2, 1); txt(#bi1, xr, y, 2);
  col(btg > 0 ? cTEXT : cDIM2, 1); txt(#bi3, xr, y + 14, 2);
  gfx_setfont(7); col(btg > 0 ? cTEXT : cDIM2, 1); txt(#bi2, x, y + 29, 0);
  btg > 0 ? tipbox(x, y - 6, xr - x, 12, isfree ? "Free field: a free-standing wall (room width × height) – sound bends around its top and side edges" : (btg == 1 ? "Wall over the full width and height" : (btg == 2 ? "Window 1.2 × 1.2 m, sill 0.9 m – the wall around it is brick, 45 dB" : "Door 0.9 × 2.1 m – the wall around it is brick, 45 dB")));
  btg > 0 && !isfree ? tipbox(x, y + 8, xr - x, 12, bil3 ? "Next room: how much quieter the reverb of the room behind the barrier comes back – depends on Damp, the opening and the size of both rooms" : "Room spill: how much quieter the room sound of the other side arrives – depends on Damp, the opening, the wall area, the room sizes and on how close source and listener are to the barrier");
);
// SOURCE EQ curve (edit = 1: points H, 1-3, L can be dragged; 0 = display only, Basic view)
function eqview(edit)
(
!fzrespok ? ( fzcache(); fzrespok = 1; );
sqpx = sqx + 6; sqpy = sqy + 4; sqpw = sqw - 12; sqph = sqh - 16;
col(cSURF, 1); RR(sqx, sqy, sqw, sqh, 3); col(cHAIR, 1); RRO(sqx, sqy, sqw, sqh, 3);
col(cHAIR, 1);
gi = 0; loop(3, fq = gi == 0 ? 100 : (gi == 1 ? 1000 : 10000); gx = sqfx(fq); LN(gx, sqy + 3, gx, sqpy + sqph); gi += 1; );
col(cBORD, 1); LN(sqpx, sqgy(0), sqpx + sqpw, sqgy(0));
col(cMUTED, 1); gfx_setfont(7);
txt("100", sqfx(100), sqy + sqh - 6, 1); txt("1k", sqfx(1000), sqy + sqh - 6, 1); txt("10k", sqfx(10000), sqy + sqh - 6, 1);
txt("0 dB", sqpx + sqpw, sqgy(0) - 5, 2);
g_fzfill(fzBP, fzsel);                                 // the unedited model (drag = offset from it)
g_fzdesign(fzt, fzTP, fzsel, 1);                       // the edited model, as it is heard
eqk = fzsel * 1000 + g_fzkeyf() + srate;
eqk != lasteqk ? ( gi = 0; loop(400, fzcur[gi] = fzmagdb(20 * 1000 ^ (gi / 399)); gi += 1; ); lasteqk = eqk; );
// one value per screen pixel (linear between the 400 points)
sqn = min(4096, max(2, floor(sqpw * gs))); gi = 0;
loop(sqn, sqt = gi / (sqn - 1) * 399; sqi = min(398, floor(sqt)); sqf = sqt - sqi; cvY[gi] = goy + sqgy(fzcur[sqi] * (1 - sqf) + fzcur[sqi + 1] * sqf) * gs; gi += 1; );
cvfill(floor(gox + sqpx * gs + 0.5), sqn, floor(goy + (sqpy + sqph) * gs + 0.5), cSRTT, 0.24, floor(goy + sqpy * gs));
cvline(floor(gox + sqpx * gs + 0.5), sqn, cSRTT, 1, 1.6);
// the call line on top: device x network band, dashed (Butterworth HP 4th / LP 8th order, as in the audio path)
fzsel > 0 && slider114 >= 0.5 ? (
  lnfh = slider114 < 1.5 ? 300 : (slider114 < 2.5 ? 100 : 50); lnfl = slider114 < 1.5 ? 3400 : (slider114 < 2.5 ? 7000 : 14000);
  gi = 0;
  loop(399,
    fq = 20 * 1000 ^ (gi / 399); fq2 = 20 * 1000 ^ ((gi + 1) / 399);
    y1 = sqgy(fzcur[gi] - 10 * log10(1 + (fq / lnfl) ^ 16) - 10 * log10(1 + (lnfh / fq) ^ 8));
    y2 = sqgy(fzcur[gi + 1] - 10 * log10(1 + (fq2 / lnfl) ^ 16) - 10 * log10(1 + (lnfh / fq2) ^ 8));
    (gi % 8) < 4 ? ( col(cTEXT, 0.75); LNW(sqpx + gi / 399 * sqpw, min(sqpy + sqph, y1), sqpx + (gi + 1) / 399 * sqpw, min(sqpy + sqph, y2), 1.1); );
    gi += 1;
  );
);
eqhov = -1;
edit ? (
  // points: 0 = H, 1-3 = bells, 4 = L. Drag = frequency (+ gain for bells), wheel = Q, double-click / Alt+click = back to the model
  // sliders: 47 = H cutoff offset (octaves), 48 = L, 49 + 3 x (n-1) = bell n (offset, gain dB, Q), 58 / 59 = H / L slope; fzTP[] = [0] H freq, [1] H slope, [2] L freq, [3] L slope, [4] bell count, then freq / gain / Q per bell from [5]; point hit radius 9 px (81 = 9^2)
  eqbest = 81;
  gk = 0;
  loop(5,
    eqf = gk == 0 ? fzTP[0] : (gk == 4 ? fzTP[2] : fzTP[5 + 3 * (gk - 1)]);
    eqnx = sqfx(eqf); eqny = sqgy(fzmagdb(eqf));
    eqd2 = sqr(mx - eqnx) + sqr(my - eqny);
    eqd2 < eqbest ? ( eqbest = eqd2; eqhov = gk; );
    gk += 1;
  );
  eqdrag ? eqhov = eqdrag - 1;
  click && eqhov >= 0 ? (
    tnow2 = time_precise(); eqs = eqhov == 0 ? 47 : (eqhov == 4 ? 48 : 49 + 3 * (eqhov - 1));
    ((lasteqn == eqhov && tnow2 - lasteqt < 0.5) || (mouse_cap & 16)) ? (
      snap_take(); sset(eqs, 0); eqhov > 0 && eqhov < 4 ? ( sset(eqs + 1, 0); sset(eqs + 2, 0); ) : ( sset(eqhov == 0 ? 58 : 59, 0); ); snap_notify();
      eqdrag = 0; lasteqn = -1;
    ) : (
      eqdrag = eqhov + 1; eqmx0 = mx; eqmy0 = my; eqv0 = slider(eqs); eqg0 = slider(eqs + 1); lasteqn = eqhov;
    );
    lasteqt = tnow2;
  );
  eqdrag ? (
    gk = eqdrag - 1; eqs = gk == 0 ? 47 : (gk == 4 ? 48 : 49 + 3 * (gk - 1));
    eqb = gk == 0 ? fzBP[0] : (gk == 4 ? fzBP[2] : fzBP[5 + 3 * (gk - 1)]);                 // the model's own frequency: keep the point inside 20 Hz … 20 kHz
    eqnv = eqv0 + (mx - eqmx0) / sqpw * (log(1000) / log(2));
    eqnv = min(log(20000 / eqb) / log(2), max(log(20 / eqb) / log(2), eqnv));
    setp(eqs, min(10, max(-10, eqnv)));
    gk > 0 && gk < 4 ? setp(eqs + 1, min(24, max(-24, eqg0 - (my - eqmy0) / sqph * 45)));
  );
  mouse_wheel != 0 && !(mouse_cap & 1) && eqhov > 0 && eqhov < 4 ? (
    wheelused = 1;
    eqs = 49 + 3 * (eqhov - 1);
    setp(eqs + 2, min(3, max(-3, slider(eqs + 2) + mouse_wheel / 120 * 0.25)));
  );
// the wheel on H / L = the slope, one notch = 6 dB/oct (up = steeper, 6 … 48; from "Model" it starts at the model's)
  mouse_wheel != 0 && !(mouse_cap & 1) && (eqhov == 0 || eqhov == 4) ? (
    wheelused = 1;
    eqcur = eqhov == 0 ? fzTP[1] : fzTP[3];
    setp(eqhov == 0 ? 58 : 59, min(8, max(1, eqcur + (mouse_wheel > 0 ? 1 : -1))));
    mouse_wheel = 0;
  );
  gk = 0;
  loop(5,
    eqf = gk == 0 ? fzTP[0] : (gk == 4 ? fzTP[2] : fzTP[5 + 3 * (gk - 1)]);
    eqnx = sqfx(eqf); eqny = sqgy(fzmagdb(eqf));
    eqact = gk == 0 ? fzTP[1] > 0 : (gk == 4 ? fzTP[3] > 0 : (gk - 1 < fzTP[4] && abs(fzTP[6 + 3 * (gk - 1)]) > 0.05));   // does this point shape the sound right now?
    gk == eqhov ? ( col(cSRTT, 1); CI(eqnx, eqny, 5, 1); col(cSURF, 1); )
                : ( col(cSURF, 1); CI(eqnx, eqny, 5, 1); col(eqact ? cSRTT : cDIM2, 1); CI(eqnx, eqny, 5, 0); );
    gfx_setfont(8, "Arial", floor(6.5 * gs + 0.5), 'b');
    txtc(gk == 0 ? "H" : (gk == 4 ? "L" : (gk == 1 ? "1" : (gk == 2 ? "2" : "3"))), eqnx, eqny);
    gk += 1;
  );
  eqhov >= 0 ? (
    eqhov == 0 ? ( fzTP[1] > 0 ? sprintf(#w1, "High-pass %.0f Hz · %d dB/oct  (wheel = slope)", fzTP[0], fzTP[1] * 6) : strcpy(#w1, "High-pass off  (wheel = on, 6 dB/oct)"); ) : (
    eqhov == 4 ? ( fzTP[3] > 0 ? sprintf(#w1, "Low-pass %.0f Hz · %d dB/oct  (wheel = slope)", fzTP[2], fzTP[3] * 6) : strcpy(#w1, "Low-pass off  (wheel = on, 6 dB/oct)"); ) : (
      eqb = 5 + 3 * (eqhov - 1);
      sprintf(#w1, fzTP[eqb + 1] >= 0 ? "Band %d:  %.0f Hz  +%.1f dB  Q %.1f" : "Band %d:  %.0f Hz  %.1f dB  Q %.1f", eqhov, fzTP[eqb], fzTP[eqb + 1], fzTP[eqb + 2]);
    ));
    col(cSRTT, 1); gfx_setfont(7); txt(#w1, sqx + 7, sqy + 8, 0);
  ) : (
    tipbox(sqx, sqy, sqw, sqh, "Source EQ: drag H / L = cut-off, wheel on H / L = slope, drag 1–3 = frequency and gain, wheel on 1–3 = Q, double-click = back to the model");
  );
) : (
  tipbox(sqx, sqy, sqw, sqh, "Frequency response of the source model – edit its points in Expert");
);
);
// dimension label in the room view: plate, value; outlined while it can be grabbed (drag = resize the room)
function dimlab(s, x, yc, al, hov) local(w, x0)
(
  gfx_setfont(1); w = tws(s) + 8; x0 = al == 1 ? x - w / 2 : (al == 2 ? x - w : x);
  col(cSURF, 1); RR(x0, yc - 6.5, w, 13, 3);
  hov ? ( col(cRMTT, 1); RRO(x0, yc - 6.5, w, 13, 3); );
  col(cTEXT, 1); txt(s, x0 + 4, yc, 0);
);
// ================= GUI: Basic / Expert =================
mtEg = slider100 < 0.5 && mtE > 0.001 && time_precise() - lastblk > 0.5 ? 0 : mtE;   // Motion was stopped but no audio block comes (transport stopped / bypassed): the fade-out can never finish - the GUI treats it as ended (mtEg), so source and listener are free again
time_precise() - lastblk > 0.5 ? geo_if_changed();   // also during playback when no audio block comes (plugin bypassed / offline): the room view never shows an old geometry
// (geo_if_changed above runs only while no audio block arrives, so it never races the audio thread)

// ---- layout: width 760 design units; the height follows the open sections. Never smaller than 1:1 at the display's
// pixel density (4K / Retina: gfx_ext_retina) - when the window is too low for that, the page scrolls.
TOPY = 66; BW0 = vopt[11] >= 0.5 ? 760 : (vopt[43] >= 0.5 ? 880 : 1080);   // Expert: two columns side by side - every module visible at once                    // TOPY: top of the sections (top bar 0 … 32, signal-flow strip 36 … 60; the view modes below move it)
szclr ? ( szoom = 0; zoomv = 0; szclr = 0; );   // a mode / view switch of the last frame
basic = vopt[11] >= 0.5; learn = !basic && vopt[43] >= 0.5;   // LEARN: Expert sound, its own page (view + explanations)                             // Basic view: the main controls only (display only - every setting stays as it is)
basic ? ( selw = 0; tpon = 0; tmbOn = 0; ) : ( xpon = 0; );
// TABS (Expert): the room view over the whole width, under it a row of tabs and ONE module, as large as the window
// allows - no scrolling. vopt[45] = 1: the All tab = every module at once in two columns .
tabm = !basic && !learn && vopt[45] < 0.5;
tabsel = floor(vopt[46] + 0.5);
!(tabsel == 1 || tabsel == 15 || tabsel == 3 || tabsel == 4 || tabsel == 5 || tabsel == 6 || tabsel == 7 || tabsel == 10 || tabsel == 14) ? ( tabsel = 1; vopt[46] = 1; );
ffTab = tabm && tabsel == 15;   // the Free field tab shows the Room card's place
tabm ? ( vopt[12] & (2 ^ (ffTab ? 1 : tabsel)) ? ( vopt[12] -= 2 ^ (ffTab ? 1 : tabsel); ); TOPY = 48; );   // 10 more for the Tabs | All | Fit switch under the view modes
!basic && !learn && !tabm ? TOPY = 76;   // All - 10 more for the Tabs | All | Fit switch under the view modes
basic ? ( TOPY = 98; );   // lower tiles - Basic: the row of room tiles under the top bar (TOPY 98)
vlock = vopt[15] >= 0.5;                                // layout locked: folding and column widths stay (also on Reset)
KR = vopt[11] < 0.5 && vopt[43] < 0.5 && vopt[45] < 0.5 ? 18 : 21; KLW = KR * 0.2; KVF = 3;   // tabs: knobs a little smaller (the text larger)
 KR0 = KR; KLW0 = KLW; KVF0 = KVF; KSC = 1; KNS = 1; KNF = 4;   // one knob size per view mode (Basic: larger)
// each section folds on its own (Expert and Basic); the sections below move up. Folding is animated.
// state (bit 2^id set = folded): Expert vopt[12] (ids 1-11, 14 = Motion), Basic vopt[13] (its own: 1 Room, 3 Source, 5 Barrier, 7 Output) - secop[id] / secop[12 + id]
tanim = time_precise(); adt = min(0.1, max(0, tanim - lastanim)); lastanim = tanim; animing = 0;
k = 1;
loop(23,
  tg = k == 14 ? !(vopt[12] & 16384) : (k <= 11 ? !(vopt[12] & (2 ^ k)) : !(vopt[13] & (2 ^ (k - 12))));   // 14 = Motion (Expert, bit 16384)     // 9 = the 3D view, 10 = Delay, 11 = Decay by band (Expert)
  abs(tg - secop[k]) < 0.02 ? ( secop[k] = tg; ) : ( secop[k] += (tg - secop[k]) * min(1, adt * 14); animing = 1; );
  k += 1;
);
HDR = 24; VFH = 96; bfill = 0; LP1 = 206;   // LEARN FLICKER: the panels' height comes from their text, the text wraps by the width, the width follows the scale, the scale follows the height - in some
  // windows (e.g. 2000 x 1300) this flipped every frame. Now the larger of this and the last frame's need counts: a flip between two values settles on the larger one
  lp2use = lp2need; lp3use = lp3need;   // (1.0.1: the scale no longer follows the text - no loop left, so no smoothing over two frames, which only added a frame of lag)
  LP2 = lp2use > 60 ? min(420, lp2use) : 300; LP3 = lp3use > 60 ? min(320, lp3use) : 196;   // Learn: What you hear, Your turn, Words (the last two: as tall as their text)
k = 21; loop(12, vopt[k] = min(400, max(0, floor(vopt[k] + 0.5))); k += 1; ); vopt[37] = min(400, max(0, floor(vopt[37] + 0.5)));   // module heights (mouse): extra 0 … 400
k = 33; loop(2, vopt[k] = vopt[k] < 1 ? 0 : min(1400, max(140, floor(vopt[k] + 0.5))); k += 1; );   // room view: 0 = automatic
shD = sech(10, 196 + secx(10)); shR = sech(1, 182 + secx(1)); shV = 0; shS = sech(3, (basic ? 136 : 160) + secx(3)); shE = 0; shK = 0;   // Expert: + 24 for the call strip (and the filter next to it) // left: FILTER | SOURCE, DELAY, ROOM + REVERB (+ OUTPUT while the room view is shown)
shW = sech(4, 118 + secx(4)); shB = sech(5, 170 + secx(5)); shM = sech(14, (mtPW0 < 600 ? 286 : (mtPW0 < 830 ? 260 : 224)) + secx(14)); shF = sech(6, (basic ? 136 : 160) + secx(6)); shO = sech(7, (basic ? 180 : 112) + secx(7));   // right: room view, WALLS, BARRIER, MOTION (+ OUTPUT when the room view is hidden) (narrow column: Direction / Rate on their own row) // shF / shO had slipped into a comment in - Filter and Output cards in All had no height
learn ? (
  vop = 1; CH = TOPY + LP1 + LP2 + LP3 + 12 + 22;
) : basic ? (
  hbR = sech(1, 206 + secx(1)); hbS = sech(3, 206 + secx(3)); hbB = sech(5, 180 + secx(5)); hbO = sech(7, 180 + secx(7));
  hb1 = max(hbS, hbR); hb2 = max(hbB, hbO); hbM = max(hbS + hbB, hbR + hbO) + 6;   // two columns of two cards (Source over Barrier, Room over Output): a folded card lets the one under it move up
  vop = secop[21]; CH = TOPY + max(hbM, HDR + vop * ((vopt[34] > 0 ? vopt[34] : hbM) - HDR)) + 22;
) : (
  vhid = (vopt[12] & 512) > 0; VFH = 96;                                   // room view hidden: a bar with a mini plan, Output goes right
// FIT ALL FLICKER: the Motion card is taller in a narrow column (mtPW0 < 600), the column width comes from the scale,
  // the scale from the page height - at some window sizes this flipped every frame (gs 1.035 <-> 1.000, the whole page
  // jumping = the blinking). Fit all now sizes the page for the taller Motion card: one scale, no feedback
  shMc = !basic && vopt[42] >= 0.5 ? sech(14, 286 + secx(14)) : shM;   // the taller Motion card (286, tempo tools and knobs inside) - 236 cut it off at the bottom
  rsum = shW + shB + shMc + 18 + (vhid ? shO + 6 : 0); lsec = max(shF, shS) + shD + shR + 12 + (vhid ? 0 : shO + 6);
  vop = secop[9]; CH = TOPY + max(lsec, rsum + VFH + vop * ((vopt[33] > 0 ? vopt[33] : max(!basic && vopt[42] >= 0.5 ? 200 : 260, lsec - rsum)) - VFH)) + 22;   // Fit all: the room view may be lower (200)
);
gsmin = max(1, gfx_ext_retina);
// EXPERT, standard: exactly the scale Basic has in this window - text and knobs as large as in Basic, the page scrolls
// (mouse wheel). Two columns when the window is wide enough for them at that scale, else one column.
// "Fit all" (strip, vopt[42]): the whole page in the window, smaller.
ebig = !basic && !learn && vopt[42] < 0.5;
ebig ? (
  gs = max(0.25, min(gfx_w / 998, min(gfx_w / 760, max(gsmin, gfx_h / max(450 + 2 * vopt[32], TOPY + vopt[34] + 18)))));   // never narrower than the two columns
  vopt[14] > 0 ? ( gs = max(0.25, min(gs, gfx_w / (536 / (1 - min(0.6, vopt[14])) + 22))); );   // right column dragged wider than the window allows: the page gets smaller (the left column keeps its 536)
  rzid ? ( gs = rzgs; );                   // while a height is dragged the scale stays (the edge follows the mouse)
// (the one-column layout of earlier versions is gone - the room view, walls and barrier always stay at the right)
  BW0 = max(760, floor(gfx_w / gs));
) : (
  // LEARN FLICKER (1.0.1): the scale comes from the window and a FIXED reference height (panels at their standard 300 / 196), not from
  // the measured text - text height -> page height -> scale -> text width -> text height made the page shrink and grow for several frames
  // LEARN: larger than "fit the page" - the explanations are read, not scanned; the right column scrolls when the window is low
  gs = learn ? max(0.25, min(gfx_w / BW0, max(gsmin, gfx_h / max(640, TOPY + LP1 + 300 + 196 + 34)))) : max(0.25, min(gfx_w / BW0, max(basic && vopt[36] >= 0.5 ? 0.25 : (!basic && !learn && vopt[42] >= 0.5 ? 0.6 * gsmin : gsmin), gfx_h / CH)));   // Basic Fit all: no lower limit - the page fits   // Learn: large text, but the whole page in the window (no scrolling)
  !learn && !basic && vopt[14] > 0 ? ( gs = max(0.25, min(gs, gfx_w / (536 / (1 - min(0.6, vopt[14])) + 22))); );
  rzid ? ( gs = rzgs; );
);
tabm ? ( gs = max(0.25, min(gfx_w / 860, gfx_h / 560)); BW0 = max(760, floor(gfx_w / gs)); );   // tabs: one scale for top bar, room view and tabs
XW = max(0, floor(gfx_w / gs - BW0)); WT = BW0 + XW; HT = gfx_h / gs;  // HT = visible height
LH = zoomv || tabm ? HT : max(HT, CH);                                      // height of the page
scmax = max(0, LH - HT); scy = min(max(scy, 0), scmax);
gox = 0; goy = -floor(scy * gs + 0.5);
avail = LH - TOPY - 22;
// BASIC: a window taller than the page - the two rows of cards grow (knobs too) to the height of the room view
basic && !zoomv && !szoom && vopt[34] <= 0 ? (
  bfill = max(0, floor((avail - hbM) / 2));
  bfill > 0 ? ( hbR = sech(1, 206 + secx(1)); hbS = sech(3, 206 + secx(3)); hbB = sech(5, 180 + secx(5)); hbO = sech(7, 180 + secx(7)); hb1 = max(hbS, hbR); hb2 = max(hbB, hbO); hbM = max(hbS + hbB, hbR + hbO) + 6; );
);
learn ? (
  // LEARN: the room view at the left, the explanations at the right
  L0 = 8; colT = WT - 16; LRW = max(380, floor(colT * 0.38)); VX = 8; VY = TOPY; VW = colT - LRW - 6; VH = min(avail, max(360, floor(HT) - TOPY - 18));   // the room view stays in the window
  LPX = VX + VW + 6; LQ1 = TOPY; LQ2 = LQ1 + LP1 + 6; LQ3 = LQ2 + LP2 + 6; LQH = max(LP3, TOPY + avail - LQ3);
  LW = VW; RWc = LRW; R0 = LPX; IOX = NOPOS; IOY = 0; IOW = 0; IOH = 0;
) : basic ? (
  // four cards 2 x 2 at the left in signal order (Source | Room, Barrier | Output), the room view at the right takes the rest;
  // card area: standard 62 % of the width (at least 372), dragged = a share of the width (corner of Room or Output)
  L0 = 8; bTot = WT - 16;
