    gdpp ? ( dech = gk % 2; dtt += dech == 0 ? gtL : gtR; damp = dech == 0 ? dlgL * dvL : dlgR * dvL; dech == 1 ? ( dvL *= sqrt(dfL * dfR); ); dbP *= dech == 0 ? dqL : dqR; dbr = dbP; )
         : ( dech = gk % 2; dech == 0 ? ( dnL += 1; dtt = dnL * gtL; damp = dlgL * dfL ^ (dnL - 1); dbr = dqL ^ dnL; ) : ( dnR += 1; dtt = dnR * gtR; damp = dlgR * dfR ^ (dnR - 1); dbr = dqR ^ dnR; ); );
    dtt <= dtmx && damp > 0.004 ? (
      // bar height = echo level mapped from -48 … +6 dB to 0 … 1 of the half height
      dtx = dpx0 + dtt / dtmx * dlw; dsg = dech == 0 ? -1 : 1; dhh = (deh / 2 - 18) * min(1, max(0, (20 * log10(damp) + 48) / 54));
      drtl > 2 ? (
        // room tail behind the echo: falls 60 dB (exp(-6.9)) over drtl = RT60 in pixels, drawn at 60 % of the echo height
        col(darkmode ? 0xD2C8FF : cAMB, darkmode ? 0.6 : 0.30); dstp = max(2.4, drtl / 30); k = 1;
        loop(30, dxx = k * dstp; dxx < drtl && dtx + dxx < dpx0 + dlw ? LN(dtx + dxx, demid, dtx + dxx, demid + dsg * dhh * 0.6 * exp(-6.9 * dxx / drtl)); k += 1; );
      );
      col(dech == 0 ? cSRC : cLIS, darkmode ? 0.5 + 0.5 * dbr : 0.22 + 0.78 * dbr); LNW(dtx, demid, dtx, demid + dsg * dhh, 1.3); CIF(dtx, demid + dsg * dhh, 1.15, 1);   // finer - a thin stem and a small dot
    );
    gk += 1;
  );
  deh >= 70 ? (   // a small graph (All, Fit) has no legend - it covered the echoes (the tooltip names the colors)
    gfx_setfont(7); dlgw = max(tws("echoes"), rbyp ? 0 : tws("+ their room")); col(darkmode ? cSTAGE : cBG, 0.88); RR(dex + dew - dlgw - 13, dey + 3, dlgw + 9, rbyp ? 12 : 23, 4);   // a backdrop - the legend no longer lies on the echo bars (small module)
  col(cMUTED, 1); gfx_setfont(7); txt("echoes", dex + dew - 8, dey + 9, 2); !rbyp ? ( col(darkmode ? 0xD2C8FF : cAMB, 1); txt("+ their room", dex + dew - 8, dey + 20, 2); );
  );
  tipbox(dex, dey, dew, deh, "Echoes: L above, R below the line, height = level (dB), paler = darker and thinner after the filters; violet = the room tail every echo gets");
  // TAPE: wow + flutter and drive (both sides)
  sprintf(#fv, "%.0f %%", slider83);
  kmap(0, 0, 100, 1);
  nf = hsl(50, dex + 2, syD + shD - (tabm ? 12 : 0) - 44, dew - 4, "Wow + flutter", #fv, slider83 / 100, 0, cDLTT);
  tipbox(dex, syD + shD - (tabm ? 12 : 0) - 50, dew, 20, "Tape: wow + flutter – the echoes waver in pitch like on an old tape echo (0 % = clean, double-click = type a value, Alt+click = 0)");
  kchg ? setp(83, nf * 100);
  sprintf(#fv, "%.0f %%", slider84);
  kmap(0, 0, 100, 1);
  nf = hsl(51, dex + 2, syD + shD - (tabm ? 12 : 0) - 22, dew - 4, "Saturation", #fv, slider84 / 100, 0, cDLTT);
  tipbox(dex, syD + shD - (tabm ? 12 : 0) - 28, dew, 20, "Saturation in the feedback loop: the tape saturates – loud repeats get rounder and denser, quiet ones stay clean (0 % = clean)");
  kchg ? setp(84, nf * 100);
  sprintf(#fv, slider99 < 0.05 ? "off" : "%.1f dB", slider99);
  kmap(0, 0, 24, 1);
  nf = hsl(52, dex + 2, syD + shD - (tabm ? 12 : 0) - 66, dew - 4, "Ducking", #fv, slider99 / 24, 0, cDLTT);
  tipbox(dex, syD + shD - (tabm ? 12 : 0) - 72, dew, 20, "Ducking: the echoes get quieter while the input plays and come back in the pauses – keeps dialogue clear (0 = off, up to 24 dB, automatable)");
  kchg ? setp(99, nf * 24);
  // delay off: veil (the switches stay usable)
  !gdon ? ( col(cSURF, 0.55); R(x0 + 2, syD + 48, w0 - 4, shD - 50); );
);
// Delay section card: header, on/off, mix, Tempo tools, 3D chip and preset menu; draws the body via gfxp6 when open
function gfxp7()
(
x0 = L0; w0 = LW;
card(x0, syD, w0, shD); sechdr(10, "Delay", x0, syD, cDLTT);
tgl(x0 + w0 - 36, syD + 5, gdon, cDLTT) ? ( slider65 = gdon ? 0 : 1; sauto1(65); );
tipbox(x0 + w0 - 36, syD + 5, 26, 14, "Delay on / off – it works before the room, so every echo is reverberated too. Off: the room gets exactly the source");
tpbx = x0 + w0 - (tabm ? 218 : 198);
hmix(60, x0 + w0 - (tabm ? 132 : 112), syD + 12, 90, cDLTT, "Amount of the delay (module mix): the share of the echoes – 100 % = as set, 0 % = no echoes (double-click = type a value, Alt+click = 100 %, automatable)");
chip(tpbx, syD + 5, 76, 14, "Tempo tools", tpon && tpctx != 14, cDLTT) ? ( tpon = !tpon; tpctx = 10; tpmv = 0; );   // opens at its place again
tipbox(tpbx, syD + 5, 76, 14, "Tempo tools: tap the tempo or let Ahh listen to the song – then send a note value to the delay");
d3on = vopt[20] < 0.5;
chip(tpbx - 32, syD + 5, 28, 14, "3D", d3on, cTEXT) ? ( vopt[20] = d3on ? 1 : 0; );
tipbox(tpbx - 32, syD + 5, 28, 14, d3on ? "Delay times at the source in the 3D view: shown (while the delay is on) – click to hide" : "Delay times at the source in the 3D view: hidden – click to show");
// PRESET menu (like the room presets): film & post, music, sound design
gfx_setfont(2); dpbx = x0 + 28 + tws("Delay") + (tabm ? 54 : 58);   /* 0.311: + the reset icon */ dpbw = max(90, min(secopen(10) ? 190 : 140, tpbx - 40 - dpbx)); dpby = syD + 4; dpbh = 16;
dpsel = dpmatch();
strcpy(#w1, dpsel >= 0 ? dpname(dpsel) : "Custom");
ddbox(dpbx, dpby, dpbw, dpbh, #w1, 1, dmenu);
!secopen(10) && tpbx - 38 - (dpbx + dpbw + 10) > 30 ? (                // folded: what the delay does, in one line
  gdtm ? ( strcpy(#w2, "L "); strcat(#w2, dnname(slider72)); strcat(#w2, " · R "); strcat(#w2, dnname(gdlt ? slider72 : slider73)); sprintf(#w3, " · %.0f BPM", gbpm); strcat(#w2, #w3); )
       : sprintf(#w2, "L %.0f · R %.0f ms", gtL, gtR);
  gdpp ? strcat(#w2, " · ping-pong");
  col(gdon ? cMUTED : cDIM2, 1); gfx_setfont(4); txtfit(#w2, dpbx + dpbw + 10, syD + 12, tpbx - 38 - (dpbx + dpbw + 10));
);
click && inbox(dpbx, dpby, dpbw, dpbh) ? ( dmenu = !dmenu; click = 0; );
tipbox(dpbx, dpby, dpbw, dpbh, dpsel >= 0 ? dpdesc(dpsel) : "Delay presets for film / post, music and sound design – loading one switches the delay on");
secopen(10) ? (gfxp6());
);
// FREE FIELD (its own tab after Room, Tabs view): outdoors - no walls, no reverb. On = the room is off (one switch for both).
// The card takes the place of the Room card: heights and angle of the source, Distance, and the ground reflection
// GROUND PICTURES: the three grounds seen from above as material swatches. Click = choose
// Draws one clickable ground swatch picture (asphalt, grass or snow) with name and tooltip; click selects the ground
function gndpanel(x, y, w, h, m, nm, ds)
local(i, r, r2, bx, by, hv, gsl, n, ix, iy, iw, ih, a, ln)
(
  hv = inbox(x, y, w, h); gsl = floor(slider119 + 0.5) == m + 1;
  col(gsl ? cFFTT : (hv ? cBORD : cHAIR), 1); RR(x, y, w, h, 6);
  ix = x + 3; iy = y + 3; iw = w - 6; ih = h - 6;
// flat, abstract swatches (cartoon style): one calm colour and two or three simple shapes per ground
  col(m == 0 ? (darkmode ? 0x5A5D64 : 0x777B83) : (m == 1 ? (darkmode ? 0x4E7D66 : 0xA3CBB3) : (darkmode ? 0xD2DCE5 : 0xEAF0F5)), 1); RR(ix, iy, iw, ih, 4);   // muted tones that fit the gray design
  m == 0 ? (
    col(darkmode ? 0x45484E : 0x666A72, 1); RR(ix, iy + ih * 0.62, iw, ih * 0.38, 3);   // the kerb side
    col(0xEEF0F3, 1); by = iy + ih * 0.36; bx = ix + iw * 0.08; i = 0;
    loop(4, RR(bx, by, iw * 0.14, max(2, ih * 0.08), 1); bx += iw * 0.23; i += 1; );   // road marking
  );
  m == 1 ? (
    col(darkmode ? 0x43705B : 0x8FBBA0, 1); RR(ix, iy + ih * 0.58, iw, ih * 0.42, 4);   // a darker lawn strip
    col(darkmode ? 0x78B096 : 0x5C987C, 1); i = 0;
    loop(4, bx = ix + iw * (0.14 + i * 0.22); by = iy + ih * (0.3 + (i % 2) * 0.28); LNW(bx - 3, by, bx, by - 5, 1.6); LNW(bx, by - 5, bx + 3, by, 1.6); i += 1; );   // little tufts
  );
  m == 2 ? (
    col(darkmode ? 0xB9C8D6 : 0xD5E0EA, 1); CIF(ix + iw * 0.24, iy + ih * 0.68, ih * 0.26, 1); CIF(ix + iw * 0.5, iy + ih * 0.7, ih * 0.22, 1); CIF(ix + iw * 0.76, iy + ih * 0.66, ih * 0.27, 1); RR(ix + iw * 0.24, iy + ih * 0.68, iw * 0.52, ih * 0.26, 2);   // soft drifts
    col(0xFFFFFF, 1); CIF(ix + iw * 0.3, iy + ih * 0.28, 1.6, 1); CIF(ix + iw * 0.55, iy + ih * 0.18, 1.2, 1); CIF(ix + iw * 0.8, iy + ih * 0.34, 1.6, 1);
  );
  gfx_setfont(4); col(gsl ? cTEXT : cMUTED, 1); txt(nm, x + w / 2, y + h + 8, 1);
  tipbox(x, y, w, h + 14, ds);
  click && hv ? ( setp(119, m + 1); click = 0; );
);
// Lays out the three ground swatches (asphalt, grass, snow) side by side
function gndpics(x, y, w, h)
local(pw, gp)
(
  gp = 10; pw = min(120, floor((w - 2 * gp) / 3));
  gndpanel(x, y, pw, h, 0, "Asphalt", "Hard ground (asphalt, concrete): reflects almost everything – a bright, clear second arrival; with a moving source the typical sweeping comb filter");
  gndpanel(x + pw + gp, y, pw, h, 1, "Grass", "Grass: absorbs much and the highs most – a weaker, duller reflection, the comb is shallow");
  gndpanel(x + 2 * (pw + gp), y, pw, h, 2, "Snow", "Fresh snow: very soft – only a muffled trace of the ground reflection is left");
);
// Free field tab: outdoors card with source heights/angle, distance, ground reflection and ground pictures
function gfxpff()
(
x0 = L0; w0 = LW; ksp = (w0 - 40) / 9; kx0 = x0 + 20 + ksp / 2;
card(x0, syR, w0, shR); sechdr(15, "Free field", x0, syR, cFFTT);
tgl(x0 + w0 - 36, syR + 5, isfree, cFFTT) ? ( modeset(isfree ? 0 : 1); snlast = 0; );
tipbox(x0 + w0 - 36, syR + 5, 26, 14, "Free field on / off – outdoors, no walls, no reverb. On: the room is off; off: the room is back");
gfx_setfont(2); ffpx = x0 + 28 + tws("Free field") + 40; ffpy = syR + 4; ffpw = min(190, max(110, w0 - (ffpx - x0) - 70));
ffpx + ffpw < x0 + w0 - 50 ? (
  ddbox(ffpx, ffpy, ffpw, 16, ffpLast >= 0 ? ffpname(ffpLast) : "Presets", 1, ffpmenu);
  click && inbox(ffpx, ffpy, ffpw, 16) ? ( ffpmenu = 1; click = 0; );
  tipbox(ffpx, ffpy, ffpw, 16, "Free field presets: a street, an alley, a soccer field, a canyon … – area, ground and the two reflectors are set for the place (the listener in the middle, the source 1.5 m in front)");
);
secopen(1) ? (
  kscale(min(ksp / (2 * KR0 + 22), kfit(secx(1) / 4))); ky = syR + 50 + secx(1) / 4; kx = kx0; kdim = 0;
  hmax = max(0.1, roomH - 0.1);
  kcol = cSRC; sprintf(#fv, "%.2f m", sz);
  kmap(0, 0, hmax, 1);
  nf = knob(20, kx, ky, "Src height", #fv, min(1, sz / hmax), min(1, 1.5 / hmax));
  knobtip(kx, ky, "Source height above the ground in meters – double-click = type a value, Alt+click = 1.5 m");
  kchg && (!rbyp || isfree) ? moveobjz(1, nf * hmax);
  kx += ksp; kcol = cLIS; sprintf(#fv, "%.2f m", lz);
  kmap(0, 0, hmax, 1);
  nf = knob(21, kx, ky, "Lis height", #fv, min(1, lz / hmax), min(1, 1.5 / hmax));
  knobtip(kx, ky, "Listener height above the ground in meters – double-click = type a value, Alt+click = 1.5 m");
  kchg && (!rbyp || isfree) ? moveobjz(2, nf * hmax);
  kx += ksp; kcol = cSRC; sprintf(#fv, abs(slider61 - floor(slider61 + 0.5)) > 0.05 ? "%.1f°" : "%.0f°", slider61);
  nf = dirknob(30, kx, ky, "Src angle", #fv, slider61, slider63 >= 0.5 ? 0 : (abs(lx - sx) + abs(ly - sy) > 0.001 ? atan2(-(lx - sx), ly - sy) * 180 / $pi : 0));
  knobtip(kx, ky, "Source angle: where the source points – 0° (mark) = to the front, +90° = left, −90° = right, ±180° = to the back. Drag around the dial (snaps to 15°), Shift = fine, wheel = 1°, double-click = type");
  kchg && (!rbyp || isfree) ? setp(61, nf);
  kx += ksp; kcol = cLIS; sprintf(#fv, abs(slider17 - floor(slider17 + 0.5)) > 0.05 ? "%.1f°" : "%.0f°", slider17); kdim = slider16 < 0.5;   // the listener's own angle (Facing); with Facing: Source it is not used - turning it switches to Fixed
  nf = dirknob(35, kx, ky, "Lis angle", #fv, slider17, 180);
  knobtip(kx, ky, "Listener angle (Facing Fixed): where the listener looks – 0° (mark) = straight ahead, to the back wall, +90° = right, −90° = left, ±180° = to the front. Drag around the dial (snaps to 15°), Shift = fine, wheel = 1°, double-click = type, Alt+click = 0°. Facing Source / Path: turning it switches to Fixed");
  kchg ? ( slider16 < 0.5 ? ( slider16 = 1; autom(32768); ); setp(17, nf); ); kdim = 0;
  kx += ksp; kcol = cFFTT; sprintf(#fv, "%.1f m", slider4 * rs);   // real meters (the preset Size factor is not shown here)
  kmap(1, 0.8, 15, rs);
  nf = knob(3, kx, ky, "Max height", #fv, log2f(slider4, 0.8, 15), log2f(3, 0.8, 15));
  knobtip(kx, ky, "Highest point source and listener can reach outdoors (the room height – the same control as Height in Room)");
  kchg ? setp(4, f2log(nf, 0.8, 15));
  kx += ksp; kcol = cFFTT; sprintf(#fv, "%.0f %%", slider117); kdim = slider60 >= 0.5;
  kmap(0, 0, 100, 1);
  nf = knob(34, kx, ky, "Distance", #fv, slider117 / 100, 0); kdim = 0;
  knobtip(kx, ky, slider60 >= 0.5 ? "Distance: no effect while Equal loudness is on (Output)" : "Distance (perspective, for film): beyond 2 m the sound gets quieter with the distance – 0 % = physics, 100 % = 6 dB more per doubling, like a film mix");
  kchg ? setp(117, nf * 100);
// the area source and listener can walk in outdoors (the same width / depth as in the Room tab)
  kx += ksp; kcol = cFFTT; sprintf(#fv, "%.1f m", slider2 * rs);
  kmap(1, 0.8, 40, rs);
  nf = knob(1, kx, ky, "Area width", #fv, log2f(slider2, 0.8, 40), log2f(10, 0.8, 40));
  knobtip(kx, ky, "Width of the area source and listener can move in – up to 40 m (the same control as Width in Room)");
  kchg ? setp(2, f2log(nf, 0.8, 40));
  kx += ksp; sprintf(#fv, "%.1f m", slider3 * rs);
  kmap(1, 0.8, 40, rs);
  nf = knob(2, kx, ky, "Area depth", #fv, log2f(slider3, 0.8, 40), log2f(7, 0.8, 40));
  knobtip(kx, ky, "Depth of the area source and listener can move in – up to 40 m (the same control as Depth in Room)");
  kchg ? setp(3, f2log(nf, 0.8, 40));
  kcol = cTEXT;
  col(cHAIR, 1); LN(x0 + 12, syV + 2, x0 + w0 - 12, syV + 2);
  col(cFFTT, 1); RR(x0 + 19, syV + 9, 3, 12, 1.5);
  grndseg(x0 + 28, syV + 7, min(260, w0 - 60));
  gfx_setfont(4); olx = x0 + 28 + min(260, w0 - 60) + 14;
  olx + 84 < x0 + w0 - 14 - tws("Free field: no reverb · distance 00.00 m") - 8 ? (
    chip(olx, syV + 7, 84, 16, "Outline view", vopt[67] >= 0.5, cFFTT) ? vopt[67] = 1 - vopt[67];
    tipbox(olx, syV + 7, 84, 16, "Outline view (display only, the sound does not change): the colored sky, hills, ground and panel fills are hidden – only lines and the plain floor remain");
  );
// the pictures of the grounds under the Ground row (when the card is tall enough)
  gnpy = syV + 30; gnph = min(40, syR + shR - 24 - gnpy);   // small swatches (own variables: gph / gpw belong to the pixel-rect helpers and are overwritten by every drawing call)
// GROUND LEVEL: a slider right of the pictures (-12 .. +6 dB, 0 = as before) scales the strength of the ground reflection
  gnlw = w0 > 620 ? 170 : 0;
  gnph >= 30 ? gndpics(x0 + 19, gnpy, w0 - 38 - (gnlw ? gnlw + 16 : 0), gnph);
  gnlw && gnph >= 30 ? (
    sprintf(#fv, "%+.1f dB", vopt[69]); kmap(0, -12, 6, 1);
    nf = hsl(177, x0 + w0 - 19 - gnlw, gnpy + gnph / 2 - 7, gnlw, "Ground level", #fv, (vopt[69] + 12) / 18, 12 / 18, cFFTT);
    kchg ? vopt[69] = floor((nf * 18 - 12) * 2 + 0.5) / 2;
    tipbox(x0 + w0 - 19 - gnlw - 4, gnpy + gnph / 2 - 10, gnlw + 8, 24, "Strength of the ground reflection: 0 dB = as modeled, lower = softer ground, higher = a more obvious comb effect (double-click = 0 dB)");
  );
  gfx_setfont(4); col(cMUTED, 1); sprintf(#w1, isfree ? "Free field: no reverb · distance %.2f m" : "Free field is off – the room is on", dpd); txt(#w1, x0 + w0 - 14, syV + 15, 2);
);
);
// Expert left/right columns: Delay, Room (size, reverb, hear, morph), Source, Walls and Motion sections
function gfxp8()
(
// =================== EXPERT: two columns as in 0.172 – every section folds ===================
// ---- DELAY (left column, top): stereo / ping-pong delay before the room - every echo is reverberated too ----
(!szoom || szoom == 10) ? (gfxp7());
// ---- ROOM (left, under the room view): dimensions, size, absorption, heights ----
x0 = L0; w0 = LW; ksp = (w0 - 40) / 10; kx0 = x0 + 20 + ksp / 2;   // nine places (+ Distance); ten (+ Lis angle)
ffTab ? gfxpff();
(!szoom || szoom == 1) && !ffTab ? (
card(x0, syR, w0, shR); sechdr(1, "Room", x0, syR, cRMTT);
tgl(x0 + w0 - 36, syR + 5, !rbyp, cRMTT) ? ( slider36 = rbyp ? 0 : 1; sauto1(36); );
w0 >= 400 && !tabm ? ( chip(x0 + w0 - (tabm ? 132 : 112) - 74, syR + 5, 66, 14, "Free field", isfree, cRMTT) ? ( modeset(isfree ? 0 : 1); snlast = 0; click = 0; ); tipbox(x0 + w0 - (tabm ? 132 : 112) - 74, syR + 5, 66, 14, isfree ? "Free field is on – click: back to the room" : "Free field: outdoors, no walls, no reverb (quick switch, same as the Free field tab)"); );
hmix(61, x0 + w0 - (tabm ? 132 : 112), syR + 12, 91, cRMTT, "Amount of room + reverb (module mix, one for both): 100 % = the room as set, 0 % = as if the room were off – only the source (and the delay), in between = both (double-click = type a value, Alt+click = 100 %, automatable)");
tipbox(x0 + w0 - 36, syR + 5, 26, 14, "Room engine on / off – Off: only the source model is heard (no distance, walls, barrier or reverb)");
secopen(1) ? (
  kscale(min(ksp / (2 * KR0 + 22), kfit(secx(1) / 4))); ky = syR + 50 + secx(1) / 4; kcol = cRMTT;
  kx = kx0; sprintf(#fv, "%.1f m", slider2);
  kmap(1, 0.8, 40, 1);
  nf = knob(1, kx, ky, "Width", #fv, log2f(slider2, 0.8, 40), log2f(10, 0.8, 40));
  knobtip(kx, ky, "Room width – a bigger room gives longer delays and more reverb (also: drag the width label in the room)");
  kchg ? setp(2, f2log(nf, 0.8, 40));
  kx += ksp; sprintf(#fv, "%.1f m", slider3);
  kmap(1, 0.8, 40, 1);
  nf = knob(2, kx, ky, "Depth", #fv, log2f(slider3, 0.8, 40), log2f(7, 0.8, 40));
  knobtip(kx, ky, "Room depth – changes volume, reflection times and reverb time");
  kchg ? setp(3, f2log(nf, 0.8, 40));
  kx += ksp; sprintf(#fv, "%.1f m", slider4); kdim = isfree;   // free field - no ceiling, no walls
  kmap(1, 0.8, 15, 1);
  nf = knob(3, kx, ky, "Height", #fv, log2f(slider4, 0.8, 15), log2f(3, 0.8, 15));
  knobtip(kx, ky, "Ceiling height – changes the room volume and the floor/ceiling reflections");
  kchg ? setp(4, f2log(nf, 0.8, 15));
  kx += ksp; sprintf(#fv, "%.2f×", slider31);
  kmap(1, 0.25, 4, 1);
  nf = knob(13, kx, ky, "Size", #fv, log2f(slider31, 0.25, 4), log2f(1, 0.25, 4));
  knobtip(kx, ky, "Size: scales the room and the positions in it (not the heights of source and listener) – ×1 = the dimensions set here");
  kchg ? setp(31, f2log(nf, 0.25, 4));
  kx += ksp; sprintf(#fv, "%.2f", ta);
  kmap(0, 0.01, 1, 1);
  nf = knob(4, kx, ky, tname, #fv, lin2f(ta, 0.01, 1), lin2f(selw == 5 ? 0.17 : 0.45, 0.01, 1));
  knobtip(kx, ky, "Absorption α of the surface chosen in Walls: 0 = reflects all sound, 1 = absorbs all sound");
  kchg ? setalpha(f2lin(nf, 0.01, 1)); kdim = 0;
  hmax = max(0.1, roomH - 0.1);                     // heights in meters above the floor (respect Link S+L)
  kx += ksp; kcol = cSRC; sprintf(#fv, "%.2f m", sz);
  kmap(0, 0, hmax, 1);
