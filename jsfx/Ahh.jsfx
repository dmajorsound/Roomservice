    bxE = asz; bxF = 0; bxM = 0; bxC = 0; bxT = 1; bxV = 0;       // 1 = straight through the opening: heard where the source is
  ) : (
    inelm = bew > 0 && fx >= bex0 && fx <= bex1 && fz >= bez0 && fz <= bez1;
