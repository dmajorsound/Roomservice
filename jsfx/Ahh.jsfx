function ARC(x, y, rad, a1, a2, wd) ( rad * gs < 16 && gfx_a > 0.05 ? ARCS(x, y, rad, floor(a1 * 200 + 0.5) / 200, floor(a2 * 200 + 0.5) / 200, wd) : ARCST(x, y, rad, a1, a2, wd); );   // (angles in 1/200 rad steps: no sub-pixel creep from frame to frame)
