    nf = knob(330 + gk, kx, ky, gk == 0 ? "X" : gk == 1 ? "Y" : gk == 2 ? "Angle" : gk == 3 ? "Length" : gk == 4 ? "Height" : "Level", #fv, lin2f(av, lo, hi), lin2f(df, lo, hi));
    knobtip(kx, ky, gk < 2 ? "Position of the reflector's center in the free-field area (also: drag its handle in the Stage View)" : gk == 2 ? "Direction of the wall line seen from above: 0° = along the width, 90° = along the depth" : gk == 3 ? "Length of the reflector – the echo only exists where the sound hits it" : gk == 5 ? "Level of this echo in dB. 0 = physically exact (a facade 10 m away is 20 dB below the direct sound – hardly audible); +12 = film default, clearly audible; up to +24" : "Height of the reflector – a low fence reflects only low sound paths");
