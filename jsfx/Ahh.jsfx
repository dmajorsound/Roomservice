// output level: knob 0 .. 0.25 covers -inf(-72) .. -24 dB, 0.25 .. 1 covers -24 .. +24 dB
function lvl2f(v) ( v <= -24 ? 0.25 * (v + 72) / 48 : 0.25 + 0.75 * (v + 24) / 48; );
// Converts an output-level knob position f (0..1) to dB: 0..0.25 maps -72..-24 dB, 0.25..1 maps -24..+24 dB.
function f2lvl(f) ( f <= 0.25 ? -72 + f / 0.25 * 48 : -24 + (f - 0.25) / 0.75 * 48; );
// input level: knob 0 .. 0.25 covers -inf(-72) .. -24 dB, 0.25 .. 1 covers -24 .. +48 dB
function ilvl2f(v) ( v <= -24 ? 0.25 * (v + 72) / 48 : 0.25 + 0.75 * (v + 24) / 72; );
// Converts an input-level knob position f (0..1) to dB: 0..0.25 maps -72..-24 dB, 0.25..1 maps -24..+48 dB.
function f2ilvl(f) ( f <= 0.25 ? -72 + f / 0.25 * 48 : -24 + (f - 0.25) / 0.75 * 72; );
// dropdown box: text (shortened to fit) + arrow; en = enabled, opn = its menu is open
function ddbox(x, y, w, h, s, en, opn)
(
  col(cSURF, 1); RR(x, y, w, h, min(8, h / 2)); col(opn ? cMUTED : (inbox(x, y, w, h) && en ? cDIM2 : cBORD), 1); RRO(x, y, w, h, min(8, h / 2));   // the radius of the cards
  col(en ? cTEXT : cDIM2, 1); gfx_setfont(6); txtfit(s, x + 7, y + h / 2, w - 22);
  chevd(x + w - 10, y + h / 2, en ? cMUTED : cDIM2);
);
// wall materials (WALLS dropdown): name, absorption, tail density, help text
// wall materials, hard -> soft: absorption α at mid frequencies (500 Hz - 1 kHz) and the density of the tail
function wmatname(k) ( k == 0 ? "Tiles" : (k == 1 ? "Glass" : (k == 2 ? "Plaster" : (k == 3 ? "Concrete" : (k == 4 ? "Metal" : (k == 5 ? "Wood" : (k == 6 ? "Curtain" : (k == 7 ? "Foam" : "Wool"))))))); );
// Returns the mid-frequency absorption coefficient alpha of wall material k (0 Tiles 0.02 ... 8 Wool 0.85).
function wmata(k) ( k == 0 ? 0.02 : (k == 1 ? 0.03 : (k == 2 ? 0.04 : (k == 3 ? 0.05 : (k == 4 ? 0.08 : (k == 5 ? 0.10 : (k == 6 ? 0.45 : (k == 7 ? 0.70 : 0.85))))))); );
// Returns the tail density value (20-90) of wall material k (0 Tiles ... 8 Wool).
function wmatd(k) ( k == 0 ? 45 : (k == 1 ? 28 : (k == 2 ? 65 : (k == 3 ? 80 : (k == 4 ? 20 : (k == 5 ? 70 : (k == 6 ? 80 : (k == 7 ? 85 : 90))))))); );
// Returns the help/tooltip text for wall material k (name, alpha and typical use).
function wmattip(k) ( k == 0 ? "Glazed tiles α 0.02: bathroom, kitchen, swimming pool – the hardest, brightest walls" : (k == 1 ? "Glass α 0.03: window panes – thin bass (the pane gives way), very bright, long-ringing highs" : (k == 2 ? "Plaster α 0.04: painted plaster or plasterboard – the usual wall at home and in offices" : (k == 3 ? "Concrete α 0.05: bare concrete or stone – booming, long bass, dark highs that die quickly" : (k == 4 ? "Sheet metal α 0.08: very bright, metallic and ringing – sparse, flutter-like reflections" : (k == 5 ? "Wood α 0.10: paneling – hard surface, lively sound" : (k == 6 ? "Curtain α 0.45: heavy fabric, absorbs about half of the sound" : (k == 7 ? "Acoustic foam α 0.70: absorbs most mid and high frequencies" : "Mineral wool α 0.85: strong absorber, makes the room very dry"))))))); );
// what thickness of a typical absorber gives this α (broadband average, mineral wool / foam on a hard wall; the bass needs more)
function wthick(a) ( a < 0.035 ? "no absorber at all: glass, glazed tile or polished stone" : (a < 0.07 ? "no absorber: plain plaster, plasterboard or bare concrete" : (a < 0.15 ? "wood paneling, or under 1 cm of carpet" : (a < 0.25 ? "about 1 cm of felt or a thin carpet" : (a < 0.38 ? "about 2 cm of mineral wool, or a light curtain" : (a < 0.52 ? "about 3 cm of mineral wool, or a heavy curtain" : (a < 0.65 ? "about 4 cm of mineral wool, or 3 cm of foam" : (a < 0.78 ? "about 5 cm of acoustic foam" : (a < 0.92 ? "5 to 10 cm of mineral wool" : "10 cm or more of mineral wool with an air gap")))))))) );
// Returns tooltip string #wtp: s followed by the typical absorber thickness for absorption a (via wthick).
function wtip(s, a) ( sprintf(#wtp, "%s  ·  thickness: %s (bass needs more)", s, wthick(a)); #wtp; );
// Returns the name of wall-surface selection k (0 All walls, 1-4 Back/Right/Front/Left wall, 5 Floor + ceiling).
function wsurfname(k) ( k == 0 ? "All walls" : (k == 1 ? "Back wall" : (k == 2 ? "Right wall" : (k == 3 ? "Front wall" : (k == 4 ? "Left wall" : "Floor + ceiling")))); );

// Returns the display name of delay preset k.
function dpname(k) ( k == 0 ? "Slapback alley" : (k == 1 ? "Courtyard flutter" : (k == 2 ? "Street shot" : (k == 3 ? "Underground station" : (k == 4 ? "Stadium PA" : (k == 5 ? "PA announcement" : (k == 6 ? "Radio comms" : (k == 7 ? "Phone line echo" : (k == 8 ? "Forest edge" : (k == 9 ? "Cave" : (k == 10 ? "Canyon echo" : (k == 11 ? "Mountain call" : (k == 12 ? "Dream / flashback" : (k == 13 ? "Vocal 1/4" : (k == 14 ? "Ballad 1/4 dotted" : (k == 15 ? "Vocal throw 1/2" : (k == 16 ? "Rap 1/8 throws" : (k == 17 ? "Snare 1/16" : (k == 18 ? "Guitar 1/8 dotted" : (k == 19 ? "Lead 1/4 + 1/8 dotted" : (k == 20 ? "Ping-pong 1/8" : (k == 21 ? "Ping-pong 1/4 dotted" : (k == 22 ? "Synth 1/8 triplet" : (k == 23 ? "Wide 1/8 + 1/8 dotted" : (k == 24 ? "Tape echo 1/8" : (k == 25 ? "Analog BBD 1/4" : (k == 26 ? "Dub 1/4 dotted" : (k == 27 ? "Rockabilly slap" : (k == 28 ? "Haas widener" : (k == 29 ? "Doubler" : (k == 30 ? "Metal resonator" : (k == 31 ? "Robot voice comb" : (k == 32 ? "Glitch stutter" : (k == 33 ? "Alien chatter" : (k == 34 ? "Space ripples" : (k == 35 ? "Time freeze" : (k == 36 ? "Infinite wash" : (""))))))))))))))))))))))))))))))))))))); );
// Returns the one-line description of delay preset k.
function dpdesc(k) ( k == 0 ? "one wall across the street" : (k == 1 ? "flutter between parallel walls" : (k == 2 ? "gunshot / bang between two building rows" : (k == 3 ? "tiled platform, tunnel echo" : (k == 4 ? "delayed loudspeaker towers" : (k == 5 ? "station, airport, hall" : (k == 6 ? "intercom, cockpit, walkie echo" : (k == 7 ? "long-distance call, faint return" : (k == 8 ? "one echo from a tree line" : (k == 9 ? "stone cave, dense dark echoes" : (k == 10 ? "rock walls far away" : (k == 11 ? "valley, very distant echo" : (k == 12 ? "soft, wavering ping-pong" : (k == 13 ? "classic vocal echo" : (k == 14 ? "soft vocal tail for ballads" : (k == 15 ? "one word thrown into the space" : (k == 16 ? "short throws on line ends" : (k == 17 ? "tight rhythmic snare echo" : (k == 18 ? "rhythmic guitar delay" : (k == 19 ? "wide lead guitar or synth" : (k == 20 ? "left - right in eighths" : (k == 21 ? "wide, lazy bounce" : (k == 22 ? "shuffling triplet bounce" : (k == 23 ? "two rhythms left / right" : (k == 24 ? "warm, wobbly repeats" : (k == 25 ? "dark bucket-brigade repeats" : (k == 26 ? "long dark feedback" : (k == 27 ? "50s slapback, tape" : (k == 28 ? "moves the image to the left" : (k == 29 ? "second voice, slightly detuned" : (k == 30 ? "pipe, tube, robot ring" : (k == 31 ? "metallic comb on a voice" : (k == 32 ? "machine-gun repeats in 1/32" : (k == 33 ? "wobbling, warped echoes" : (k == 34 ? "sci-fi sixteenths" : (k == 35 ? "almost endless smear" : (k == 36 ? "endless dark cloud" : (""))))))))))))))))))))))))))))))))))))); );
// Returns the category of delay preset k: 0 for k < 13, 1 for k < 28, else 2.
function dpcat(k) ( k < 13 ? 0 : (k < 28 ? 1 : 2); );
// Returns the name of delay preset category c: Film & post, Music (tempo) or Sound design.
function dpcatname(c) ( c == 0 ? "Film & post" : (c == 1 ? "Music (tempo)" : "Sound design"); );
function dpsl(i) ( i < 8 ? 66 + i : (i < 18 ? 67 + i : 86); );   // field -> slider (74 = tempo is skipped, 18 = link level)
// the preset the delay matches now (-1 = custom); unused fields are ignored (ms in tempo mode, notes in ms mode, R when linked)
function dpmatch() local(k, i, b, m, sl, dpr)
(
  dpr = -1; k = 0;
  loop(NDP,
    b = dptab + k * 19; m = 1; i = 0;
    loop(19,
      sl = dpsl(i);
      ((i == 4 || i == 5) && b[1] >= 0.5) || ((i == 6 || i == 7) && b[1] < 0.5) || ((i == 5 || i == 7) && b[2] >= 0.5) || ((i == 13 || i == 15) && b[3] >= 0.5) || (i == 11 && b[18] >= 0.5) || (i == 9 && slider87 >= 0.5 && abs(b[8] - b[9]) < 0.01) ? 0 :
        ( abs(slider(sl) - b[i]) > 0.01 * max(1, abs(b[i])) ? ( m = 0; ); );
      i += 1;
    );
    m && dpr < 0 ? ( dpr = k; );
    k += 1;
  );
  dpr;
);
// Loads delay preset k (19 fields from dptab) into the delay sliders, sets slider65 on and the preset-type sliders 115/116, notifies automation.
function dpload(k) local(b, i)
(
  b = dptab + k * 19;
  snap_take();
  slider65 = 1;
  i = 0; loop(19, sset(dpsl(i), b[i]); i += 1; );
  sset(87, abs(b[8] - b[9]) < 0.01);
  sset(115, k == 24 || k == 26 || k == 27 ? 1 : (k == 25 ? 2 : (k == 6 || k == 32 ? 3 : 0))); sset(116, k == 7 ? 1 : 0);   // type of the preset
  snap_notify();
);
// TEMPO TOOLS: set the delay to a note value (Time -> Tempo) for L, R or both (tptg 0 / 1 / 2) at the tempo now chosen
// the note value (code of slider 72 / 73) nearest to a time in ms at a tempo
function tpnear(ms, bpm) local(n, b, d, bd) ( b = 8; bd = 1000000000; n = 0; loop(13, d = abs(log(max(1, g_dnote(n) * 60000 / bpm) / max(1, ms))); d < bd ? ( bd = d; b = n; ); n += 1; ); b; );
// Switches the delay to Tempo mode with note code at bpm (-1 keeps tempo source) for L, R or both per tptg; converts old ms times to nearest notes.
function tpapply(code, bpm) local(nb, wasms)
(
  snap_take();
  wasms = slider67 < 0.5;
  bpm >= 0 ? ( slider74 = bpm; );   // -1: keep the tempo source
  nb = slider74 > 0.5 ? slider74 : (tempo > 1 ? tempo : 120);
  // from ms to Tempo with only one side chosen (times not linked): the other side keeps (nearly) its time
  wasms && slider68 < 0.5 && tptg == 0 ? ( slider73 = tpnear(slider71, nb); );
  wasms && slider68 < 0.5 && tptg == 1 ? ( slider72 = tpnear(slider70, nb); );
  wasms && code < 0 ? ( slider72 = tpnear(slider70, nb); slider73 = tpnear(slider71, nb); );   // a tempo alone: the notes nearest the times
  slider67 = 1;
  code >= 0 ? (
    tptg != 1 ? ( slider72 = code; );
    tptg != 0 ? ( slider73 = code; );
    tptg == 1 ? ( slider68 = 0; );
  );
  snap_notify();
);
// TEMPO ANALYSIS (GUI thread, once per analysis): onset strength in 10 ms frames, slightly smoothed -> autocorrelation.
// Score of a beat period L (60 … 200 BPM, in quarter frames, interpolated): r(L) + r(2L) / 2 + r(4L) / 2 (beat, half bar,
// bar - so syncopated patterns do not win), a mild preference around 120 BPM. Then the fine step: the autocorrelation at
// 1, 2, 3 … periods - the error of one frame is divided by the number of periods (about 0.1 BPM).
// Confidence = how far the best score stands out (z-score); onsets = local maxima of the onset strength above mean + 1.5 sd.
function anari(x) local(i0) ( i0 = floor(x); i0 < anaN - 2 ? anaR[i0] + (anaR[i0 + 1] - anaR[i0]) * (x - i0) : 0; );
// Estimates tempo from the onset envelope anaNv: autocorrelation, best beat period; sets anaBf (BPM), anaConf, anaOns (onset count), anaRes (1 ok, -1 flat).
function anaest() local(n, mn, sd, i, L, acc, sc, bS, bL, sm2, sq, cnt, w, rPer, rK, k)
(
  n = anaN;
  i = 0; loop(n, anaS[i] = 0.5 * anaNv[i] + 0.25 * (i > 0 ? anaNv[i - 1] : anaNv[i]) + 0.25 * (i < n - 1 ? anaNv[i + 1] : anaNv[i]); i += 1; );
  mn = 0; i = 0; loop(n, mn += anaS[i]; i += 1; ); mn /= max(1, n);
  sd = 0; i = 0; loop(n, sd += sqr(anaS[i] - mn); i += 1; ); sd = sqrt(sd / max(1, n));
  L = 0; loop(n - 1, acc = 0; i = 0; loop(n - L, acc += (anaS[i] - mn) * (anaS[i + L] - mn); i += 1; ); anaR[L] = acc / (n - L); L += 1; );
  bS = -1000000000; bL = 50; sm2 = 0; sq = 0; cnt = 0; L = 30;
  loop(281,
    w = exp(-0.5 * sqr(log(6000 / L / 120) / log(2)));
    sc = (anari(L) + 0.5 * anari(2 * L) + 0.5 * anari(4 * L)) * (0.7 + 0.3 * w);
    sm2 += sc; sq += sc * sc; cnt += 1;
    sc > bS ? ( bS = sc; bL = L; );
    L += 0.25;
  );
  sm2 /= cnt; sq = sqrt(max(0, sq / cnt - sm2 * sm2));
  anaConf = sq > 0 ? (bS - sm2) / sq : 0;
  bS = -1000000000; rPer = bL - 1; L = bL;
  loop(201,
    rK = max(1, floor(0.8 * n / rPer)); sc = 0; k = 1;
    loop(rK, sc += anari(k * rPer); k += 1; );
    sc /= rK; sc > bS ? ( bS = sc; L = rPer; );
    rPer += 0.01;
  );
  anaBf = 6000 / L; abs(anaBf - floor(anaBf + 0.5)) < 0.12 ? ( anaBf = floor(anaBf + 0.5); );   // songs are mostly in whole BPM
  anaOns = 0; i = 1; loop(max(0, n - 2), anaNv[i] > mn + 1.5 * sd && anaNv[i] >= anaNv[i - 1] && anaNv[i] > anaNv[i + 1] ? anaOns += 1; i += 1; );
  anaRes = sd > 0.000001 ? 1 : -1;
);
// EXPERT SETTINGS ACTIVE (Basic): short names of the hidden Expert settings that change the sound
function xpname(k) ( k == 0 ? "Delay" : (k == 1 ? "Filter" : (k == 2 ? "Single walls" : (k == 3 ? "Source EQ" : (k == 4 ? "Reflect" : (k == 5 ? "Early / late level" : (k == 6 ? "Source direction" : (k == 7 ? "Facing" : (k == 8 ? "Floor + ceiling off" : (k == 9 ? "Barrier element" : (k == 10 ? "Input gain" : (k == 11 ? "Output" : (k == 12 ? "Snapshot morph" : (k == 13 ? "Hear" : (k == 14 ? "Module mix" : "Motion")))))))))))))); );
// (the tap table itself - tnc / tnname - follows below the motion helpers)
// TEMPO TOOLS FOR MOTION (opened from the Motion module): a note value sets the motion's cycle at once
// (straight 1/2 … 1/16 -> Rate: Tempo 1/2 … 1/16; 1/1 = 1 bar), Use sets the tempo and switches the motion to Tempo
function mtcode(q) ( q == 4 ? 0 : (q == 5 ? 2 : (q == 6 ? 5 : (q == 7 ? 8 : (q == 8 ? 11 : -1)))); );   // motion tempo -> note code
// Maps a delay note code (0,2,5,8,11) to motion tempo rate 4..8 and sets slider 108 to it via setp; other codes are ignored.
function tpmot(code) local(q) ( q = code == 0 ? 4 : (code == 2 ? 5 : (code == 5 ? 6 : (code == 8 ? 7 : (code == 11 ? 8 : -1)))); q > 0 ? setp(108, q); );
// Applies a tempo-tool choice: in the motion context (tpctx 14) sets tempo slider 74 and motion rate, otherwise calls tpapply(code, bpm).
function tpuse(code, bpm) ( tpctx == 14 ? ( bpm >= 0 ? setp(74, bpm); floor(slider108 + 0.5) == 0 ? setp(108, 4); ) : tpapply(code, bpm); );
// Returns the note code (slider 72/73 value) of tap-table entry k (1/4, 1/8, 1/8 dotted, 1/8 triplet, 1/16, 1/16 dotted).
function tnc(k) ( k == 0 ? 5 : (k == 1 ? 8 : (k == 2 ? 6 : (k == 3 ? 10 : (k == 4 ? 11 : 9)))); );
// Returns the label of tap-table note entry k (1/4, 1/8, 1/8 dotted, 1/8 triplet, 1/16, 1/16 dotted).
function tnname(k) ( k == 0 ? "1/4" : (k == 1 ? "1/8" : (k == 2 ? "1/8 dotted" : (k == 3 ? "1/8 triplet" : (k == 4 ? "1/16" : "1/16 dotted")))); );
// Maps frequency f (20 Hz-20 kHz, clamped, log scale) to an x pixel inside the EQ square plot (sqpx, width sqpw).
function sqfx(f) ( sqpx + log(max(20, min(20000, f)) / 20) / log(1000) * sqpw; );
// Maps gain g in dB (clamped -30..+15) to a y pixel inside the EQ square plot (sqpy, height sqph); +15 dB at the top.
function sqgy(g) ( sqpy + (15 - min(15, max(-30, g))) / 45 * sqph; );
// Stores the slider values (snap_take), sets the 13 EQ band sliders (47..59) to 0, then sends automation for the changed sliders.
function eqreset() local(i) ( snap_take(); i = 47; loop(13, sset(i, 0); i += 1; ); snap_notify(); );
// ---------- section help: "?" beside every section title -> description + signal flow with the section highlighted ----------
// ids: 1 ROOM, 2 REVERB, 3 SOURCE, 4 WALLS (REFLECTORS in free field), 5 BARRIER, 6 FILTER, 7 I/O, 8 echogram, 10 DELAY, 11 DECAY BY BAND, 14 MOTION, 15 FREE FIELD.  A click opens the panel (and closes it
// again); mouse-over opens it only while the tips (T in VIEW) are on.
function sechelp(id, s, x, yc, c) local(hx, hit)
(
  gfx_setfont(2); hx = x + (strlen(s) > 0 ? tws(s) + 9 : 0);
  hit = sqr(mx - hx) + sqr(my - yc) < 49;
  (hit || shpin == id) ? ( col(c, 1); CI(hx, yc, 5.5, 1); col(cSURF, 1); )
                       : ( col(cLINE, 1); CI(hx, yc, 5.5, 1); col(cMUTED, 1); );
  gfx_setfont(8, "Arial", floor(7.5 * gs + 0.5), 'b'); txtc("?", hx, yc);
  hit && tipShow ? ( shsec = id; shax = hx; shay = yc; );       // mouse-over only with the tips (T in VIEW) switched on
  shpin == id ? ( shbx = hx; shby = yc; );
  click && hit ? ( shpin = shpin == id ? 0 : id; shclr = 0; shbx = hx; shby = yc; );
);
// section heading of the redesign: color mark, name, "?"
function sechead(id, s, x, yc, c) ( col(c, 1); RR(x, yc - 6, 3, 12, 1.5); col(cTEXT, 1); gfx_setfont(2); txt(s, x + 9, yc, 0); sechelp(id, s, x + 9, yc, c); );
// Returns the section-help panel title string for section id (1 ROOM ... 15 FREE FIELD).
function shname(id) ( id == 15 ? "FREE FIELD  –  outdoors, no walls" : id == 14 ? "MOTION  –  source or listener on a path" : id == 11 ? "DECAY BY BAND  –  reverb time per octave" : id == 10 ? "DELAY  –  echoes before the room" : id == 1 ? "ROOM" : (id == 2 ? "REVERB" : (id == 3 ? "SOURCE" : (id == 4 ? (isfree ? "REFLECTORS  –  two free walls outdoors" : "WALLS") : (id == 5 ? "BARRIER" : (id == 6 ? "FILTER" : (id == 7 ? "OUTPUT  –  levels and limiter" : "TIMELINE  –  the room over time (echogram)")))))); );
// Returns the theme color (cXXTT constant) that goes with section id, used to tint its help panel.
function shcol(id) ( id == 15 ? cFFTT : id == 14 ? cMOTT : id == 11 ? cRVTT : id == 10 ? cDLTT : id == 1 ? cRMTT : (id == 2 ? cRVTT : (id == 3 ? cSRTT : (id == 4 ? cWALTT : (id == 5 ? cBARTT : (id == 6 ? cFLTT : (id == 7 ? cIOTT : cTEXT)))))); );
// Returns line hline (0-2) of the section-help description text for section id; the WALLS text differs in free field.
function shtext(id, hline) (
  id == 15 ? (hline == 0 ? "Outdoors: no walls, no ceiling, no reverb – only the direct sound and, with Ground, its" : (hline == 1 ? "reflection from the floor (Hard = asphalt, Grass, Snow) and the two Reflectors (facade, rock …)." : "Free field on = room off. Presets set area, ground and reflectors. Distance = film perspective.")) :
  id == 14 ? (hline == 0 ? "Moves the source, the listener or both on a pattern: circle, square, left – right, front –" : (hline == 1 ? "back, up – down, wave, a drawn path or a pass-by. Rate in Hz or tempo, Size in m, Glide = the" : "fade in / out. Runs with the transport – the same place at every playback.")) :
  id == 11 ? (hline == 0 ? "How long the reverb rings in each octave (RT60 = time to fall by 60 dB), exactly as the reverb" : (hline == 1 ? "engine plays it. Hard walls ring long and bright, soft ones swallow the highs first, air dampens them too." : "Green bars: room modes – below this frequency a small room rings on its own tones.")) :
  id == 10 ? (hline == 0 ? "Echoes before the room: L and R each have Time, Feedback (repeats), Level and" : (hline == 1 ? "a low / high cut in the feedback loop – every repeat gets thinner and darker." : "The echoes play into the room, so each one is reverberated. Off = no change.")) :
  id == 1 ? (hline == 0 ? "Room: width, depth, height, Size, absorption, heights and the angle of the source." : (hline == 1 ? "Reverb (2nd row): Early / Late level, Decay = RT60, Predelay, Density, Tone and" : "Reflect = how much all surfaces reflect (100 % = as built). Off = only the source model.")) : (
  id == 2 ? (hline == 0 ? "How the room answers: Early = level of the reflections, Late = level of the" : (hline == 1 ? "reverb, Decay = reverb time RT60, Predelay = gap before the room answers," : "Density = smooth or grainy tail, Tone = darker or brighter room sound.")) : (
  id == 3 ? (hline == 0 ? "What is making the sound: a phone, a radio, a megaphone … Each model is a" : (hline == 1 ? "filter curve plus distortion. Drag the points H, 1–3 and L to reshape the curve." : "Distortion pushes the device. Call line (Expert): band, duplex, codec, dropouts.")) : (
  id == 4 && isfree ? (hline == 0 ? "Two freely placed vertical planes outdoors: a facade, glass, rock face, fence or hedge." : (hline == 1 ? "Each one adds a real echo from where it stands (X, Y, Angle, Length, Height) – the sound" : "bounces off it like off a house wall. Drag the R1 / R2 handles in the Stage View.")) :
  id == 4 ? (hline == 0 ? "What the room is made of. Choose a surface, then a material: hard materials" : (hline == 1 ? "(glass, concrete) reflect – long, bright reverb; soft materials (curtain, foam)" : "absorb – short, dry room. Floor + ceiling switches their reflections on or off.")) : (
  id == 5 ? (hline == 0 ? "A wall, window or door between source and listener. Damp = how much it" : (hline == 1 ? "blocks (bass passes more), Open = how far the door or window is open," : "Pos = where it stands, Back part = material of the room behind it.")) : (
  id == 6 ? (hline == 0 ? "Low cut removes everything below its frequency (rumble), high cut everything" : (hline == 1 ? "above it (hiss). The dB value is the steepness per octave. Pre = filter the" : "input before source and room, Post = filter the finished output.")) :
  (id == 7 ? (hline == 0 ? "Levels in and out: In = gain into the plugin, Out = gain out of it," : (hline == 1 ? "Mix = balance between dry input and room. Limiter on: a look-ahead limiter" : "keeps every peak below −1 dBFS (1.5 ms latency, compensated by REAPER)."))
           : (hline == 0 ? "What the room does to one short click: time runs left to right (ms), level" : (hline == 1 ? "bottom to top (dB). Green bar = direct sound, blue bars = wall reflections," : "shaded area = reverb tail. RT60 = time until the reverb has dropped by 60 dB.")))
  )))));
);
function shboxname(k) ( k == 0 ? "IN" : (k == 1 ? "FILTER" : (k == 2 ? "SOURCE" : (k == 3 ? "DELAY" : (k == 4 ? "ROOM" : (k == 5 ? "MOTION" : (k == 6 ? "MIX" : (k == 7 ? "OUT" : (k == 8 ? "FILTER" : "LIMIT")))))))); );   // + MOTION
// highlight of flow box k for section id: 0 = none, 1 = solid (this section works here), 2 = outline (the section's other possible place)
function shhl(id, k) local(fp)
(
  fp = slider30 >= 0.5;
  id == 3 ? (k == 2) : (
  id == 14 ? (k == 5) : (
  id == 10 ? (k == 3) : (
  id == 6 ? ((k == 1 || k == 8) ? ((k == 8) == fp ? 1 : 2) : 0) : (
  id == 7 ? (k == 0 || k == 6 || k == 7 || k == 9) : (k == 4)))));
);
// Draws the section-help popup for id near (ax, ay): title, 3 text lines, and the signal-flow boxes with the section highlighted.
function drawsechelp(id, ax, ay) local(ffh, pw, ph, px, py, k, bx, by, hl, c, tw1, sw1, sw2, sw3, sx0)
(
  c = shcol(id);
  gfx_setfont(4); tw1 = max(tws(shtext(id, 0)), max(tws(shtext(id, 1)), tws(shtext(id, 2))));
  pw = max(10 * 36 + 9 * 8, tw1) + 20; ph = 108;
  px = min(max(ax + 10, 6), WT - 6 - pw); py = ay + 12; py + ph > scy + HT - 6 ? py = ay - 12 - ph;
  col(cINK, 0.14); RR(px + 1, py + 3, pw, ph, 8);
  col(cSURF, 1); RR(px, py, pw, ph, 8); col(c, 1); RRO(px, py, pw, ph, 8);
  col(c, 1); gfx_setfont(2); txt(shname(id), px + 10, py + 12, 0);
  col(cTEXT, 1); gfx_setfont(4);
  txt(shtext(id, 0), px + 10, py + 27, 0); txt(shtext(id, 1), px + 10, py + 38, 0); txt(shtext(id, 2), px + 10, py + 49, 0);
  col(cMUTED, 1); gfx_setfont(6); txt("SIGNAL FLOW", px + 10, py + 64, 0);
  by = py + 72; k = 0;
  loop(10,
    bx = px + 10 + k * 44; hl = shhl(id, k);
    hl == 1 ? ( col(c, 1); RR(bx, by, 36, 16, 4); col(cSURF, 1); )
            : ( col(cLINE, 1); RR(bx, by, 36, 16, 4); hl == 2 ? ( col(c, 1); RRO(bx, by, 36, 16, 4); ) : col(cMUTED, 1); );
    txtbox(shboxname(k), bx + 18, by + 8, 36, 16, 6);
    k < 9 ? ( col(cMUTED, 1); LN(bx + 37, by + 8, bx + 42, by + 8); POLY4(bx + 40, by + 5.5, bx + 43.5, by + 8, bx + 40, by + 10.5, bx + 40, by + 10.5); );
    k += 1;
  );
  // below the boxes: where the filter sits, and what is inside ROOM
  gfx_setfont(7);
  col(slider30 < 0.5 ? cTEXT : cDIM2, 1); txt("pre", px + 10 + 44 + 18, by + 23, 1);
  col(slider30 >= 0.5 ? cTEXT : cDIM2, 1); txt("post", px + 10 + 8 * 44 + 18, by + 23, 1);
// in the free field the ROOM box holds: free field (ground), reflectors, barrier - no walls, no reverb
  ffh = isfree || id == 15;
  ffh ? ( sw1 = tws("free field"); sw2 = tws("reflectors"); sw3 = tws("barrier"); ) : ( sw1 = tws("walls"); sw2 = tws("barrier"); sw3 = tws("reverb"); );
  sx0 = px + 10 + 4 * 44 + 18 - (sw1 + sw2 + sw3 + 12) / 2;
  ffh ? (
    col(id == 15 ? c : cMUTED, 1); txt("free field", sx0, by + 23, 0);
    col(id == 4 ? c : cMUTED, 1); txt("reflectors", sx0 + sw1 + 6, by + 23, 0);
    col(id == 5 ? c : cMUTED, 1); txt("barrier", sx0 + sw1 + sw2 + 12, by + 23, 0);
  ) : (
    col(id == 4 ? c : cMUTED, 1); txt("walls", sx0, by + 23, 0);
    col(id == 5 ? c : cMUTED, 1); txt("barrier", sx0 + sw1 + 6, by + 23, 0);
    col(id == 2 ? c : cMUTED, 1); txt("reverb", sx0 + sw1 + sw2 + 12, by + 23, 0);
  );
);
// Maps value v in [lo,hi] to a linear 0..1 fraction (clamped).
function lin2f(v, lo, hi) ( min(1, max(0, (v - lo) / (hi - lo))); );
// Inverse of lin2f: maps a 0..1 fraction f to a value in [lo,hi] linearly.
function f2lin(f, lo, hi) ( lo + f * (hi - lo); );
// Maps value v in [lo,hi] to a logarithmic 0..1 fraction (clamped).
function log2f(v, lo, hi) ( min(1, max(0, log(v / lo) / log(hi / lo))); );
// Inverse of log2f: maps a 0..1 fraction f to a value in [lo,hi] on a log scale.
function f2log(f, lo, hi) ( lo * exp(f * log(hi / lo)); );
// Sets the density parameter (slider 38) to d through setp, as a gesture-held GUI change.
function setdens(d) ( setp(38, d); );
// Sets wall absorption v (clamped 0.01..1) on the selected wall (selw: 0 = four side walls, 1-4 single walls, 5 floor/ceiling).
function setalpha(v)
(
  v = min(1, max(0.01, v));
  selw == 0 ? ( setp(5, v); setp(6, v); setp(7, v); setp(8, v); );
  selw == 1 ? setp(5, v);
  selw == 2 ? setp(6, v);
  selw == 3 ? setp(7, v);
  selw == 4 ? setp(8, v);
  selw == 5 ? setp(9, v);
);
// Sets the gfx color for a wall of absorption a (greener/darker when more absorbent, with wlift offset) and alpha al, then applies gmono().
function wallcol(a, al) ( gfx_r = (120 + wlift - 90 * a) / 255; gfx_g = (120 + wlift + 40 * a) / 255; gfx_b = (120 + wlift - 20 * a) / 255; gfx_a = al; gmono(); );
// Converts a linear amplitude v to dB (20*log10); returns -200 for values at or below 1e-10.
function dbs(v) ( v > 0.0000000001 ? 20 * log10(v) : -200; );

// oblique 3D projection : x right, y depth (0 = back wall), z up
function PJ(x, y, z) ( qx = pX0 + x * pXs + y * pKX; qy = pY0 + y * pKY - z * pSZ; );
// ROOM CORNERS in the 3D view: the two lower front corners (1 = left, 2 = right) within 8 px, or 0
function cornerhit() local(d1, d2)
(
  PJ(0, roomD, 0); d1 = sqrt(sqr(mx - qx) + sqr(my - qy));
  PJ(roomW, roomD, 0); d2 = sqrt(sqr(mx - qx) + sqr(my - qy));
  d2 < 8 && d2 <= d1 ? 2 : (d1 < 8 ? 1 : 0);
);
// ROOM EDGES in the 3D view: index of the edge under the mouse (0-3 along the width, 4-7 along the depth, 8-11 along the
// height) or -1; 6 px catch distance
function edgehit() local(e, ax, j, o1, o2, x0, y0, z0, x1, y1, z1, ax0, ay0, ux, uy, l2, t, d, best)
(
  ehx = -1; best = 6;
  e = 0;
  loop(12,
    ax = floor(e / 4); j = e % 4; o1 = j & 1; o2 = (j >> 1) & 1;
    ax == 0 ? ( x0 = 0; x1 = roomW; y0 = y1 = o1 * roomD; z0 = z1 = o2 * roomH; ) : (
    ax == 1 ? ( x0 = x1 = o1 * roomW; y0 = 0; y1 = roomD; z0 = z1 = o2 * roomH; ) : (
              x0 = x1 = o1 * roomW; y0 = y1 = o2 * roomD; z0 = 0; z1 = roomH; ));
    PJ(x0, y0, z0); ax0 = qx; ay0 = qy; PJ(x1, y1, z1);
    ux = qx - ax0; uy = qy - ay0; l2 = max(0.0001, ux * ux + uy * uy);
    t = min(1, max(0, ((mx - ax0) * ux + (my - ay0) * uy) / l2));
    d = sqrt(sqr(mx - ax0 - t * ux) + sqr(my - ay0 - t * uy));
    d < best && e != 3 && (!sidevOn || ax == 2 || (frontv ? (ax == 0 && o2 == 1) : (ax == 1 && o2 == 1))) && (!hidew || (ax < 2 && o2 == 0)) && (!planv || (ax < 2 && o2 == 0)) ? ( best = d; ehx = e; );   // not the faint top front edge; walls hidden / plan: floor edges only
    e += 1;
  );
  ehx;
);
// Draws room box edge e (0-11: 4 per axis x/y/z) in color c as a projected 3D line.
function edgedraw(e, c) local(ax, j, o1, o2, x0, y0, z0, x1, y1, z1, ax0, ay0)
(
  ax = floor(e / 4); j = e % 4; o1 = j & 1; o2 = (j >> 1) & 1;
  ax == 0 ? ( x0 = 0; x1 = roomW; y0 = y1 = o1 * roomD; z0 = z1 = o2 * roomH; ) : (
  ax == 1 ? ( x0 = x1 = o1 * roomW; y0 = 0; y1 = roomD; z0 = z1 = o2 * roomH; ) : (
            x0 = x1 = o1 * roomW; y0 = y1 = o2 * roomD; z0 = 0; z1 = roomH; ));
  PJ(x0, y0, z0); ax0 = qx; ay0 = qy; PJ(x1, y1, z1);
  col(c, 1); LNW(ax0, ay0, qx, qy, 3);
);

// point on a wall face: id 1 = top/back, 2 = right, 3 = bottom/front, 4 = left; u along wall, t up
function facept(id, u, t)
(
  id == 1 ? PJ(u * roomW, 0, t * roomH) : (
    id == 2 ? PJ(roomW, u * roomD, t * roomH) : (
      id == 3 ? PJ(u * roomW, roomD, t * roomH) : PJ(0, u * roomD, t * roomH)));
);
// Draws the projected 4-sided outline of wall face id with line width wd.
function faceoutline(id, wd) local(x1, y1, x2, y2, x3, y3, x4, y4)
(
  facept(id, 0, 0); x1 = qx; y1 = qy; facept(id, 1, 0); x2 = qx; y2 = qy;
  facept(id, 1, 1); x3 = qx; y3 = qy; facept(id, 0, 1); x4 = qx; y4 = qy;
  LNW(x1, y1, x2, y2, wd); LNW(x2, y2, x3, y3, wd); LNW(x3, y3, x4, y4, wd); LNW(x4, y4, x1, y1, wd);
);
// Draws wall face id as a tinted projected quad plus diagonal hatching whose density follows absorption a.
function drawface(id, a) local(x1, y1, x2, y2, x3, y3, x4, y4, u, k, st, t0, t1, hx, hy)
(
  facept(id, 0, 0); x1 = qx; y1 = qy; facept(id, 1, 0); x2 = qx; y2 = qy;
  facept(id, 1, 1); x3 = qx; y3 = qy; facept(id, 0, 1); x4 = qx; y4 = qy;
  wallcol(a, 0.10); POLY4(x1, y1, x2, y2, x3, y3, x4, y4);
  a >= 0.03 ? (
    wallcol(a, 0.45);
    k = 0.18; st = max(0.025, 0.22 - 0.2 * a); u = -k;
    while (
      t0 = max(0, -u / k); t1 = min(1, (1 - u) / k);
      facept(id, u + k * t0, t0); hx = qx; hy = qy;
      facept(id, u + k * t1, t1);
      LN(hx, hy, qx, qy);
      u += st;
      u < 1;
    );
  );
  wallcol(a, 0.9); faceoutline(id, 1.5);
);
// is (mx,my) inside the projected wall face?
function inface(id) local(x1, y1, x2, y2, x3, y3, x4, y4, c1, c2, c3, c4)
(
  facept(id, 0, 0); x1 = qx; y1 = qy; facept(id, 1, 0); x2 = qx; y2 = qy;
  facept(id, 1, 1); x3 = qx; y3 = qy; facept(id, 0, 1); x4 = qx; y4 = qy;
  c1 = (x2 - x1) * (my - y1) - (y2 - y1) * (mx - x1);
  c2 = (x3 - x2) * (my - y2) - (y3 - y2) * (mx - x2);
  c3 = (x4 - x3) * (my - y3) - (y4 - y3) * (mx - x3);
  c4 = (x1 - x4) * (my - y4) - (y1 - y4) * (mx - x4);
  (c1 >= 0 && c2 >= 0 && c3 >= 0 && c4 >= 0) || (c1 <= 0 && c2 <= 0 && c3 <= 0 && c4 <= 0);
);
// Draws a 72-segment ring (center cx0,cy0, radius rad) on the floor, clipped to the room; dashed 1 = every other, 2 = every third segment.
function floorring(cx0, cy0, rad, dashed) local(q, a1, a2, xq1, yq1, xq2, yq2, hx, hy)
(
  q = 0;
  loop(72,
    a1 = q / 72 * 2 * $pi; a2 = (q + 1) / 72 * 2 * $pi;
    xq1 = cx0 + rad * cos(a1); yq1 = cy0 + rad * sin(a1);
    xq2 = cx0 + rad * cos(a2); yq2 = cy0 + rad * sin(a2);
    (!dashed || (dashed == 2 ? q % 3 == 0 : (q & 1) == 0)) && xq1 >= 0 && xq1 <= roomW && yq1 >= 0 && yq1 <= roomD && xq2 >= 0 && xq2 <= roomW && yq2 >= 0 && yq2 <= roomD ? (
      PJ(xq1, yq1, 0); hx = qx; hy = qy; PJ(xq2, yq2, 0); LNW(hx, hy, qx, qy, 0.7);
    );
    q += 1;
  );
);
// Draws a soft matte ellipse shadow on the floor under an object at room position (x, y) using pixel rows.
function shadow(x, y) local(cx, cy, rx, ry, k, n, t, w)
(
// a soft matte ellipse on the floor (pixel rows, no triangle seams)
  PJ(x, y, 0); cx = gox + qx * gs; cy = goy + qy * gs; rx = 0.3 * pS * gs; ry = max(1, 0.3 * pKY * gs);
  col(cINK, 0.09); n = floor(2 * ry); k = 0;
  loop(n, t = (k + 0.5 - ry) / ry; w = rx * sqrt(max(0, 1 - t * t)); gfx_rect(floor(cx - w + 0.5), floor(cy - ry + k), max(1, floor(2 * w + 0.5)), 1); k += 1; );
);
// Draws the dashed source-to-reflection-point-to-listener path with a dot; point clamped into the room, brighter when on, alpha scaled by 1-a.
function reflpath(px, py, pz, a, on) local(hx, hy, x2, y2)
(
  px = min(roomW, max(0, px)); py = min(roomD, max(0, py)); pz = min(roomH, max(0, pz));   // the reflection point always on a surface of the room
  PJ(sx, sy, sz); hx = qx; hy = qy;                                // from the center of the source ball (the old icon sat 10 px higher)
  PJ(px, py, pz); x2 = qx; y2 = qy;
  col(cRMTT, on ? 0.25 + 0.6 * (1 - a) : 0.12);   // reflections are blue (as in the Timeline; was the old teal)
  DL(hx, hy, x2, y2, 4, 3, 0.7);
  PJ(lx, ly, lz); DL(x2, y2, qx, qy, 4, 3, 0.7);
  col(cRMTT, on ? 1 : 0.3); CI(x2, y2, 2, 1);
);
// padlock beside the name plate of a locked source / listener: its own small plate of the same height (14), fine lines.
// (x, yc) = center of the plate
function drawlock(x, yc, c) local(y)
(
  col(cSURF, 0.92); RR(x - 6, yc - 7, 12, 14, 4);
  y = yc - 0.6; col(c, 1);
  SDB0(); SDARC(x, y - 2, 2.5, -0.5 * $pi, 0.5 * $pi); SDSEG(x - 2.5, y - 2, x - 2.5, y + 0.4); SDSEG(x + 2.5, y - 2, x + 2.5, y + 0.4); SDDRAW(1.2);   // smooth shackle
  SDB0(); SDSEG(x - 1.6, y + 2.3, x + 1.6, y + 2.3); SDDRAW(4.6);           // body: a rounded block (smooth edges)
  col(cSURF, 1); SDDISC(x, y + 1.7, 0.85); SDB0(); SDSEG(x, y + 2, x, y + 3.6); SDDRAW(0.7);   // keyhole
);
// ---- source and listener as shaded balls with a direction arrow - in the plan and in 3D, in every mode ----
// a ball: color c, radius r (px at the page scale), lit from the top left; letter inside (S / L)
function ball3d(x, y, r, c, s)
(
  b3tx = rvTX; rvTX = 0;   // (Labels off: the S and L on the balls stay)
// matte - one flat color, a fine edge a little darker, the letter in white (B&W: source solid, listener a ring)
  monoOn ? (
    strcmp(s, "L") == 0 ? ( col(cSURF, 1); CIF(x, y, r, 1); col(cTEXT, 1); CIF(x, y, r, 0); CIF(x, y, r - 0.7, 0); CIF(x, y, r - 1.4, 0); col(cTEXT, 1); )
                        : ( col(cTEXT, 1); CIF(x, y, r, 1); col(cBG, 1); );
  ) : (
    col(0x000000, darkmode ? 0.35 : 0.10); CIF(x + 0.6, y + 1.8, r + 1.2, 1); col(0x000000, darkmode ? 0.25 : 0.07); CIF(x + 0.4, y + 1.2, r + 0.6, 1);   // a soft drop shadow
    col(c, 1); CIF(x, y, r, 1);
    col(0xFFFFFF, darkmode ? 0.06 : 0.11); CIF(x - r * 0.22, y - r * 0.26, r * 0.62, 1);   // a faint highlight
    col(0x000000, 0.14); CIF(x, y, r, 0); CIF(x, y, r - 0.6, 0);
    col(darkmode ? 0x101418 : 0xFFFFFF, 1);   // dark mode: light pastel balls, dark letter
  );
  gfx_setfont(6); txt(s, x, y + 0.5, 1);
  rvTX = b3tx;
);
// direction arrow from the edge of a ball (center x0, y0, radius r) to x1, y1 (projected)
function arrow3d(x0, y0, x1, y1, r, c, al) local(dx, dy, l, ex, ey)
(
  dx = x1 - x0; dy = y1 - y0; l = max(0.001, sqrt(dx * dx + dy * dy)); dx /= l; dy /= l;
  l > 0.6 ? (                                            // (pointing straight at the viewer: no arrow)
    l = max(l, r + 17); x1 = x0 + dx * l; y1 = y0 + dy * l;  // at least a readable arrow beside the ball
    ex = x1 - dx * 6; ey = y1 - dy * 6;
    col(c, al); LNW(x0 + dx * (r + 2), y0 + dy * (r + 2), ex, ey, 1.5);
    POLY4(x1, y1, ex - dy * 3.6, ey + dx * 3.6, ex + dy * 3.6, ey - dx * 3.6, x1, y1);
  );
);
// model loaded (and on), 3D: an info sign in the bottom right corner of the stage - icon + "Source model: …"
function srcsign(fz) local(w, x, y)
(
  gfx_setfont(6); sprintf(#ssg, "Source model: %s", srcname(fz)); w = tws(#ssg) + 34;
  x = VX + VW - 16 - w; y = VY + VH - 26 - 26;
  x < VX + 204 ? y -= 30;   // not under the source pill (bottom left) in a narrow view
  col(cSURF, 0.94); RR(x, y, w, 20, 6); col(cSRC, 1); RRO(x, y, w, 20, 6);
  icOL = 1; srcicon(fz, x + 13, y + 15.5, 0.55, cTEXT, cSURF); icOL = 0;   // line icons everywhere
  col(cTEXT, 1); gfx_setfont(6); txt(#ssg, x + 26, y + 10, 0);
);
// STEREO WIDTH helpers: the value in % or m (vopt[50]: 100 % = 1 m by convention - the side signal has no place of
// its own, the meter is the width the span in the room view shows), the unit toggle, the Mono mix power button
function swfmt() ( vopt[50] >= 0.5 ? sprintf(#fv, "%.2f m", slider98 / 100) : sprintf(#fv, "%.0f %%", slider98); kmap(0, 0, 200, 1); );
// Draws the % / m unit toggle for stereo width (sets vopt[50]) with a tooltip, at (x, y).
function swunit(x, y) local(u) (
  u = vopt[50] >= 0.5;
  chip(x, y, 14, 11, "%", !u, cSRTT) ? ( vopt[50] = 0; click = 0; ); chip(x + 16, y, 14, 11, "m", u, cSRTT) ? ( vopt[50] = 1; click = 0; );
  tipbox(x, y, 30, 11, "Stereo width in % of the input or in meters (100 % = 1 m): the same control, another label – the span in the Stage View is always in meters");
);
// ---- RoomservicePro: the monitoring ring in the Stage View (Plan and 3D) ----
// One loudspeaker: an upright square with the cone as a dot (never turned - a turned cabinet looked crooked in the 3D view); the name sits
// beside it, inward (towards the middle of the room) or outward. ang only says which side that is.
function pskspk(x, y, ang, lab, hot, inw) local(ux, uy)
(
  ux = cos(ang); uy = sin(ang);
  col(hot ? cACTO : cBORD, 1); RR(x - 7, y - 7, 14, 14, 3);
  col(cSURF, 1); CIF(x, y, 3.4, 1);
  col(hot ? cACTO : cBORD, 1); CIF(x, y, 1.3, 1);
  lab != "" ? ( gfx_setfont(4); col(hot ? cACTO : cMUTED, 1); inw ? txt(lab, x + ux * 17, y + uy * 17, 1) : txt(lab, x - ux * 16, y - uy * 16, 1); );
);
// The ring belongs to the ROOM: the speakers sit on the walls (the list SPKL, see spkgeo), at one fixed height; they do not move with the
// source or the listener. ITU = a circle round the middle of the room with L C R Rs Ls on it; Film = L C R across the screen wall, the surrounds as arrays on the side walls.
function prospk() local(i, j, k, z, cx, cy, ang, px, py, lab, rr, tw, az, a)
(
  gfx_mode = 0; gfx_a = 1;
  spkgeo(SPKG, slider13 * gsrs, slider14 * gsrs, face + $pi / 2);   // (the audio thread may not have run: playback stopped, or a screenshot host; face: the listener's facing, computed by the geometry)
  z = SPKG[2]; rr = SPKG[62];
  PJ(SPKG[60], SPKG[61], z); cx = qx; cy = qy;
  // the ring (all five loudspeakers the same distance from the listener)
  i = 0;
  loop(65,
    ang = i / 64 * 2 * $pi;
    PJ(SPKG[60] + sin(ang) * rr, SPKG[61] - cos(ang) * rr, z);
    i > 0 ? ( col(cBORD, 0.55); LNW(px, py, qx, qy, 1); );
    px = qx; py = qy; i += 1;
  );
  i = 0;
  loop(5,
    k = i == 0 ? 2 : (i == 1 ? 0 : (i == 2 ? 1 : (i == 3 ? 4 : 5)));
    lab = i == 0 ? "C" : (i == 1 ? "L" : (i == 2 ? "R" : (i == 3 ? "Ls" : "Rs")));
    SPKG[k * 8 + 4] >= 0.5 ? (
      // Film: a surround ARRAY along the ring (+-75 ... +-125 degrees), three boxes, the label on the middle one
      j = 0;
      loop(3,
        a = (SPKG[k * 8 + 3] + (j - 1) * 18) * $pi / 180 + SPKG[63];
        PJ(SPKG[60] + sin(a) * rr, SPKG[61] - cos(a) * rr, z);
        pskspk(qx, qy, atan2(cy - qy, cx - qx), j == 1 ? lab : "", slider146 >= 0.5 && pro_on && qSnapK == i, 1);
        j += 1; );
    ) : (
      PJ(SPKG[k * 8], SPKG[k * 8 + 1], z);
      pskspk(qx, qy, atan2(cy - qy, cx - qx), lab, slider146 >= 0.5 && pro_on && qSnapK == (i == 0 ? 2 : (i == 1 ? 0 : (i == 2 ? 1 : i))), i >= 3);   // hot: the loudspeaker the source snaps to
    );
    i += 1;
  );
  // LFE: its own small area (not a direction - the subwoofer is not panned), on the floor inside the ring, behind the listener
  a = $pi + SPKG[63];
  PJ(SPKG[60] + sin(a) * rr * 0.6, SPKG[61] - cos(a) * rr * 0.6, z * 0.25);
  !rvTX ? ( col(slider141 >= 0.5 ? cBORD : cLINE, 1); RR(qx - 14, qy - 7, 28, 13, 3); );
  col(slider141 >= 0.5 ? cMUTED : cDIM, 1); gfx_setfont(4); txt("LFE", qx, qy, 1);
  // the chip: layout, angles, where the ring sits, height - and the warning when the track has too few channels
  slider137 < 0.5 ? sprintf(#pskt, "5.1   ITU   %g / %g deg   %s   height %g m", slider138, slider139, slider145 >= 0.5 ? "in the room" : "at the listener", min(z, 99))
                  : sprintf(#pskt, "5.1   Film   25 / 100 deg   %s   height %g m", slider145 >= 0.5 ? "in the room" : "at the listener", min(z, 99));
  !rvTX ? (
  gfx_setfont(4); tw = tws(#pskt) + 22;   // (no warning about the track's channel count: a stereo source is moved in the 5.1 room as it is)
  p51y = VY + (isfree ? 48 : 28);   // outdoors: under the FREE FIELD label
  col(cSURF, 0.9); RR(VX + 10, p51y, tw, 16, 8); col(cBORD, 1); RRO(VX + 10, p51y, tw, 16, 8);
  col(cMUTED, 1); txt(#pskt, VX + 10 + tw / 2, p51y + 8, 1);
  );
);
// SOURCE PILL: stereo width and mono mix of the source, in the room view - visible and adjustable from every
// module and in Basic, 136 x 20 (plus the Handles chip,) in the lower left corner of the plan / 3D view
function srcpill(x, y) local(on, nf, hit, dpw)
(
  on = slider110 >= 0.5;
  col(cSURF, 0.92); RR(x, y, 136, 20, 7); col(cBORD, 1); RRO(x, y, 136, 20, 7);   // compact
  col(cSRTT, 1); RR(x + 6, y + 5, 3, 10, 1.5);
  tgl(x + 6, y + 3, on, cSRTT) ? ( slider110 = on ? 0 : 1; sauto1(110); click = 0; );
  col(on ? cTEXT : cMUTED, 1); gfx_setfont(7); txt("mono", x + 31, y + 10, 0);
  tipbox(x + 6, y, 48, 20, on ? "Source – mono mix on: the input is summed to mono before anything else. Click: stereo again" : "Source – mono mix: sum the input to mono before any processing (the same switch as in the Source module)");
  swfmt(); kdim = on || devm;
  nf = hsl(86, x + 60, y + 1, 36, "", "", slider98 / 200, 0.5, on || devm ? cDIM : cSRTT); kdim = 0;
  col(on || devm ? cDIM2 : cTEXT, 1); gfx_setfont(7); txt(#fv, x + 131, y + 10, 2);
  hit = inbox(x + 55, y, 80, 20);
// the stereo handles (the span of the source in the view) on / off - drawn only while the chip fits into the view
  x + 200 <= VX + VW - 8 ? (
    chip(x + 142, y + 3, 58, 14, "Handles", vopt[51] < 0.5, cSRTT) ? ( vopt[51] = vopt[51] >= 0.5 ? 0 : 1; click = 0; );
    tipbox(x + 142, y + 3, 58, 14, vopt[51] < 0.5 ? "Stereo handles on (key H): the span of the source is drawn with its two ends – Shift + mouse wheel in the Stage View sets the stereo width (up = wider, down = narrower). Click: hide them (Shift + wheel still works)" : "Stereo handles hidden (key H) – Shift + mouse wheel in the Stage View still sets the stereo width. Click: show them again");
  );
// Doppler while dragging by hand (slider135): on = the real pitch glide, off = only the distance (level, filter, room)
  dpw = x + 264 <= VX + VW - 8 ? 58 : 44;   // a narrow view: the short label still fits
  x + 206 + dpw <= VX + VW - 8 ? (
    chip(x + 206, y + 3, dpw, 14, dpw > 50 ? "Doppler" : "Dop", slider135 < 0.5, cSRTT) ? ( slider135 = slider135 >= 0.5 ? 0 : 1; slider_automate(slider135); click = 0; );
    tipbox(x + 206, y + 3, dpw, 14, slider135 < 0.5 ? "Doppler on: dragging source or listener glides the delays – a real pitch change while they move (fast drags are audible). Click: off – only the distance changes (level, filter, room), no pitch. Motion has its own Doppler setting" : "Doppler off while dragging by hand: the pitch stays, only the distance changes. Click: on again (the real pitch glide)");
  );
// 5.1 (switched in the top bar): the ITU layout is fixed (no Film layout any more) - the ring's place and Snap - drawn while they fit into the view
  slider136 >= 0.5 ? (
    // the ring on the listener (it moves and turns with him) or in the middle of the room (the listener is held there: a cinema panner, the room adds its acoustics)
    x + 212 + dpw + 96 <= VX + VW - 8 ? (
      segtrack(x + 212 + dpw, y + 2, 96, 16);
      segp(x + 212 + dpw, y + 2, 96, 16, 2, 0, "Listener", slider145 < 0.5, cTEXT) ? ( slider145 = 0; slider_automate(slider145); click = 0; );
      segp(x + 212 + dpw, y + 2, 96, 16, 2, 1, "Room", slider145 >= 0.5, cTEXT) ? ( slider145 = 1; slider_automate(slider145); click = 0; );
      tipbox(x + 212 + dpw, y + 2, 48, 16, "Ring at the listener: the loudspeakers sit around him and turn with his facing - move him towards a wall and that wall comes from the side, early and loud");
      tipbox(x + 260 + dpw, y + 2, 48, 16, "Ring in the room: the listener is held in the middle, facing the screen - the source pans across the loudspeakers like in a cinema panner, the room adds its acoustics");
    );
    // snap: the direct sound on one loudspeaker (the nearest to the source's direction), the room stays around it
    x + 314 + dpw + 64 <= VX + VW - 8 ? (
      chip(x + 314 + dpw, y + 2, 64, 16, "Snap spk", slider146 >= 0.5, cSRTT) ? ( slider146 = slider146 >= 0.5 ? 0 : 1; slider_automate(slider146); click = 0; );
      tipbox(x + 314 + dpw, y + 2, 64, 16, "Snap to loudspeaker: the direct sound sits on the one loudspeaker nearest to the source's direction - a hard channel assignment. Reflections and reverb still come from the room");
    );
    // DELAY ECHOES: their left / right difference in front (L / R), behind (Ls / Rs) or all around
    x + 384 + dpw + 150 <= VX + VW - 8 ? (
      segtrack(x + 384 + dpw, y + 2, 150, 16);
      segp(x + 384 + dpw, y + 2, 150, 16, 3, 0, "Echo front", slider152 < 0.5, cDLTT) ? ( slider152 = 0; slider_automate(slider152); click = 0; );
      segp(x + 384 + dpw, y + 2, 150, 16, 3, 1, "rear", slider152 >= 0.5 && slider152 < 1.5, cDLTT) ? ( slider152 = 1; slider_automate(slider152); click = 0; );
      segp(x + 384 + dpw, y + 2, 150, 16, 3, 2, "around", slider152 >= 1.5, cDLTT) ? ( slider152 = 2; slider_automate(slider152); click = 0; );
      tipbox(x + 384 + dpw, y + 2, 150, 16, "Delay in 5.1: where the left / right width of the echoes (Stereo or Ping-pong) plays – in front on L / R, behind on Ls / Rs, or around on all four. The echoes themselves still come from the source's place in the room");
    );
  );
  kchg && !(on || devm) ? setp(98, nf * 200); kchg = 0;
  hit && mouse_wheel != 0 ? mouse_wheel = 0;   // (not the floor zoom)
  tipbox(x + 55, y, 80, 20, devm ? "Source – stereo width: no effect with a device (a mono loudspeaker)" : on ? "Source – stereo width: off while mono mix is on" : "Source – stereo width: 100 % = as the input comes in, 0 % = mono, up to 200 % = wider (drag, wheel, Alt+click = 100 %; Shift + wheel anywhere in the Stage View; the same control as in the Source module, % or m there)");
);
// Draws the Mono mix toggle (slider110) at (x, y), label beside it if side else below; click flips it and sends automation.
function monobtn(x, y, side) local(on) (
  on = slider110 >= 0.5;
  tgl(x, y, on, cSRTT) ? ( slider110 = on ? 0 : 1; sauto1(110); click = 0; );
  col(on ? cTEXT : cMUTED, 1); gfx_setfont(7); side ? txt("Mono mix", x + 28, y + 7, 0) : txt("Mono mix", x + 15, y + 24, 1);
  tipbox(x - 3, y - 3, side ? 80 : 32, side ? 20 : 32, devm && !on ? "Mono mix: with a device only the dry part of Dry / wet changes (the device itself is mono anyway)" : on ? "Mono mix on: the input is summed to (L + R) / 2 before anything else – click: stereo again" : "Mono mix: sum the input to mono before any processing (automatable) – the stereo width stays set, just switched off");
);
// the stereo span of the source in the room view (plan and 3D): a soft, matt capsule through the ball, across its aim,
// as long as the stereo width (100 % = 1 m) - only with a stereo input, without mono mix and without a device model
function drawspan() local(h, px, py, x1, y1, x2, y2, ok)
(
  ok = vopt[51] < 0.5 && slider110 < 0.5 && !(slider85 >= 0.5 && fzsel > 0);   // (also at 0 %: the handles stay, so the width can be opened again)
  spHov = 0;
  ok ? (
    h = 0.5 * slider98 / 100; px = -srAy; py = srAx;
    PJ(sx + px * h, sy + py * h, sz); x1 = qx; y1 = qy; PJ(sx - px * h, sy - py * h, sz); x2 = qx; y2 = qy;
// in a large area (free field) 1 m is only a few pixels - the span is drawn at least 2 x 18 px long so the handles can be seen and grabbed (display only)
    spHL = sqrt(sqr(x2 - x1) + sqr(y2 - y1)) / 2; spPx = slider98 > 2 ? spHL / slider98 : max(0.01, abs(pXs)) / 200;   // spPx: px per % (below 2 % from the scale of the view, so the step does not jump)   // spTr: the true half length (the drag measures against it - the drawn one can be longer)
// the drawn minimum shrinks a little with the width (0 % = 16 px, 100 % = 18 px); at 0 % the capsule is gone and a thin
// ring hugs the ball (one channel) - so a small room still shows mono against stereo
    spMn = 16 + 2 * min(1, slider98 / 100);
    spHL < spMn ? (
      spCx = (x1 + x2) / 2; spCy = (y1 + y2) / 2;
      PJ(sx + px, sy + py, sz); spUx = qx - spCx; spUy = qy - spCy; h = sqrt(sqr(spUx) + sqr(spUy));   // the direction across the aim (also at 0 %)
      h > 0.01 ? ( spUx /= h; spUy /= h; ) : ( spUx = 1; spUy = 0; );
      x1 = spCx - spUx * spMn; y1 = spCy - spUy * spMn; x2 = spCx + spUx * spMn; y2 = spCy + spUy * spMn;
    );
    spAl = min(1, slider98 / 25);   // the capsule fades out below 25 % (the handles stay)
    spAl > 0.01 ? ( col(cSRC, 0.20 * spAl); LNW(x1, y1, x2, y2, 7); );
    col(cSRC, 0.20); CIF(x1, y1, 3.5, 1); CIF(x2, y2, 3.5, 1);
    spAl > 0.01 ? ( col(cSRC, 0.55 * spAl); LNW(x1, y1, x2, y2, 1.4); );
    col(cSRC, 0.55); CIF(x1, y1, 2.2, 1); CIF(x2, y2, 2.2, 1);
    slider98 < 0.5 ? ( PJ(sx, sy, sz); col(cSRC, 1); CI(qx, qy, 12.6, 0); CI(qx, qy, 13.2, 0); );   // mono: one thin ring around the ball (one channel)
// the two ends are handles - drag = stereo width (also Alt+Shift+drag on the source ball, see the room view mouse)
    spX1 = x1; spY1 = y1; spX2 = x2; spY2 = y2; spCx = (x1 + x2) / 2; spCy = (y1 + y2) / 2;
    spHL = max(1, sqrt(sqr(x2 - x1) + sqr(y2 - y1)) / 2); spUx = (x2 - x1) / (2 * spHL); spUy = (y2 - y1) / (2 * spHL);
    spHov = spHL >= 12 && (sqr(mx - x1) + sqr(my - y1) < 64 || sqr(mx - x2) + sqr(my - y2) < 64);   // the mouse on a handle (the walls and edges stand back - tooltips and clicks)
    spHov || drag == 13 ? (
      col(cSRC, 0.9); CIF(x1, y1, 4.2, 0); CIF(x2, y2, 4.2, 0);
      swfmt(); strcpy(#swt, "Stereo width "); strcat(#swt, #fv); strcat(#swt, " – Shift + mouse wheel: up = wider, down = narrower · double-click = 100 % / 0 % · Alt+click = 100 % · Ctrl/Cmd+click = 0 %");
      tipon = 1; tipforce = 0; tipstr = #swt; tipx = spCx; tipy = min(y1, y2) - 16;
    );
  );
  spOk = ok;
);
// Draws the source in the room view: shadow, stem, aim arrow, stereo span and the 'S' ball, including the source model/lock markers.
function drawsource() local(fz3, bx, by)
(
  fz3 = slider85 >= 0.5 ? fzsel : 0;                // source model off: the plain source
  !planv ? shadow(sx, sy);
  PJ(sx, sy, 0); bx = qx; by = qy; PJ(sx, sy, sz);
  col(cSRC, 0.7); DL(bx, by, qx, qy, 3, 3, 1);
  // where the source points (its axis): a short arrow on the floor plane - turned by SOURCE ANGLE
  sax = qx; say = qy; PJ(sx + srAx * 0.7, sy + srAy * 0.7, sz);
// the ball design (the old icon / name-plate branches that never ran are removed)
  arrow3d(sax, say, qx, qy, 10, cSRC, abs(slider61) > 0.5 || slider63 >= 0.5 ? 0.95 : 0.4);
  drawspan();
  PJ(sx, sy, sz); ball3d(qx, qy, 10, cSRC, "S");
  dpqx = qx; dpqy = qy - 18; dpok = 1; dpsw = 24;            // (the delay plate goes above the ball)
  lockS ? drawlock(qx + 17, qy + 8, cSRC);
  fz3 > 0 ? srcsign(fz3);
  // height: shown in the HEIGHT section of the room view
);
// Draws the listener in the room view: shadow, stem, facing arrow, the 'L' ball, lock icon and the OUCH burst after a wall hit.
function drawlistener() local(bx, by, hx, hy)
(
  !planv ? shadow(lx, ly);
  PJ(lx, ly, 0); bx = qx; by = qy; PJ(lx, ly, lz);
  col(cLIS, 0.7); DL(bx, by, qx, qy, 3, 3, 1);
  hx = qx; hy = qy; PJ(lx + cos(face) * 0.7, ly + sin(face) * 0.7, lz);
  arrow3d(hx, hy, qx, qy, 10, cLIS, 0.95); ball3d(hx, hy, 10, cLIS, "L"); hy -= 9;
  PJ(lx, ly, lz); lockL ? drawlock(qx + 17, qy + 8, cLIS);
// OUCH as a comic burst: a jagged star (16 spikes, yellow, red zigzag edge) that pops up over the head, grows a
  // little in the first 120 ms and holds for 0.8 s
  wca = time_precise() - wcT;
  wca >= 0 && wca < 0.8 ? (
    gfx_setfont(2); wcw = tws("OUCH!"); wsc = wca < 0.12 ? 0.85 + 0.15 * wca / 0.12 : 1; wbcx = hx; wbcy = hy - 46;
    wrx = (wcw / 2 + 16) * wsc; wry = 17 * wsc; wk = 0;
    loop(16,
      wa0 = wk * 0.3926991; wa1 = wa0 + 0.19635; wa2 = wa0 + 0.3926991;
      col(0xFFE34D, 1); POLY4(wbcx, wbcy, wbcx + wrx * cos(wa0), wbcy + wry * sin(wa0), wbcx + wrx * 0.72 * cos(wa1), wbcy + wry * 0.72 * sin(wa1), wbcx + wrx * cos(wa2), wbcy + wry * sin(wa2));
      col(0xD03030, 1); LNW(wbcx + wrx * cos(wa0), wbcy + wry * sin(wa0), wbcx + wrx * 0.72 * cos(wa1), wbcy + wry * 0.72 * sin(wa1), 1.3);
      LNW(wbcx + wrx * 0.72 * cos(wa1), wbcy + wry * 0.72 * sin(wa1), wbcx + wrx * cos(wa2), wbcy + wry * sin(wa2), 1.3);
      wk += 1;
    );
    col(0xD03030, 1); txt("OUCH!", wbcx, wbcy, 1);
  );
  // height: shown in the HEIGHT section of the room view
);
// source and listener at exactly the same spot: the 'L' ball with its arrow and a smaller 'S' ball beside it
function drawcombined() local(fz3, bx, by, hx, hy)
(
  fz3 = slider85 >= 0.5 ? fzsel : 0;                // source model off: the plain source
  !planv ? shadow(sx, sy);
  PJ(sx, sy, 0); bx = qx; by = qy; PJ(sx, sy, max(sz, lz));
  col(cLIS, 0.7); DL(bx, by, qx, qy, 3, 3, 1);
  PJ(lx, ly, lz); hx = qx; hy = qy; PJ(lx + cos(face) * 0.7, ly + sin(face) * 0.7, lz); arrow3d(hx, hy, qx, qy, 10, cLIS, 0.95); ball3d(hx, hy, 10, cLIS, "L");
  PJ(sx, sy, sz); ball3d(qx + 9, qy + 4, 8, cSRC, "S");
  PJ(sx, sy, max(sz, lz));
  fz3 > 0 ? srcsign(fz3); lockS || lockL ? drawlock(qx + 20, qy + 8, lockL ? cLIS : cSRC);
  // height: shown in the HEIGHT section of the room view
);

// ---------- waves view: one wavefront circle in the horizontal plane z = cz, clipped to x 0..W, y y0..y1 ----------
// segments on the far side of the barrier (seen from the circle's center) are drawn faint: what gets through
function wring(cx, cy, cz, wrr, y0, y1, al, c) local(n, i, a0, a1, wxa, wya, wxb, wyb, wxm, wym, hx, hy, f)
(
  n = max(16, min(72, floor(wrr * pS / 4)));
  i = 0;
  loop(n,
    a0 = 2 * $pi * i / n; a1 = 2 * $pi * (i + 1) / n;
    wxa = cx + wrr * cos(a0); wya = cy + wrr * sin(a0); wxb = cx + wrr * cos(a1); wyb = cy + wrr * sin(a1);
    wxm = 0.5 * (wxa + wxb); wym = 0.5 * (wya + wyb);
    wxm >= 0 && wxm <= roomW && wym >= y0 && wym <= y1 ? (
      f = (bon && ((wym - yb) * (cy - yb) < 0)) ? 0.22 : 1;
      col(c, al * f);
      PJ(wxa, wya, cz); hx = qx; hy = qy; PJ(wxb, wyb, cz); LNW(hx, hy, qx, qy, 1.3);
    );
    i += 1;
  );
);
// ---------- barrier materials: 3 presets per type (Rw in dB) ----------
function bmatrw(t, i) ( t == 3 ? (i == 0 ? 17 : (i == 1 ? 25 : 37)) : (t == 2 ? (i == 0 ? 24 : (i == 1 ? 30 : 39)) : (i == 0 ? 38 : (i == 1 ? 45 : 55))); );   // installed values R'w
// Returns the barrier material name for barrier type t (1 wall, 2 window, 3 door) and material index i (0-2).
function bmatname(t, i) ( t == 3 ? (i == 0 ? "Hollow-core door" : (i == 1 ? "Heavy wood door" : "Acoustic door"))
                        : (t == 2 ? (i == 0 ? "Single glazing" : (i == 1 ? "Double glazing" : "Acoustic glazing"))
                                  : (i == 0 ? "Drywall" : (i == 1 ? "Brick wall 12 cm" : "Concrete 20 cm"))); );
// Returns the tooltip text (construction and approximate dB insulation) for barrier type t and material index i.
function bmattip(t, i) ( t == 3 ? (i == 0 ? "Hollow-core door, 40 mm honeycomb panel: about 17 dB installed (lab Rw 20–22)" : (i == 1 ? "Heavy wood door, 45 mm solid wood, no seals: about 25 dB installed (lab Rw 30–32)" : "Acoustic door, solid core + double seals: about 37 dB installed (lab Rw 40–42)"))
                       : (t == 2 ? (i == 0 ? "Single glazing, 4 mm float glass: about 24 dB installed (lab Rw 27–29)" : (i == 1 ? "Double glazing 4/16/4 mm: about 30 dB installed (lab Rw 32–34)" : "Acoustic glazing 8/16/6 mm laminated: about 39 dB installed (lab Rw 41–43)"))
                                 : (i == 0 ? "Drywall, 2 × 12.5 mm gypsum on studs + mineral wool: about 38 dB installed (lab Rw 42)" : (i == 1 ? "Interior brick wall 11.5 cm, plastered: about 45 dB installed (lab Rw 47–48)" : "Concrete 20 cm: about 55 dB installed (lab Rw 57–59)"))); );
// Returns the index (0-2) of the barrier material whose Rw matches slider44 for type bt, or -1 if none matches.
function bmatsel() local(i, bmr) ( bmr = -1; i = 0; loop(3, abs(slider44 - bmatrw(bt, i)) < 0.05 ? bmr = i; i += 1; ); bmr; );
// one rectangle of the barrier plane (x0..x1, z0..z1) at depth yb
function bquad(x0, x1, z0, z1) local(ax, ay, bx2, by2, cx2, cy2)
(
  x1 > x0 + 0.001 && z1 > z0 + 0.001 ? (
    PJ(x0, yb, z0); ax = qx; ay = qy; PJ(x1, yb, z0); bx2 = qx; by2 = qy; PJ(x1, yb, z1); cx2 = qx; cy2 = qy; PJ(x0, yb, z1);
    POLY4(ax, ay, bx2, by2, cx2, cy2, qx, qy);
  );
);
// the barrier in the 3D view: translucent gray plane (opacity and hatching = damping), the element with its
// opening, the door leaf / window sash turned into the source's side, the depth handle on the top edge
function drawbarrier() local(al, u, st, x1, x2, hx, hy, sg, lx2, ly2, zt, dz, hz, hw, cs, sn, k, ax)
(
  al = 0.10 + 0.22 * bdamp / 70;
  col(cBARV, al);
  bt == 1 ? bquad(brX0, brX1, 0, brH) : (
    bquad(brX0, bex0, 0, brH); bquad(bex1, brX1, 0, brH); bquad(bex0, bex1, 0, bez0); bquad(bex0, bex1, bez1, brH);
  );
  // hatching: denser = more damping (outside the element)
  col(cBARV, 0.35);
  st = max(0.12, 0.7 - 0.008 * bdamp) * max(1, brW / 8); u = brX0 + st * 0.5;
  while (
    x1 = u; x2 = min(brX1, u + 0.25 * brH);
    (bt == 1 || x2 < bex0 || x1 > bex1) ? ( PJ(x1, yb, 0); hx = qx; hy = qy; PJ(x2, yb, brH); LN(hx, hy, qx, qy); );
    u += st; u < brX1;
  );
  col(cBARV, 0.9);
  // DIVIDING LINE on the floor (an open door leaves a gap the listener can pass); plan: thicker with more damping
  // (a sign, not to scale) - door and window are drawn in their gap
  dz = planv ? 2.5 + 3.5 * min(1, bdamp / 60) : 2.6;
  (bt == 3 && (slider43 >= 40 || planv)) || (bt == 2 && planv) ? (
    PJ(brX0, yb, 0); hx = qx; hy = qy; PJ(bex0, yb, 0); LNW(hx, hy, qx, qy, dz);
    PJ(bex1, yb, 0); hx = qx; hy = qy; PJ(brX1, yb, 0); LNW(hx, hy, qx, qy, dz);
    !planv ? ( PJ(bex0, yb, 0); hx = qx; hy = qy; PJ(bex1, yb, 0); DL(hx, hy, qx, qy, 3, 3, 1); );
  ) : ( PJ(brX0, yb, 0); hx = qx; hy = qy; PJ(brX1, yb, 0); LNW(hx, hy, qx, qy, dz); );
  !planv ? (
    PJ(brX0, yb, brH); hx = qx; hy = qy; PJ(brX1, yb, brH); LNW(hx, hy, qx, qy, 1);
    PJ(brX0, yb, 0); hx = qx; hy = qy; PJ(brX0, yb, brH); LN(hx, hy, qx, qy);
    PJ(brX1, yb, 0); hx = qx; hy = qy; PJ(brX1, yb, brH); LN(hx, hy, qx, qy);
  );
  sg = sideS ? 1 : -1;                                            // leaf / sashes turn into the source's side
  bt == 3 ? (
    // door frame + leaf on the left hinge
    PJ(bex0, yb, 0); hx = qx; hy = qy; PJ(bex0, yb, bez1); LNW(hx, hy, qx, qy, 1.2);
    PJ(bex1, yb, 0); hx = qx; hy = qy; PJ(bex1, yb, bez1); LNW(hx, hy, qx, qy, 1.2);
    !planv ? ( PJ(bex0, yb, bez1); hx = qx; hy = qy; PJ(bex1, yb, bez1); LNW(hx, hy, qx, qy, 1.2); );
    lx2 = bex0 + bew * cos(bphi); ly2 = yb + sg * bew * sin(bphi);
    PJ(bex0, yb, 0); hx = qx; hy = qy; PJ(lx2, ly2, 0); x1 = qx; x2 = qy; PJ(lx2, ly2, bez1); u = qx; st = qy; PJ(bex0, yb, bez1);
    col(cBARV, 0.45); POLY4(hx, hy, x1, x2, u, st, qx, qy);
    col(cBARV, 0.95); LNW(hx, hy, x1, x2, 1); LNW(x1, x2, u, st, 1.2); LNW(u, st, qx, qy, 1);
    planv ? (                                                      // plan: the leaf as a solid line, its swing dashed
      col(cBARV, 0.75); u = 0;
      loop(14, (u & 1) == 0 ? ( PJ(bex0 + bew * cos(bphi * u / 14), yb + sg * bew * sin(bphi * u / 14), 0); hx = qx; hy = qy;
                                PJ(bex0 + bew * cos(bphi * (u + 1) / 14), yb + sg * bew * sin(bphi * (u + 1) / 14), 0); LNW(hx, hy, qx, qy, 1.2); ); u += 1; );
      col(cBARV, 1); PJ(bex0, yb, 0); hx = qx; hy = qy; PJ(lx2, ly2, 0); LNW(hx, hy, qx, qy, 3);
    );
  );
  bt == 2 ? (
    // WINDOW: frame (blue) + two casement sashes, hinged at the left and the right, opening into the source's side
    col(cGLS, 0.9);
    !planv ? (
      PJ(bex0, yb, bez0); hx = qx; hy = qy; PJ(bex1, yb, bez0); LNW(hx, hy, qx, qy, 1.2);
      PJ(bex0, yb, bez1); hx = qx; hy = qy; PJ(bex1, yb, bez1); LNW(hx, hy, qx, qy, 1.2);
      PJ(bex0, yb, bez0); hx = qx; hy = qy; PJ(bex0, yb, bez1); LNW(hx, hy, qx, qy, 1.2);
      PJ(bex1, yb, bez0); hx = qx; hy = qy; PJ(bex1, yb, bez1); LNW(hx, hy, qx, qy, 1.2);
    ) : ( col(cGLS, 0.45); PJ(bex0, yb, 0); hx = qx; hy = qy; PJ(bex1, yb, 0); LNW(hx, hy, qx, qy, 1); );   // plan: the sill
    hw = bew / 2; cs = cos(bphi); sn = sg * sin(bphi); k = 0;
    loop(2,
      ax = k == 0 ? bex0 : bex1; x1 = k == 0 ? 1 : -1;            // hinge, direction to the middle
      lx2 = ax + x1 * hw * cs; ly2 = yb + hw * sn;
      PJ(ax, yb, bez0); hx = qx; hy = qy; PJ(lx2, ly2, bez0); x2 = qx; zt = qy; PJ(lx2, ly2, bez1); u = qx; st = qy; PJ(ax, yb, bez1);
      col(cGLS, 0.20); POLY4(hx, hy, x2, zt, u, st, qx, qy);
      col(cGLS, 0.9); LNW(hx, hy, x2, zt, 1.2); LNW(x2, zt, u, st, 1.2); LNW(u, st, qx, qy, 1.2);
      planv ? (                                                    // plan: each sash a solid line, its swing dashed
        col(cGLS, 0.7); u = 0;
        loop(10, (u & 1) == 0 ? ( PJ(ax + x1 * hw * cos(bphi * u / 10), yb + sg * hw * sin(bphi * u / 10), 0); hx = qx; hy = qy;
                                  PJ(ax + x1 * hw * cos(bphi * (u + 1) / 10), yb + sg * hw * sin(bphi * (u + 1) / 10), 0); LNW(hx, hy, qx, qy, 1.2); ); u += 1; );
        col(cGLS, 1); PJ(ax, yb, 0); hx = qx; hy = qy; PJ(lx2, ly2, 0); LNW(hx, hy, qx, qy, 3);
      );
      k += 1;
    );
  );
  // handles: depth (top edge, right) and side (top of the element, or of a partition narrower than the room)
  PJ(brHX, yb, brH); col(cSURF, 1); CI(qx, qy, 4.5, 1); col(cBARV, 1); CI(qx, qy, 4.5, 0); CI(qx, qy, 1.5, 1);
  brEon ? ( PJ(brEX, yb, brEZ); col(cSURF, 1); CI(qx, qy - 6, 3.5, 1); col(cBARV, 1); CI(qx, qy - 6, 3.5, 0); );
  // padlocks beside the handles of what is locked
  lockB ? ( PJ(brHX, yb, brH); drawlock(qx + 14, qy, cBARTT); );
  lockE && brEon ? ( PJ(brEX, yb, brEZ); drawlock(qx + 13, qy - 6, cELK); );
);

// LOAD A ROOM PRESET: the room as defined, source and listener on the center line (no left / right tilt), listener
// facing the back wall, no barrier. "Keep" options in the menu: vopt[16] = keep source + listener (and facing),
// vopt[17] = keep the barrier - both are fitted into the new room.
// KEEP: a position that fits into the new room stays where it is (in meters); one that does not keeps its place relative
// to the room (so two of them never end up squeezed into the same corner)
function keepfit(a, ol, nl) ( a >= 0.1 && a <= nl - 0.1 ? a : min(max(a / max(0.1, ol) * nl, 0.1), nl - 0.1); );
// the standard arrangement of source and listener in a room (slider units: before the size factor rs)
// listener in the middle, source 2 m in front of it towards the back wall (in a small room: near the back wall) - same rule as Reset positions
function pdefsy(d, r) ( max(d / 2 - 2 / r, d * 0.05); );
// Loads room preset k: takes an undo snapshot, stops motion, sets room size, walls, reverb sliders and re-places source/listener (keeping default layout if untouched).
function loadroom(k) local(b, ors, ow, od, oh, nw, nd, nh, isdef)
(
  scnlast = -1;
  b = PT + k * PRS; snap_take(); mtE > 0.001 || slider100 >= 0.5 ? ( mtKill = 1; slider100 = 0; );   // a running motion ends (the new room has new places)
  lhE0 = eqE; lhT = time_precise(); lhPre = rsel; lhNew = k; lhDb = -1000;   // the loudness hint (level of the new room against the one before)
  ors = slider31; ow = slider2 * ors; od = slider3 * ors; oh = slider4 * ors; nw = b[0] * b[14]; nd = b[1] * b[14]; nh = b[2] * b[14];
  // untouched (still the standard arrangement of the old room)? Then the new room gets its own standard arrangement -
  // source and listener stay in the same place RELATIVE to the room (middle, 2 m apart), whatever preset is loaded
  isdef = (abs(slider13 - (ow / ors) / 2) < 0.02 && abs(slider14 - (od / ors) / 2) < 0.02 && abs(slider10 - (ow / ors) / 2) < 0.02
       && (abs(slider11 - pdefsy(od / ors, ors)) < 0.02 || abs(slider11 - max((od / ors) / 2 - 2 / ors, (od / ors) * 0.15)) < 0.02) && abs(slider12 - slider15) < 0.02 && slider16 >= 0.5 && abs(slider17) < 0.5 && abs(slider61) < 0.5);
  slider1 = 0; slider2 = b[0]; slider3 = b[1]; slider4 = b[2]; slider36 = 0;    // room engine on
  slider5 = b[3]; slider6 = b[4]; slider7 = b[5]; slider8 = b[6]; slider9 = b[7];   // walls back / right / front / left, floor + ceiling
  ((basic || (vopt[16] >= 0.5 && isdef)) && !lockS && !lockL) ? (   // Basic: every preset starts with source and listener at the standard places
    slider13 = b[0] / 2; slider14 = b[1] / 2; slider10 = b[0] / 2; slider11 = pdefsy(b[1], b[14]);
    basic ? ( slider15 = min(max(1.5, 0.1), nh - 0.1); slider16 = 1; slider17 = 0; slider63 = 1; slider61 = 0; ) : slider15 = min(max(slider15, 0.1), nh - 0.1);
    slider12 = slider15;
  ) : (vopt[16] >= 0.5) ? (
    // KEEP (the default): source and listener stay where they are - only moved inside if the new room is smaller
    slider10 = keepfit(slider10 * ors, ow, nw) / b[14]; slider11 = keepfit(slider11 * ors, od, nd) / b[14]; slider12 = keepfit(slider12, oh, nh);
    slider13 = keepfit(slider13 * ors, ow, nw) / b[14]; slider14 = keepfit(slider14 * ors, od, nd) / b[14]; slider15 = keepfit(slider15, oh, nh);
  ) : (
    slider10 = b[8]; slider11 = b[9]; slider12 = b[10]; slider13 = b[11]; slider14 = b[12]; slider15 = b[13];
    slider16 = 1; slider17 = 0;                                                   // facing: fixed, towards the back wall
    slider63 = 1; slider61 = abs(b[11] - b[8]) + abs(b[12] - b[9]) > 0.01 ? atan2(-(b[11] - b[8]), b[12] - b[9]) * 180 / $pi : 0;   // source aims at the listener
  );
  vopt[17] >= 0.5 ? (
    slider42 = min(max(slider42, 0.3), b[1] - 0.3); slider45 = min(max(slider45, 0), b[0]);
  ) : (
    slider41 = 0; slider42 = b[1] / 2; slider43 = 0; slider44 = 25; slider45 = b[0] / 2; slider46 = 0; slider95 = 0; slider96 = 0; slider97 = 100;   // no barrier
  );
  slider19 = 1; slider31 = b[14]; slider34 = b[15]; slider33 = b[16]; slider20 = b[17]; slider21 = b[18]; slider38 = b[19]; selw = 0;
  vopt[8] >= 0.5 ? ( slider34 = pdroom(); );       // predelay follows the room: from its size
  slider32 = 1; slider62 = 100;                    // DECAY and REFLECTIVITY back: the menu shows the room's own reverb time
  snap_notify();
);
// Returns true if the current room size, wall absorptions and scale sliders equal those of preset k (within 0.001).
function roommatch(k) local(b)
(
  b = PT + k * PRS;
  abs(slider2 - b[0]) < 0.001 && abs(slider3 - b[1]) < 0.001 && abs(slider4 - b[2]) < 0.001 &&
  abs(slider5 - b[3]) < 0.001 && abs(slider6 - b[4]) < 0.001 && abs(slider7 - b[5]) < 0.001 &&
  abs(slider8 - b[6]) < 0.001 && abs(slider9 - b[7]) < 0.001 && abs(slider31 - b[14]) < 0.001;
);
// Estimates preset k's RT60 in seconds (Eyring with air absorption), clamped to 0.08..20.
function presetrt(k) local(b, w, d, h, v, a)
(
  b = PT + k * PRS; w = b[0] * b[14]; d = b[1] * b[14]; h = b[2] * b[14];
  v = w * d * h; a = w * h * (b[3] + b[5]) + d * h * (b[4] + b[6]) + 2 * w * d * b[7];
  a = -2 * (w * d + w * h + d * h) * log(1 - min(0.95, a / (2 * (w * d + w * h + d * h))));   // Eyring
  min(20, max(0.08, 0.161 * v / (a + 4 * airm5 * v)));
);

// ---- SCENARIO presets: situations from film mixing - source, room, barrier and delay in one click (menu page 3) ----
NSC = 33; scnX = alloc(NSC); scnY = alloc(NSC); scnH = alloc(NSC); scnlast = -1; lkT = -100;
// Returns the display name of scenario preset k.
function scname(k) ( k == 0 ? "Party next door" : (k == 1 ? "Neighbor's TV" : (k == 2 ? "Argument behind the wall" : (k == 3 ? "Club thump from the street" : (k == 4 ? "Outside the door" : (k == 5 ? "Door ajar" : (k == 6 ? "TV in the next room" : (k == 7 ? "Voice from the cellar" : (k == 8 ? "Street through the window" : (k == 9 ? "Window tilted open" : (k == 10 ? "In the woods" : (k == 11 ? "Canyon shout" : (k == 12 ? "Gunshot in the city" : (k == 13 ? "Snowfield hush" : (k == 14 ? "Station announcement" : (k == 15 ? "Stadium PA" : (k == 16 ? "Phone call in the stairwell" : (k == 17 ? "Radio in the tunnel" : (k == 18 ? "Car radio" : (k == 19 ? "Car next to you" : (k == 20 ? "Hands-free call in the car" : (k == 21 ? "Taxi dispatch radio" : (k == 22 ? "Bus announcement" : (k == 23 ? "Radio in the bathroom" : (k == 24 ? "Elevator speaker" : (k == 25 ? "Hiding in the closet" : (k == 26 ? "Call from the bathroom" : (k == 27 ? "Door intercom" : (k == 28 ? "Headphone leak on the train" : (k == 29 ? "Video call at the desk" : (k == 30 ? "Boombox in the park" : (k == 31 ? "Megaphone in the street" : (k == 32 ? "Radio in the garage" : (""))))))))))))))))))))))))))))))))); );
// Returns a short label (e.g. insulation value) for scenario preset k.
function scshort(k) ( k == 0 ? "wall 45 dB" : (k == 1 ? "wall 38 dB" : (k == 2 ? "wall 42 dB" : (k == 3 ? "concrete" : (k == 4 ? "door 25 dB" : (k == 5 ? "door 12 %" : (k == 6 ? "door 35 %" : (k == 7 ? "door + echo" : (k == 8 ? "glass 30 dB" : (k == 9 ? "glass 20 %" : (k == 10 ? "free field" : (k == 11 ? "free field" : (k == 12 ? "free field" : (k == 13 ? "free field" : (k == 14 ? "PA + echo" : (k == 15 ? "music + echo" : (k == 16 ? "mobile call" : (k == 17 ? "walkie + echo" : (k == 18 ? "radio" : (k == 19 ? "glass 24 dB" : (k == 20 ? "speakerphone" : (k == 21 ? "radio + echo" : (k == 22 ? "PA + echo" : (k == 23 ? "bluetooth" : (k == 24 ? "small box" : (k == 25 ? "door 17 dB" : (k == 26 ? "phone + echo" : (k == 27 ? "intercom" : (k == 28 ? "leak" : (k == 29 ? "video call" : (k == 30 ? "free field" : (k == 31 ? "free field + echo" : (k == 32 ? "radio + echo" : (""))))))))))))))))))))))))))))))))); );
// Returns a one-line description of what scenario preset k sounds like.
function scdesc(k) ( k == 0 ? "bass thump through a brick wall, the highs are gone: the lows carry the party" : (k == 1 ? "dialog and music through drywall: muffled, but still half intelligible" : (k == 2 ? "raised voices through a wall: mostly vowels and rhythm get through" : (k == 3 ? "kick and bass through 20 cm concrete, with a faint slapback from the alley" : (k == 4 ? "voice behind a closed wooden door: dull and quiet, your own room tone stays" : (k == 5 ? "the same door open a crack: a narrow gap lets the highs back in" : (k == 6 ? "TV through a half-open door: boxy, indirect, a little room around it" : (k == 7 ? "a call from a concrete cellar through a half-open door, a trace of cave echo" : (k == 8 ? "traffic and voices through a closed double-glazed window" : (k == 9 ? "the window tilted open: the street gets brighter and louder" : (k == 10 ? "a voice among trees: soft ground, no walls, a faint tree-line echo" : (k == 11 ? "a shout across a valley with a late, hard echo from the rock" : (k == 12 ? "a shot between building rows: hard ground and a slap from the facades" : (k == 13 ? "fresh snow swallows everything: dry, very quiet, no reflections" : (k == 14 ? "tiled platform: a PA voice with a long underground echo" : (k == 15 ? "the stadium music system at one end of a huge stadium, you far up in the stands: fat sub bass and full range, the direct sound arrives late, dense long echoes from the stands, a very big tail" : (k == 16 ? "a mobile call in a hard stairwell: narrow band, bright room" : (k == 17 ? "walkie-talkie voice in a tunnel with a radio echo" : (k == 18 ? "the radio from the dashboard speakers in a small, damped car cabin" : (k == 19 ? "the boombox of the car at the traffic light: bass through the side window" : (k == 20 ? "a call over the car speakers: narrow band, the cabin around it" : (k == 21 ? "a scratchy dispatch radio in the front, a short comms echo" : (k == 22 ? "a stop announcement in a long bus: PA voice and a little hall" : (k == 23 ? "a small speaker on the sink: tiles, bright and boomy" : (k == 24 ? "thin ceiling speaker in a tiny steel cabin, a short echo" : (k == 25 ? "you are in a tiny room, the voices outside behind a thin door" : (k == 26 ? "a phone call in a tiled room: line echo on top of the tile reverb" : (k == 27 ? "a voice from the intercom in a hallway, a faint echo" : (k == 28 ? "thin, distant sound leaking from earbuds in a train compartment" : (k == 29 ? "a laptop call in a small office: thin voice, close room" : (k == 30 ? "a boombox on the grass, 20 m away: open air, soft ground" : (k == 31 ? "a megaphone between facades: hard ground, slapback from the walls" : (k == 32 ? "an old radio on the workbench: concrete garage, a short slapback" : (""))))))))))))))))))))))))))))))))); );
// Returns the category index (0-7) of scenario preset k.
function sccat(k) ( k < 4 ? 0 : (k < 8 ? 1 : (k < 10 ? 2 : (k < 14 ? 3 : (k < 18 ? 4 : (k < 23 ? 5 : (k < 28 ? 6 : 7)))))); );
// Returns the name of scenario category c.
function sccatname(c) ( c == 0 ? "Through walls" : (c == 1 ? "Doors" : (c == 2 ? "Windows" : (c == 3 ? "Outdoors" : (c == 4 ? "Spaces & comms" : (c == 5 ? "Vehicles" : (c == 6 ? "Small rooms" : "Devices & media")))))); );
// Returns 1 if scenario category c is shown in the right menu column (categories 3, 4 and 6+), else 0.
function sccol(c) ( c == 3 || c == 4 || c >= 6; );

// Resets the scenario-controlled sliders to neutral (reflectors cleared, device/delay/filter/EQ bands and motion off, dry-wet and levels to 100).
function scnbase() local(i)
(
  rflclr(); sset(41, 0); sset(43, 0); sset(65, 0); sset(90, 100); sset(117, 0); sset(119, 0); sset(37, 0); sset(35, 0); sset(85, 1); sset(89, 100); sset(98, 100);
  i = 47; loop(13, sset(i, 0); i += 1; );
  sset(111, 0); sset(112, 0); sset(113, 0); sset(114, 0);
);
// a barrier between a source behind it (sy) and the listener in front (ly): positions as fractions of the room depth, both on the center line
function scbar(t, dmp, pos, op, sy, ly) local(hh)
(
  hh = min(1.5, slider4 * 0.6);
  sset(41, t); sset(44, dmp); sset(42, pos * slider3); sset(43, op); sset(45, slider2 / 2); sset(46, 0); sset(95, 0); sset(96, 0); sset(97, 100);
  sset(10, slider2 / 2); sset(11, sy * slider3); sset(13, slider2 / 2); sset(14, ly * slider3); sset(12, hh); sset(15, hh);
  sset(16, 1); sset(17, 0); sset(63, 1); sset(61, 0);
);
// open air: 40 x 40 m area, source and listener on the center line (meters), ground and distance perspective
function scff(gr, dist, sy, ly)
(
  sset(1, 1); sset(2, 40); sset(3, 40); sset(4, 12); sset(119, gr); sset(117, dist);
  sset(10, 20); sset(11, sy); sset(12, 1.5); sset(13, 20); sset(14, ly); sset(15, 1.5);
  sset(16, 1); sset(17, 0); sset(63, 1); sset(61, 0);
);
// the places of a scene without a barrier: source and listener on the center line (fractions of the room depth)
function scpos(sy, ly) ( sset(10, slider2 / 2); sset(11, sy * slider3); sset(13, slider2 / 2); sset(14, ly * slider3); sset(16, 1); sset(17, 0); sset(63, 1); sset(61, 0); );
// a reflector of a free-field scenario (r = 0 / 1; material 1 Facade 2 Glass 3 Rock 4 Fence 5 Hedge; X, Y, length, height in meters, angle in degrees; the reflector level is set to +12 dB)
function scrf(r, m, x, y, a, l, h) local(o) ( vopt[RFB + 12 + r] = 12; o = RFB + r * 6; vopt[o] = m; vopt[o + 1] = x; vopt[o + 2] = y; vopt[o + 3] = a; vopt[o + 4] = l; vopt[o + 5] = h; );
// Loads scenario preset k: picks its room, source model, delay preset and mix via lookup tables, then applies the scenario's barrier, free-field and position setup.
function scnload(k) local(rm, sp, dpk, dmx, pre)
(
  pre = scnlast >= 0 ? -2 - scnlast : rsel;   // what plays now (a scenario or a room) - for the loudness hint
  // lookup tables per scenario k: rm = room preset, sp = source model (-1 = none), dpk = delay preset (-1 = none), dmx = delay mix % (100 = default)
  rm = k == 0 ? 3 : (k == 2 ? 8 : (k == 3 ? 35 : (k == 7 || k == 16 ? 5 : (k == 14 ? 29 : (k == 15 ? 30 : (k == 17 ? 29 : (k >= 18 && k <= 21 ? 13 : (k == 22 ? 14 : (k == 23 || k == 26 ? 0 : (k == 24 ? 15 : (k == 25 ? 31 : (k == 27 ? 4 : (k == 28 ? 41 : (k == 29 ? 37 : (k == 32 ? 7 : 2)))))))))))))));
  sp = k == 14 || k == 15 || k == 22 ? 11 : (k == 16 || k == 26 ? 2 : (k == 17 ? 8 : (k == 18 ? 21 : (k == 32 ? 14 : (k == 20 ? 4 : (k == 21 ? 9 : (k == 23 ? 19 : (k == 24 ? 17 : (k == 27 ? 12 : (k == 28 ? 20 : (k == 29 ? 6 : (k == 30 ? 15 : (k == 31 ? 10 : -1)))))))))))));
  k == 15 ? sp = 22;   // Stadium PA: the stadium MUSIC system (fat), not the thin announcement speaker
  dpk = k == 3 ? 0 : (k == 7 ? 9 : (k == 10 ? 8 : (k == 11 ? 10 : (k == 12 ? 2 : (k == 14 ? 3 : (k == 15 ? 4 : (k == 17 ? 6 : (k == 21 ? 6 : (k == 22 ? 5 : (k == 24 ? 5 : (k == 26 ? 7 : (k == 27 ? 6 : (k == 31 || k == 32 ? 0 : -1)))))))))))));
  dmx = k == 3 ? 35 : (k == 7 ? 30 : (k == 17 ? 60 : (k == 21 ? 40 : (k == 22 ? 50 : (k == 24 ? 30 : (k == 26 ? 45 : (k == 27 ? 30 : (k == 31 ? 60 : (k == 32 ? 30 : 100)))))))));
  loadroom(rm);
  lhNew = -2 - k; lhPre = pre;   // the hint names the scenario
  snap_take(); scnbase();
  k == 0 ? ( scbar(1, bmatrw(1, 1), 0.5, 0, 0.2, 0.8); sset(35, 6); sset(37, 25); );              // brick wall, boombox
  k == 1 ? ( scbar(1, bmatrw(1, 0), 0.5, 0, 0.2, 0.8); sset(35, 7); sset(37, 25); );              // drywall, TV
  k == 2 ? ( scbar(1, 42, 0.5, 0, 0.2, 0.8); );                                                   // a wall, the plain voice
  k == 3 ? ( scbar(1, bmatrw(1, 2), 0.5, 0, 0.2, 0.8); sset(35, 6); sset(37, 35); );              // concrete, boombox
  k == 4 ? ( scbar(3, bmatrw(3, 1), 0.4, 0, 0.1, 0.75); );                                        // heavy wood door, closed
  k == 5 ? ( scbar(3, bmatrw(3, 1), 0.4, 12, 0.1, 0.75); );                                       // ... open a crack
  k == 6 ? ( scbar(3, bmatrw(3, 1), 0.4, 35, 0.1, 0.75); sset(35, 7); sset(37, 20); );            // half open, TV
  k == 7 ? ( scbar(3, bmatrw(3, 1), 0.4, 25, 0.1, 0.8); sset(46, 1); );                           // concrete back part = the cellar
  k == 8 ? ( scbar(2, bmatrw(2, 1), 0.4, 0, 0.1, 0.75); );                                        // double glazing, closed
  k == 9 ? ( scbar(2, bmatrw(2, 1), 0.4, 20, 0.1, 0.75); );                                       // tilted open
  k == 10 ? ( scff(2, 60, 6, 26); scrf(0, 5, 31, 16, 90, 30, 8); );                                                              // grass
  k == 11 ? ( scff(1, 70, 4, 30); scrf(0, 3, 20, 39, 0, 38, 30); );                                                              // rock: hard ground
  k == 12 ? ( scff(1, 45, 10, 28); scrf(0, 1, 30, 19, 90, 30, 20); scrf(1, 1, 10, 19, 90, 30, 20); );   // facades left and right
  k == 13 ? ( scff(3, 65, 8, 28); );                                                              // snow
  k == 15 ? ( scpos(0.1, 0.55); sset(20, 3); sset(21, 4); );   // the Stadium room: the PA tower at one end, you far away in the stands
  k == 14 || k == 16 || k == 17 ? ( scpos(0.15, 0.75); );
  k >= 18 && k <= 22 ? ( scpos(0.1, 0.6); );                                                      // vehicles: the speakers in front, the listener behind
  k == 19 ? ( scbar(2, bmatrw(2, 0), 0.3, 0, 0.1, 0.7); sset(35, 6); sset(37, 30); );             // single glazing, the boombox of the next car
  k == 23 || k == 26 || k == 27 || k == 28 || k == 29 || k == 32 ? ( scpos(0.2, 0.7); );
  k == 24 ? ( scpos(0.5, 0.5); sset(12, slider4 * 0.9); sset(11, 0.45 * slider3); sset(14, 0.6 * slider3); );   // speaker in the ceiling
  k == 25 ? ( scbar(3, bmatrw(3, 0), 0.35, 0, 0.1, 0.8); );                                        // thin door, you inside the small room
  k == 30 ? ( scff(2, 50, 8, 28); );
  k == 31 ? ( scff(1, 40, 8, 26); scrf(0, 1, 27, 17, 90, 30, 14); scrf(1, 1, 13, 17, 90, 30, 14); );   // the street canyon
  snap_notify();
  sp >= 0 ? spapply(sp);
  dpk >= 0 ? ( dpload(dpk); dmx < 100 ? ( snap_take(); sset(90, dmx); snap_notify(); ); );
  scnlast = k;   // the loudness hint (with the Equal loudness chip) comes as with a room preset
);
