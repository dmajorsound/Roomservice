// 4-point Hermite (Catmull-Rom) read from a circular buffer: flat to ~-0.3 dB at 10 kHz for any fraction
// (linear interpolation loses up to 2 dB at 10 kHz and 6 dB at 16 kHz at half-sample positions)
function rdh(b, n, rp) local(i0, im, i1, i2, t, xm, x0, x1, x2)
(
  rp < 0 ? rp += n;
  i0 = floor(rp); t = rp - i0; i0 >= n ? i0 -= n;
  im = i0 - 1; im < 0 ? im += n;
  i1 = i0 + 1; i1 >= n ? i1 -= n;
  i2 = i1 + 1; i2 >= n ? i2 -= n;
