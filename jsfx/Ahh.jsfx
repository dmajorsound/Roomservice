    // it arrives through the opening (or the barrier): delay of the way through the neighbor room, stereo position of the opening
    brOA > 0.0001 ? ( pcx = brOX; pcz = brOZ; ) : ( pcx = 0.5 * (sx + lx); pcz = 0.5 * (sz + lz); );
    xLD2 = min(MAXIN - 4, (sqrt(sqr(sx - pcx) + sqr(sy - yb) + sqr(sz - pcz)) + mfpQ + sqrt(sqr(lx - pcx) + sqr(ly - yb) + sqr(lz - pcz))) / C_SND * srate + pre) + dopA;
    plat = sin(atan2(yb - ly, pcx - lx) - face) * 0.6;          // 60 % of the opening's direction: a wide source
    pang(plat); xP2L = pgL * 1.41421356; xP2R = pgR * 1.41421356;
  );
  // EQUAL LOUDNESS, room: total energy that reaches the listener (direct + reflections + reverb, mid band), relative to
  // a source 1 m away in the open. Switched on, the room sound is brought to that level: every room, distance and
  // barrier plays about as loud as the input (limited to +36 dB)
  eqE = sqr(tapW[0]); k = 1; loop(NT - 1, eqE += tapOn[k] * sqr(tapW[k] * erg); k += 1; );
  eqE += sqr(xLG / max(0.000000001, tailn)) / bcmpE;
  xLG2 > 0 ? eqE += sqr(xLG2 / max(0.000000001, tailn2)) / bcmpE;
  xEQL = slider60 >= 0.5 ? min(63, 1 / sqrt(max(0.0000001, eqE))) : 1;
// DISTANCE PERSPECTIVE (film): beyond 2 m the whole room sound - direct, reflections, reverb, echoes - falls by an
  // extra 6 dB per doubling of the distance at 100 % (0 % = physics: in a big hall the reverb keeps the level up). The
  // stereo picture and the direct / room ratio stay as they are. Not with Equal loudness (that one keeps the level)
  dpd = sqrt(sqr(sx - lx) + sqr(sy - ly) + sqr(sz - lz)); dpG = slider60 >= 0.5 ? 1 : (2 / max(2, dpd)) ^ min(1, max(0, slider117 / 100));
  xEQL *= dpG;
