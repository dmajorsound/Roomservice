    );
    i = 1;
    loop(max(0, n - 2),
      gfx_triangle(gox + PLQ[0] * gs, goy + PLQ[1] * gs, gox + PLQ[2 * i] * gs, goy + PLQ[2 * i + 1] * gs, gox + PLQ[2 * i + 2] * gs, goy + PLQ[2 * i + 3] * gs);
      i += 1;
    );
  ) : gfx_triangle(gox + x1 * gs, goy + y1 * gs, gox + x2 * gs, goy + y2 * gs,
               gox + x3 * gs, goy + y3 * gs, gox + x4 * gs, goy + y4 * gs);
