NRP = 12; rpLast = -1; rpSnap = alloc(15);
function rpname(k) ( k == 0 ? "Facade behind the listener" : k == 1 ? "Facade behind the source" : k == 2 ? "House wall beside you" : k == 3 ? "Street canyon (both sides)" :
  k == 4 ? "Narrow alley" : k == 5 ? "Building corner" : k == 6 ? "Shop window" : k == 7 ? "Garden fence" : k == 8 ? "Hedge behind you" :
  k == 9 ? "Rock face far away (echo)" : k == 10 ? "Courtyard (two walls)" : "No reflectors"; );
function rpdesc(k) ( k == 0 ? "a facade 3 m behind the listener, parallel - a short slap from behind, the voice gets fuller" :
  k == 1 ? "a facade 3 m behind the source - the source sounds stronger, a short echo follows it" :
  k == 2 ? "a house wall 4 m to the left - one strong early reflection from the side, wider and closer" :
  k == 3 ? "facades 6 m to the left and right - the sound slaps between them (flutter), typical city street" :
  k == 4 ? "walls 1.8 m on both sides - a dense, fast flutter, close and hard" :
  k == 5 ? "a wall behind and one to the left (an L) - two early echoes from different sides" :
  k == 6 ? "a glass front 2.5 m to the right - bright, hard reflection from one side" :
  k == 7 ? "a 1.8 m fence 2 m to the left - a weak, low reflection, mostly highs" :
  k == 8 ? "a 2 m hedge 1.5 m behind - soft, damped, the space feels a little closer" :
  k == 9 ? "a high rock face at the far edge of the area in front - a clear, late echo (the larger the area, the later)" :
  k == 10 ? "two high walls 8 m behind and 8 m to the left - a courtyard, echoes from two sides" : "both reflectors off - only the direct sound and the ground"; );
// keeps a reflector center inside the area (0.3 m from its edge)
function rpcx(v) ( min(max(0.3, v), max(0.8, slider2) * min(4, max(0.25, slider31)) - 0.3); );
function rpcy(v) ( min(max(0.3, v), max(0.8, slider3) * min(4, max(0.25, slider31)) - 0.3); );
function rpapply(k) local(lxm, lym, sxm, sfy, i)
(
  snap_take();
  lxm = slider13 * min(4, max(0.25, slider31)); lym = slider14 * min(4, max(0.25, slider31)); sxm = slider10 * min(4, max(0.25, slider31)); sfy = slider11 * min(4, max(0.25, slider31));
  vopt[RFB] = 0; vopt[RFB + 6] = 0;   // (R2 stays off unless the setup uses it)
  k == 0 ? scrf(0, 1, rpcx(lxm), rpcy(lym + 3), 0, 12, 8);
  k == 1 ? scrf(0, 1, rpcx(sxm), rpcy(sfy - 3), 0, 12, 8);
  k == 2 ? scrf(0, 1, rpcx(lxm - 4), rpcy(lym), 90, 15, 9);
  k == 3 ? ( scrf(0, 1, rpcx(lxm - 6), rpcy(lym), 90, 40, 15); scrf(1, 1, rpcx(lxm + 6), rpcy(lym), 90, 40, 15); );
  k == 4 ? ( scrf(0, 1, rpcx(lxm - 1.8), rpcy(lym), 90, 25, 10); scrf(1, 1, rpcx(lxm + 1.8), rpcy(lym), 90, 25, 10); );
  k == 5 ? ( scrf(0, 1, rpcx(lxm), rpcy(lym + 3), 0, 10, 8); scrf(1, 1, rpcx(lxm - 4), rpcy(lym - 2), 90, 10, 8); );
  k == 6 ? scrf(0, 2, rpcx(lxm + 2.5), rpcy(lym), 90, 8, 3);
  k == 7 ? scrf(0, 4, rpcx(lxm - 2), rpcy(lym), 90, 15, 1.8);
  k == 8 ? scrf(0, 5, rpcx(lxm), rpcy(lym + 1.5), 0, 8, 2);
  k == 9 ? scrf(0, 3, rpcx(sxm), rpcy(0.3), 0, 40, 25);
  k == 10 ? ( scrf(0, 1, rpcx(lxm), rpcy(lym + 8), 0, 20, 12); scrf(1, 1, rpcx(lxm - 8), rpcy(lym), 90, 20, 12); );
  vopt[RFB + 14] = 0; rflSel = 0; rpLast = k;
  i = 0; loop(15, rpSnap[i] = vopt[RFB + i]; i += 1; );
  snap_notify();
);
// the setup shown on the menu button: the last one while nothing was changed by hand since, else "Custom"
function rpcur() local(i, eq) ( eq = rpLast >= 0; i = 0; loop(15, abs(vopt[RFB + i] - rpSnap[i]) > 0.0001 ? eq = 0; i += 1; ); eq ? rpLast : -1; );
// entering / leaving the free field with the mode switch: the room and the free-field setup are remembered (this session)
// rfLoad counts the project loads (written by @serialize alone); the audio thread and the GUI each keep their own copy (rfLoadA / rfLoadG)
ffRm = alloc(28); ffFf = alloc(28); dRfl = alloc(12); airOB = alloc(8); lastair = -1; WSA = alloc(2 * 2700); wsaLast = -1; rflSx0 = alloc(2); rflSy0 = alloc(2); rflSx1 = alloc(2); rflSy1 = alloc(2); rflLHv = alloc(2); rflLHx = alloc(2); rflLHy = alloc(2); rflHHv = alloc(2); rflHHx = alloc(2); rflHHy = alloc(2); rflLM = alloc(2); rflLM[0] = rflLM[1] = 1; rflLK = alloc(2); rflLK[0] = rflLK[1] = 1; rflHK = alloc(2); rflHK[0] = rflHK[1] = 1; rfSl = alloc(15); rfTch = alloc(15); memset(rfSl, -1000000000, 15); rfLoad = 0; rfLoadA = 0; rfLoadG = 0; ffpmX = alloc(20); ffpmY = alloc(20); ffRmOk = 0; ffFfOk = 0; ffpLast = 0;   // airOB = the air absorption of the 8 octave bands; lastair = -1: fill them again after a new @init; WSA: the still-air points of the waves view
// Stores the current room/free-field sliders (size, source / listener positions, distance, ground) and reflector options into array d.
function ffsave(d) local(i) ( d[0] = slider2; d[1] = slider3; d[2] = slider4; d[3] = slider31; d[4] = slider10; d[5] = slider11; d[6] = slider12; d[7] = slider13; d[8] = slider14; d[9] = slider15; d[10] = slider117; d[11] = slider119;
  i = 0; loop(12, d[12 + i] = vopt[RFB + i]; i += 1; ); d[24] = vopt[RFB + 12]; d[25] = vopt[RFB + 13]; );
// Restores room/free-field sliders and reflector options from array d (the inverse of ffsave).
function ffrest(d) local(i) ( sset(2, d[0]); sset(3, d[1]); sset(4, d[2]); sset(31, d[3]); sset(10, d[4]); sset(11, d[5]); sset(12, d[6]); sset(13, d[7]); sset(14, d[8]); sset(15, d[9]); sset(117, d[10]); sset(119, d[11]);
  i = 0; loop(12, vopt[RFB + i] = d[12 + i]; i += 1; ); vopt[RFB + 12] = d[24]; vopt[RFB + 13] = d[25]; );
// Switches Room/Free field mode (v >= 0.5 is free field), saving the old mode's setup and restoring the new mode's, then sets param 1.
function modeset(v)
(
  v >= 0.5 && !isfree ? ( snap_take(); ffsave(ffRm); ffRmOk = 1; rbyp ? sset(36, 0);   // the Room power off would silence the free-field controls
   ffFfOk ? ffrest(ffFf) : ffpapply(0); snap_notify(); )
  : ( v < 0.5 && isfree ? ( snap_take(); ffsave(ffFf); ffFfOk = 1; ffRmOk ? ffrest(ffRm); snap_notify(); ); );
  setp(1, v);
);
// categories (menu page 1: Household, Work & school, Vehicles left - Studio & media, Venues, Industrial & large right;
// page 2: Homes, Offices & schools, Trains, cars & trucks left - Basements & huts, Religious & caves, Effect rooms right)
function roomcat(k) ( k < 8 ? 0 : (k < 13 ? 1 : (k < 16 ? 2 : (k < 21 ? 3 : (k < 26 ? 4 : (k < 31 ? 5 :
                     (k < 37 ? 6 : (k < 41 ? 7 : (k < 47 ? 8 : (k < 51 ? 9 : (k < 56 ? 10 : 11)))))))))); );   // page 2: 6 … 11
// Returns the name of room category c (menu pages 1 and 2).
function roomcatname(c) ( c == 0 ? "Household" : (c == 1 ? "Work & school" : (c == 2 ? "Vehicles" : (c == 3 ? "Studio & media" : (c == 4 ? "Venues" : (c == 5 ? "Industrial & large" :
  (c == 6 ? "Homes" : (c == 7 ? "Offices & schools" : (c == 8 ? "Trains, cars & trucks" : (c == 9 ? "Basements & huts" : (c == 10 ? "Religious & caves" : "Effect rooms")))))))))); );
// Returns the name of built-in room preset k for the first block of presets.
function roomnameA(k) ( k == 0 ? "Bathroom" : (k == 1 ? "Kitchen" : (k == 2 ? "Living room" : (k == 3 ? "Bedroom" : (k == 4 ? "Hallway" : (k == 5 ? "Staircase" : (k == 6 ? "Cellar" : (k == 7 ? "Garage" : (k == 8 ? "Office" : (k == 9 ? "Open-plan office" : (k == 10 ? "Classroom" : (k == 11 ? "Lecture hall" : (k == 12 ? "Gym hall" : (k == 13 ? "Car" : (k == 14 ? "Bus" : (k == 15 ? "Elevator" : (k == 16 ? "Vocal booth" : (k == 17 ? "Control room" : (k == 18 ? "Studio" : (k == 19 ? "Live room" : (k == 20 ? "Cinema" : (k == 21 ? "Jazz club" : (k == 22 ? "Restaurant" : (k == 23 ? "Theater" : (k == 24 ? "Concert hall" : (k == 25 ? "Church" : (k == 26 ? "Warehouse" : (k == 27 ? "Factory hall" : (k == 28 ? "Car park" : (k == 29 ? "Tunnel" : ("Stadium")))))))))))))))))))))))))))))); );
// Returns the name of room preset k for the extended block (k = 31 and up).
function roomnameB(k) ( (k == 31 ? "WC" : (k == 32 ? "Small kitchen" : (k == 33 ? "Kitchen-diner" : (k == 34 ? "Pro kitchen" : (k == 35 ? "Cozy living room" : (k == 36 ? "Loft" : (k == 37 ? "Small office" : (k == 38 ? "Meeting room" : (k == 39 ? "Old classroom" : (k == 40 ? "Music classroom" : (k == 41 ? "Train compartment" : (k == 42 ? "Train coach" : (k == 43 ? "Small car" : (k == 44 ? "Empty van" : (k == 45 ? "Truck cab" : (k == 46 ? "Truck box" : (k == 47 ? "Concrete basement" : (k == 48 ? "Hobby basement" : (k == 49 ? "Wood hut" : (k == 50 ? "Sauna" : (k == 51 ? "Chapel" : (k == 52 ? "Village church" : (k == 53 ? "Cathedral" : (k == 54 ? "Small cave" : (k == 55 ? "Large cave" : (k == 56 ? "Metal tank" : (k == 57 ? "Concrete bunker" : (k == 58 ? "Tin shed" : (k == 59 ? "Glass box" : (k == 60 ? "Dead room" : "Drain pipe")))))))))))))))))))))))))))))); );
// Returns the name of room preset k, choosing roomnameA or roomnameB by index (NPG1 boundary).
function roomname(k) ( k < NPG1 ? roomnameA(k) : roomnameB(k); );
// Clamps an x position (unscaled units) to stay at least 0.1 m inside the room width.
function clampx(v) ( min(max(v, 0.1 / rs), (roomW - 0.1) / rs); );
// Clamps a y position (unscaled units) to stay at least 0.1 m inside the room depth.
function clampy(v) ( min(max(v, 0.1 / rs), (roomD - 0.1) / rs); );
function clampz(v) ( min(max(v, 0.1), roomH - 0.1); );   // heights: absolute meters
// THE LISTENER IS A PERSON: it cannot walk through walls. The room walls stop it, the barrier too - a wall and a window
// always (it gets as close as its body allows, 16 cm), a door only when it is open far enough (40 %) and the listener
// walks through the opening. Pressing against a wall: "Ouch!" (wcT). In: target in slider units, out: wcX, wcY.
function lis_walk(nx, ny) local(ox, oy, tx, ty, wr, wtyp, wyb, wym, wbw, wbx, wb0, wb1, pas, inb, hit)
(
  wr = 0.16; hit = 0;   // 16 cm - the head is 8 cm, the wall line 4; the Ouch came while there was still a gap
  ox = slider13 * rs; oy = slider14 * rs; tx = nx * rs; ty = ny * rs;
  // room walls (not in the free field: there the edge is only the end of the drawing)
  !isfree ? ( (tx < 0.1 - 0.06 || tx > roomW - 0.1 + 0.06 || ty < 0.1 - 0.06 || ty > roomD - 0.1 + 0.06) ? ( hit = 1; ); );
  tx = min(max(tx, 0.1), roomW - 0.1); ty = min(max(ty, 0.1), roomD - 0.1);
  wtyp = floor(slider41 + 0.5);
  wtyp > 0 ? (
    // barrier geometry in meters: wyb = depth of the barrier plane, wbw = opening width (door 0.9, window 1.2, wall none), wb0..wb1 = free passage between the frame posts (0.15 m inset on each side)
    wym = min(0.3, 0.25 * roomD); wyb = min(max(slider42 * rs, wym), roomD - wym);
    wbw = wtyp == 3 ? 0.9 : (wtyp == 2 ? 1.2 : 0); wbw = min(wbw, roomW - 0.1);
    wbx = min(max(slider45 * rs, wbw / 2 + 0.05), roomW - wbw / 2 - 0.05); wb0 = wbx - wbw / 2 + 0.15; wb1 = wbx + wbw / 2 - 0.15;
    pas = wtyp == 3 && slider43 >= 40;                                   // a door, open far enough for a person
    inb = abs(oy - wyb) < wr;                                            // standing in the doorway
    pas && inb ? (
      (tx < wb0 - 0.04 || tx > wb1 + 0.04) && abs(ty - wyb) < wr ? ( hit = 1; );   // the door frame
      abs(ty - wyb) < wr ? ( tx = min(max(tx, wb0), wb1); );
    ) : (
      !(pas && tx >= wb0 && tx <= wb1) ? (
        oy < wyb ? ( ty > wyb - wr + 0.06 ? ( hit = 1; ); ty = min(ty, wyb - wr); )
                 : ( ty < wyb + wr - 0.06 ? ( hit = 1; ); ty = max(ty, wyb + wr); );   // (6 cm into the stop zone = really pushing)
      );
    );
  );
  hit ? ( time_precise() - wcT > 0.9 ? ( wcT = time_precise(); ); );            // one "Ouch!" per bump
  wcX = tx / rs; wcY = ty / rs;
);
// ON A LINE (Ctrl/Cmd held while dragging source or listener): from where it was when the key went down it moves only
// left / right or only forward / back - the first few pixels of mouse movement choose which. Out: axNX, axNY (slider units)
function axcon(which, nx, ny, thr)
(
  (mouse_cap & 4) ? (
    !axOn ? ( axOn = 1; axA = 0; axX0 = which == 1 ? slider10 : slider13; axY0 = which == 1 ? slider11 : slider14; axMX = mx; axMY = my; );
    axA == 0 && abs(mx - axMX) + abs(my - axMY) > thr ? ( axA = abs(nx - axX0) >= abs(ny - axY0) ? 1 : 2; );
    axNX = axA == 1 ? nx : axX0; axNY = axA == 2 ? ny : axY0;
  ) : ( axOn = 0; axNX = nx; axNY = ny; );
);
// START POSITIONS (implemented by posreset / prstep further below): source and listener back to where a new instance has them - listener in the middle of the room, the
// source 2 m in front of it (closer in a small room), both 1.5 m high, facing and aim fixed, straight ahead. The room
// (size, materials, barrier) stays as it is; a locked one stays where it is. One undo step.
// They glide there in 0.35 s (prstep, every frame): the sound follows smoothly instead of jumping with a click.

// MOTION PRESETS: practical moves for film - set the pattern and start it (from where the balls are)
NMP = 14;
// SHAPES of the new patterns (audio thread copy - the GUI has its own, gmtpt): phase ph 0 … 1 -> amU, amV in -1 … 1
// 5 Square: along the edge of a square (starts right of the center, like the circle); 6 Wave: left - right like the auto pan,
// on a sine line (two waves across); 7 Drawn: the path drawn with the mouse, one round per cycle
// FULL SIZE: the extent of a pattern around its center (in units of Size) - the center moves in from the walls as
// far as needed, so the path always runs at its full Size (a path larger than the room is centered instead)
function amtext(p) local(k)
(
  amX0 = amY0 = -1; amX1 = amY1 = 1; amZ0 = amZ1 = 0;
  p == 1 ? ( amY0 = amY1 = 0; ); p == 2 ? ( amX0 = amX1 = 0; ); p == 3 ? ( amX0 = amX1 = amY0 = amY1 = 0; amZ0 = -1; amZ1 = 1; );
  p == 6 ? ( amY0 = -0.35; amY1 = 0.35; );
  p == 7 && MTDP[512] >= 256 ? ( amX0 = amY0 = amZ0 = 1; amX1 = amY1 = amZ1 = -1; k = 0;
    loop(256, amX0 = min(amX0, MTDP[2 * k]); amX1 = max(amX1, MTDP[2 * k]); amY0 = min(amY0, MTDP[2 * k + 1]); amY1 = max(amY1, MTDP[2 * k + 1]); amZ0 = min(amZ0, MTDP[514 + k]); amZ1 = max(amZ1, MTDP[514 + k]); k += 1; ); );
);
// Fits motion-path center c inside a box of width w with margin mg and path extents lo/hi; returns the midpoint if the path doesn't fit.
function amfit(c, lo, hi, w, mg) local(a, b) ( a = mg - lo; b = w - mg - hi; a <= b ? min(max(c, a), b) : (a + b) / 2; );
// MTDP (drawn motion path, 770 values): [2k], [2k + 1] = x, y of point k (k = 0 … 255, -1 … 1), [512] = number of points (256 = a path exists), [514 + k] = z; the four path slots are kept in MTDS (770 each)
// Evaluates motion pattern p (square, wave or drawn) at phase ph; sets globals amU, amV, amW as the unit-path x/y/z offset.
function amtpt(p, ph) local(s, i0, i1, f)
(
  ph -= floor(ph); amW = 0;
  // Square: s = ph * 8 walks the four edges (2 units each), starting in the middle of the right edge and going up; Wave: two sine periods across; else the drawn path (linear interpolation) or a circle
  p == 5 ? ( s = ph * 8;
    s < 1 ? ( amU = 1; amV = s; ) : ( s < 3 ? ( amU = 2 - s; amV = 1; ) : ( s < 5 ? ( amU = -1; amV = 4 - s; ) : ( s < 7 ? ( amU = s - 6; amV = -1; ) : ( amU = 1; amV = s - 8; ); ); ); );
  ) : ( p == 6 ? ( amU = sin(2 * $pi * ph); amV = 0.35 * sin(2 * $pi * amU); ) : (
    MTDP[512] >= 256 ? ( s = ph * 256; i0 = floor(s); f = s - i0; i0 = i0 % 256; i1 = (i0 + 1) % 256;
      amU = MTDP[2 * i0] + (MTDP[2 * i1] - MTDP[2 * i0]) * f; amV = MTDP[2 * i0 + 1] + (MTDP[2 * i1 + 1] - MTDP[2 * i0 + 1]) * f; amW = MTDP[514 + i0] + (MTDP[514 + i1] - MTDP[514 + i0]) * f; ) : ( amU = cos(2 * $pi * ph); amV = sin(2 * $pi * ph); );
  ); );
);
// Returns the name of motion preset k.
function mpname(k) ( k == 0 ? "Circle around the listener" : (k == 1 ? "Insect around the head" : (k == 2 ? "Car passing by" : (k == 3 ? "Motorbike, fast pass-by" : (k == 4 ? "Someone walks past" :
  (k == 5 ? "Comes closer and goes away" : (k == 6 ? "Auto pan left - right" : (k == 7 ? "Up and down (ladder, lift)" : (k == 8 ? "Listener walks around the room" : (k == 9 ? "Listener walks through the room" : (k == 10 ? "Square around the listener" : (k == 11 ? "Slalom in front" : (k == 12 ? "Lying eight (∞)" : "Standing eight (8)")))))))))))); );
// Returns a one-line description of motion preset k.
function mpdesc(k) ( k == 0 ? "the source circles the listener at its present distance, slowly" : (k == 1 ? "small and fast circles close to the ears" : (k == 2 ? "from where the source is to the right, 3 s" : (k == 3 ? "1.2 s, the pitch drops as it passes" : (k == 4 ? "a few meters from here to the right, 5 s" :
  (k == 5 ? "forward and back from where it is" : (k == 6 ? "a sine across the room, 4 s per swing" : (k == 7 ? "the source rises and sinks" : (k == 8 ? "the listener circles the room center" : (k == 9 ? "the listener walks left and right" : (k == 10 ? "along the edges of a square around the listener" : (k == 11 ? "a wave line left and right from where it is, 10 s" : (k == 12 ? "a figure of eight lying on its side, from where it is" : "a figure of eight from front to back, from where it is")))))))))))); );
// the presets start from where source and listener are now - nothing is moved first; the size is kept inside the room
function mpapply(k) local(rsc, W, D, lx0, ly0, sx0, sy0, sz0, mv, pat, ar, rate, sz, st, gl, mx0, my0, dx, dy, dd, j, a)
(
  rsc = min(4, max(0.25, slider31)); W = slider2; D = slider3;                                     // slider units (meters / Size)
  sx0 = slider10; sy0 = slider11; sz0 = slider12; lx0 = slider13; ly0 = slider14;
  // defaults: mv = who moves (0 source, 1 listener), pat = pattern (0 circle, 1 left - right, 2 front - back, 3 up - down, 4 pass-by, 5 square, 6 wave, 7 drawn), ar = around (0 listener, 1 own spot, 2 room center), rate in Hz, sz = size (slider units), st = start angle in degrees, gl = glide in s
  mv = 0; pat = 0; ar = 0; rate = 0.1; sz = 2 / rsc; st = 0; gl = 1;
  k == 1 ? ( rate = 0.6; sz = 0.6 / rsc; gl = 0.3; );
  k == 2 ? ( pat = 4; rate = 1 / 3; sz = 8 / rsc; gl = 0.2; );
  k == 3 ? ( pat = 4; rate = 1 / 1.2; sz = 10 / rsc; gl = 0.2; );
  k == 4 ? ( pat = 4; rate = 1 / 5; sz = 3 / rsc; gl = 0.2; );
  k == 5 ? ( pat = 2; ar = 1; rate = 0.08; sz = 2 / rsc; );
  k == 6 ? ( pat = 1; ar = 1; rate = 0.25; sz = 2 / rsc; );
  k == 7 ? ( pat = 3; ar = 1; rate = 0.1; sz = 0.9 / rsc; );
  k == 8 ? ( mv = 1; ar = 2; rate = 0.03; sz = min(W, D) / 3; );
  k == 9 ? ( mv = 1; pat = 1; ar = 1; rate = 0.05; sz = W / 2 - 0.6; );
  k == 10 ? ( pat = 5; rate = 0.06; sz = 2 / rsc; );
  k == 11 ? ( pat = 6; ar = 1; rate = 0.1; sz = 3 / rsc; );
// FIGURE EIGHT (lying / standing): written as a path into the slot in use, then run as Drawn
  k >= 12 ? ( pat = 7; ar = 1; rate = 0.1; sz = 2 / rsc; j = 0;
    loop(256, a = 2 * $pi * j / 256; MTDP[2 * j] = k == 12 ? sin(a) : 0.6 * sin(2 * a); MTDP[2 * j + 1] = k == 12 ? 0.6 * sin(2 * a) : sin(a); MTDP[514 + j] = 0; j += 1; );
    MTDP[512] = 256; MTDP[513] = 0; memcpy(MTDS + 770 * min(3, max(0, floor(MTDS[3080] + 0.5))), MTDP, 770); );
  // a circle around the listener: radius and start = where the source is now (it does not jump)
  dx = sx0 - lx0; dy = sy0 - ly0; dd = sqrt(dx * dx + dy * dy);
  k == 0 && dd > 0.3 / rsc ? ( sz = dd; st = atan2(dy, dx) * 180 / $pi; st < 0 ? st += 360; );
  // keep the path inside the room (from the present spots)
  mx0 = mv == 1 ? lx0 : sx0; my0 = mv == 1 ? ly0 : sy0;
  (pat == 0 || pat == 5) && mv == 0 && k != 0 ? ( sz = min(sz, min(min(lx0, W - lx0), min(ly0, D - ly0)) - 0.3 / rsc); );
  pat == 1 || pat == 6 ? ( sz = min(sz, min(mx0, W - mx0) - 0.3 / rsc); );
  pat == 7 ? ( sz = min(sz, max(0.3, min(W, D) / 2 - 0.3 / rsc)); );   // (the full-size fit moves the center in)
  pat == 4 ? ( sz = min(sz, (W - mx0 - 0.3 / rsc) / 2); );                 // the pass-by runs from here to the right (2 x Size)
  pat == 2 ? ( sz = min(sz, min(my0, D - my0) - 0.3 / rsc); );
  pat == 3 ? ( sz = min(sz, min(sz0 - 0.2, slider4 * rsc - 0.2 - sz0) / rsc); );   // the room height in meters (slider4 x Size) - the source height is in meters
  sz = max(0.1, sz);
  snap_take();
  mtE > 0.001 || slider100 >= 0.5 ? ( mtKill = 1; );
  sset(101, mv); sset(102, pat); sset(103, rate); sset(104, sz); sset(105, st); sset(106, 0); sset(107, ar); sset(108, 0); sset(109, gl);
  sset(100, 1);
  snap_notify();
);
// Starts a smooth reset of unlocked source and/or listener to the default arrangement (middle of room, 1.5 m high, facing fixed); sets prA*/prB* targets and prOn.
function posreset()
(
  snap_take(); mtE > 0.001 || slider100 >= 0.5 ? ( mtKill = 1; slider100 = 0; );
  prLo = !lockL; prSo = !lockS;
  prA0 = slider10; prA1 = slider11; prA2 = slider12; prA3 = slider13; prA4 = slider14; prA5 = slider15; prA6 = slider17; prA7 = slider61;
  prB0 = slider2 / 2; prB1 = clampy(pdefsy(slider3, rs)); prB2 = clampz(1.5);
  prB3 = slider2 / 2; prB4 = slider3 / 2; prB5 = clampz(1.5); prB6 = 0; prB7 = 0;
  prLo ? ( setp(16, 1); ); prSo ? ( setp(63, 1); );                 // facing and aim: fixed (the angles glide)
  prOn = 1; prT0 = time_precise();
);
// Interpolates angle a to b in degrees by fraction e via the shortest way round; result wrapped to -180..180.
function prang(a, b, e) local(d) ( d = b - a; d > 180 ? d -= 360; d < -180 ? d += 360; d = a + d * e; d > 180 ? d - 360 : (d < -180 ? d + 360 : d); );
// Per-frame step of the position-reset glide (0.35 s, smoothstep): eases source/listener position and angles; ends with prOn = 0.
function prstep() local(t, e)
(
  t = min(1, (time_precise() - prT0) / 0.35); e = t * t * (3 - 2 * t);
  prSo ? ( setp(10, prA0 + (prB0 - prA0) * e); setp(11, prA1 + (prB1 - prA1) * e); setp(12, prA2 + (prB2 - prA2) * e); setp(61, prang(prA7, prB7, e)); );
  prLo ? ( setp(13, prA3 + (prB3 - prA3) * e); setp(14, prA4 + (prB4 - prA4) * e); setp(15, prA5 + (prB5 - prA5) * e); setp(17, prang(prA6, prB6, e)); );
  t >= 1 ? ( prOn = 0; snap_notify(); );
);
// The 5.1 sliders (above 119) are not part of setp / sset (their lists end at 119): set here directly and sent to the host
function set51(i, v) (
  i == 136 ? ( slider136 = v; slider_automate(slider136); );
  i == 141 ? ( slider141 = v; slider_automate(slider141); );
  i == 145 ? ( slider145 = v; slider_automate(slider145); );
  i == 146 ? ( slider146 = v; slider_automate(slider146); );
  i == 152 ? ( slider152 = v; slider_automate(slider152); );
  i == 153 ? ( slider153 = v; slider_automate(slider153); );
  i == 143 ? ( slider143 = v; slider_automate(slider143); );
  i == 144 ? ( slider144 = v; slider_automate(slider144); );
  i == 147 ? ( slider147 = v; slider_automate(slider147); );
  i == 148 ? ( slider148 = v; slider_automate(slider148); );
  i == 149 ? ( slider149 = v; slider_automate(slider149); );
  i == 150 ? ( slider150 = v; slider_automate(slider150); );
  i == 151 ? ( slider151 = v; slider_automate(slider151); );
);
// SURROUND PRESETS (page "5.1" of the preset menu): each one loads a room, a scenario, a delay preset or a motion preset that
// is already there, switches the output to 5.1 and sets what 5.1 adds - the ring, the Center, the LFE, where the echoes'
// width plays, and for some the source behind the listener. Groups: 0 Rooms, 1 Scenarios, 2 Delay, 3 Motion.
// S5T (stride 9): group, index of the preset it loads, ring (0 listener / 1 room), Center %, LFE on, LFE dB, echoes
// (0 front / 1 rear / 2 around), source (0 as loaded, 1 behind, 2 behind left, 3 behind right); -1 = leave as it is
NS5 = 17; s5X = alloc(NS5); s5Y = alloc(NS5); S5T = alloc(9 * NS5); s5last = -1;
function s5put(k, g, ix, ring, ctr, lfon, lfdb, echo, sdir) local(b) ( b = S5T + k * 9; b[0] = g; b[1] = ix; b[2] = ring; b[3] = ctr; b[4] = lfon; b[5] = lfdb; b[6] = echo; b[7] = sdir; );
s5put(0, 0, 20, 1, 100, 1, 0, 0, 0);     // Cinema
s5put(1, 0, 25, 0, 50, 1, -6, 0, 0);     // Church
s5put(2, 0, 13, 0, 100, 1, 3, 0, 0);     // Car
s5put(3, 0, 2, 0, 100, 1, 0, 0, 1);      // Living room, voice behind
s5put(4, 0, 24, 0, 0, 1, -6, 0, 0);      // Concert hall
s5put(5, 1, 0, 0, 100, 1, 3, 0, 2);      // Party next door, behind left
s5put(6, 1, 14, 0, 100, 0, 0, 2, 0);     // Station announcement
s5put(7, 1, 2, 0, 100, 0, 0, 0, 1);      // Argument behind you
s5put(8, 1, 15, 0, 50, 1, 0, 2, 0);      // Stadium PA
s5put(9, 2, 0, -1, -1, -1, 0, 1, 0);     // Slapback behind
s5put(10, 2, 20, -1, -1, -1, 0, 2, 0);   // Ping-pong around
s5put(11, 2, 10, -1, -1, -1, 0, 1, 0);   // Canyon echo behind
s5put(12, 2, 26, -1, -1, -1, 0, 2, 0);   // Dub echoes around
s5put(13, 3, 0, 0, -1, -1, 0, -1, 0);    // Circle around the head
s5put(14, 3, 1, 0, -1, -1, 0, -1, 0);    // Insect
s5put(15, 3, 5, 0, -1, -1, 0, -1, 0);    // front - back
s5put(16, 3, 10, 0, -1, -1, 0, -1, 0);   // Square
function s5name(k) ( k == 0 ? "Cinema – discrete center" : (k == 1 ? "Church – all around" : (k == 2 ? "Car interior" : (k == 3 ? "Living room – voice behind you" : (k == 4 ? "Concert hall – phantom center" :
  (k == 5 ? "Party next door – behind left" : (k == 6 ? "Station announcement" : (k == 7 ? "Argument behind you" : (k == 8 ? "Stadium PA – all around" :
  (k == 9 ? "Slapback behind" : (k == 10 ? "Ping-pong around" : (k == 11 ? "Canyon echo behind" : (k == 12 ? "Dub echoes around" :
  (k == 13 ? "Circle around the head" : (k == 14 ? "Insect around the head" : (k == 15 ? "Front – back through the room" : "Square around the listener"))))))))))))))); );
function s5desc(k) ( k == 0 ? "The Cinema room with the loudspeakers fixed in the room, a hard center and the LFE" : (k == 1 ? "The Church with half of the front on the center and a soft LFE – the reverb comes from all sides" : (k == 2 ? "The Car with a hard center and a strong LFE" : (k == 3 ? "The Living room with the source behind the listener" : (k == 4 ? "The Concert hall without a center loudspeaker (phantom) and a soft LFE" :
  (k == 5 ? "The scenario Party next door, the source behind you on the left" : (k == 6 ? "The scenario Station announcement, its echoes on all four corners, no LFE" : (k == 7 ? "The scenario Argument behind the wall, the source behind you" : (k == 8 ? "The scenario Stadium PA with its echoes all around" :
  (k == 9 ? "The delay Slapback alley, the width of its echoes on Ls / Rs – your room stays" : (k == 10 ? "The delay Ping-pong 1/8, bouncing on all four corners – your room stays" : (k == 11 ? "The delay Canyon echo, its width behind you – your room stays" : (k == 12 ? "The delay Dub 1/4 dotted on all four corners – your room stays" :
  (k == 13 ? "Motion: the source circles the listener – through all five loudspeakers" : (k == 14 ? "Motion: small and fast around the head" : (k == 15 ? "Motion: the source comes closer, passes and goes away" : "Motion: the source walks a square around the listener"))))))))))))))); );
function s5gname(g) ( g == 0 ? "Rooms" : (g == 1 ? "Scenarios" : (g == 2 ? "Delay" : "Motion")); );
function s5load(k) local(b, g, W, D, px, py)
(
  b = S5T + k * 9; g = b[0];
  g == 0 ? ( isfree ? modeset(0); loadroom(b[1]); );
  g == 1 ? ( isfree ? modeset(0); scnload(b[1]); );
  g == 2 ? dpload(b[1]);
  g == 3 ? mpapply(b[1]);
  set51(136, 1);
  b[2] >= 0 ? ( set51(145, b[2]); set51(146, 0); );
  b[3] >= 0 ? set51(144, b[3]);
  b[4] >= 0 ? ( set51(141, b[4]); set51(143, b[5]); );
  b[6] >= 0 ? set51(152, b[6]);
  b[7] > 0 ? (   // the source behind the listener (1), behind left (2), behind right (3) - inside the room
    W = slider2; D = slider3;
    px = slider13 + (b[7] == 2 ? -1 : (b[7] == 3 ? 1 : 0)) * min(1.5, 0.6 * min(slider13, W - slider13));
    py = slider14 + min(1.8, 0.7 * (D - slider14));
    setp(10, min(W - 0.2, max(0.2, px))); setp(11, min(D - 0.2, max(0.2, py)));
  );
  s5last = k;
);

// Moves source (which = 1) or listener (2) to x/y (nx, ny); shifts the motion pattern center while MOTION runs and drags the linked partner with Link S+L.
function moveobj(which, nx, ny) local(dx, dy)
(
// MOTION running: the drag moves the CENTER of the pattern (the audio thread writes the ball's position itself)
  mtEg > 0.001 && slider100 < 0.5 ? mtKill = 1;   // a drag during the fade-out ends the glide at once (the ball is the user's again)
  mtEg > 0.001 && slider100 >= 0.5 && ((which == 1 && mtSon) || (which == 2 && mtLon)) ? (
    !mtDrg ? ( mtDrg = 1; mtGx = nx; mtGy = ny; mtGcx = mtApOn ? MTAP[0] : (which == 1 ? mtC0x : mtC1x); mtGcy = mtApOn ? MTAP[1] : (which == 1 ? mtC0y : mtC1y); );   // grab: the center and the mouse
    mtApOn ? ( MTAP[0] = clampx(mtGcx + nx - mtGx); MTAP[1] = clampy(mtGcy + ny - mtGy); )   // with a placed Own spot the drag moves the spot
    : which == 1 ? ( mtC0x = clampx(mtGcx + nx - mtGx); mtC0y = clampy(mtGcy + ny - mtGy); )                              // the path follows the mouse by its delta
               : ( mtC1x = clampx(mtGcx + nx - mtGx); mtC1y = clampy(mtGcy + ny - mtGy); );
  ) :
  which == 1 ? (
    !lockS ? (
      dx = nx - slider10; dy = ny - slider11; setp(10, clampx(nx)); setp(11, clampy(ny));
      linksl && !lockL ? ( lis_walk(slider13 + dx, slider14 + dy); setp(13, wcX); setp(14, wcY); );
      mtEg > 0.001 && slider100 >= 0.5 ? ( !mtSon ? ( mtC0x = slider10; mtC0y = slider11; ); !mtLon && linksl && !lockL ? ( mtC1x = slider13; mtC1y = slider14; ); );   // a ball the pattern does not move is the CENTER of the path around it - it takes the center along
    );
  ) : (
    !lockL ? (
      dx = nx - slider13; dy = ny - slider14; lis_walk(nx, ny); setp(13, wcX); setp(14, wcY);
      linksl && !lockS ? ( setp(10, clampx(slider10 + dx)); setp(11, clampy(slider11 + dy)); );
      mtEg > 0.001 && slider100 >= 0.5 ? ( !mtLon ? ( mtC1x = slider13; mtC1y = slider14; ); !mtSon && linksl && !lockS ? ( mtC0x = slider10; mtC0y = slider11; ); );   // the listener stays where it is put - and the path around it follows (the source circled around the old spot before)
    );
  );
);
// Sets height of source (which = 1) or listener (2) to nz (clamped), moving the other by the same offset when linked and unlocked.
function moveobjz(which, nz) local(dz)
(
  which == 1 ? ( !lockS ? ( dz = nz - slider12; setp(12, clampz(nz)); linksl && !lockL ? setp(15, clampz(slider15 + dz)); ); )
             : ( !lockL ? ( dz = nz - slider15; setp(15, clampz(nz)); linksl && !lockS ? setp(12, clampz(slider12 + dz)); ); );
);
// Returns the index (0-12) of the source-model menu item under mouse y yy, or -1 if none.
function srcitem(yy) local(ri, k, top)
(
  ri = -1; k = 0;
  // item k sits at its row k * srcih; 5 px group gaps open up before item 1 and before item 5
  loop(13, top = srcmy + 4 + k * srcih + (k > 0) * 5 + (k > 4) * 5; yy >= top && yy < top + srcih ? ri = k; k += 1; );
  ri;
);
