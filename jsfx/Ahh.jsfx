);
function snslx(k) ( basic ? 346 + tbOff + k * 20 : 346 + tbOff + (k % 8) * 17; );   // snapshot button k: left edge in the top bar (Basic: one row, larger buttons)
function snsly(k) ( basic ? 14 : 10 + floor(k / 8) * 15; );   // snapshot button k: top edge; larger snapshot buttons (15 x 13) in Expert
// Opens the snapshot editor for slot k: copies its name (snam) and description (dsc) into the edit buffers and sets snedit=k+1, name field active.
function sn_open(k) local(i) (
  snelen = 0; i = 0;
  loop(SNL, sneb[i] = snam[k * SNL + i]; snelen == i && sneb[i] > 0 ? ( snelen += 1; ); i += 1; );
  sneb[snelen] = 0;
  dselen = 0; i = 0;
  loop(DSL, dseb[i] = dsc[k * DSL + i]; dselen == i && dseb[i] > 0 ? ( dselen += 1; ); i += 1; );
  dseb[dselen] = 0;
  snf = 0; snedit = k + 1; snt0 = time_precise();
);
// snapshot popup geometry (top-bar scale): centered under the top bar
function sn_geo() (
  snpx = min(max(4, (WTN - SNPW) / 2 + pdSX), WTN - SNPW - 4); snpy = min(max(4, 40 + pdSY), HTN - SNPH - 4); snby = snpy + SNPH - 28;
  snfx = snpx + 12; snfw = SNPW - 24; snny = snpy + 42; snnh = 24; sndy = snny + snnh + 22; sndh = 54;
