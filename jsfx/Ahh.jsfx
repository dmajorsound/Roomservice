  tipbox(tlx + tlw - 44, tpy0 + 83, 44, 14, "Use the tapped tempo: the delay keeps its note values and plays them at this tempo (in ms mode: the note value chosen below)");
  col(cMUTED, 1); gfx_setfont(7); txt("best with playback stopped", tlx, tpy0 + 106, 0);
