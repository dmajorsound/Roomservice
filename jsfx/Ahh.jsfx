  col(kdim ? cDIM2 : cTEXT, 1); txtbox(vs, cx, cy, 2 * KR - 2 * KLW - 3, 16 * KSC, KVF);
  col(kdim ? cDIM2 : cMUTED, 1); gfx_setfont(KNF); txt(nm, cx, cy + KR + 8 * KNS, 1);
  nf = deg; kchg = 0; sh = (mouse_cap & 8) > 0;
  hit = sqr(mx - cx) + sqr(my - cy) < sqr(KR + 5);
  ((click && (mouse_cap & 36)) || rclick) && hit ? ( vedopen(id, vs); click = 0; rclick = 0; );
  vedPend && vedId == id ? ( nf = min(180, max(-180, vedVal)); kchg = 1; vedPend = 0; );
  vedit == id ? vedplace(cx, cy + KR + 8 * KNS, 2 * KR + 12);
  click && hit ? (
    t = time_precise();
    (mouse_cap & 16) ? ( nf = 0; kdrag = 0; lastkid = -1; kchg = 1; ) :
    (lastkid == id && t - lastkt < 0.5) ? ( vedopen(id, vs); lastkid = -1; kdrag = 0; )
                                        : ( kdrag = id; dkmy = my; dkmx = mx; kf0 = deg; lastkid = id; kmv = 0; dkSh = sh; );
    lastkt = t;
  );
  kdrag == id && !kmv && abs(dkmy - my) + abs(dkmx - mx) > 2 ? ( kmv = 1; );
  kdrag == id && kmv ? (
    sh != dkSh ? ( kf0 = deg; dkmy = my; dkSh = sh; );            // Shift pressed / released: continue from here
    sh ? ( nf = kf0 + (dkmy - my) * 0.25; ) : (
      dx = mx - cx; dy = my - cy;
      dx * dx + dy * dy > 16 ? (
        nf = atan2(-dx, dy) * 180 / $pi - base;
