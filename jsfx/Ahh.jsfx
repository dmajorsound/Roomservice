  krow(c1, y, "B  ·  E  ·  L", "View: Basic  ·  Expert  ·  Learn", ovkw, ovdw); y += 25;
  krow(c1, y, "[  /  ]", "Tabs: previous / next module", ovkw, ovdw); y += 25;
  krow(c1, y, "0", "Expert: Tabs <-> All (All with Fit all)", ovkw, ovdw); y += 25;
  krow(c1, y, "T  ·  A  ·  F", "Expert: Tabs  ·  All  ·  Fit on / off", ovkw, ovdw); y += 25;
  krow(c1, y, "Z", "Zoom what is under the mouse", ovkw, ovdw); y += 25;
