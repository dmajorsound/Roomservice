    dv1 > 0.001 ? ( btV = 1; btVx = lx + (vpx - lx) * (dv1 + dv2) / dv1; btVy = ly + (crY - ly) * (dv1 + dv2) / dv1; btVz = lz + (vpz - lz) * (dv1 + dv2) / dv1; );
  );
);

// stereo position: constant-power pan with a limited side (see below) from lat = -1 … +1 (lateral component, front / back folded) -> gains pgL / pgR.
// Until this was the TANGENT LAW for loudspeakers at +-30 degrees: a source 10 degrees right was heard 10 degrees right between the speakers.
// Beyond the speakers nothing can be shown, so the angle was compressed smoothly into the base (30 deg -> 23 deg, 60 deg -> 29 deg, 90 deg -> hard).
// (before 0.176: sine law, which pulled every source toward the center - 30 degrees came out at 13)
function pang(lat) local(pp)
(
// constant-power pan with a LIMITED side: a sound straight to the side keeps 15 dB less in the other channel, not
  // silence (two ears on one head never hear nothing). Before: tangent law for 30-degree speakers - everything beyond
  // about 50 degrees sat in one channel alone, and a circling source jumped from one side to the other
  pp = min(1, max(-1, lat)) * 0.78;   // 78 % = 15 dB at the side, 9 dB at 45 degrees - the highs get more from the head shadow (19 dB broadband) // +-1 -> +-86 % of the pot = 19 dB at the side, 10 dB at 45 degrees (15 / 7 dB - too little direction)
  pgL = cos((pp + 1) * 0.78539816); pgR = sin((pp + 1) * 0.78539816);
);
// RoomservicePro: the five loudspeaker gains of a tap (L R C Ls Rs) from its direction of arrival (rel: 0 = ahead, + = right,
// radians) and its mono gain gm. Pairwise constant-power panning between the two loudspeakers that enclose the direction (their
// azimuths come from the layout, SPKL - ITU or Film, as the Stage View shows them); a path from overhead (hf = its horizontal
// share, small) has no direction to pan to and is spread over all five with equal power. The Center knob (slider144) turns the
// C share into a phantom center on L / R, power kept. The ear cues of the stereo path (ear timing, head shadow, near-field
// level difference) are not used here: loudspeakers in a room give the listener's ears those cues themselves.
function vbap5(k, gm, rel, hf) local(qpp, az, azL, azR, aC, aLs, aRs, i1, i2, t, w, d, gcc)
(
  qpp = qG5x + k * 5; qpp[0] = qpp[1] = qpp[2] = qpp[3] = qpp[4] = 0;
  az = rel * 57.29577951; while(az > 180 ? ( az -= 360; 1; ) : 0); while(az <= -180 ? ( az += 360; 1; ) : 0);
  azL = SPKL[3]; azR = SPKL[11]; aC = SPKL[19]; aLs = SPKL[35]; aRs = SPKL[43];
  az >= aC && az <= azR ? ( i1 = 2; i2 = 1; t = (az - aC) / max(1, azR - aC); ) : (
  az < aC && az >= azL ? ( i1 = 0; i2 = 2; t = (az - azL) / max(1, aC - azL); ) : (
  az > azR && az <= aRs ? ( i1 = 1; i2 = 4; t = (az - azR) / max(1, aRs - azR); ) : (
  az < azL && az >= aLs ? ( i1 = 3; i2 = 0; t = (az - aLs) / max(1, azL - aLs); ) : (
  ( i1 = 4; i2 = 3; az < 0 ? az += 360; t = (az - aRs) / max(1, aLs + 360 - aRs); ) ) ) ) );   // behind: Rs -> Ls across the back
  t = min(1, max(0, t)) * 1.5707963; qpp[i1] = cos(t); qpp[i2] = sin(t);
  w = min(1, hf / 0.3); w < 1 ? ( i1 = 0; loop(5, qpp[i1] = sqrt(w * sqr(qpp[i1]) + (1 - w) * 0.2); i1 += 1; ); );
  // SNAP (slider146): the direct sound sits on the one loudspeaker nearest to its direction - a hard channel assignment, as a
  // cinema panner's snap does. Reflections and the tail stay geometric (the room is still around the source). 6 degrees of
  // hysteresis so a source on a border between two loudspeakers does not flap. qSnapK: the chosen loudspeaker (GUI highlight)
  k == 0 && slider146 >= 0.5 ? (
    azL = abs(az - SPKL[3]); azL > 180 ? azL = 360 - azL; i1 = 0; t = azL;
    w = abs(az - SPKL[11]); w > 180 ? w = 360 - w; w < t ? ( t = w; i1 = 1; );
    w = abs(az - SPKL[19]); w > 180 ? w = 360 - w; w < t ? ( t = w; i1 = 2; );
    w = abs(az - SPKL[35]); w > 180 ? w = 360 - w; w < t ? ( t = w; i1 = 3; );
    w = abs(az - SPKL[43]); w > 180 ? w = 360 - w; w < t ? ( t = w; i1 = 4; );
    qSnapK >= 0 && qSnapK != i1 ? ( w = abs(az - SPKL[(qSnapK == 3 ? 4 : (qSnapK == 4 ? 5 : qSnapK)) * 8 + 3]); w > 180 ? w = 360 - w; w <= t + 6 ? i1 = qSnapK; );
    qSnapK = i1; qpp[0] = qpp[1] = qpp[2] = qpp[3] = qpp[4] = 0; qpp[i1] = 1;
  ) : ( k == 0 ? qSnapK = -1; );
  d = min(1, max(0, slider144 / 100)); gcc = qpp[2];
  qpp[2] = gcc * sqrt(d); qpp[0] = sqrt(sqr(qpp[0]) + sqr(gcc) * (1 - d) * 0.5); qpp[1] = sqrt(sqr(qpp[1]) + sqr(gcc) * (1 - d) * 0.5);
  qpp[0] *= gm; qpp[1] *= gm; qpp[2] *= gm; qpp[3] *= gm; qpp[4] *= gm;
);
// image-source tap: delay, distance gain, air / wall absorption and the stereo position (pan law, see pang)
// SOURCE DIRECTIVITY: a voice or a loudspeaker radiates mostly forward, the more the higher the frequency (directivity
// index of the human voice about 1.5 dB at 250 Hz, 3 dB at 1 kHz, 6 dB at 4 kHz). The source faces the listener; every
// reflection leaves it in another direction (the image path mirrored back) and gets its level and its highs from that
// angle: first-order pattern 0.65 + 0.35 cos (Q = 2.2 in the mids, back -10 dB) and a low-pass that closes towards the back.
// The diffuse tail gets the total power (1 / Q) and is a bit darker. Result: near the source the bright direct sound
// dominates, further away the darker room - distance is heard as in a real room (before: an omnidirectional source).
// (QDIR, the pattern and the source axis come from compute_geo: per source model, turned by SOURCE ANGLE)
QDIR = 1 / (0.65 * 0.65 + 0.35 * 0.35 / 3); lastdmd = -1; lastair = -1;
dirA = 0.65; dirN = 1; dirFl = 0.25; dirHb = 2500; dirShG = 0.5; dirBG = 0.29; srAx = 0; srAy = 1; srAz = 0;
// Source directivity gain for cosine c of the angle off axis: (a + (1-a) c)^n, never below the floor dirFl.
function dpat(c) ( max(dirFl, max(0, dirA + (1 - dirA) * c) ^ dirN); );
// kind: 0 = direct sound, 1 = image source, 2 = early cluster (diffuse: no directivity, the tail's 1 / Q already holds it)
function settap(k, ix, iy, iz, refl, hff, kind, trE, trF, trM)
local(ddx, ddy, ddz, hd, d3, dist, rel, lat, fwd, gg, fc, emx, emy, emz, eln, cse, isdir, dpv, fdir, fdst, itd, fshd, shA, dEL, dER)
(
  isdir = kind == 0;
  ddx = ix - lx; ddy = iy - ly; ddz = iz - lz;
  hd   = sqrt(ddx*ddx + ddy*ddy);
  d3   = sqrt(ddx*ddx + ddy*ddy + ddz*ddz);
  dist = max(0.25, d3);
  rel  = (hd > 0.001) ? atan2(ddy, ddx) - face : 0;
  lat  = (d3 > 0.001) ? min(1, max(-1, sin(rel) * hd / d3)) : 0;      // lateral component (+ = right)
  fwd  = (d3 > 0.001) ? cos(rel) * hd / d3 : 1;                       // front component (- = behind)
  gg   = refl * sqrt(trE) / dist;
// GROUND (free field): the floor image gets more weight than the plain 1 / distance law gives it (fourth root of the path ratio) -
  // close up, the ground reflection is then clearly audible (comb of hard ground, duller grass / snow); far away the law is the same
  isfree && slider119 >= 0.5 && tIZ[k] == -1 && tIX[k] == 0 && tIY[k] == 0 ? (
    fdst = max(0.25, sqrt(sqr(sx - lx) + sqr(sy - ly) + sqr(sz - lz)));
    gg = refl * sqrt(trE) / fdst * (fdst / dist) ^ 0.25 * exp(vopt[69] * 0.11512925);   // x Ground level (dB, vopt[69])
  );
  // directivity: angle between the direct path and the direction this path leaves the source
  cse = 1;
  kind < 2 ? (
    // direction this path leaves the source (the image path mirrored back) against the source axis
    emx = -ddx * ((abs(tIX[k]) % 2) ? -1 : 1); emy = -ddy * ((abs(tIY[k]) % 2) ? -1 : 1); emz = -ddz * ((abs(tIZ[k]) % 2) ? -1 : 1);
    rflOv ? ( emx = rflEx; emy = rflEy; emz = rflEz; );   // reflector: the path leaves the source towards the reflection point
    eln = sqrt(emx * emx + emy * emy + emz * emz);
    cse = eln > 0.001 ? min(1, max(-1, (emx * srAx + emy * srAy + emz * srAz) / eln)) : 1;
    dpv = dpat(cse);
    kind == 1 ? ( ceO += sqr(gg); ceD += sqr(gg * dpv); ceU += sqr(gg * dpv) * (1 - cse) / 2; );   // for the early cluster
    gg *= dpv;
  );
  // air absorption (ISO 9613-1, temperature + humidity): one-pole matched at 4 kHz; the walls' own highs per bounce (hff =
  // amplitude at 4 kHz / mid of all its bounces) as a second one-pole in cascade
  fc   = 4000 / sqrt(max(0.000001, 10 ^ (airdb4k * dist / 10) - 1));
// DISTANCE: beyond the ISO air absorption (small indoors) a gentle, perceptual high loss with distance - the way a
  // voice or a step sounds duller the further away it is (1 m: none, 4 m: -3 dB at 10 kHz, 16 m: at 5 kHz)
  kind < 2 ? ( fdst = 20000 / sqrt(max(1, dist)); fc = fc * fdst / sqrt(fc * fc + fdst * fdst); );
  !isdir && hff < 0.999 ? fc = 1 / sqrt(1 / sqr(fc) + (1 / sqr(max(0.05, hff)) - 1) / sqr(4000));
  fc   = isdir ? max(1000, fc) : max(500, fc);
  // scattering: no real wall is a perfect mirror for short waves - with every bounce part of the highs leaves the mirror
  // path and joins the reverb (about -1 dB at 4 kHz, -4.5 dB at 10 kHz per bounce)
  !isdir && tnb > 0 ? fc = max(800, 1 / sqrt(1 / sqr(fc) + tnb / sqr(7000)));
  fc   = min(0.45 * srate, fc * (1 - 0.35 * max(0, -fwd)));            // from behind: a bit darker
  // directivity of the highs: a low-pass whose corner falls the more the path leaves the source sideways / backwards
  // (dirHb = corner straight behind, twice that at 90 degrees, no effect on axis) - in Hz, the same at every sample rate
  kind < 2 ? ( fdir = dirHb / max(0.02, (1 - cse) / 2); fc = fc * fdir / sqrt(fc * fc + fdir * fdir); );
  kind == 2 && clFd > 0 ? ( fc = fc * clFd / sqrt(fc * fc + clFd * clFd); );   // early cluster: the mean of the reflections
  trF > 0 ? fc = fc * trF / sqrt(fc * fc + trF * trF);              // barrier: cascade of the two low-passes
  xA[k]  = exp(-2 * $pi * fc / srate);
  xSM[k]  = trF > 0 ? trM : 0;
  pang(lat); xGL[k] = gg * pgL; xGR[k] = gg * pgR;
// NEAR-FIELD ILD: close to the head the two ears are at clearly different distances (8.75 cm from the center each):
  // a source 30 cm to the right is 21 cm from the right ear and 39 cm from the left - 5 dB more level difference from the
  // distance alone, on top of pan law and head shadow. Far away both ratios go to 1 (nothing changes beyond ~2 m)
  k < NIMG ? ( dER = sqrt(dist * dist + 0.00766 - 0.175 * dist * lat); dEL = sqrt(dist * dist + 0.00766 + 0.175 * dist * lat);
    xGL[k] *= dist / max(0.05, dEL); xGR[k] *= dist / max(0.05, dER); );
  xDL[k] = xDR[k] = min(MAXIN - 4, dist / C_SND * srate);
// INTERAURAL TIME DIFFERENCE (also the second order, taps 7-24): the far ear hears the direct sound and the reflections later (up to 0.66 ms,
  // Woodworth for a head of 8.75 cm) - with the level difference this is what places a sound in the stereo field and makes a
  // movement sound like a movement
  k < NIMG ? ( itd = 0.00066 * lat * srate * 0.5; xDL[k] = min(MAXIN - 4, xDL[k] + itd); xDR[k] = min(MAXIN - 4, max(1, xDR[k] - itd));
// HEAD SHADOW: the far ear loses the highs - the head is in the way of short waves, not of long ones (a real head:
    // about 5 dB at 500 Hz, 20 dB at 8 kHz straight from the side). A one-pole low-pass on the far ear whose corner falls
    // with the lateral angle (20 kHz ahead, 3.5 kHz at 45 degrees, 2.2 kHz at the side) - the level difference is now
    // frequency dependent, as it is between two ears, and a sound moving past gets its direction from the highs as well
    fshd = 20000 / (1 + 8 * abs(lat) ^ 1.5); shA = exp(-2 * $pi * min(0.45 * srate, fshd) / srate);
    lat > 0 ? ( xHL[k] = shA; xHR[k] = 0; ) : ( xHL[k] = 0; xHR[k] = shA; );
  );
// PROXIMITY: the source ON the listener (linked) = the input as it is - gain 1 per channel, no ear timing, no head
  // shadow, no air / distance filter, no near-field lows, no bass steering; pulled apart, these cues fade in over the first
  // meter (smooth, no step). Every parameter goes to its neutral value on its own - no blend of two signals, so no comb.
  // Delay: 1 sample + the real distance (+ the ear timing, never below 1 sample: the cubic read needs one sample of past)
  isdir ? (
    pbD = min(1, d3 / 1.0); pbD = pbD * pbD * (3 - 2 * pbD);
    xGL[k] = 1 + (xGL[k] - 1) * pbD; xGR[k] = 1 + (xGR[k] - 1) * pbD;
    xA[k] *= pbD; xHL[k] *= pbD; xHR[k] *= pbD;
    itd = 0.00066 * lat * srate * 0.5 * pbD;
    xDL[k] = min(MAXIN - 4, 1 + d3 / C_SND * srate + itd + abs(itd)); xDR[k] = min(MAXIN - 4, 1 + d3 / C_SND * srate - itd + abs(itd));
  );
  pro_on ? vbap5(k, isdir ? 1 + (gg - 1) * pbD : gg, rel, d3 > 0.001 ? hd / d3 : 1);   // RoomservicePro: the same path, panned for the loudspeakers (the source on the listener: gain 1, as in stereo)
  tapT[k] = dist / C_SND * 1000;
  tapG[k] = gg;
);

// image coordinate along one axis (room length L, source at s) for image index i; wall hits near (0) / far (L)
function imgc(i, L, sp) ( (abs(i) % 2) ? (i + 1) * L - sp : i * L + sp; );
// Number of hits on the near wall for image index i (floor(i/2) for i>=0, ceil(-i/2) for negative).
function hitN(i) ( i >= 0 ? floor(i / 2) : ceil(-i / 2); );
// Number of hits on the far wall for image index i (ceil(i/2) for i>=0, floor(-i/2) for negative).
function hitF(i) ( i >= 0 ? ceil(i / 2) : floor(-i / 2); );

// Recomputes all room geometry and acoustics from the sliders: sizes, absorption, RT60 per band, image sources, taps, filters and loudness trims.
function compute_geo()
local(hfW, hfE, hfN, hfS, hfFl, fcturn, k, ddx, ddy, g0, gh, lsum, gm, ghm, gkey, base, ds, hfr, lfP, lfQ, rtt, rpx, rpy, rpz, rhit, bfl, bcmp, mg, dirg, fcg, pre, hr, hc, hB, ix, iy, iz, rf, hf, px, py, pz, pV, pS2, pA, qV, qS, qA, rtL, rtQ, rcS, rcP, bshare, pcx, pcz, pD, AeP, AeQ, base2, gkey2, plat, dq, clt, clw, cldist, clhf, ecW, clA, clB, srL, srA0, srAng, airkey, dmd)
(
  rs = min(4, max(0.25, slider31));
  roomW = max(0.8, slider2) * rs; roomD = max(0.8, slider3) * rs; roomH = max(0.8, slider4) * rs;
  isfree = slider1 >= 0.5;
  aN = min(1, max(0.01, slider5)); aE = min(1, max(0.01, slider6));
  aS = min(1, max(0.01, slider7)); aW = min(1, max(0.01, slider8));
  aF = min(1, max(0.01, slider9));
  // REFLECTIVITY: how much all surfaces reflect, relative to their materials - 200 % = half the absorption (livelier, longer),
  // 50 % = twice the absorption (drier, shorter); walls, floor + ceiling, back part alike, so the room keeps its character
  rflf = 100 / min(400, max(25, slider62));
  aN = min(0.99, max(0.005, aN * rflf)); aE = min(0.99, max(0.005, aE * rflf)); aS = min(0.99, max(0.005, aS * rflf));
  aW = min(0.99, max(0.005, aW * rflf)); aF = min(0.99, max(0.005, aF * rflf));
  // air: absorption per band from temperature and humidity (energy constants m for RT60, dB/m at 4 kHz for the reflections)
  airT = 20; airH = 50;                                                 // air: 20 C, 50 % (ISO 9613-1)
  airkey = airT * 1000 + airH;
  airkey != lastair ? (
    airm125 = airdb(125, airT, airH) / 4.343; airm5 = airdb(500, airT, airH) / 4.343;
    airdb4k = airdb(4000, airT, airH); airm4k = airdb4k / 4.343; lastair = airkey;
    k = 0; loop(8, airOB[k] = airdb(62.5 * 2 ^ k, airT, airH) / 4.343; k += 1; );   // the 8 octave bands once (they were computed on every geometry change)
  );
  // source directivity of the selected model
  dmd = slider85 >= 0.5 ? min(12, max(0, floor(slider35 + 0.5))) : 0;   // source model off: radiates like the Original
  dmd != lastdmd ? (
    dirA = dtab[dmd * 5]; dirN = dtab[dmd * 5 + 1]; dirFl = dtab[dmd * 5 + 2]; dirHb = dtab[dmd * 5 + 3]; dirShG = dtab[dmd * 5 + 4];
    // Q = 2 / integral of p^2 sin(theta) over 0 … pi (numerically)
    dq = 0; k = 0; loop(90, dq += sqr(dpat(cos((k + 0.5) * $pi / 90))) * sin((k + 0.5) * $pi / 90) * $pi / 90; k += 1; );
    QDIR = 2 / max(0.01, dq);
    dirBG = max(0, sqrt(QDIR / 1.3) - 1);                           // nearly round in the bass: give the power back below ~250 Hz
    lastdmd = dmd;
  );
  mg = 0.1;
// MOTION: the pattern position blended in (mtE = 0 … 1: the glide in / out), the sliders stay the center
  sx = slider10 * rs; sy = slider11 * rs; sz = slider12; lx = slider13 * rs; ly = slider14 * rs; lz = slider15;
  mtSon ? ( sx += (mtSX * rs - sx) * mtE; sy += (mtSY * rs - sy) * mtE; sz += (mtSZ - sz) * mtE; );
  mtLon ? ( lx += (mtLX * rs - lx) * mtE; ly += (mtLY * rs - ly) * mtE; lz += (mtLZ - lz) * mtE; );
  sx = min(max(sx, mg), roomW - mg); sy = min(max(sy, mg), roomD - mg);
  // heights: the acoustic center of an ear or a loudspeaker lying on the floor is still about 10 cm above it. Exactly on the
  // floor the direct sound and its floor reflection would arrive at the very same instant and double at EVERY frequency -
  // that only happens for a microphone built into the surface
  sz = min(max(sz, mg), roomH - mg);                 // heights are absolute meters: SIZE scales the room, not the people in it
  lx = min(max(lx, mg), roomW - mg); ly = min(max(ly, mg), roomD - mg);
  lz = min(max(lz, mg), roomH - mg);

  // SOURCE AXIS, turned by SOURCE ANGLE around the vertical (+ = to the source's left).
  // Fixed (default): the source points in one direction of the room (0 = towards the front wall), like a real loudspeaker
  // or actor - walk behind it and you hear its back. Listener: it always aims at the listener (0 = at the listener).
  slider63 >= 0.5 ? ( srAx = 0; srAy = 1; srAz = 0; ) : (
    srAx = lx - sx; srAy = ly - sy; srAz = lz - sz; srL = sqrt(srAx * srAx + srAy * srAy + srAz * srAz);
    srL > 0.001 ? ( srAx /= srL; srAy /= srL; srAz /= srL; ) : ( srAx = 0; srAy = 1; srAz = 0; );
  );
  srAng = min(180, max(-180, slider61)) * $pi / 180;
  srA0 = srAx; srAx = srA0 * cos(srAng) - srAy * sin(srAng); srAy = srA0 * sin(srAng) + srAy * cos(srAng);
  slider16 < 0.5 ? (
    ddx = sx - lx; ddy = sy - ly;
    face = (abs(ddx) + abs(ddy) > 0.0001) ? atan2(ddy, ddx) : -$pi / 2;
    fcturn = 1;                                                       // (with a barrier between: turned to the opening, below)
  ) : (
    face = (slider17 - 90) * $pi / 180;
  );

  // ---- barrier geometry (absolute meters, scaled with SIZE like all positions) ----
  bt = bgoff ? 0 : floor(slider41 + 0.5); bon = bt > 0;                      // also in the free field: a free-standing wall W x H
  ybm = min(0.3, 0.25 * roomD);                                     // margin to back / front wall (smaller in tiny rooms)
  yb = min(max(slider42 * rs, ybm), roomD - ybm);
  bopen = min(1, max(0, slider43 / 100)); bdamp = min(70, max(0, slider44));
  // DAMP is the installed value (R'w at 500 Hz: gaps and side paths included) - what you set is what you get.
  // Around a door / window: an interior brick wall, R'w 45 dB
  bmixk = min(1, max(0, slider92 / 100));                               // MIX of the barrier: share of its damping
  dEl = bdamp * bmixk; dWall = (bt == 1 ? bdamp : 45) * bmixk;
  // SHELF of the partition (see bxing): corner + share of the highs, fitted to typical measured sound transmission loss
  // (125 Hz - 4 kHz, relative to 500 Hz) of the three materials of each type - DAMP between two of them = in between (log),
  // outside = the nearest. Relative to 500 Hz (125 / 250 / 1k / 2k / 4k):
  //   drywall +10 / +5 / -4 / -5 / -6   brick +9 / +5 / -6 / -10 / -13   concrete +11 / +6 / -6 / -11 / -14
  //   single glazing +7 / +4 / -3 / -4 / -4   double +6 / +4 / -4 / -8 / -10   acoustic glazing +8 / +5 / -5 / -9 / -10
  //   doors without seals (hollow-core, heavy wood): +5 / +2 / -1 / -2 / -2 - the gaps pass the highs, so a closed
  //   ordinary door is hardly darker above 1 kHz;   acoustic door (seals) +9 / +5 / -4 / -6 / -6
  // per type (bt 3 door, 2 window, else wall; materials in the order of the legend above): bsh0..2 = DAMP (dB) of the 3 materials, bf0..2 = shelf corner (Hz), bm0..2 = share of the highs that passes above the corner (linear)
  bt == 3 ? ( bsh0 = 17; bsh1 = 25; bsh2 = 37; bf0 = 158; bf1 = 93; bf2 = 113; bm0 = 0.378; bm1 = 0.323; bm2 = 0.119; ) : (
  bt == 2 ? ( bsh0 = 24; bsh1 = 30; bsh2 = 39; bf0 = 192; bf1 = 262; bf2 = 146; bm0 = 0.130; bm1 = 0.050; bm2 = 0.080; ) : (
              bsh0 = 38; bsh1 = 45; bsh2 = 55; bf0 = 30; bf1 = 133; bf2 = 65; bm0 = 0.020; bm1 = 0.045; bm2 = 0.020; ); );
  // COINCIDENCE (glass, gypsum board): around the frequency where the bending waves of the pane match the sound in air the
  // partition lets clearly more through - a peak on the transmitted sound (frequency, Q, gain dB) per material:
  //   single glazing 4 mm 4.5 kHz +12 dB (Q 3), double glazing 4 kHz +9 dB (Q 3), laminated: damped (none);
  //   drywall 2.5 kHz +7 dB (Q 1.2); masonry, concrete and doors: below the audio band / no effect
  //   (fitted with the shelf to the transmission-loss curves: single glazing 125 Hz - 4 kHz within 0.3 dB, double within 2.3 dB)
  bt == 2 ? ( pf0 = 4500; pq0 = 3; pg0 = 12; pf1 = 4000; pq1 = 3; pg1 = 9; pf2 = 4000; pq2 = 3; pg2 = 0; ) : (
  bt == 1 ? ( pf0 = 2500; pq0 = 1.2; pg0 = 7; pf1 = 2500; pq1 = 1.2; pg1 = 0; pf2 = 2500; pq2 = 1.2; pg2 = 0; ) : (
              pf0 = pf1 = pf2 = 3000; pq0 = pq1 = pq2 = 1; pg0 = pg1 = pg2 = 0; ); );
  // bsht = position between the 3 materials (0 = first, 1 = second, 2 = third) from DAMP; below, corner and highs share are interpolated geometrically, peak Q and dB linearly
  bsht = bdamp <= bsh0 ? 0 : (bdamp >= bsh2 ? 2 : (bdamp < bsh1 ? (bdamp - bsh0) / (bsh1 - bsh0) : 1 + (bdamp - bsh1) / (bsh2 - bsh1)));
  bsht < 1 ? ( bfEl = bf0 * (bf1 / bf0) ^ bsht; bmEl = bm0 * (bm1 / bm0) ^ bsht; ) : ( bfEl = bf1 * (bf2 / bf1) ^ (bsht - 1); bmEl = bm1 * (bm2 / bm1) ^ (bsht - 1); );
  bsht < 1 ? ( bpkF = pf0 * (pf1 / pf0) ^ bsht; bpkQ = pq0 + (pq1 - pq0) * bsht; bpkG = pg0 + (pg1 - pg0) * bsht; )
           : ( bpkF = pf1 * (pf2 / pf1) ^ (bsht - 1); bpkQ = pq1 + (pq2 - pq1) * (bsht - 1); bpkG = pg1 + (pg2 - pg1) * (bsht - 1); );
  bt == 1 ? ( bfWl = bfEl; bmWl = bmEl; ) : ( bfWl = 133; bmWl = 0.045; );   // the wall itself / the brick wall around a door or window
  bmixk < 1 ? ( bmEl = 1 - (1 - bmEl) * bmixk; bmWl = 1 - (1 - bmWl) * bmixk; ); bpkG *= bmixk;            // mix < 100 %: less of the highs held back
  // BARRIER SIZE: width x height of the partition (0 = wall to wall / floor to ceiling). It stands on the floor, centered at
  // its X position (the door / window stays inside it). Beside and above it the sound passes freely and bends around its
  // free edges; the gap also couples the two parts of the room (opening area).
  brW = slider95 > 0.001 ? min(roomW, max(0.3, slider95 * rs)) : roomW; brH = slider96 > 0.001 ? min(roomH, max(0.3, slider96 * rs)) : roomH;
  brC = min(max(slider45 * rs, brW / 2), roomW - brW / 2); brX0 = brC - brW / 2; brX1 = brC + brW / 2;
  // DOOR / WINDOW SIZE (slider 97, 50 … 200 %): the door 0.9 x 2.1 m grows from the floor, the window 1.2 x 1.2 m around its
  // center 1.5 m above the floor - the opening, the coupling of the two parts and the sound through it follow
  besz = min(2, max(0.5, slider97 / 100));
  bt == 3 ? ( bew = 0.9 * besz; bez0 = 0; bez1 = min(2.1 * besz, brH - 0.05); ) : (
    bt == 2 ? ( bew = 1.2 * besz; bez0 = min(1.5 - 0.6 * besz, brH - 0.05 - 0.6 * besz); bez1 = min(bez0 + 1.2 * besz, brH - 0.05); ) : ( bew = 0; bez0 = bez1 = 0; );
  );
  bew = min(bew, brW - 0.1); bez0 = max(0, bez0); bez1 = max(bez0 + 0.1, bez1);   // element never larger than the wall (tiny rooms)
  bex = min(max(slider45 * rs, brX0 + bew / 2 + 0.05), brX1 - bew / 2 - 0.05); bex0 = bex - bew / 2; bex1 = bex + bew / 2;
  brHX = brX1 - 0.08 * brW;                                          // depth handle (top edge, right)
  brEon = bew > 0 || brW < roomW - 0.01; brEX = bew > 0 ? bex : brC; brEZ = bew > 0 ? bez1 : brH;   // side handle: element or partition
  brMG = brW < roomW - 0.01 ? brW / 2 : bew / 2 + 0.05;            // how close the side handle gets to the walls
  sideS = sy >= yb; sideL = ly >= yb; bsame = sideS == sideL;
  // opening: door = gap between frame and leaf edge (chord 2 w sin(phi/2), leaf turns on the left hinge, up to 90 degrees)
  //          window = two casement sashes, hinged left and right (each: chord w/2 x 2 sin(phi/2), up to its width)
  bphi = bopen * 0.5 * $pi;
  bt == 3 ? ( ax1 = bex1; ax0 = bex1 - min(bew, 2 * bew * sin(0.5 * bphi)); az0 = bez0; az1 = bez1; ) : (
    bt == 2 ? ( ax0 = bex - min(bew / 2, bew * sin(0.5 * bphi)); ax1 = 2 * bex - ax0; az0 = bez0; az1 = bez1; ) : ( ax0 = ax1 = az0 = az1 = 0; );
  );
  aarea = bon ? max(0, (ax1 - ax0) * (az1 - az0)) : 0;
  asz = min(1, aarea / 0.49);                                   // openings smaller than ~0.7 x 0.7 m pass less
  // gap around a smaller partition (left, right, above): open area, its center (energy-weighted with the opening)
  brGL = bon ? brX0 * roomH : 0; brGR = bon ? (roomW - brX1) * roomH : 0; brGT = bon ? brW * (roomH - brH) : 0; brGA = brGL + brGR + brGT;
// a gap narrower than the wavelength couples less - per gap w f / c at 500 Hz (a 5 cm slit along the ceiling: 7 %, 40 cm: 58 %)
  brGSl = min(1, brX0 * 500 / C_SND); brGSr = min(1, (roomW - brX1) * 500 / C_SND); brGSt = min(1, (roomH - brH) * 500 / C_SND);
  brOA = aarea + brGA;
