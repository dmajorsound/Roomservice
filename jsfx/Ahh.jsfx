  sprintf(#snh, "Snapshot %d", snk + 1); col(cTEXT, 1); gfx_setfont(2); txt(#snh, snpx + 12, snpy + 15, 0); snhw = tws(#snh);
  col(cMUTED, 1); gfx_setfont(7); txt(uslot[snk * USL] ? "stored" : "empty", snpx + 18 + snhw, snpy + 15, 0);
