);   // end of the room (skipped while it is not heard)
wi += 1; wi >= MAXIN ? wi = 0;
xfade > 0 ? xfade = max(0, xfade - xfstep);
xfcnt += 1; cXR += ((xfade > 0 ? xfR : 1) - cXR) * sm5;

