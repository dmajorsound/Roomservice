// Clears the smooth-stroke buffer (sdN = 0) before collecting strokes for SDDRAW.
function SDB0() ( sdN = 0; );
// stroke record (8 slots in SDFBUF): line = [0, x1, y1, x2, y2], arc = [1, cx, cy, rad, a1, a2]; all in screen pixels
// Adds a line stroke (design units, stored in screen pixels) to the stroke buffer SDFBUF; ignored beyond 10 strokes.
function SDSEG(x1, y1, x2, y2) ( sdN < 10 ? ( SDFBUF[sdN * 8] = 0; SDFBUF[sdN * 8 + 1] = gox + x1 * gs; SDFBUF[sdN * 8 + 2] = goy + y1 * gs; SDFBUF[sdN * 8 + 3] = gox + x2 * gs; SDFBUF[sdN * 8 + 4] = goy + y2 * gs; sdN += 1; ); );
// Adds an arc stroke (center x,y, radius rad, angles a1..a2, 0 = up, clockwise) to the stroke buffer SDFBUF; max 10 strokes.
function SDARC(x, y, rad, a1, a2) ( sdN < 10 ? ( SDFBUF[sdN * 8] = 1; SDFBUF[sdN * 8 + 1] = gox + x * gs; SDFBUF[sdN * 8 + 2] = goy + y * gs; SDFBUF[sdN * 8 + 3] = rad * gs; SDFBUF[sdN * 8 + 4] = a1; SDFBUF[sdN * 8 + 5] = a2; sdN += 1; ); );
// Renders all buffered strokes at width wd as anti-aliased pixels by distance to the nearest stroke, in the current color, then empties the buffer.
function SDDRAW(wd) local(w, x0, y0, x1, y1, k, b, px, py, d, dd, qvx, qvy, t, r, al, cv, ex, ey, ux, uy, l2)
(
  w = wd * gs; al = gfx_a; x0 = 100000; y0 = 100000; x1 = -100000; y1 = -100000; k = 0;
  loop(sdN, b = SDFBUF + k * 8;
    b[0] == 0 ? ( x0 = min(x0, min(b[1], b[3])); x1 = max(x1, max(b[1], b[3])); y0 = min(y0, min(b[2], b[4])); y1 = max(y1, max(b[2], b[4])); )
              : ( x0 = min(x0, b[1] - b[3]); x1 = max(x1, b[1] + b[3]); y0 = min(y0, b[2] - b[3]); y1 = max(y1, b[2] + b[3]); );
    k += 1; );
