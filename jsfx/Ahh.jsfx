// GROUND of the free field: Off / Hard / Grass / Snow (the reflection from the ground under source and listener)
function grndseg(x, y, w) local(g)
(
  g = floor(slider119 + 0.5); gfx_setfont(4); col(cMUTED, 1); txt("Ground", x, y + 8, 0);
