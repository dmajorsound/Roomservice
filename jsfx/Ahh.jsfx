      );
    );
    kchg = 1;
  );
  mouse_wheel != 0 && hit && !(mouse_cap & 1) ? ( nf = deg + mouse_wheel / 120 * (sh ? 0.1 : 1); wheelused = 1; kchg = 1; );
  nf = nf - 360 * floor((nf + 180) / 360);                        // -180 … 180
  kmapT = -1; kmapS = 1;
  nf;
);
// knob size of a section: 1 = the standard size of the view; a taller (and wide enough) section draws its knobs larger -
// ring, value and name (the name grows a little less). kscale(1) after the section.
function kscale(k) (
  KSC = max(1, min(2, k));
  KSC > 1.001 ? (
    KR = KR0 * KSC; KLW = KLW0 * KSC; KNS = 1 + (KSC - 1) * 0.6;
    FS15 = fsz(KVF0) * KSC; FS16 = FS4 * KNS; gfx_setfont(15, "Arial", FS15, 'b'); gfx_setfont(16, "Arial", FS16); KVF = 15; KNF = 16;
  ) : ( KSC = 1; KR = KR0; KLW = KLW0; KNS = 1; KVF = KVF0; KNF = 4; );
);
// vertical room (each side of a knob row) -> knob scale
function kfit(sp) ( 1 + max(0, sp - 2) / (KR0 + 5); );
// Basic: one knob size for the whole row of cards - the card with the least room decides
function kbrow() ( min(min((bwR - 20) / 3 / (2 * KR0 + 12), (bwB - 125) / (2 * KR0)), min(2 * floor((bwO - 20) / 4) / (2 * KR0 + 12), kfit((vopt[32] + bfill) * 0.25))); );
// MIX of a module (heading, Expert): small ring + "Amount 100%" (Tabs) or just "100%" (All) - drag up / down (Shift = fine), wheel, double-click = 100 %
function hmix(id, x, yc, si, c, tip) local(v, f, nf, hit, t)
(
  v = slider(si); f = min(1, max(0, v / 100)); hit = inbox(x - 3, yc - 8, 76, 16);
  mmCur >= 0 && abs(mmB[mmCur * 5 + 1] - yc) < 6 ? ( mmB[mmCur * 5] = x - 8; );   // the header's level meter: left of the ring
  col(cHAIR, 1); ARC(x + 6, yc, 5.5, -0.75 * $pi, 0.75 * $pi, 2);
  f > 0.004 ? ( col(c, 1); ARC(x + 6, yc, 5.5, -0.75 * $pi, -0.75 * $pi + 1.5 * $pi * f, 2); );
  col(hit || kdrag == id ? cTEXT : (f < 0.999 ? c : cMUTED), 1); gfx_setfont(6);
  sprintf(#hmx, tabm ? "Amount %.0f%%" : "%.0f%%", v); txt(#hmx, x + (tabm ? 15 : 40), yc, 0);   // All: the ring and the number only (more room in the heading)
  nf = f; kchg = 0;
  ((click && (mouse_cap & 36)) || rclick) && hit ? ( kmap(0, 0, 100, 1); vedopen(id, #hmx); click = 0; rclick = 0; );
  vedPend && vedId == id ? ( kmap(0, 0, 100, 1); nf = vedmap(vedVal); kchg = 1; vedPend = 0; kmapT = -1; );
  vedit == id ? vedplace(x + 30, yc, 56);
  click && hit ? (
    t = time_precise();
    (mouse_cap & 16) ? ( nf = 1; kdrag = 0; lastkid = -1; kchg = 1; ) :
    (lastkid == id && t - lastkt < 0.5) ? ( kmap(0, 0, 100, 1); vedopen(id, #hmx); kmapT = -1; lastkid = -1; ) : ( kdrag = id; kmy = my; kf0 = f; lastkid = id; kmv = 0; );
    lastkt = t; click = 0;
  );
  kdrag == id && !kmv && abs(kmy - my) > 2 ? ( kmv = 1; kmy = my; );
  kdrag == id && kmv ? ( nf = min(1, max(0, kf0 + (kmy - my) / ((mouse_cap & 8) ? 600 : 150))); kchg = 1; );
  mouse_wheel != 0 && hit && !(mouse_cap & 1) ? ( nf = min(1, max(0, f + mouse_wheel / 120 * 0.02)); wheelused = 1; kchg = 1; );
  kchg ? setp(si, nf * 100);
  tipbox(x - 3, yc - 8, 60, 16, tip);
);
// horizontal slider (Drive): drag left / right (Shift = fine), wheel, double-click = default
function hsl(id, x, y, w, nm, vs, f, fdef, c) local(nf, t, hit)
(
  cCTLon ? ( c = cCTL; );
  col(cMUTED, 1); gfx_setfont(4); txt(nm, x, y, 0);
  col(cTEXT, 1); gfx_setfont(2); txt(vs, x + w, y, 2);
  col(cHAIR, 1); RR(x, y + 7, w, 3, 1.5);
  f > 0.004 ? ( col(c, 1); RR(x, y + 7, max(3, w * f), 3, 1.5); );
  col(cDIM2, 1); R(x + w * fdef - 0.5, y + 4, 1, 9);                 // default mark (0 dB …)
  col(c, 1); CIF(x + w * f, y + 8.5, 3.8, 1);
  nf = f; kchg = 0;
  hit = inbox(x - 5, y - 6, w + 10, 20);
