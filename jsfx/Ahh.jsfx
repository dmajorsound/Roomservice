fbp[fwi] = cTH * f1 + sn * s1 - inj; fbp += LINEMAX;
fbp[fwi] = cTH * f2 + sn * s2 + inj; fbp += LINEMAX;
fbp[fwi] = cTH * f3 + sn * s3 + inj; fbp += LINEMAX;
fbp[fwi] = cTH * f4 + sn * s4 - inj; fbp += LINEMAX;
fbp[fwi] = cTH * f5 + sn * s5 + inj; fbp += LINEMAX;
fbp[fwi] = cTH * f6 + sn * s6 - inj; fbp += LINEMAX;
