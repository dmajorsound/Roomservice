// fold an unfolded (image-space) coordinate back into the room 0 .. L
function fold(u, L) local(m) ( m = u - floor(u / (2 * L)) * 2 * L; m <= L ? m : 2 * L - m; );
function foldsg(u, L) local(m) ( m = u - floor(u / (2 * L)) * 2 * L; m <= L ? 1 : -1; );   // +1 = this image cell is not mirrored
