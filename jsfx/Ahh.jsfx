    eMd == 4 ? setp(3, min(40, max(0.8, dD0 + edm / rs))) : eMd == 5 ? setp(2, min(40, max(0.8, dW0 + edm / rs))) : (eMd == 2 || eA == 2 ? setp(4, min(15, max(0.8, dH0 + edm / rs))) : (
    eA == 0 ? setp(2, min(40, max(0.8, dW0 + edm / rs))) : setp(3, min(40, max(0.8, dD0 + edm / rs))); ); ); );
  );
  // ROOM CORNER: scale k along the line origin -> corner (the back left floor corner stays where it is)
  drag == 12 ? (
    cux = (cnI == 2 ? dW0 * drs0 * dpS0 : 0) + dD0 * drs0 * dpKX0; cuy = dD0 * drs0 * dpKY0;
    cl2 = max(1, cux * cux + cuy * cuy);
    (mouse_cap & 4) ? (
      // Ctrl / Cmd: the whole room in proportion
      ck = 1 + (((mx - dvx0) * cux + (my - dvy0) * cuy) / cl2) * dmfine;
      ck = min(min(40 / dW0, 40 / dD0), min(15 / dH0, max(0.8 / max(dW0, max(dD0, dH0)), ck)));
      ckx = max(0.8, dW0 * ck) / dW0; cky = max(0.8, dD0 * ck) / dD0; ckz = max(0.8, dH0 * ck) / dH0;
    ) : (mouse_cap & 16) ? (
      // Alt: the height - up = higher (plan: the same, the height is not drawn there)
      ckx = cky = 1; ckz = min(15, max(0.8, dH0 + (dvy0 - my) * dmfine / (dpSZ0 > 0 ? dpSZ0 : dpS0) / drs0)) / dH0;
    ) : (
      // free: right = wider, left = narrower; down = deeper, up = shallower (each side 0.8 … 40 m)
      ckx = min(40, max(0.8, dW0 + (mx - dvx0) * dmfine / dpS0 / drs0)) / dW0;
      cky = min(40, max(0.8, dD0 + (my - dvy0) * dmfine / dpKY0 / drs0)) / dD0; ckz = 1;
    );
    setp(2, dW0 * ckx); setp(3, dD0 * cky); setp(4, dH0 * ckz);
    !lockS ? ( setp(10, dSX0 * ckx); setp(11, dSY0 * cky); setp(12, dSZ0 * ckz); );      // everything inside scales with the room (per axis)
    mtEg > 0.001 ? ( mtC0x = dMC0x * ckx; mtC0y = dMC0y * cky; mtC1x = dMC1x * ckx; mtC1y = dMC1y * cky; MTAP[2] >= 0.5 ? ( MTAP[0] = dAP0x * ckx; MTAP[1] = dAP0y * cky; ); );   // a placed Own spot scales with it // a running motion scales with it
    !lockL ? ( setp(13, dLX0 * ckx); setp(14, dLY0 * cky); setp(15, dLZ0 * ckz); );
    !lockB ? ( setp(42, dBP0 * cky); ); !lockE ? ( setp(45, dBE0 * ckx); );
    isfree ? (   // the two reflectors keep their place, length, angle and height when the area changes (they used to scale with it and moved) - only kept inside the area
      fsI = 0;
      loop(2,
        fsO = RFB + fsI * 6; fsB = dRfl + fsI * 6;
        vopt[fsO + 1] = min(max(0.8, slider2) * min(4, max(0.25, slider31)) * 1.25, fsB[1]); vopt[fsO + 2] = min(max(0.8, slider3) * min(4, max(0.25, slider31)) * 1.25, fsB[2]);
        fsI += 1;
      );
    );
// no value box - the measures are on the room (dimension lines, wall notes)
  );
  drag == 7 ? setp(2, min(40, max(0.8, dvv0 + (mx - dvx0) / dpS0 / rs * dmfine)));
  drag == 8 ? setp(3, min(40, max(0.8, dvv0 + (sidevOn ? (mx - dvx0) / dpKX0 : (my - dvy0) / dpKY0) / rs * dmfine)));
  drag == 9 ? setp(4, min(15, max(0.8, dvv0 + (dvy0 - my) / dpSZ0 / rs * dmfine)));
  // the new value beside the mouse while dragging
  drag == 11 && eMd == 3 ? ( sprintf(#etip, "Size %.2f×", slider31); tipon = 1; tipforce = 1; tipstr = #etip; tipx = mx; tipy = my - 20; );   // only the size factor (it is not drawn on the room); the other dimensions show on the room's labels
  !(drag == 1 || drag == 2) && !mmdrag ? ( axOn = 0; );             // (a new drag starts a new line)
  (drag == 1 || drag == 2) ? (
    sidevOn ? (   // side view - the mouse sets the depth and the height, left / right stays; front view: left / right and the height, the depth stays
      nz = min(max((pY0 - my) / pSZ, 0), roomH - 0.1);
      frontv ? moveobj(drag == 1 ? 1 : 2, (mx - pX0) / pS / rs, (drag == 1 ? sy : ly) / rs) : moveobj(drag == 1 ? 1 : 2, (drag == 1 ? sx : lx) / rs, (mx - pX0) / pKX / rs);
      moveobjz(drag == 1 ? 1 : 2, nz);
    ) : (mouse_cap & 8) && !planv ? (
      !zmode ? ( zmode = 1; dmy0 = my; dz0 = drag == 1 ? sz : lz; );
      nz = min(max(dz0 - (my - dmy0) / pSZ, 0), roomH - 0.1);
      moveobjz(drag == 1 ? 1 : 2, nz);
    ) : (
      zmode = 0;
      zz = drag == 1 ? sz : lz;
      iy = (my + zz * pSZ - pY0) / pKY; ix = (mx - pX0 - iy * pKX) / pS;
      ix = ix / rs; iy = iy / rs;                                    // clamped in moveobj (the listener: walls, see lis_walk)
      axcon(drag, ix, iy, 6); ix = axNX; iy = axNY;                 // Ctrl/Cmd: on a line only (left / right or forward / back)
      moveobj(drag == 1 ? 1 : 2, ix, iy);
      axOn ? (
        // the guide line(s) through where it was when the key went down, at its height, across the whole room
        col(drag == 1 ? cSRC : cLIS, 1);
        axA != 2 ? ( PJ(0, axY0 * rs, zz); axq0 = qx; axq1 = qy; PJ(roomW, axY0 * rs, zz); DL(axq0, axq1, qx, qy, 5, 4, axA ? 1.4 : 0.8); );
        axA != 1 ? ( PJ(axX0 * rs, 0, zz); axq0 = qx; axq1 = qy; PJ(axX0 * rs, roomD, zz); DL(axq0, axq1, qx, qy, 5, 4, axA ? 1.4 : 0.8); );
        tipon = 1; tipforce = 0; tipx = mx; tipy = my - 22;
        tipstr = axA == 1 ? "On a line: left / right only (Ctrl/Cmd)" : (axA == 2 ? "On a line: forward / back only (Ctrl/Cmd)" : "On a line – move the mouse along the one you want");
      );
    );
  );
  drag == 4 ? ( iy = sidevOn ? (mx - pX0) / pKX : (my + brH * pSZ - pY0) / pKY; setp(42, min(max(iy, ybm), roomD - ybm) / rs); );
  drag == 5 ? ( ix = (mx - pX0 - yb * pKX) / pS; setp(45, min(max(ix, brMG), roomW - brMG) / rs); );
  drag == 6 ? setp(43, min(100, max(0, dop0 + (dmy0 - my) / 1.2)));      // Shift+drag up = open (120 px = 0 … 90°)
  drag == 10 ? (
    iy = (my + sz * pSZ - pY0) / pKY; ix = (mx - pX0 - iy * pKX) / pS;
    abs(ix - sx) + abs(iy - sy) > 0.05 ? (
      slider63 < 0.5 ? setp(63, 1);
      setp(61, atan2(-(ix - sx), iy - sy) * 180 / $pi);
    );
  );
  drag == 3 ? (
    iy = (my + lz * pSZ - pY0) / pKY; ix = (mx - pX0 - iy * pKX) / pS;
    deg = atan2(iy - ly, ix - lx) * 180 / $pi + 90;
    deg > 180 ? deg -= 360;
    slider16 < 0.5 ? ( slider16 = 1; autom(32768); );
    setp(17, deg);
  );
) : (
  drag == 20 ? mtfinish();
  drag = 0; kdrag = 0; eqdrag = 0; wbdrag = 0; swDrag = 0;
  memset(gheld, 0, SLOTS);
  i = 1; loop(NSL, gtouch[i] ? ( sauto_end(i); gtouch[i] = 0; ); i += 1; );   // ...and the touch sessions end
);
);
// TIMELINE and RT60 PER OCTAVE: the analysis tabs of the room view (Expert)
// LEARN: a line between two points that stops g1 / g2 short of its ends - the paths leave the S and L balls with a small gap,
// so the letters stay readable
LGAP = 16;
function LNGAP(x1, y1, x2, y2, g1, g2, w) local(d, ux, uy)
(
  d = sqrt(sqr(x2 - x1) + sqr(y2 - y1));
  d > g1 + g2 + 2 ? ( ux = (x2 - x1) / d; uy = (y2 - y1) / d; LNW(x1 + ux * g1, y1 + uy * g1, x2 - ux * g2, y2 - uy * g2, w); );
);
function gfxpT()
(
// ---- ECHOGRAM: the room over time ----
vtab == 2 || lrnTL ? (
!lrnTL ? ( EX = VX; EY = VY + 8; EW = VW; EH = VH - 8; );
(
  ppx = EX + 30; ppy = EY + 58; ppw = EW - 40; pph = EH - 80;
  // HEAR: direct / early / late - click = only this one (again: all three), Shift+click = on / off (the chips are the legend of the colors)
  ehm = vopt[18]; gk = 0;
  loop(3,
    hcx = EX + 10 + gk * 44; hon = !(ehm & (2 ^ gk)); hrcol = gk == 0 ? cSRC : (gk == 1 ? cRMTT : cRVTT);
    chip(hcx, EY + 24, 42, 14, gk == 0 ? "Direct" : (gk == 1 ? "Early" : "Late"), hon, hrcol) ? (
      (mouse_cap & 8) ? ( vopt[18] = (ehm & (2 ^ gk)) ? ehm - 2 ^ gk : ehm + 2 ^ gk; ) : ( vopt[18] = ehm == 7 - 2 ^ gk ? 0 : 7 - 2 ^ gk; );
    );
    tipbox(hcx, EY + 24, 42, 14, gk == 0 ? "Direct sound – click: hear only this (again: all three) · Shift+click: on / off · monitor only: not saved, ends when the window closes" : (gk == 1 ? "Early reflections, the first echoes from the walls – click: hear only these (again: all three) · Shift+click: on / off · monitor only: not saved, ends when the window closes" : "Late reverb, the diffuse tail – click: hear only the tail (again: all three) · Shift+click: on / off · monitor only: not saved, ends when the window closes"));
    gk += 1;
  );
// dB range of the plot: DBT = top, DBB = bottom; tlate = where the late tail starts (ms)
DBT = 6; DBB = -60;
tlate = (brd + mfp) / C_SND * 1000;
tmax = 2000;   // fixed window (sqrt time axis): the axis never moves, only the bars and the tail change
col(cINK, 0.06);
gi = 0; loop(3, gy = ppy + (DBT + gi * 30) / (DBT - DBB) * pph; LN(ppx, gy, ppx + ppw, gy); gi += 1; );
col(cMUTED, 1); gfx_setfont(4);
gi = 0; loop(3, gy = ppy + (DBT + gi * 30) / (DBT - DBB) * pph; sprintf(#w1, "%d", -gi * 30); txt(#w1, ppx - 4, gy, 2); gi += 1; );
txt("0", ppx, ppy + pph + 10, 0);
col(cINK, 0.08); gx = ppx + sqrt(10 / tmax) * ppw; LN(gx, ppy, gx, ppy + pph); gx2 = ppx + sqrt(100 / tmax) * ppw; LN(gx2, ppy, gx2, ppy + pph); gx3 = ppx + sqrt(1000 / tmax) * ppw; LN(gx3, ppy, gx3, ppy + pph);
col(cMUTED, 1); txt("10", gx, ppy + pph + 10, 1); txt("100", gx2, ppy + pph + 10, 1);
txt("1000 ms", gx3, ppy + pph + 10, 1);
!isfree ? (
  cfade = (ehm & 4) ? 0 : 1;                        // tail switched off (HEAR): not drawn
  // el0 holds the level (dB) of the late tail at its start tlate (diffuse-field estimate from RT60 and critical distance, plus the slider21 offset); it then falls 60 dB per RT60
  el0 = 10 * log10(13.8 / (rt * rc * rc) * 0.001) + 10 * log10(max(0.000001, latecorr)) + slider21;
  col(cAMB, 0.18);
  gi = 0;
  loop(ppw,
    tt = sqr(gi / ppw) * tmax;
    tt >= tlate ? (
      ldb = el0 - 60 * (tt - tlate) / (rt * 1000);
      ldb > DBB ? ( gy = ppy + (DBT - min(DBT, ldb)) / (DBT - DBB) * pph; R(ppx + gi, gy, 1, ppy + pph - gy); );
    );
    gi += 1;
  );
  col(cAMB, 1);
  tend = min(tmax, tlate + rt * 1000 * (el0 - DBB) / 60);
  gi = 0;
  tlate < tmax ? loop(40,
    tt = tlate + (tend - tlate) * gi / 40; tt2 = tlate + (tend - tlate) * (gi + 1) / 40;
    tx1 = ppx + sqrt(tt / tmax) * ppw; ty1 = ppy + (DBT - min(DBT, max(DBB, el0 - 60 * (tt - tlate) / (rt * 1000)))) / (DBT - DBB) * pph;
    tx2 = ppx + sqrt(tt2 / tmax) * ppw; ty2 = ppy + (DBT - min(DBT, max(DBB, el0 - 60 * (tt2 - tlate) / (rt * 1000)))) / (DBT - DBB) * pph;
    LNW(tx1, ty1, tx2, ty2, 1.4);
    gi += 1;
  );
  // density: the tail drawn as impulses – few tall echoes at low density, many small ones at high density
  dn_ = min(1, max(0, slider38 / 100)); nimp = floor(8 + dn_ * 72);
  col(cAMB, 0.28 + 0.4 * (1 - dn_));
  gi = 0;
  loop(nimp,
    // deterministic jitter so the pattern is stable; spacing shrinks with density
    tt = tlate + (tend - tlate) * ((gi + 0.5 + 0.35 * sin(gi * 12.9898)) / nimp);
    tt > tlate && tt < tmax ? (
      edb = el0 - 60 * (tt - tlate) / (rt * 1000) - (1 - dn_) * 4 * abs(sin(gi * 7.7));
      gx = ppx + sqrt(tt / tmax) * ppw; gy = ppy + (DBT - min(DBT, max(DBB, edb))) / (DBT - DBB) * pph;
      LNW(gx, ppy + pph, gx, gy, dn_ > 0.6 ? 0.8 : 1.4);
    );
    gi += 1;
  );
  // neighbor room (2nd network): dashed tail with its own level and RT60
  xLG2 > 0 ? (
    l2 = 10 * log10(max(0.0000000001, 13.8 * 0.001 / rt2 * bE2)) + slider21; t2 = xLD2 / srate * 1000;
    col(cLIS, 0.9);
    tend2 = min(tmax, t2 + rt2 * 1000 * (l2 - DBB) / 60);
    t2 < tmax && l2 > DBB ? (
      gi = 0;
      loop(24,
        tt = t2 + (tend2 - t2) * gi / 24; tt2 = t2 + (tend2 - t2) * (gi + 1) / 24;
        (gi & 1) == 0 ? (
          tx1 = ppx + sqrt(tt / tmax) * ppw; ty1 = ppy + (DBT - min(DBT, max(DBB, l2 - 60 * (tt - t2) / (rt2 * 1000)))) / (DBT - DBB) * pph;
          tx2 = ppx + sqrt(tt2 / tmax) * ppw; ty2 = ppy + (DBT - min(DBT, max(DBB, l2 - 60 * (tt2 - t2) / (rt2 * 1000)))) / (DBT - DBB) * pph;
          LNW(tx1, ty1, tx2, ty2, 1.2);
        );
        gi += 1;
      );
    );
    gfx_setfont(4); sprintf(#w1, "next room %.2f s", rt2); txt(#w1, ppx + ppw, ppy + 8, 2);
  );
  cfade = 1;
  gfx_setfont(1); sprintf(#w1, "RT60 %.2f s", rt); col(cAMB, 1); txt(#w1, EX + EW - 10, EY + 31, 2);
  col(cMUTED, 1); gfx_setfont(4); sprintf(#w1, "density %.0f %%", slider38);
  sprintf(#w2, "   bass %.2f s   4 kHz %.2f s", min(20, rt * lfrP), rt * hfrP); strcat(#w1, #w2);
  mdN > 0 && !isfree ? ( sprintf(#w2, "   modes up to %.0f Hz", mdFc); strcat(#w1, #w2); );
  txt(#w1, EX + EW - 10, EY + 44, 2);
  gi = 1;
  loop(NT - 1,
    !(ehm & 2) && tapOn[gi] && tapT[gi] < tmax ? (
      edb = dbs(tapG[gi] * erg);
      gx = ppx + sqrt(tapT[gi] / tmax) * ppw; gy = ppy + (DBT - min(DBT, max(DBB, edb))) / (DBT - DBB) * pph;
      col(cRMTT, gi <= 6 ? 1 : 0.5); LNW(gx, ppy + pph, gx, gy, gi <= 6 ? 1.6 : 1);   // 1st order bright, 2nd order faint
    );
    gi += 1;
  );
);
rbyp ? ( col(cSURF, 0.9); R(ppx + 1, ppy, ppw, pph); col(cMUTED, 1); gfx_setfont(4); txt("stereo panner only", ppx + ppw, ppy + 8, 2); );
!(ehm & 1) ? (
  edb = dbs(tapG[0]);                         // direct sound incl. a barrier in the way
  gx = ppx + sqrt(tapT[0] / tmax) * ppw; gy = ppy + (DBT - min(DBT, max(DBB, edb))) / (DBT - DBB) * pph;
  col(cSRC, 1); LNW(gx, ppy + pph, gx, gy, 2);
);
// DELAY echoes (magenta): each one reaches the listener like the source - direct path + echo time, at the echo's level
gdon && !rbyp ? (
  egL = slider77 <= -47.9 ? 0 : 10 ^ (slider77 / 20); egR = gdlv ? egL : (slider78 <= -47.9 ? 0 : 10 ^ (slider78 / 20)); gdmL ? ( egL = 0; ); gdmR ? ( egR = 0; ); efL = slider75 / 100; efR = gdlf ? efL : slider76 / 100;
  gk = 0; ett = 0; evL = 1; enL = 0; enR = 0;
  loop(60,
    gdpp ? ( ech = gk % 2; ett += ech == 0 ? gtL : gtR; eamp = ech == 0 ? egL * evL : egR * evL; ech == 1 ? ( evL *= sqrt(efL * efR); ); )
         : ( ech = gk % 2; ech == 0 ? ( enL += 1; ett = enL * gtL; eamp = egL * efL ^ (enL - 1); ) : ( enR += 1; ett = enR * gtR; eamp = egR * efR ^ (enR - 1); ); );
    etx = tapT[0] + ett; edb = dbs(tapG[0] * eamp);
    etx < tmax && edb > DBB ? (
      gx = ppx + sqrt(etx / tmax) * ppw; gy = ppy + (DBT - min(DBT, max(DBB, edb))) / (DBT - DBB) * pph;
      col(cDLS, 1); LNW(gx, ppy + pph, gx, gy, 1.6); CI(gx, gy, 1.8, 1);
    );
    gk += 1;
  );
  chip(EX + 10 + 3 * 44, EY + 24, 42, 14, "Delay", 1, cDLS);
  tipbox(EX + 10 + 3 * 44, EY + 24, 42, 14, "Magenta: the delay echoes as they reach the listener (direct path + echo time) – switch the delay in its section");
);
);
);
// ---- DECAY BY BAND: reverb time per octave as the reverb engine plays it (its loop filters), room modes below their limit ----
vtab == 3 && !lrnTL ? (
dbx0 = VX; dbw0 = VW; dkY = VY + 4; dkH = VH - 4;
(
  dbpx = dbx0 + 40; dbpw = floor((dbw0 - 52) * 0.6); dbpy = dkY + 38; dbph = dkH - 82;
  dbix = dbpx + dbpw + 26; dbiw = dbx0 + dbw0 - 12 - dbix;
  isfree || rbyp ? (
    col(cMUTED, 1); gfx_setfont(4); txt(isfree ? "Free field: no walls – no reverb" : "Room off – no reverb", dbx0 + dbw0 / 2, dkY + dkH / 2 + 6, 1);
  ) : (
    k = 0; dbvmx = 0.05;
    loop(8, rtbv[k] = rtband(62.5 * 2 ^ k); dbvmx = max(dbvmx, rtbv[k]); k += 1; );
    // grid step (s) picked from the tallest bar so the axis gets a handful of lines; dbtop = axis top, the next step above the tallest bar + 10 %
    dbst = dbvmx > 8 ? 4 : (dbvmx > 4 ? 2 : (dbvmx > 2 ? 1 : (dbvmx > 1 ? 0.5 : (dbvmx > 0.4 ? 0.2 : 0.1))));
    dbtop = ceil(dbvmx * 1.1 / dbst) * dbst;
    gi = 0;
    loop(floor(dbtop / dbst + 0.5) + 1,
      gv = gi * dbst; gy = dbpy + dbph - gv / dbtop * dbph;
      col(cHAIR, 1); LN(dbpx, gy, dbpx + dbpw, gy);
      col(cMUTED, 1); gfx_setfont(7); sprintf(#w1, dbst < 1 ? "%.1f" : "%.0f", gv); txt(#w1, dbpx - 5, gy, 2);
      gi += 1;
    );
    col(cMUTED, 1); gfx_setfont(7); txt("s", dbpx - 5, dbpy - 12, 2);
    dbbw = dbpw / 8; k = 0;
    loop(8,
      dbmd = mdN > 0 && 62.5 * 2 ^ k < mdFc;                         // below the modes' limit: the room's own tones
      dbbh = min(1, rtbv[k] / dbtop) * dbph; dbbx = dbpx + k * dbbw + dbbw * 0.18;
      col(dbmd ? cSRTT : cRVTT, 1); RR(dbbx, dbpy + dbph - max(2, dbbh), dbbw * 0.64, max(2, dbbh), 2.5);
      col(cTEXT, 1); gfx_setfont(7); sprintf(#w1, rtbv[k] < 9.95 ? "%.2f" : "%.1f", rtbv[k]); txt(#w1, dbbx + dbbw * 0.32, dbpy + dbph - max(2, dbbh) - 7, 1);
      col(cMUTED, 1); txt(k == 0 ? "63" : (k == 1 ? "125" : (k == 2 ? "250" : (k == 3 ? "500" : (k == 4 ? "1k" : (k == 5 ? "2k" : (k == 6 ? "4k" : "8k")))))), dbbx + dbbw * 0.32, dbpy + dbph + 9, 1);
      k += 1;
    );
    txt("Hz", dbpx + dbpw + 3, dbpy + dbph + 9, 0);
    tipbox(dbpx, dbpy - 6, dbpw, dbph + 18, "Reverb time RT60 per octave band – exactly what the reverb engine plays (walls, materials, air). Green = room modes: below that frequency a small room rings on its own tones");
    dby2 = dkY + dkH - 13;
    mdN > 0 ? sprintf(#w2, "room modes – below %.0f Hz", mdFc) : strcpy(#w2, "no room modes (large room)");
    col(cSRTT, 1); RR(dbpx, dby2 - 4, 8, 8, 2); col(cMUTED, 1); gfx_setfont(7); txt(#w2, dbpx + 12, dby2, 0); dblw = tws(#w2);
    col(cRVTT, 1); RR(dbpx + 26 + dblw, dby2 - 4, 8, 8, 2); col(cMUTED, 1); txt("diffuse reverb", dbpx + 38 + dblw, dby2, 0);
    // the numbers that explain the bars
    dbry = dbpy + 2; gi = 0;
    loop(5,
      gi == 0 ? ( strcpy(#w1, "RT60 (mid)"); sprintf(#w2, "%.2f s", rt); ) : (
      gi == 1 ? ( strcpy(#w1, "Room volume"); dbvv = roomW * roomD * roomH; sprintf(#w2, dbvv < 100 ? "%.1f m³" : "%.0f m³", dbvv); ) : (
      gi == 2 ? ( strcpy(#w1, "Mean free path"); sprintf(#w2, "%.2f m", mfp); ) : (
      gi == 3 ? ( strcpy(#w1, "Critical distance"); sprintf(#w2, "%.2f m", rc * sqrt(QDIR)); ) : (
                ( strcpy(#w1, "Modes up to"); mdN > 0 ? sprintf(#w2, "%.0f Hz", mdFc) : strcpy(#w2, "–"); ) ))));
      col(cMUTED, 1); gfx_setfont(4); txtfit(#w1, dbix, dbry, dbiw - 46);
      col(cTEXT, 1); gfx_setfont(2); txt(#w2, dbix + dbiw, dbry, 2);
      gi < 4 ? ( col(cHAIR, 1); LN(dbix, dbry + 9, dbix + dbiw, dbry + 9); );
      dbry += 18; gi += 1;
    );
    tipbox(dbix, dbpy - 6, dbiw, 92, "Mean free path = average way of the sound between two reflections; critical distance = where direct sound and room sound are equally loud; modes = the room's own resonances (Schroeder frequency)");
  );
);
);
);
// =================== LEARN MODE (GUI only - the sound is exactly the same as in Expert) ===================
// text that wraps at width w (line height lh), current font and color; returns the height used
function wrapt(s, x, y, w, lnh) local(n, i, c, ly)
(
  strcpy(#wsrc, s); n = strlen(#wsrc); strcpy(#wln, ""); strcpy(#wwd, ""); ly = y; i = 0;
  loop(n + 1,
    c = i < n ? str_getchar(#wsrc, i) : 32;
    c == 32 ? (
      strcpy(#wtry, #wln); strlen(#wtry) > 0 ? strcat(#wtry, " "); strcat(#wtry, #wwd);
      tws(#wtry) > w && strlen(#wln) > 0 ? ( txt(#wln, x, ly, 0); ly += lnh; strcpy(#wln, #wwd); ) : ( strcpy(#wln, #wtry); );
      strcpy(#wwd, "");
    ) : ( sprintf(#wch, "%c", c); strcat(#wwd, #wch); );
    i += 1;
  );
  strlen(#wln) > 0 ? ( txt(#wln, x, ly, 0); ly += lnh; );
  ly - y;
);
// ---- PLUGIN HELP (the Help button in the top bar): how roomservice works and the most used keys, one page; a click
// beside it or Esc closes it, "All keys and mouse actions" opens the keys page ----
function hlpsec(x, y, w, hd, bd) local(h) (
  col(cTEXT, 1); gfx_setfont(2); txt(hd, x, y, 0);
  col(cMUTED, 1); gfx_setfont(13); h = wrapt(bd, x, y + 16, w, 15);
  h + 30;
);
// Draws the 'how it works' help popup in one or two columns; its 'All keys and mouse actions' button opens the keys page
function hlpdraw() local(cw, two, cx, cy, hpch, x1, x2, w1, y, ya, yb)
(
  cw = min(WT - 24, 780); two = cw >= 640; hpch = min(HT - 24, max(200, hlpH + 54));
  // (the only thing that changes on this page: the button at its end under the mouse)
  pgopen(1, cw, hpch, max(hlpH, 100), "Ahh! – how it works", 0) ? (
  cx = pgCX; cy = pgBY - 44;
  w1 = two ? cw / 2 - 34 : cw - 40; x1 = cx + 20; x2 = two ? cx + cw / 2 + 14 : x1;
  y = cy + 54;
  y += hlpsec(x1, y, w1, "Signal flow", "In → Filter → Source → Delay → Room → Barrier → Out. The strip under the top bar shows the chain: click a module = on / off, Shift+click = solo, hear it alone.");
  y += hlpsec(x1, y, w1, "Three views", "Basic: film locations as tiles, room, decay, source and barrier at a glance – a hint in the strip shows Expert settings that still change the sound. Expert: the Stage View on top, one module per tab under it ([ and ] = previous / next) – or All = every module at once (key 0). Learn: ten listening tasks that explain what you hear.");
  y += hlpsec(x1, y, w1, "Room and positions", "Choose a room preset or one of My rooms. Drag source and listener in the plan (Shift+drag = height, 3D shows it; Ctrl/Cmd+drag = only left / right or only forward / back, a dashed line shows it). Reset positions = both back to their start places (listener in the middle, source 2 m in front), the room stays. Loading a room preset keeps source and listener in the same place relative to the room as long as you have not moved them; moved or locked positions stay. Drag the front corner = the room larger or smaller (Ctrl/Cmd = in proportion, Alt = height). Mouse wheel on the floor = zoom the view 0.1 … 5x (in and out); the chips Fit and 1:1 fit the whole room / area or go back. With the room off the direct sound still follows the positions (a 3D panner: direction, distance, height), only walls and reverb are gone. Direction (Expert): Src angle and Lis angle dials, or Alt+drag a ball to turn it; Aim = where the source points (Fixed or at the listener), Facing = where the listener looks (Fixed, at the source or along its path). The round arrows next to Aim and Facing reset them; double-click the listener's arrow (or Alt+double-click the source) = the listener looks straight ahead again. Doppler (chip beside Handles): on = a drag glides the pitch like a real move, off = only the distance changes.");
  y += hlpsec(x1, y, w1, "Free field", "Outdoors: no walls, no reverb – only the direct sound, the ground and two reflectors. Ground: Off, Hard, Grass or Snow, its strength with Ground level. Area width and depth = how far source and listener can move. The reflectors R1 and R2 (facade, glass, rock, fence, hedge): drag their dot or panel in the Stage View to move them, Alt+drag turns them, the small square at the panel's end sets the length and, in 3D, the one on the top edge the height; the knobs are in the Reflectors tab, its round button switches both on / off; they keep their place when the area changes. A reflector larger than the view: Fit (or the wheel on the floor, out to 10 %) shows all of it. All reflector values can be automated.");
  y += hlpsec(x1, y, w1, "Barrier", "A wall, a window or a door between source and listener: Pos, Size, Height, Open and Damp. The thin line around the room modules marks what belongs to the room.");
  y += hlpsec(x1, y, w1, "Delay and tempo", "The delay sits before the room – every echo is reverberated too. Tempo tools: tap, listen to the song or use the project tempo; a note value sets the delay at once. A click on Link links or unlinks all.");
  y += hlpsec(x1, y, w1, "Output", "In and Out = gain before and after the plugin. Dry / wet = the mix. Limiter = a look-ahead peak limiter at -1 dBFS (1.5 ms latency, REAPER compensates it) – a safety net, not a loudness tool. Equal loudness = every room, distance and model plays about as loud as the input, for comparing sounds.");
  ya = y; y = two ? cy + 54 : y;
  y += hlpsec(x2, y, w1, "Four ways to keep a sound", "A / B = compare quickly while you work (not saved; Match level plays both equally loud). Snapshots 1–16 = saved in this project: click = load, Save then a slot = store (a slot in use asks once), right-click = rename / overwrite / clear, keys 1–8 and Shift+1–8 (Tabs view: Shift+1–8 only, 1–8 open the tabs, 0 = All); Snapshot Morph blends them and can be automated. Room presets = typical rooms for every project. My rooms = your own rooms, kept on this computer.");
  y += hlpsec(x2, y, w1, "Motion (Expert)", "Moves the source, the listener or both on a pattern: Circle or Square (around the listener, its own spot or the room center), Left – right, Front – back, Up – down, Wave, a Drawn path (Draw: draw it in the Stage View) or Pass-by (once along a straight line through its own spot, A to B in one cycle time – the status shows the speed in m/s; it starts again with every playback start and loop). Rate in Hz or locked to the tempo (bars and notes), Size in meters, Start = where it begins, Glide = fade in / out. It runs with REAPER's transport, so every playback sounds the same; free-running while stopped. On / off, pattern, rate and size are automatable and stored in snapshots and A / B. The positions are written to the Source / Listener X, Y and height parameters, so REAPER can record the movement as automation (Write or Latch); an envelope in read mode on them overrides the pattern. The Stage View draws the path; Stop on its sign switches it off.");
  y += hlpsec(x2, y, w1, "Layout", "Drag the edges and corners of the modules and the column divider. Tabs: drag the corner of the module = larger / smaller (double-click = automatic), the bar over the tabs = height of the Stage View, Fit = the module as large as the window allows. Fit all = every module in the window, Lock GUI = the layout stays. V hides the Stage View, the magnifier enlarges a module – or key Z: in Tabs the open module, in All / Fit the module or the Stage View under the mouse (Z again or Esc = back).");
  y += hlpsec(x2, y, w1, "Most used keys", "1 … 9 tabs (Tabs view) or snapshots  ·  Ctrl/Cmd+Z undo  ·  arrows move the listener  ·  [ ] tabs  ·  0 Tabs / All  ·  Z zoom  ·  V Stage View  ·  Esc closes  ·  hold Ctrl/Cmd = help text under the mouse  ·  ? every key");
  yb = max(ya, y) + 4;
  // the keys page (its screen place is kept for the click test at the start of the next frame)
  hlpYr = yb - pgBY; hlpH = hlpYr + 10;                                               // the body as tall as its text (next frame)
  );
  pgclose();
  // "All keys and mouse actions": in the page's fixed head, top right beside the close button - no scrolling needed
  hkbx = pgCX + cw - 36 - 180; hkby = pgCY + 6;
  col(inbox(hkbx, hkby, 180, 20) ? cHAIR : cLINE, 1); RR(hkbx, hkby, 180, 20, 6); col(cTEXT, 1); gfx_setfont(6); txt("All keys and mouse actions", hkbx + 90, hkby + 10, 1);
  hkX0 = gox + hkbx * gs; hkX1 = hkX0 + 180 * gs; hkY0 = goy + hkby * gs; hkY1 = hkY0 + 20 * gs;   // (screen place for the click test)
  // "Read manual": opens the manual on dmajorsound.com in the browser (the host does it, see mango)
  mnbx = hkbx - 8 - 96;
  col(inbox(mnbx, hkby, 96, 20) ? cHAIR : cLINE, 1); RR(mnbx, hkby, 96, 20, 6); col(cTEXT, 1); gfx_setfont(6); txt("Read manual", mnbx + 48, hkby + 10, 1);
  mnX0 = gox + mnbx * gs; mnX1 = mnX0 + 96 * gs;
  tipbox(mnbx, hkby, 96, 20, "Opens the Ahh! manual on dmajorsound.com in your browser");
);
// a label in the room view: title in its color, one line below; kept inside the view
LBB = 4194304 + 44200;   // labels already placed in this frame (x, y, w) - a new one moves out of their way
// Draws a two-line label box in the plan view, nudged to avoid overlapping other labels and kept inside the view
function lbox(x, y, t1, t2, c) local(w, w2, k, b, mv, n)
(
  gfx_setfont(6); w = tws(t1); gfx_setfont(7); w2 = tws(t2); w = max(w, w2) + 14;
  x = min(max(x, VX + 6), VX + VW - w - 6); y = min(max(y, VY + 28), VY + VH - 52);
  n = 0; mv = 1;
  while ( mv && n < 6 ? (
    mv = 0; k = 0;
    loop(lbN, b = LBB + k * 3;
      x < b[0] + b[2] + 4 && b[0] < x + w + 4 && y < b[1] + 34 && b[1] < y + 34 ? (
        y = b[1] + 34 + 34 <= VY + VH - 22 ? b[1] + 36 : b[1] - 36; mv = 1; );
      k += 1; );
    n += 1; 1; ) : 0; );
  lbN < 6 ? ( b = LBB + lbN * 3; b[0] = x; b[1] = y; b[2] = w; lbN += 1; );
  col(cSURF, 1); RR(x, y, w, 30, 5); col(c, 1); RRO(x, y, w, 30, 5);
  gfx_setfont(6); txt(t1, x + 7, y + 9, 0); col(cMUTED, 1); gfx_setfont(7); txt(t2, x + 7, y + 21, 0);
);
// labels in the plan: critical distance, direct sound, the strongest first reflection (+ mirror source), reverb
function lanno() local(lrc, dx1, dy1, lbk, lbg, k, t, rpx, rpy, msx, msy, rx, ry)
(
  lbN = 0;
  !isfree ? (
    lrc = rc * sqrt(QDIR);
    col(cCRV, 0.85); floorring(sx, sy, lrc, 1);
    // the SOURCE label is an obstacle; the box sits at the upper left of the circle (on the right when there is no room)
    PJ(sx, sy, 0); LBB[0] = qx - 34; LBB[1] = qy - 36; LBB[2] = 68; lbN = 1;
    sprintf(#lw1, "Critical distance %.1f m", lrc); gfx_setfont(7); lbw = tws("inside: the direct sound is louder than the reverb") + 14;
    PJ(sx, sy, 0); msx = qx; msy = qy;
    PJ(max(0, sx - lrc * 0.707), max(0, sy - lrc * 0.707), 0);
    rx = qx - lbw - 6 < VX + 6 ? qx + 2 * (lrc * 0.707) * pS + 6 : qx - lbw - 6; ry = qy - 34;
// near the back wall the box landed on the source ball - then it goes to the right of the circle, level with the ball
    rx < msx + 16 && rx + lbw > msx - 16 && ry < msy + 14 && ry + 30 > msy - 14 ? ( PJ(sx + lrc, sy, 0); rx = qx + 8; ry = msy - 14; rx + lbw > VX + VW - 6 ? ( PJ(sx - lrc, sy, 0); rx = qx - lbw - 8; ); );
    lbox(rx, ry, #lw1, "inside: the direct sound is louder than the reverb", cCRV);
  );
  // the strongest first-order wall reflection (one open room)
  !isfree && !bon ? (
    lbk = 0; lbg = 0; k = 1;
    loop(4,                                                         // the strongest one that is not on the line source - listener
      k == 1 ? ( t = sy / max(0.001, sy + ly); rpx = sx + (lx - sx) * t; rpy = 0; ) : ( k == 2 ? ( t = (roomW - sx) / max(0.001, 2 * roomW - sx - lx); rpx = roomW; rpy = sy + (ly - sy) * t; ) :
      ( k == 3 ? ( t = (roomD - sy) / max(0.001, 2 * roomD - sy - ly); rpx = sx + (lx - sx) * t; rpy = roomD; ) : ( t = sx / max(0.001, sx + lx); rpx = 0; rpy = sy + (ly - sy) * t; ); ); );
      abs((lx - sx) * (rpy - sy) - (ly - sy) * (rpx - sx)) / max(0.01, sqrt(sqr(lx - sx) + sqr(ly - sy))) > 0.3 && tapOn[k] && tapG[k] > lbg ? ( lbg = tapG[k]; lbk = k; );
      k += 1;
    );
    lbk > 0 ? (
      lbk == 1 ? ( t = sy / max(0.001, sy + ly); rpx = sx + (lx - sx) * t; rpy = 0; msx = sx; msy = -sy; strcpy(#lw3, "back wall"); ) :
      lbk == 2 ? ( t = (roomW - sx) / max(0.001, 2 * roomW - sx - lx); rpx = roomW; rpy = sy + (ly - sy) * t; msx = 2 * roomW - sx; msy = sy; strcpy(#lw3, "right wall"); ) :
      lbk == 3 ? ( t = (roomD - sy) / max(0.001, 2 * roomD - sy - ly); rpx = sx + (lx - sx) * t; rpy = roomD; msx = sx; msy = 2 * roomD - sy; strcpy(#lw3, "front wall"); ) :
                 ( t = sx / max(0.001, sx + lx); rpx = 0; rpy = sy + (ly - sy) * t; msx = -sx; msy = sy; strcpy(#lw3, "left wall"); );
      PJ(sx, sy, 0); dx1 = qx; dy1 = qy; PJ(rpx, rpy, 0); rx = qx; ry = qy;
      col(cRMTT, 1); LNGAP(dx1, dy1, rx, ry, LGAP, 0, 1.1); PJ(lx, ly, 0); LNGAP(rx, ry, qx, qy, 0, LGAP, 1.1); CIF(rx, ry, 2.5, 1);
      PJ(msx, msy, 0);
      qx > VX + 10 && qx < VX + VW - 10 && qy > VY + 30 && qy < VY + VH - 30 ? (
        col(cRMTT, 0.75); DL(rx, ry, qx, qy, 4, 4, 1.2); DL(qx - 6, qy - 6, qx + 6, qy - 6, 2, 2, 1); DL(qx + 6, qy - 6, qx + 6, qy + 6, 2, 2, 1);
        DL(qx + 6, qy + 6, qx - 6, qy + 6, 2, 2, 1); DL(qx - 6, qy + 6, qx - 6, qy - 6, 2, 2, 1);
        gfx_setfont(7); txt("mirror source", qx + 10, qy, 0);
      );
      strcpy(#lw1, "1st reflection – "); strcat(#lw1, #lw3);
      sprintf(#lw2, "+%.1f ms after the direct sound · %.0f dB", max(0, tapT[lbk] - tapT[0]), 20 * log10(max(0.000001, lbg) / max(0.000001, tapG[0])));
      lbox(rx + 10, ry + 8, #lw1, #lw2, cRMTT);
    );
  );
  // the direct sound
  PJ(sx, sy, 0); dx1 = qx; dy1 = qy; PJ(lx, ly, 0);
  col(cSRC, 1); LNGAP(dx1, dy1, qx, qy, LGAP, LGAP, 1.3);
  sprintf(#lw2, "%.1f m · arrives after %.1f ms · %.0f dB", rdir, tapT[0], 20 * log10(max(0.000001, tapG[0])));
  lbox((dx1 + qx) / 2 + 14, (dy1 + qy) / 2 + 6, "Direct sound", #lw2, cSRC);
  // the reverb: in the corner of the room
  !isfree ? (
    PJ(0, roomD, 0); sprintf(#lw2, "thousands of reflections, after about %.0f ms – RT60 %.2f s", (brd + mfp) / C_SND * 1000, rt);
    lbox(qx + 10, qy - 44, "Reverb – from everywhere", #lw2, cAMB);
  );
);
// ---- tasks ----
function ltitle(t) (
  t == 0 ? "How far away is the voice?" : (t == 1 ? "Why does a small room sound boxy?" : (t == 2 ? "Hard walls, soft walls" : (t == 3 ? "What makes a room sound big?" :
  (t == 4 ? "A voice behind a door" : (t == 5 ? "Turn the speaker away" : (t == 6 ? "Three parts of every sound" : (t == 7 ? "A phone call in a car" :
  (t == 8 ? "Why does a passing car change its pitch?" : "Sound bends around a wall"))))))));
);
// Returns the text of step j (0..2) of Learn task t (the instruction shown in the Your turn panel)
function lstep(t, j) (
  t == 0 ? ( j == 0 ? "Drag the listener close to the source – closer than 1 m." : (j == 1 ? "Now drag it far away – more than 4 m." : "Listen: what changes besides the loudness? Tick it.") ) : (
  t == 1 ? ( j == 0 ? "Make the room smaller than 3 × 3 m – drag its front corner in the Stage View." : (j == 1 ? "Drag the listener into a corner, close to two walls." : "Listen to the bass: does it get boomier? Tick it.") ) : (
  t == 2 ? ( j == 0 ? "Turn α walls to 0.45 or more (like heavy curtains)." : (j == 1 ? "Watch What you hear: RT60 falls below 0.3 s." : "Listen to the end of a word: what is missing now? Tick it.") ) : (
  t == 3 ? ( j == 0 ? "Turn Size to 3× or more." : (j == 1 ? "In What you hear the gap between the green line and the first blue lines grows. Tick it." : "Listen: does it sound bigger, or only longer? Tick it.") ) : (
  t == 4 ? ( j == 0 ? "Switch the door on (Door below)." : (j == 1 ? "Drag source and listener to different sides of the wall." : "Open the door to more than 45°.") ) : (
  t == 5 ? ( j == 0 ? "Turn Src angle until the source looks away from the listener (about 180°)." : (j == 1 ? "Listen: darker and further away? Tick it." : "Turn it back until it faces the listener again.") ) : (
  t == 6 ? ( j == 0 ? "In What you hear play only Early: switch Direct and Late off." : (j == 1 ? "Now play only Late – the reverb tail." : "Switch all three on again.") ) : (
  t == 7 ? ( j == 0 ? "Load the room Car (button below)." : (j == 1 ? "Switch the source to Telephone (button below)." : "Listen: which part tells you car, which part phone? Tick it.") ) : (
  t == 8 ? ( j == 0 ? "Switch Pass-by on (button below): the source runs along a line past the listener." : (j == 1 ? "Listen as it passes: the pitch drops, and the sound moves from one ear to the other. Tick it." : "Make it faster: Duration 1 s or less – the pitch jump grows.") ) : (
           ( j == 0 ? "Switch the wall on (Wall below) – it stands between source and listener." : (j == 1 ? "Make it lower: Height 1.2 m (knob below) – the sound comes over the top." : "Listen: the treble comes back first, the bass stays muffled? Tick it.") ) )))))))));
);
// Returns the explanation text of Learn task t (what happens and why)
function lwhat(t) (
  t == 0 ? "Close up, the direct sound is much louder than the room: dry and present. Far away it drops 6 dB per doubling of the distance while the reverb stays almost the same – the voice sinks into the room. On the dashed circle both are equally loud." : (
  t == 1 ? "In a small hard room a few bass notes fit exactly between the walls and ring on – room modes. In a corner they are all at their loudest. Big rooms have so many modes that they melt into a smooth reverb." : (
  t == 2 ? "Soft surfaces swallow part of the sound at every bounce, so the reverb dies faster and gets darker – the room sounds dry like a vocal booth. Hard tiles and glass reflect almost everything and keep it ringing." : (
  t == 3 ? "The time between the direct sound and the first reflections tells your brain how far away the walls are. A big room has a long gap and a long reverb – together they sound big. A long reverb alone only sounds like a hard room." : (
  t == 4 ? "A closed door lets only part of the sound through, mostly the bass – the voice gets quiet and muffled. Open, the sound comes through the opening and bends around its edges: louder, clearer, and it seems to come from the door." : (
  t == 5 ? "Voices and loudspeakers send the treble mainly forward, the bass in all directions. Turned away, you hear less direct treble and more room – darker and further away, even at the same distance." : (
  t == 6 ? "The direct sound tells where the source is, the early reflections the size and shape of the room, the reverb how big and how hard it is. In a film mix these three parts are often shaped separately." :
  t == 7 ? "The tiny, soft car gives almost no reverb – only very early reflections that color the voice. The telephone cuts the bass below 300 Hz and the treble above 3.4 kHz. Both together: a call from a car." : (
  t == 8 ? "Three things happen at once. Doppler: while the source comes closer, each wave arrives a little earlier than the last – the pitch is higher; moving away, lower. At 5 m/s that is only 1.5 %, at 30 m/s (a car) 9 % – a whole tone. Direction: the ear nearer to the source hears it up to 0.7 ms earlier and louder, the head shadows the treble on the far side – this is what moves the sound across the stereo field. Distance: level and treble rise as it comes close and fall again." :
           "A wall stops the straight path, but sound bends around edges – the lower the frequency (the longer the wave), the better. Over a low wall the bass arrives almost as if there were no wall, the treble is shadowed. Through the wall itself only the bass gets through: everything behind a wall sounds muffled, and a lowered wall gives the treble back first.")))))));
);
// a step: 1 = done now, 0 = not yet, -1 = you tick it yourself (listening)
function lcond(t, j) local(dx, dy, dln, c)
(
  t == 0 ? ( j == 0 ? rdir < 1 : (j == 1 ? rdir > 4 : -1) ) : (
  t == 1 ? ( j == 0 ? roomW < 3.05 && roomD < 3.05 : (j == 1 ? (lx < 0.7 || lx > roomW - 0.7) && (ly < 0.7 || ly > roomD - 0.7) : -1) ) : (
  t == 2 ? ( j == 0 ? min(min(slider5, slider6), min(slider7, slider8)) >= 0.445 : (j == 1 ? rt < 0.3 : -1) ) : (
  t == 3 ? ( j == 0 ? slider31 >= 2.95 : -1 ) : (
  t == 4 ? ( j == 0 ? floor(slider41 + 0.5) == 3 : (j == 1 ? bon && !bsame : slider43 >= 50) ) : (
  // (lrnB & 2^k) = step k was already reached earlier - e.g. task 5: 'faces the listener again' only counts after the turn-away step
  t == 5 ? ( dx = lx - sx; dy = ly - sy; dln = max(0.001, sqrt(dx * dx + dy * dy)); c = (srAx * dx + srAy * dy) / dln;
             j == 0 ? c < -0.85 : (j == 1 ? -1 : c > 0.95 && (lrnB & 1) > 0) ) : (
  t == 6 ? ( j == 0 ? vopt[18] == 5 : (j == 1 ? vopt[18] == 3 : vopt[18] == 0 && (lrnB & 3) == 3) ) : (
  t == 7 ? ( j == 0 ? rsel == 13 : (j == 1 ? fzsel == 1 && slider85 >= 0.5 : -1) ) : (
  t == 8 ? ( j == 0 ? slider100 >= 0.5 && floor(slider102 + 0.5) == 4 : (j == 1 ? -1 : slider100 >= 0.5 && floor(slider102 + 0.5) == 4 && slider103 >= 0.95 && (lrnB & 2) > 0) ) : (
           ( j == 0 ? floor(slider41 + 0.5) == 1 && bon && !bsame : (j == 1 ? floor(slider41 + 0.5) == 1 && bon && slider96 > 0.05 && slider96 <= 1.3 : -1) ) )))))))));
);
// Show me: everything set so the result can be heard; Start again: back to where the task begins
function lshow(t) local(i)
(
  snap_take();
  t == 0 ? ( sset(10, roomW / 2 / rs); sset(11, min(0.6, roomD * 0.15) / rs); sset(13, roomW / 2 / rs); sset(14, (roomD - min(0.6, roomD * 0.15)) / rs); );
  t == 1 ? ( loadroom(0); sset(13, slider2 - 0.4 / max(0.01, slider31)); sset(14, slider3 - 0.4 / max(0.01, slider31)); );
  t == 2 ? ( sset(5, 0.45); sset(6, 0.45); sset(7, 0.45); sset(8, 0.45); );
  t == 3 ? ( sset(31, 3); );
  t == 4 ? ( sset(11, 0.22 * slider3); sset(14, 0.78 * slider3); sset(41, 3); sset(44, bmatrw(3, 1)); sset(42, 0.5 * slider3); sset(43, 55); );
  t == 5 ? ( sset(63, 0); sset(61, 180); );
  t == 6 ? ( vopt[18] = 5; );
  t == 7 ? ( loadroom(13); sset(35, 1); sset(37, 50); i = 47; loop(13, sset(i, 0); i += 1; ); sset(85, 1); );
  t == 8 ? ( sset(13, roomW / 2 / rs); sset(14, roomD * 0.6 / rs); sset(10, roomW / 2 / rs); sset(11, max(0.3, roomD * 0.6 - 1) / rs); sset(101, 0); sset(102, 4); sset(105, 0); sset(104, roomW / 2 / rs); sset(103, 0.33); sset(107, 1); sset(109, 0); sset(100, 1); );
  t == 9 ? ( sset(11, 0.22 * slider3); sset(14, 0.78 * slider3); sset(41, 1); sset(44, bmatrw(1, 1)); sset(42, 0.5 * slider3); sset(45, slider2 / 2); sset(95, 0); sset(96, 1.2); );
  snap_notify();
);
// Resets the room/settings for Learn task t after taking a snapshot, so the task starts from a clean state
function lreset(t)
(
  snap_take();
  t == 0 || t == 1 ? ( loadroom(2); );
  t == 2 ? ( sset(5, 0.04); sset(6, 0.04); sset(7, 0.04); sset(8, 0.04); );
  t == 3 ? ( sset(31, 1); );
  t == 4 ? ( sset(41, 0); sset(43, 0); );
  t == 5 ? ( sset(63, 0); sset(61, 0); );
  t == 6 ? ( vopt[18] = 0; );
  t == 7 ? ( loadroom(2); sset(35, 0); sset(37, 0); );
  t == 8 ? ( sset(100, 0); );
  t == 9 ? ( sset(41, 0); sset(96, 0); );
  snap_notify();
);
// the control a task needs (Learn has no modules): knob, dial or buttons
function lctl(t, x, yc) local(nf, v)
(
  t == 1 || t == 2 ? (
    v = (slider5 + slider6 + slider7 + slider8) / 4; sprintf(#fv, "%.2f", v); kmap(1, 0.01, 1, 1); kcol = cWALTT;
    nf = knob(72, x + 30, yc, "α walls", #fv, log2f(max(0.01, v), 0.01, 1), log2f(0.04, 0.01, 1));
    knobtip(x + 30, yc, "Absorption α of all four walls – 0.02 tiles, glass · 0.04 plaster · 0.45 heavy curtain · 0.85 mineral wool");
    kchg ? ( v = f2log(nf, 0.01, 1); setp(5, v); setp(6, v); setp(7, v); setp(8, v); );
  );
  t == 3 ? (
    sprintf(#fv, "%.2f×", slider31); kmap(1, 0.25, 4, 1); kcol = cRMTT;
    nf = knob(73, x + 30, yc, "Size", #fv, log2f(slider31, 0.25, 4), log2f(1, 0.25, 4));
    knobtip(x + 30, yc, "Size: the whole room and everything in it, larger or smaller");
    kchg ? setp(31, f2log(nf, 0.25, 4));
  );
  t == 4 ? (
    chip(x, yc - 8, 54, 16, "Door", floor(slider41 + 0.5) == 3, cBARTT) ? (
      snap_take(); floor(slider41 + 0.5) == 3 ? sset(41, 0) : ( btg == 0 ? bcenter(); sset(41, 3); sset(44, bmatrw(3, 1)); ); snap_notify();
    );
    btg >= 2 ? sprintf(#fv, "%.0f°", slider43 * 0.9) : strcpy(#fv, "–"); kmap(0, 0, 90, 1); kcol = cBARTT; kdim = btg <= 1;
    nf = knob(74, x + 100, yc, "Open", #fv, slider43 / 100, 0);
    knobtip(x + 100, yc, "Open: how far the door is open (0° = closed, 90° = wide open)");
    !lockE && kchg ? setp(43, nf * 100); kdim = 0;
  );
  t == 5 ? (
    kcol = cSRC; sprintf(#fv, abs(slider61 - floor(slider61 + 0.5)) > 0.05 ? "%.1f°" : "%.0f°", slider61);
    nf = dirknob(30, x + 30, yc, "Src angle", #fv, slider61, slider63 >= 0.5 ? 0 : (abs(lx - sx) + abs(ly - sy) > 0.001 ? atan2(-(lx - sx), ly - sy) * 180 / $pi : 0));
    knobtip(x + 30, yc, "Where the source points, as seen in the plan – drag around the dial");
    kchg && (!rbyp || isfree) ? setp(61, nf);
    kcol = cLIS; sprintf(#fv, abs(slider17 - floor(slider17 + 0.5)) > 0.05 ? "%.1f°" : "%.0f°", slider17); kdim = slider16 < 0.5;   // the listener's angle next to it
    nf = dirknob(35, x + 100, yc, "Lis angle", #fv, slider17, 180);
    knobtip(x + 100, yc, "Listener angle: where the listener looks – 0° = straight ahead (Facing Fixed)");
    kchg ? ( slider16 < 0.5 ? ( slider16 = 1; autom(32768); ); setp(17, nf); ); kdim = 0;
  );
  t == 8 ? (
    chip(x, yc - 8, 64, 16, "Pass-by", slider100 >= 0.5 && floor(slider102 + 0.5) == 4, cMOTT) ? ( snap_take(); slider100 >= 0.5 ? sset(100, 0) : ( sset(101, 0); sset(102, 4); sset(107, 1); sset(109, 0); sset(104, roomW / 2 / rs); sset(100, 1); ); snap_notify(); );
    sprintf(#fv, "%.1f s", 1 / slider103); kmap(1, 0.1, 50, 1); kcol = cMOTT;   // as in the Motion module - up = longer, typed seconds exact
    nf = knob(75, x + 110, yc, "Duration", #fv, 1 - log(slider103 / 0.02) / log(500), 1 - log(0.33 / 0.02) / log(500));
    knobtip(x + 110, yc, "Duration of one pass (A to B): up = longer, slower – shorter = faster = a bigger pitch jump");
    kchg ? setp(103, 0.02 * 500 ^ (1 - nf));
  );
  t == 9 ? (
    chip(x, yc - 8, 54, 16, "Wall", floor(slider41 + 0.5) == 1, cBARTT) ? (
      snap_take(); floor(slider41 + 0.5) == 1 ? sset(41, 0) : ( btg == 0 ? bcenter(); sset(41, 1); sset(44, bmatrw(1, 1)); ); snap_notify();
    );
    slider96 > 0.05 ? sprintf(#fv, "%.1f m", slider96) : strcpy(#fv, "full"); kmap(0, 0, 3, 1); kcol = cBARTT; kdim = floor(slider41 + 0.5) != 1;
    nf = knob(76, x + 100, yc, "Height", #fv, slider96 <= 0.05 ? 1 : min(1, slider96 / 3), 1);
    knobtip(x + 100, yc, "Height of the wall: full = floor to ceiling, lower = sound passes over the top and bends around its edge");
    kchg ? setp(96, nf >= 0.99 ? 0 : max(0.3, nf * 3)); kdim = 0;
  );
  t == 7 ? (
    chip(x, yc - 8, 54, 16, "Car", rsel == 13, cRMTT) ? ( loadroom(13); snlast = 0; );
    chip(x + 60, yc - 8, 76, 16, "Telephone", fzsel == 1 && slider85 >= 0.5, cSRTT) ? ( snap_take(); sset(35, 1); sset(37, 50); i = 47; loop(13, sset(i, 0); i += 1; ); sset(85, 1); snap_notify(); );
  );
  col(cMUTED, 1); gfx_setfont(7);
  t == 0 ? txtfit("Drag source and listener in the Stage View.", x, yc, LRW - 24) : (
  t == 6 ? txtfit("Use the chips Direct · Early · Late in What you hear.", x, yc, LRW - 24) : (
  t == 4 ? txtfit("then drag the two in the Stage View", x + 140, yc, LRW - 164) : (
  t == 7 || t == 8 || t == 9 ? 0 : txtfit("or Show me", x + 70, yc, LRW - 94) )));
  kcol = cTEXT;
);
// ---- words ----
function lword(k) ( k == 0 ? "Direct sound" : (k == 1 ? "Early reflections" : (k == 2 ? "Reverb" : (k == 3 ? "RT60" : (k == 4 ? "Absorption α" : (k == 5 ? "Critical distance" : (k == 6 ? "Room modes" : "Damping dB")))))); );
// Returns the definition text of Learn word k (direct, early, late, RT60, absorption, critical distance, modes, loss)
function lwdef(k) (
  k == 0 ? "The sound that travels straight from the source to your ears – the first and loudest part. It tells you where the source is, and it gets 6 dB quieter with every doubling of the distance." : (
  k == 1 ? "The first echoes from walls, floor and ceiling, within about 50–80 ms. You do not hear them as echoes: they melt into the direct sound and tell your brain the size and shape of the room." : (
  k == 2 ? "Thousands of reflections that come from everywhere and fade away together. It has no direction any more – it tells how big the room is and what its surfaces are made of." : (
  k == 3 ? "Reverb time: how long the sound needs to fade away by 60 dB, to a thousandth. A car about 0.1 s, a living room 0.5 s, a classroom 0.7 s, a church 5 s." : (
  k == 4 ? "How much of the sound a surface swallows instead of reflecting it: 0 = a perfect mirror (tiles and glass about 0.02), 1 = nothing comes back (an open window). A heavy curtain 0.45, mineral wool 0.85." : (
  k == 5 ? "The distance from the source where direct sound and reverb are equally loud – the dashed circle. Closer: clear and present. Further: the room takes over." : (
  k == 6 ? "In small rooms some bass notes fit exactly between two walls and ring on longer than the rest – the room sounds boomy or boxy. In a corner they are at their loudest." :
           "How much quieter the sound gets through a wall, door or window: 25 dB a light interior door, 45 dB a brick wall. Bass gets through more easily than treble – that is why music next door sounds muffled."))))));
);
// Returns the 'Try:' hint line for Learn word k
function lwtry(k) (
  k == 0 ? "Try: drag the listener away and watch the green line in What you hear." : (k == 1 ? "Try: play only Early, then move the source close to a wall." : (k == 2 ? "Try: play only Late." : (
  k == 3 ? "Try: Your turn, task 3 – soft walls." : (k == 4 ? "Try: Your turn, task 3." : (k == 5 ? "Try: drag the listener across the dashed circle." : (k == 6 ? "Try: Your turn, task 2." : "Try: Your turn, task 5 – a voice behind a door."))))));
);
// ---- the three panels ----
function lpan1()
(
  card(LPX, LQ1, LRW, LP1);
  col(cAMB, 1); RR(LPX + 10, LQ1 + 6, 3, 12, 1.5); col(cTEXT, 1); gfx_setfont(2); txt("What you hear", LPX + 19, LQ1 + 12, 0);
  lrnTL = 1; EX = LPX; EY = LQ1 + 8; EW = LRW; EH = LP1 - 50; gfxpT(); lrnTL = 0;
  rt < 0.3 ? strcpy(#lw2, "very dry, like a vocal booth or a car") : (rt < 0.7 ? strcpy(#lw2, "like a living room or an office") : (rt < 1.3 ? strcpy(#lw2, "like a bathroom or a classroom") : (rt < 2.5 ? strcpy(#lw2, "like a concert hall") : strcpy(#lw2, "like a church or a tunnel"))));
  sprintf(#lw1, "Reverb time RT60 = %.2f s – ", rt); strcat(#lw1, #lw2);
  col(cTEXT, 1); gfx_setfont(2); txtfit(#lw1, LPX + 12, LQ1 + LP1 - 26, LRW - 24);
  col(cMUTED, 1); gfx_setfont(7); txtfit("the time the sound needs to fade away by 60 dB · Direct / Early / Late: listen to one part alone", LPX + 12, LQ1 + LP1 - 11, LRW - 24);
);
// Learn panel 2: 'Your turn' task list with steps, auto-checked conditions, the needed controls and the What happened text
function lpan2() local(k, y, c, h, on, wy, done, lkn)
(
  card(LPX, LQ2, LRW, LP2);
  lrnT = min(9, max(0, floor(vopt[44] + 0.5)));
  lrnT != lrnTp ? ( lrnB = 0; lrnShow = 0; lrnTp = lrnT; );
  col(cRMTT, 1); RR(LPX + 10, LQ2 + 6, 3, 12, 1.5); col(cTEXT, 1); gfx_setfont(2); sprintf(#lw1, "Your turn – task %d of 10", lrnT + 1); txt(#lw1, LPX + 19, LQ2 + 12, 0);
  rbtn(LPX + LRW - 36, LQ2 + 12, 6, "‹", 0, cTEXT, "Previous task") ? ( vopt[44] = (lrnT + 9) % 10; );
  rbtn(LPX + LRW - 18, LQ2 + 12, 6, "›", 0, cTEXT, "Next task") ? ( vopt[44] = (lrnT + 1) % 10; );
  chip(LPX + LRW - 182, LQ2 + 5, 58, 14, "Show me", lrnShow, cRMTT) ? ( lshow(lrnT); lrnShow = 1; );
  tipbox(LPX + LRW - 182, LQ2 + 5, 58, 14, "Show me: sets everything so you can hear the result – and shows what happened");
  chip(LPX + LRW - 120, LQ2 + 5, 72, 14, "Start again", 0, cTEXT) ? ( lreset(lrnT); lrnB = 0; lrnShow = 0; );
  tipbox(LPX + LRW - 120, LQ2 + 5, 72, 14, "Start again: back to where this task begins");
  col(cTEXT, 1); gfx_setfont(3); h = wrapt(ltitle(lrnT), LPX + 12, LQ2 + 38, LRW - 24, 15);
  y = LQ2 + 40 + h + 4; k = 0;
  loop(3,
    c = lcond(lrnT, k); c > 0 ? ( lrnB = lrnB | (2 ^ k); );
    on = (lrnB & (2 ^ k)) > 0;
    on ? ( col(cRMTT, 1); RR(LPX + 12, y - 6, 12, 12, 3); col(cSURF, 1); LNW(LPX + 15, y, LPX + 17.5, y + 3, 1.6); LNW(LPX + 17.5, y + 3, LPX + 21, y - 3, 1.6); )
       : ( col(c < 0 ? cTEXT : cBORD, 1); RRO(LPX + 12, y - 6, 12, 12, 3); );
    c < 0 && click && inbox(LPX + 8, y - 8, LRW - 16, 18) ? ( lrnB = on ? lrnB - (2 ^ k) : lrnB | (2 ^ k); click = 0; );
    tipbox(LPX + 8, y - 8, 22, 18, c < 0 ? "Tick it yourself when you have listened" : "This ticks itself when it is done");
    col(on ? cMUTED : cTEXT, 1); gfx_setfont(13); h = wrapt(lstep(lrnT, k), LPX + 32, y, LRW - 44, 13);
    y += max(18, h + 6); k += 1;
  );
  lkn = (lrnT >= 1 && lrnT <= 5) || lrnT >= 8;                                           // tasks with a knob need its height, the others one line
  lctl(lrnT, LPX + 12, y + (lkn ? 28 : 12));
  wy = y + (lkn ? 64 : 28); done = lrnB == 7 || lrnShow;
  // the box is as tall as its text (measured in the frame before): the panel - and the page - only take what they need
  col(done ? cVIEWT : cBG, 1); RR(LPX + 10, wy, LRW - 20, max(26, lp2wh), 6);
  done ? ( col(cRMTT, 1); gfx_setfont(6); txt("What happened", LPX + 18, wy + 11, 0);
           col(cTEXT, 1); gfx_setfont(13); h = wrapt(lwhat(lrnT), LPX + 18, wy + 27, LRW - 36, 13); lp2wh = 27 + h + 8; )
       : ( col(cMUTED, 1); gfx_setfont(7); h = wrapt("Do the three steps – then the explanation appears here. Stuck? Show me.", LPX + 18, wy + 13, LRW - 36, 11); lp2wh = 13 + h + 6; );
  lp2need = wy + max(26, lp2wh) + 8 - LQ2;
);
// Learn panel 3: 'Words' glossary - word chips plus definition and try-it hint of the selected word
function lpan3() local(k, x, y, w, h, h2)
(
  card(LPX, LQ3, LRW, LQH);
  col(cRVTT, 1); RR(LPX + 10, LQ3 + 6, 3, 12, 1.5); col(cTEXT, 1); gfx_setfont(2); txt("Words", LPX + 19, LQ3 + 12, 0);
  x = LPX + 10; y = LQ3 + 26; k = 0;
  loop(8,
    gfx_setfont(6); w = tws(lword(k)) + 14;
    x + w > LPX + LRW - 10 ? ( x = LPX + 10; y += 18; );
    chip(x, y, w, 14, lword(k), lrnW == k, cRVTT) ? ( lrnW = k; );
    x += w + 4; k += 1;
  );
  y += 22;
  col(cBG, 1); RR(LPX + 10, y, LRW - 20, LQ3 + LQH - 8 - y, 6);
  col(cRVTT, 1); gfx_setfont(6); txt(lword(lrnW), LPX + 18, y + 11, 0);
  col(cTEXT, 1); gfx_setfont(13); h = wrapt(lwdef(lrnW), LPX + 18, y + 27, LRW - 36, 13);
  col(cRMTT, 1); gfx_setfont(14); h2 = wrapt(lwtry(lrnW), LPX + 18, y + 30 + h, LRW - 36, 13);
  lp3need = y + 30 + h + h2 + 10 + 8 - LQ3;                                // (the panel takes what its text needs)
);
// Learn mode: draws the three Learn panels (What you hear, Your turn, Words)
// LEARN without a jump: the two text panels learn their height while they are drawn. When it differs from the height this
// frame was laid out with, the frame is not shown (lpHold: no blit - the window keeps the last picture) and the next frame is
// drawn in full with the real heights - the panels never appear at a wrong size for a frame
function gfxpL()
(
  lpan1(); lpan2(); lpan3();
  (abs(lp2need - lp2use) > 0.5 || abs(lp3need - lp3use) > 0.5) && lpHoldN < 3 ? ( lpHold = 1; lpHoldN += 1; lpGen += 1; ) : ( lpHoldN = 0; );
);
// Heading and chrome of the Stage View: fold/zoom/lock/info, morph, hide, view tabs, start positions, snapshot name
function gfxp4()
(
rvTX = 0;
// ---------- 3D room ----------
card(VX, VY, VW, VH);
zoomv ? ( zxbX = gox + (VX + VW) * gs; zxbY = goy + VY * gs; zxbOn = 1; );
vwopen = zoomv || learn || secop[9 + basic * 12] >= 1;
// heading of the 3D view: fold arrow + name, zoom magnifier, fold / open all sections
vay = VY + 12;
!zoomv ? (
  vop = secop[9 + basic * 12]; vax = VX + 10; vvi = basic ? 13 : 12;
  vop > 0.5 ? chevd(vax, vay, vlock ? cDIM2 : cMUTED) : chevr(vax, vay, vlock ? cDIM2 : cMUTED);
  col(cDIM2, 1); RR(VX + 19, vay - 6, 3, 12, 1.5); col(cTEXT, 1); gfx_setfont(2); txt("Stage View", VX + 28, vay, 0);
  vhw = 30 + tws("Stage View");
  !vlock && !learn && click && inbox(VX + 2, VY + 2, vhw, 20) ? ( (mouse_cap & 16) ? foldall() : ( (vopt[vvi] & 512) ? ( vopt[vvi] -= 512; ) : ( vopt[vvi] += 512; ); ); );
  tipbox(VX + 2, VY + 2, vhw - 14, 20, vop > 0.5 ? "Click: fold the Stage View (Alt+click: fold everything)" : "Click: open the Stage View (Alt+click: open everything)");
  ZBX = VX + 28 + tws("Stage View") + 12;
) : ( ZBX = VX + 16; );
// zoom: magnifier, the same symbol as in the sections (+ = enlarge, - = back)
zrh = sqr(mx - ZBX) + sqr(my - vay) < 49;
col(zoomv ? cRMTT : (zrh ? cTEXT : cMUTED), 1); SDB0(); SDARC(ZBX - 1, vay - 1, 3.5, 0, 2 * $pi); SDSEG(ZBX + 1.6, vay + 1.6, ZBX + 4.3, vay + 4.3); SDSEG(ZBX - 2.6, vay - 1, ZBX + 0.6, vay - 1); !zoomv ? SDSEG(ZBX - 1, vay - 2.6, ZBX - 1, vay + 0.6); SDDRAW(1.05);

!zoomv ? ( svzX = gox + VX * gs; svzY = goy + VY * gs; svzW = VW * gs; svzH = VH * gs; svzF = mzfr; );   // the Stage View's place in every mode (Tabs, Basic, Learn too) - key Z over it zooms it
!basic && !learn && !tabm && !zoomv && !szoom ? ( MZR[0] = gox + VX * gs; MZR[1] = goy + VY * gs; MZR[2] = VW * gs; MZR[3] = VH * gs; MZR[80] = mzfr; );   // the Stage View's place - key Z zooms it (All / Fit)
click && zrh ? ( zoomv = !zoomv; vvi = basic ? 13 : 12; zoomv && basic && (vopt[vvi] & 512) ? ( vopt[vvi] -= 512; ); click = 0; );   // Expert: a hidden view stays hidden after the zoom
zrh ? ( tipon = 1; tipforce = 0; tipstr = zoomv ? "Back to the normal view (Esc or key Z)" : "Zoom: the Stage View alone, over the whole window (All / Fit: key Z with the mouse over it)"; tipx = ZBX; tipy = vay + 16; );
// (the fold-all arrows are gone - Alt+click on a heading folds / opens everything)
!zoomv ? (
  FBX = ZBX + 1;
  // (the layout lock is Lock GUI in the signal-flow strip - here vlock only dims the fold arrow and blocks folding)
  // INFO: shows / hides the window with the live numbers
  INX = FBX + 17; ion = vopt[19] >= 0.5;
  !basic && !learn ? ( rbtn(INX, vay, 5.5, "i", ion, cTEXT, ion ? "Hide the info window" : "Info window: distance, critical distance and direct / room ratio, live") ? ( vopt[19] = ion ? 0 : 1; ); ) : ( INX = FBX + 3; );
  SIX = INX + 14;
);
zoomv ? ( SIX = ZBX + 14; );
// MORPH in the heading (tabs): a fader beside the snapshot name - off, 1 … 16 = that snapshot, between = a blend; automatable
tabm && !zoomv ? (
  mrk = slider64; mphx = VX + VW - 78 - 212 - 134;
  mrk < 1 ? strcpy(#fv, "off") : ( abs(mrk - floor(mrk + 0.5)) < 0.005 ? sprintf(#fv, "snapshot %d", floor(mrk + 0.5)) : sprintf(#fv, "%d → %d  %.0f %%", floor(mrk), floor(mrk) + 1, (mrk - floor(mrk)) * 100) );
  kmap(0, 0, 16, 1);
  nf = hsl(33, mphx, vay - 7, 116, "Morph", #fv, mrk / 16, 0, cRMTT);
  tipbox(mphx - 4, vay - 9, 124, 18, "Snapshot morph (automatable): off, 1 … 16 = that snapshot, in between = blend into the next one (3.5 = half 3, half 4). Automate it in REAPER to change rooms with the picture – double-click = type a value");
  kchg ? setp(64, nf < 0.5 / 16 ? 0 : nf * 16);
);
// HIDE / SHOW the room view (Expert, also key V): hidden = a bar with a live mini plan, every other module gets the room
!basic && !learn && !zoomv ? (
  vhx = VX + VW - 70; vhon = (vopt[12] & 512) > 0;
  chip(vhx, vay - 7, 62, 14, vhon ? "Show view" : "Hide view", vhon, cTEXT) ? ( !vlock ? ( vopt[12] = vhon ? vopt[12] - 512 : vopt[12] + 512; ); click = 0; );
  tipbox(vhx, vay - 7, 62, 14, vhon ? "Show the Stage View again (key V) – the zoom magnifier shows it over the whole window" : "Hide the Stage View (key V): the other modules get its place; a mini plan stays, the zoom magnifier shows the view over the whole window");
);
// ROOM VIEW TABS: Plan (from above, the standard), 3D; Expert also Timeline and RT60 per octave - drawn in the view
gk = 0; vtx = SIX;
loop(basic || learn ? 2 : 4,
  vtw = gk == 0 ? 34 : (gk == 1 ? 26 : (gk == 2 ? 52 : 40));
  chip(vtx, vay - 7, vtw, 14, gk == 0 ? "Plan" : (gk == 1 ? "3D" : (gk == 2 ? "Timeline" : "RT60")), vtab == gk, cTEXT) ? ( vopt[40] = gk; vtab = gk; planv = gk == 0; click = 0; vvi = basic ? 13 : 12; (vopt[vvi] & 512) ? ( basic ? ( !vlock ? ( vopt[vvi] -= 512; ); ) : ( zoomv = 1; ); ); );   // hidden: Expert shows it over the window, Basic opens it
  tipbox(vtx, vay - 7, vtw, 14, gk == 0 ? "Plan: the room from above, to scale – positions, distances and the barrier are easy to set" : (gk == 1 ? "3D: the room in perspective – heights of source and listener (Shift+drag)"
    : (gk == 2 ? "Timeline: direct sound, early reflections and the reverb tail over time – what reaches the listener" : "RT60 per octave: the reverb time in each frequency band as the reverb plays it, the room modes and the numbers behind them")));
  vtx += vtw + 2; gk += 1;
);
SIX = vtx + 8;
// START POSITIONS (every view, also in the zoom): source and listener back to their start places, the room stays.
// Right after the tabs; short label when the heading is narrow
