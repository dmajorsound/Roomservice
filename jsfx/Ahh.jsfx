);
// VIEW: display options as underlined words (display only, not automatable); "View" itself = all on / off
function viewgrp(vgx, vgd) local(gk, gq, vtx, von, nv)
(
col(cTEXT, 1); gfx_setfont(2); txt("View", vgx, 17 + vgd, 0);
click && inbox(vgx - 2, 7 + vgd, 26, 20) ? ( nv = showinfo ? 0 : 1; !basic ? ( vopt[1] = nv; vopt[2] = nv; ); vopt[3] = nv; vopt[6] = nv; );
tipbox(vgx - 2, 7 + vgd, 26, 20, basic ? "View: switch tips and waves on or off at once" : "View: switch tips, paths, direct line and waves on or off at once");
gk = 0;
loop(basic ? 3 : 6,
  gq = basic ? (gk == 0 ? 0 : (gk == 1 ? 3 : 5)) : gk;   // Basic: Tips, Waves, Labels
  vtx = vgx + 26 + gk * 30;
  von = gq == 0 ? tipsOn : (gq == 1 ? showpaths : (gq == 2 ? showdirect : (gq == 3 ? wavesOn : (gq == 4 ? !hidew : !hidetx))));
  col(von ? cTEXT : cMUTED, 1); gfx_setfont(von ? 6 : 4); txt(gq == 0 ? "Tips" : (gq == 1 ? "Paths" : (gq == 2 ? "Direct" : (gq == 3 ? "Waves" : (gq == 4 ? "Walls" : "Labels")))), vtx + 13, 17 + vgd, 1);
  von ? ( col(cRMTT, 1); LNW(vtx + 3, 24 + vgd, vtx + 23, 24 + vgd, 1.4); );
  click && inbox(vtx, 7 + vgd, 28, 20) ? (
    gq == 0 ? ( vopt[3] = !tipsOn; ); gq == 1 ? ( vopt[1] = !showpaths; ); gq == 2 ? ( vopt[2] = !showdirect; ); gq == 3 ? ( vopt[6] = !wavesOn; ); gq == 4 ? ( vopt[10] = !hidew; ); gq == 5 ? ( vopt[71] = !hidetx; );
  );
  gq == 5 ? tipbox(vtx, 7 + vgd, 28, 20, hidetx ? "Labels are hidden in the Stage View – click to show them again" : "Labels: the texts in the Stage View (sizes, distances, loudspeaker names). Off = only the drawing – the lines, handles and barrier buttons are easier to grab") :
  tipbox(vtx, 7 + vgd, 28, 20, gq == 0 ? "Tips: help texts on mouse-over" : (gq == 1 ? "Paths: reflection paths and the critical-distance circle" : (gq == 2 ? "Direct: the direct-sound line between source and listener"
    : (gq == 3 ? "Waves: how the sound spreads – the direct wavefront (blue) and the wall reflections (violet) as moving air, slowed down so you can follow it" : (hidew ? "Walls are hidden – click to show them again (the sound is the same)" : "Hide the walls in the Stage View: easier to grab source and listener – the sound does not change")))));
  gk += 1;
);
);
// ---- BASIC: a row of typical rooms as tiles - line icon, name, reverb time; click = load the room
// (like the room preset menu: source and listener stay where they are when they fit)
// film locations (; the set was changed in - see the next line)
// sorted by reverb time, Outdoors (no reverb) first; Bathroom and Classroom in, Gym and Cave out; "Religious" (neutral icon)
// preset index (PT + k * PRS) of the factory room behind Basic tile i; the tile row itself starts with Outdoors (see basictiles)
function bastile(i) ( i == 0 ? 13 : (i == 1 ? 3 : (i == 2 ? 2 : (i == 3 ? 10 : (i == 4 ? 4 : (i == 5 ? 0 : (i == 6 ? 26 : 25)))))); );
// Returns the Basic-view room preset tile name for index i (0 Car ... 7 Religious)
function bastname(i) ( i == 0 ? "Car" : (i == 1 ? "Small room" : (i == 2 ? "Living room" : (i == 3 ? "Classroom" : (i == 4 ? "Hallway" : (i == 5 ? "Bathroom" : (i == 6 ? "Warehouse" : "Religious")))))); );
// line icons, 16 x 14 units, top left x, y - drawn in the current color
function tileicon(i, x, y)
(
  i == 0 ? ( LNW(x, y + 10, x + 16, y + 10, 1); LNW(x + 2, y + 10, x + 4.5, y + 4, 1); LNW(x + 4.5, y + 4, x + 11, y + 4, 1); LNW(x + 11, y + 4, x + 14, y + 10, 1);
             CIF(x + 4.5, y + 11.5, 1.8, 0); CIF(x + 11.5, y + 11.5, 1.8, 0); ) : (                                 // car
  i == 1 ? ( LNW(x + 1, y + 3, x + 1, y + 13, 1); LNW(x + 1, y + 13, x + 15, y + 13, 1); LNW(x + 1, y + 9, x + 15, y + 9, 1);
             LNW(x + 15, y + 9, x + 15, y + 13, 1); RRO(x + 3, y + 6, 4, 3, 1); ) : (                                   // bed
  i == 2 ? ( RRO(x + 1, y + 7, 14, 5, 1.5); LNW(x + 3, y + 7, x + 3, y + 3.5, 1); LNW(x + 3, y + 3.5, x + 13, y + 3.5, 1); LNW(x + 13, y + 3.5, x + 13, y + 7, 1);
             LNW(x + 3, y + 12, x + 3, y + 14, 1); LNW(x + 13, y + 12, x + 13, y + 14, 1); ) : (                       // sofa
  i == 3 ? ( LNBOX(x + 2, y, 12, 7.5, 0.9); LNW(x + 4.5, y + 3, x + 9, y + 3, 0.8); LNW(x + 4.5, y + 5, x + 7.5, y + 5, 0.8);
             LNW(x + 1, y + 11, x + 15, y + 11, 1); LNW(x + 3, y + 11, x + 3, y + 14, 0.9); LNW(x + 13, y + 11, x + 13, y + 14, 0.9); ) : (   // classroom: board and desk
  i == 4 ? ( LNBOX(x, y, 16, 14, 0.9); LNBOX(x + 5.5, y + 4.5, 5, 5, 0.8); LNW(x, y, x + 5.5, y + 4.5, 0.8); LNW(x + 16, y, x + 10.5, y + 4.5, 0.8);
             LNW(x, y + 14, x + 5.5, y + 9.5, 0.8); LNW(x + 16, y + 14, x + 10.5, y + 9.5, 0.8); ) : (                // corridor
  i == 5 ? ( LNW(x + 0.5, y + 8, x + 15.5, y + 8, 1); LNW(x + 1.5, y + 8, x + 3, y + 12.5, 1); LNW(x + 3, y + 12.5, x + 13, y + 12.5, 1); LNW(x + 13, y + 12.5, x + 14.5, y + 8, 1);
             LNW(x + 4, y + 12.5, x + 3.5, y + 14, 0.9); LNW(x + 12, y + 12.5, x + 12.5, y + 14, 0.9);
             LNW(x + 3, y + 8, x + 3, y + 1.5, 0.9); LNW(x + 3, y + 1.5, x + 6.5, y + 1.5, 0.9); LNW(x + 6.5, y + 1.5, x + 6.5, y + 3, 0.9); CIF(x + 6.5, y + 4.8, 0.6, 1); ) : (   // bathroom: tub and tap
  i == 6 ? ( LNW(x, y + 14, x, y + 6, 1); LNW(x + 16, y + 14, x + 16, y + 6, 1); LNW(x, y + 14, x + 16, y + 14, 1);
             LNW(x, y + 6, x + 5.3, y + 2, 1); LNW(x + 5.3, y + 2, x + 5.3, y + 6, 1); LNW(x + 5.3, y + 6, x + 10.6, y + 2, 1);
             LNW(x + 10.6, y + 2, x + 10.6, y + 6, 1); LNW(x + 10.6, y + 6, x + 16, y + 2, 1); LNW(x + 16, y + 2, x + 16, y + 6, 1); ) : (   // sawtooth hall
             LNW(x + 1, y + 14, x + 1, y + 6.5, 1); LNW(x + 15, y + 14, x + 15, y + 6.5, 1); LNW(x - 0.5, y + 14, x + 16.5, y + 14, 1);
             ARCS(x + 8, y + 6.5, 7, -0.5 * $pi, 0.5 * $pi, 1);
