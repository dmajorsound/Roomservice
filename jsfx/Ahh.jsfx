  k = 0; loop(8, bgoff ? ( fqRo[k] = fqR[k]; ) : ( bgblend ? ( fqR[k] = fqR[k] * bmixg + fqRo[k] * (1 - bmixg); ); ); k += 1; );
  fqR[1] = lfrP; fqR[6] = hfr;
  fqsr != srate ? fqinit();
  // cache key: the loop gains are redesigned only when one of the decay inputs changes (prime weights keep the sum from colliding)
  gkey = rt * 1000003 + hfr * 1009 + last_mfp + lfrP * 7919 + fqR[2] * 104729 + fqR[3] * 7907 + fqR[4] * 6053 + fqR[5] * 5821 + fqR[7] * 4643;
  gkey != last_gkey ? (
    lsum = 0; k = 0;
    loop(8,
      g0 = 10 ^ (-3 * flen[k] / (rt * srate));
